/workspace/argmin/crates/server-core/src/coordinator/authz.rs (L404 to 411)
  Note: Object tag management still allows any same-account principal (requester_is_bucket_owner_account) without AuthorizationProfile checks, enabling constrained credentials to modify tags.
```
    pub(super) fn requester_can_manage_object_tags(
        requester: &Requester,
        bucket: &BucketSummary,
        _object: &StoredObject,
    ) -> bool {
        Self::requester_can_bucket_admin(requester, &bucket.owner_principal)
            || Self::requester_is_bucket_owner_account(requester, bucket)
    }
