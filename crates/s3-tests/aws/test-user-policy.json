{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowCreateDeletePrefixedBucketsOnly",
            "Effect": "Allow",
            "Action": [
                "s3:CreateBucket",
                "s3:DeleteBucket"
            ],
            "Resource": "arn:aws:s3:::claude-s3-*"
        },
        {
            "Sid": "AllowListBuckets",
            "Effect": "Allow",
            "Action": "s3:ListAllMyBuckets",
            "Resource": "*"
        },
        {
            "Sid": "AllowBucketLevelOpsOnPrefixedBucketsOnly",
            "Effect": "Allow",
            "Action": [
                "s3:GetBucketLocation",
                "s3:ListBucket",
                "s3:ListBucketVersions",
                "s3:ListBucketMultipartUploads",
                "s3:GetBucketVersioning",
                "s3:PutBucketVersioning",
                "s3:GetLifecycleConfiguration",
                "s3:PutLifecycleConfiguration",
                "s3:GetBucketPublicAccessBlock",
                "s3:GetBucketPolicyStatus",
                "s3:PutBucketPublicAccessBlock",
                "s3:DeleteBucketPolicy",
                "s3:GetBucketPolicy",
                "s3:PutBucketPolicy",
                "s3:GetEncryptionConfiguration",
                "s3:PutEncryptionConfiguration",
                "s3:GetBucketTagging",
                "s3:PutBucketTagging",
                "s3:GetBucketAbac",
                "s3:PutBucketAbac",
                "s3:GetBucketCors",
                "s3:PutBucketCors",
                "s3:GetBucketOwnershipControls",
                "s3:PutBucketOwnershipControls",
                "s3:GetBucketAcl",
                "s3:PutBucketAcl",
                "s3:GetBucketObjectLockConfiguration",
                "s3:PutBucketObjectLockConfiguration"
            ],
            "Resource": "arn:aws:s3:::claude-s3-*"
        },
        {
            "Sid": "AllowBucketTagControlPlaneOps",
            "Effect": "Allow",
            "Action": [
                "s3:TagResource",
                "s3:UntagResource"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AllowObjectOpsOnlyInsidePrefixedBuckets",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:GetObjectVersion",
                "s3:GetObjectAttributes",
                "s3:GetObjectVersionAttributes",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:DeleteObjectVersion",
                "s3:AbortMultipartUpload",
                "s3:ListMultipartUploadParts",
                "s3:GetObjectTagging",
                "s3:GetObjectVersionTagging",
                "s3:PutObjectTagging",
                "s3:PutObjectVersionTagging",
                "s3:DeleteObjectTagging",
                "s3:DeleteObjectVersionTagging",
                "s3:GetObjectAcl",
                "s3:GetObjectVersionAcl",
                "s3:PutObjectAcl",
                "s3:PutObjectVersionAcl",
                "s3:GetObjectRetention",
                "s3:PutObjectRetention",
                "s3:GetObjectLegalHold",
                "s3:PutObjectLegalHold",
                "s3:BypassGovernanceRetention"
            ],
            "Resource": "arn:aws:s3:::claude-s3-*/*"
        },
        {
            "Sid": "AllowManageTemporaryStsOracleRoles",
            "Effect": "Allow",
            "Action": [
                "iam:CreateRole",
                "iam:DeleteRole",
                "iam:GetRole",
                "iam:GetRolePolicy",
                "iam:ListRolePolicies",
                "iam:DeleteRolePolicy",
                "iam:UpdateAssumeRolePolicy"
            ],
            "Resource": "arn:aws:iam::*:role/argmin-sts-oracle/*"
        },
        {
            "Sid": "AllowBoundedTemporaryRolePolicyMutation",
            "Effect": "Allow",
            "Action": [
                "iam:PutRolePermissionsBoundary",
                "iam:PutRolePolicy"
            ],
            "Resource": "arn:aws:iam::*:role/argmin-sts-oracle/same-account/policy-mutation-*",
            "Condition": {
                "ArnLike": {
                    "iam:PermissionsBoundary": "arn:aws:iam::*:policy/argmin-s3-tests/sts-oracle-role-boundary"
                }
            }
        },
        {
            "Sid": "AllowListTemporaryStsOracleRoles",
            "Effect": "Allow",
            "Action": "iam:ListRoles",
            "Resource": "*"
        },
        {
            "Sid": "AllowSimulateOwnStsOracleAuthorization",
            "Effect": "Allow",
            "Action": "iam:SimulatePrincipalPolicy",
            "Resource": [
                "arn:aws:iam::*:user/${aws:username}",
                "arn:aws:iam::*:user/*/${aws:username}"
            ]
        },
        {
            "Sid": "AllowAssumeCrossAccountStsOracleRoles",
            "Effect": "Allow",
            "Action": "sts:AssumeRole",
            "Resource": "arn:aws:iam::*:role/argmin-sts-oracle/cross-account/*"
        }
    ]
}
