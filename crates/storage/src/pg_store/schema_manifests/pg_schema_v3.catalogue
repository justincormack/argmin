    command_bytes    BLOB NOT NULL,
    publication_started INTEGER NOT NULL DEFAULT 0 CHECK (publication_started IN (0, 1)),
    placed_segment_reference_count INTEGER NOT NULL CHECK (placed_segment_reference_count BETWEEN 0 AND 4294967295),
