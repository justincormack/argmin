    part_number   INTEGER NOT NULL,
    segment_index INTEGER NOT NULL,
    size          INTEGER NOT NULL,
    segment_crc64 INTEGER NOT NULL,
    segment_okh   BLOB NOT NULL,
    segment_vid   INTEGER NOT NULL CHECK (segment_vid > 0),
