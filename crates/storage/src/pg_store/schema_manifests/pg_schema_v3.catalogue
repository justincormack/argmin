    last_modified    INTEGER NOT NULL,
    checksum         BLOB,
    PRIMARY KEY (upload_id, part_number),
    FOREIGN KEY (upload_id) REFERENCES multipart_uploads(upload_id) ON DELETE CASCADE
) STRICT
