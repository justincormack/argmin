{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "LimitOracleMutationRoleToPrefixedObjects",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": "arn:aws:s3:::claude-s3-*/*"
        }
    ]
}
