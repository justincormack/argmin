            -g '!crates/storage/**' \
            || true
        rg -n --color=never \
            '\b(control_plane_startup_error_is_retryable|control_plane_startup_message_indicates_runtime_map_not_ready|frontend_control_plane_startup_error_is_retryable)\b' \
            crates/argmin-s3/src \
            -g '*.rs' \
            || true
        rg -n -U --color=never \
            '(error|message)\.(starts_with|contains)\(\s*"(failed to (fetch|refresh) control-plane runtime map|control-plane runtime map has no routed| has no serving primary in cluster epoch )' \
            crates/argmin-s3/src \
            -g '*.rs' \
            || true
    }
)
fail_with_matches \
    "Raw control-plane transport/protocol errors and remote diagnostic text are storage-owned; preserve typed errors and use semantic ControlPlaneError classifications" \
    "$control_plane_error_representation_leaks"

