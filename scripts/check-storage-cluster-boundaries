    awk '
    FNR == 1 {
        pending_test_cfg = 0
        in_test_module = 0
        pending_bucket_write_client = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    in_test_module {
        next
    }
    {
        if ($0 ~ /\.(retained_)?bucket_write_reservation_client\(\)/ \
            || $0 ~ /(retained_)?bucket_write_reservation_client[[:space:]]*$/) {
            pending_bucket_write_client = 1
        }
        if ($0 ~ /\.(durable_bucket_write_drain_exists|list_lifecycle_sweep_buckets|get_lifecycle_sweep_roots|acquire_lifecycle_sweep_claim|heartbeat_lifecycle_sweep_claim|record_lifecycle_sweep_claim_error|release_lifecycle_sweep_claim)\(/) {
            if ($0 ~ /self\.list_lifecycle_sweep_buckets\(/) {
                next
            }
            if (pending_bucket_write_client \
                || $0 ~ /\.(retained_)?bucket_write_reservation_client\(\)/ \
                || $0 ~ /(retained_)?bucket_write_reservation_client\./) {
                pending_bucket_write_client = 0
                next
            }
            print FILENAME ":" FNR ":" $0
            next
        }
        if ($0 ~ /;/) {
            pending_bucket_write_client = 0
        }
    }
    ' crates/storage/src/cluster.rs \
      crates/storage/src/cluster/request_ops.rs \
      crates/storage/src/cluster/local.rs
)
fail_with_matches \
    "Production lifecycle sweep coordination must use its active or retained reservation role" \
    "$lifecycle_sweep_coordination_broad_client_bypasses"

# Temporary migration prohibition: physical deletion stays behind the
# reclaim-fenced placed-delete implementation until capabilities enforce it.
payload_shard_delete_callers=$(
    awk '
    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        in_test_module = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    pending_test_cfg \
        && $0 !~ /^[[:space:]]*$/ \
        && $0 !~ /^[[:space:]]*#\[/ \
        && $0 !~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/ {
        pending_test_cfg = 0
    }
    in_test_module {
        next
    }
    function update_function_context() {
        if ($0 ~ /^    (pub(\([^)]*\))? |pub\(crate\) |pub\(super\) )?fn [A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
        }
    }
    {
        update_function_context()
        if ($0 ~ /\.[[:space:]]*delete_payload_shard\(/ && current_fn != "delete_payload_shard") {
            print FILENAME ":" current_fn
        }
    }
    ' $(find crates/storage/src -type f -name '*.rs' \
        ! -path '*/tests/*' \
        ! -name '*_tests.rs' \
        | sort) \
        | sort \
        | uniq -c \
        | sed 's/^ *//'
)
expected_payload_shard_delete_callers=$(cat <<'EOF'
1 crates/storage/src/cluster.rs:delete_placed_payload_shard_keys
EOF
)
if [[ "$payload_shard_delete_callers" != "$expected_payload_shard_delete_callers" ]]; then
    fail_with_matches \
        "Physical payload shard deletes must stay behind the placed-delete reclaim fence helper" \
        "$payload_shard_delete_callers"
fi

