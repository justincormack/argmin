raw_coordinator_payload_read_store_mapping=$(
    awk '
    FNR == 1 {
        pending_test_cfg = 0
        in_test_cfg = 0
        in_payload_read_call = 0
        payload_read_call_start = ""
        payload_read_has_store_mapper = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ || /^[[:space:]]*#\[cfg\(feature = "test-hooks"\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*#\[/ {
        next
    }
    function update_function_context() {
        if ($0 ~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            in_test_cfg = pending_test_cfg
            pending_test_cfg = 0
        } else if (pending_test_cfg \
            && $0 !~ /^[[:space:]]*$/ \
            && $0 !~ /^[[:space:]]*#\[/) {
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if (in_test_cfg) {
            next
        }
        if (!in_payload_read_call && $0 ~ /read_segment_payload_stored_bytes_into[[:space:]]*\(/) {
            in_payload_read_call = 1
            payload_read_call_start = FILENAME ":" FNR ":" $0
            payload_read_has_store_mapper = 0
        }
        if (in_payload_read_call \
            && $0 ~ /map_err[[:space:]]*\([[:space:]]*super::map_store_error[[:space:]]*\)/) {
            payload_read_has_store_mapper = 1
        }
        if (in_payload_read_call && $0 ~ /[?][[:space:]]*;/) {
            if (!payload_read_has_store_mapper) {
                print payload_read_call_start
            }
            in_payload_read_call = 0
            payload_read_call_start = ""
            payload_read_has_store_mapper = 0
        } else if (in_payload_read_call && $0 ~ /;[[:space:]]*$/) {
            in_payload_read_call = 0
            payload_read_call_start = ""
            payload_read_has_store_mapper = 0
        }
    }
    ' $(find crates/server-core/src/coordinator -type f -name '*.rs' \
        ! -name '*_tests.rs' \
        ! -path '*/tests/*' \
        | sort)
)
fail_with_matches \
    "Production coordinator payload reads must map storage errors through map_store_error before using ?" \
    "$raw_coordinator_payload_read_store_mapping"

raw_coordinator_bucket_snapshot_store_mappers=$(
    awk '
    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        in_test_cfg = 0
        in_bucket_snapshot_store_mapper = 0
        mapper_depth = 0
        brace_depth = 0
        command_conflict_seen = 0
        fallback_count = 0
    }
    function brace_delta(line,    opens, closes, tmp) {
        tmp = line
        opens = gsub(/\{/, "{", tmp)
        tmp = line
        closes = gsub(/\}/, "}", tmp)
        return opens - closes
    }
    function flush_mapper(    i) {
        if (in_bucket_snapshot_store_mapper && fallback_count > 0 && !command_conflict_seen) {
            for (i = 1; i <= fallback_count; i++) {
                print fallback_line[i]
            }
        }
        in_bucket_snapshot_store_mapper = 0
        mapper_depth = 0
        command_conflict_seen = 0
        fallback_count = 0
        delete fallback_line
    }
    function flush_function() {
        if (!in_test_cfg) {
            flush_mapper()
        }
        in_bucket_snapshot_store_mapper = 0
        mapper_depth = 0
        command_conflict_seen = 0
        fallback_count = 0
        delete fallback_line
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ || /^[[:space:]]*#\[cfg\(feature = "test-hooks"\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*#\[/ {
        next
    }
    function update_function_context() {
        if ($0 ~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            flush_function()
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            in_test_cfg = pending_test_cfg
            pending_test_cfg = 0
        } else if (pending_test_cfg \
            && $0 !~ /^[[:space:]]*$/ \
            && $0 !~ /^[[:space:]]*#\[/) {
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if (in_test_cfg) {
            brace_depth += brace_delta($0)
            next
        }
        if (!in_bucket_snapshot_store_mapper && $0 ~ /BucketSnapshotLoadError::/) {
            in_bucket_snapshot_store_mapper = 1
            mapper_depth = brace_depth
            if ($0 ~ /match[^{]*\{/) {
                mapper_depth++
            }
        }
        if (in_bucket_snapshot_store_mapper \
            && $0 ~ /MetadataCommand(LogConflict|PendingConflict)/) {
            command_conflict_seen = 1
        }
        if (in_bucket_snapshot_store_mapper && $0 ~ /ServerError::Store[[:space:]]*\(/) {
            fallback_count++
            fallback_line[fallback_count] = FILENAME ":" FNR ":" $0
        }
        brace_depth += brace_delta($0)
        if (in_bucket_snapshot_store_mapper && brace_depth < mapper_depth) {
            flush_mapper()
        }
    }
    END {
        flush_function()
    }
    ' $(find crates/server-core/src/coordinator -type f -name '*.rs' \
        ! -name '*_tests.rs' \
        ! -path '*/tests/*' \
        | sort)
)
fail_with_matches \
    "Production coordinator bucket snapshot store errors must use contention-aware bucket snapshot mappers instead of ad hoc Store mapping" \
    "$raw_coordinator_bucket_snapshot_store_mappers"

raw_coordinator_bucket_snapshot_metadata_mappers=$(
    awk '
    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        in_test_cfg = 0
        in_bucket_snapshot_mapper = 0
        mapper_depth = 0
        brace_depth = 0
        command_contention_mapper_seen = 0
    }
    function brace_delta(line,    opens, closes, tmp) {
        tmp = line
        opens = gsub(/\{/, "{", tmp)
        tmp = line
        closes = gsub(/\}/, "}", tmp)
        return opens - closes
    }
    function flush_mapper() {
        in_bucket_snapshot_mapper = 0
        mapper_depth = 0
        command_contention_mapper_seen = 0
    }
    function flush_function() {
        if (!in_test_cfg) {
            flush_mapper()
        }
        in_bucket_snapshot_mapper = 0
        mapper_depth = 0
        command_contention_mapper_seen = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ || /^[[:space:]]*#\[cfg\(feature = "test-hooks"\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*#\[/ {
        next
    }
    function update_function_context() {
        if ($0 ~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            flush_function()
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            in_test_cfg = pending_test_cfg
            pending_test_cfg = 0
        } else if (pending_test_cfg \
            && $0 !~ /^[[:space:]]*$/ \
            && $0 !~ /^[[:space:]]*#\[/) {
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if (in_test_cfg) {
            brace_depth += brace_delta($0)
            next
        }
        if (!in_bucket_snapshot_mapper && $0 ~ /BucketSnapshotLoadError::/) {
            in_bucket_snapshot_mapper = 1
            mapper_depth = brace_depth
            if ($0 ~ /match[^{]*\{/) {
                mapper_depth++
            }
        }
        if (in_bucket_snapshot_mapper && $0 ~ /metadata_error_is_command_contention/) {
            command_contention_mapper_seen = 1
        }
        if (in_bucket_snapshot_mapper && $0 ~ /ServerError::Metadata[[:space:]]*\(/) {
            if (!command_contention_mapper_seen) {
                print FILENAME ":" FNR ":" $0
            }
        }
        brace_depth += brace_delta($0)
        if (in_bucket_snapshot_mapper && brace_depth < mapper_depth) {
            flush_mapper()
        }
    }
    END {
        flush_function()
    }
    ' $(find crates/server-core/src/coordinator -type f -name '*.rs' \
        ! -name '*_tests.rs' \
        ! -path '*/tests/*' \
        | sort)
)
fail_with_matches \
    "Production coordinator bucket snapshot mappers must handle metadata command contention before raw Metadata fallback" \
    "$raw_coordinator_bucket_snapshot_metadata_mappers"

unbudgeted_request_work_helpers=$(
    awk '
    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        in_test_hook = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*#\[/ {
        next
    }
    /^[[:space:]]*(pub(\([^)]*\))?[[:space:]]+|pub\(super\)[[:space:]]+|pub\(crate\)[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/ {
        current_fn = $0
        sub(/^.*fn[[:space:]]+/, "", current_fn)
        sub(/\(.*/, "", current_fn)
        in_test_hook = pending_test_cfg
        pending_test_cfg = 0
    }
    pending_test_cfg && $0 !~ /^[[:space:]]*$/ {
        pending_test_cfg = 0
    }
    {
        if (in_test_hook || current_fn ~ /^test_/) {
            next
        }
        if (current_fn == "drain_unrelated_pending_metadata_command_for_bucket" \
            || current_fn == "drain_pending_metadata_command_pg_slot" \
            || current_fn == "drain_bucket_pg_pending_metadata_command" \
            || current_fn == "drain_pending_completed_multipart_sequence_command" \
            || current_fn == "next_bucket_metadata_command_id_or_drain" \
            || current_fn == "next_completion_bucket_metadata_command_id_or_drain" \
            || current_fn == "try_set_bucket_pg_pending_command_or_retry" \
            || current_fn == "try_set_bucket_control_pending_command_or_retry") {
            next
        }
        if ($0 ~ /\.(drain_unrelated_pending_metadata_command_for_bucket|drain_pending_metadata_command_pg_slot|drain_bucket_pg_pending_metadata_command|drain_pending_completed_multipart_sequence_command|next_bucket_metadata_command_id_or_drain|next_completion_bucket_metadata_command_id_or_drain|try_set_bucket_pg_pending_command_or_retry|try_set_bucket_control_pending_command_or_retry)\(/) {
            print FILENAME ":" FNR ":" $0
        }
    }
    ' crates/storage/src/cluster/request_ops.rs
)
fail_with_matches \
    "Production request paths must use request-work-budget variants for bucket metadata drain/retry helpers" \
    "$unbudgeted_request_work_helpers"

