        if (derive ~ /Clone|PartialEq|Eq/) {
            print FILENAME ":" FNR ":" derive
        }
        in_submission = 1
        depth = 0
    }
    in_submission {
        if ($0 ~ /^[[:space:]]*pub([[:space:]]*\([^)]*\))?[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*:/) {
            print FILENAME ":" FNR ":" $0
        }
        line = $0
        depth += gsub(/\{/, "{", line)
        depth -= gsub(/\}/, "}", line)
        if (depth == 0 && $0 ~ /\}/) {
            in_submission = 0
        }
    }
    /impl UncertifiedInitialControlPlaneTopologySubmission[[:space:]]*\{/ {
        in_impl = 1
        depth = 0
    }
    in_impl {
        if ($0 ~ /^[[:space:]]*pub[[:space:]]+([^[:space:]]+[[:space:]]+)*fn[[:space:]]+/) {
            print FILENAME ":" FNR ":" $0
        }
        line = $0
        depth += gsub(/\{/, "{", line)
        depth -= gsub(/\}/, "}", line)
        if (depth == 0 && $0 ~ /\}/) {
            in_impl = 0
        }
    }
    {
        if ($0 !~ /^[[:space:]]*$/ && $0 !~ /^#\[derive\(/) {
            derive = ""
        }
    }
    ' crates/storage/src/control_plane_raft.rs
)
fail_with_matches \
    "The uncertified initial-topology submission must remain one-use and opaque across durable publication" \
    "$uncertified_initial_topology_submission_surface_leaks"

