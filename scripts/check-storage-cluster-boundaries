            'pub fn (serialize|deserialize)\(' \
            crates/server-core/src/metadata_blob.rs \
            crates/server-core/src/system_metadata.rs \
            || true
    }
)
fail_with_matches \
    "User/system metadata byte codecs are private to server-core and storage carries only their opaque serialized values" \
    "$metadata_blob_codec_leaks"

