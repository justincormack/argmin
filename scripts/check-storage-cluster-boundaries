metadata_proof_carrier_leaks=$(
    {
        rg -n --color=never \
            'pub[[:space:]]+(struct|enum)[[:space:]]+(MetadataCommandLogHash|CanonicalStateDigest)\b' \
            crates/storage/src \
            -g '*.rs' \
            || true
        rg -n --color=never \
            '\bPgMetadataProof::(current|from_carriers|for_test|test_applied_log_index|test_applied_log_hash|test_state_digest)\b' \
            crates \
            -g '*.rs' \
            -g '!crates/storage/**' \
            -g '!crates/argmin-s3/src/main_tests.rs' \
            || true
        rg -n --color=never \
            '\b(MetadataCommandLogHash|CanonicalStateDigest)\b' \
            crates \
            -g '*.rs' \
            -g '!crates/storage/**' \
            || true
        rg -n --color=never \
            '\bInto(MetadataCommandLogHash|CanonicalStateDigest)\b' \
            crates/storage/src \
            -g '*.rs' \
            || true
        rg -n --color=never \
            '\bMetadataCommandLogHash::from_hash_owner\b' \
            crates/storage/src \
            -g '*.rs' \
            -g '!crates/storage/src/metadata_command.rs' \
            || true
        rg -n --color=never \
            '\b(MetadataCommandLogHash|CanonicalStateDigest)::from_storage\b' \
            crates/storage/src \
            -g '*.rs' \
            -g '!crates/storage/src/pg_store/command_log.rs' \
            || true
        rg -n --color=never \
            '\b(MetadataCommandLogHash|CanonicalStateDigest)::from_encoded_parts\b' \
            crates/storage/src \
            -g '*.rs' \
            -g '!crates/storage/src/control_plane.rs' \
            -g '!crates/storage/src/control_plane/rpc.rs' \
            -g '!crates/storage/src/control_plane_command.rs' \
            -g '!crates/storage/src/control_plane_pg_admin.rs' \
            -g '!crates/storage/src/pg_store/command_log.rs' \
            -g '!crates/storage/src/storage_node_server/config.rs' \
            -g '!crates/storage/src/storage_rpc/metadata_command_codec.rs' \
            || true
        awk '
            function allowed(carrier, method) {
                if (carrier == "MetadataCommandLogHash") {
                    return method ~ /^(from_hash_owner|from_storage|genesis|from_encoded_parts|encoding_version|value|for_test)$/
                }
                return method ~ /^(from_storage|genesis|from_encoded_parts|encoding_version|value|for_test|wrapping_add)$/
            }
            /^impl (MetadataCommandLogHash|CanonicalStateDigest) \{/ {
                carrier = $2
                depth = 1
                next
            }
            carrier != "" {
                if ($0 ~ /pub(\([^)]*\))?[[:space:]]+(const[[:space:]]+)?fn[[:space:]]+/) {
                    method = $0
                    sub(/^.*fn[[:space:]]+/, "", method)
                    sub(/[^A-Za-z0-9_].*$/, "", method)
                    if (!allowed(carrier, method)) {
                        print FILENAME ":" FNR ":unexpected-carrier-method:" carrier "::" method
                    }
                }
                line = $0
                opens = gsub(/\{/, "{", line)
                closes = gsub(/\}/, "}", line)
                depth += opens - closes
                if (depth == 0) {
                    carrier = ""
                }
            }
        ' crates/storage/src/control_plane.rs
    }
)
fail_with_matches \
    "Metadata proof carriers are issued only by their hash/digest owners or exact-version decoders; production callers carry typed values and receive only opaque PgMetadataProof capabilities" \
    "$metadata_proof_carrier_leaks"

