        if ($0 ~ /\.load_bucket_snapshot\(/) {
            if (pending_bucket_metadata_client \
                || pending_reservation_node == 2 \
                || $0 ~ /\.bucket_metadata_client\(\)/ \
                || $0 ~ /bucket_metadata_client\./ \
                || $0 ~ /storage_client\.load_bucket_snapshot\(/ \
                || $0 ~ /reservation\.node\.load_bucket_snapshot\(/) {
                pending_storage_client = 0
                pending_bucket_metadata_client = 0
                pending_reservation_node = 0
