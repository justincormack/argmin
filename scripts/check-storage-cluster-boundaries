            && current_fn != "load_leased_object_read_snapshot_if_on_route<T, E>" \
            && current_fn != "try_acquire_object_payload_lease" \
            && current_fn != "try_acquire_object_payload_lease_on_locations" \
            && current_fn != "acquire_object_payload_lease_session_admission" \
            && current_fn != "object_payload_lease_control_response" \
            && !in_test_hook) {
            print FILENAME ":" current_fn
        }
    }
    ' $(find crates/storage/src crates/server-core/src -type f -name '*.rs' \
        ! -path '*/tests/*' \
        ! -name '*_tests.rs' \
        | sort) \
        | sort \
        | uniq -c \
        | sed 's/^ *//'
)
fail_with_matches \
    "Production reads may use a coarse generation-wide lease only while loading an exact leased snapshot before shard-location handoff" \
    "$coarse_payload_lease_callers"

legacy_payload_matches=$(
    rg -n --color=never \
        'write_direct_put_segment_shards|PayloadShardStorage::MetadataPrimary|payload_storage:[[:space:]]*PayloadShardStorage::MetadataPrimary|write_erasure_coded_segment_shards\(' \
        crates/storage/src \
        crates/server-core/src \
        -g '*.rs' \
        || true
)
fail_with_matches \
    "Legacy metadata-primary payload write path reintroduced" \
    "$legacy_payload_matches"

legacy_bucket_counter_matches=$(
    rg -n --color=never \
        '\b(acquire_bucket_write_reservation|release_bucket_write_reservation|begin_bucket_write_drain|end_bucket_write_drain)\b' \
        crates/storage/src \
        -g '*.rs' \
        || true
