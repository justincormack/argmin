maintenance_sweeper_public_test_method_pattern='^[[:space:]]*pub[[:space:]]+fn[[:space:]]+test_(is_enabled|routes_to|stop|backfill_one_pending|repair_one_pending|sweep_once)\b'

scan_public_maintenance_sweeper_test_methods() {
    local source_root=$1

    rg -n --color=never \
        "$maintenance_sweeper_public_test_method_pattern" \
        "$source_root" \
        -g '*.rs' \
        || true
}

