        fi
        if ! rg -q \
            '^required-features = \["uat-pg-topology"\]$' \
            crates/s3-tests/Cargo.toml
        then
            printf '%s\n' \
                'crates/s3-tests/Cargo.toml: PG topology UAT binary must require its storage test-support feature'
        fi
        if ! rg -q \
            '^pub trait PgTopologyPlacementTestSupport' \
            crates/storage/src/test_support/pg_topology.rs
        then
            printf '%s\n' \
                'crates/storage/src/test_support/pg_topology.rs: storage must own the feature-gated UAT placement selector'
        fi
        if ! rg -q \
            '^pub mod uat_pg_backfill_support;$' \
            crates/s3-tests/src/lib.rs
        then
            printf '%s\n' \
                'crates/s3-tests/src/lib.rs: PG topology UAT unit logic must remain in the default-built library target'
        fi
        rg -n -U --color=never \
            '#\[cfg[^\n]*\][[:space:]]*(#\[doc\(hidden\)\][[:space:]]*)?pub mod uat_pg_backfill_support;' \
            crates/s3-tests/src/lib.rs \
            || true
        rg -n --color=never \
            '#\[(cfg\(test\)|test)\]' \
            crates/s3-tests/src/bin/uat_pg_backfill_smoke.rs \
            || true
        for test_name in \
            committed_placement_parser_requires_one_standard_segment \
            committed_placement_rejects_a_target_mismatch \
            distinct_data_pg_bucket_search_scales_for_large_excluded_metadata_set
        do
            if ! rg -q \
                "^[[:space:]]*fn[[:space:]]+${test_name}\\b" \
                crates/s3-tests/src/uat_pg_backfill_support.rs
            then
                printf '%s\n' \
                    "crates/s3-tests/src/uat_pg_backfill_support.rs: default-built UAT regression ${test_name} is missing"
            fi
        done
    }
)
fail_with_matches \
    "Physical payload placement types and methods must remain private to storage" \
    "$physical_payload_placement_public_surface"


