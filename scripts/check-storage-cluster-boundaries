operator_admin_opaque_surface_leaks=$(
    {
        rg -n -U --color=never \
            'pub struct (ControlPlaneRaftAdminClient|ControlPlaneAuthorityClockAdminClient|ControlPlaneAuthorityClockAdminStatus|ControlPlaneOperatorAdminError)\(pub|pub struct (ControlPlaneRaftAdminClient|ControlPlaneAuthorityClockAdminClient|ControlPlaneAuthorityClockAdminStatus|ControlPlaneOperatorAdminError)[[:space:]]*\{[^}]*[[:space:]]pub[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*:' \
            crates/storage/src/control_plane_operator_admin.rs \
            || true
        rg -n -U --color=never \
            '#\[derive\([^]]*(Debug|Clone|Copy|PartialEq|Eq)[^]]*\)\][[:space:]]*pub struct (ControlPlaneRaftAdminClient|ControlPlaneAuthorityClockAdminClient|ControlPlaneAuthorityClockAdminStatus|ControlPlaneOperatorAdminError)' \
            crates/storage/src/control_plane_operator_admin.rs \
            || true
        awk '
        /impl (ControlPlaneRaftAdminClient|ControlPlaneAuthorityClockAdminClient|ControlPlaneAuthorityClockAdminStatus|ControlPlaneOperatorAdminError)[[:space:]]*\{/ {
            in_operator_admin_impl = 1
            operator_admin_impl = $0
            sub(/^.*impl /, "", operator_admin_impl)
            sub(/[[:space:]]*\{.*/, "", operator_admin_impl)
            depth = 0
        }
        in_operator_admin_impl {
            if ($0 ~ /^[[:space:]]*pub[[:space:]]+([^[:space:]]+[[:space:]]+)*fn[[:space:]]+/) {
                method = $0
                sub(/^.*fn[[:space:]]+/, "", method)
                sub(/\(.*/, "", method)
                if ((operator_admin_impl == "ControlPlaneRaftAdminClient" && method != "from_bootstrap" && method != "transfer_leadership_to" && method != "trigger_snapshot_and_purge" && method != "trigger_election") || (operator_admin_impl == "ControlPlaneAuthorityClockAdminClient" && method != "from_bootstrap" && method != "status" && method != "reestablish") || operator_admin_impl == "ControlPlaneAuthorityClockAdminStatus" || operator_admin_impl == "ControlPlaneOperatorAdminError") {
                    print FILENAME ":" FNR ":" $0
                }
            }
            line = $0
            depth += gsub(/\{/, "{", line)
            depth -= gsub(/\}/, "}", line)
            if (depth == 0 && $0 ~ /\}/) {
                in_operator_admin_impl = 0
            }
        }
        ' crates/storage/src/control_plane_operator_admin.rs
    }
)
fail_with_matches \
    "Operator administration facades must retain transport, clock state, and diagnostics opaquely and expose only their bounded logical operations" \
    "$operator_admin_opaque_surface_leaks"

