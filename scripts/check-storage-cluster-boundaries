store_error_policy_leaks=$(
    {
        rg -n --color=never \
            '\bStoreError::|\bstorage_node_failure_class\b|\bStorageNodeFailureClass\b' \
            crates/server-core/src crates/server-http/src crates/argmin-s3/src \
            -g '*.rs' \
            -g '!**/*_tests.rs' \
            -g '!**/tests/**' \
            -g '!crates/server-core/src/error.rs' \
            -g '!crates/server-http/src/http/mod.rs' \
            -g '!crates/server-http/src/http/response.rs' \
            -g '!crates/server-http/src/http/serve.rs' \
            || true
        for source in \
            crates/server-core/src/error.rs \
            crates/server-http/src/http/mod.rs \
            crates/server-http/src/http/response.rs \
            crates/server-http/src/http/serve.rs
        do
            awk '
                previous_was_test_cfg && /^mod tests \{/ { exit }
                { print FNR ":" $0 }
                { previous_was_test_cfg = ($0 == "#[cfg(test)]") }
            ' "$source" | rg --color=never \
                '\bStoreError::|\bstorage_node_failure_class\b|\bStorageNodeFailureClass\b' \
                || true
        done
    }
)
