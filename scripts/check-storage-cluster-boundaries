    "$raw_route_admission_error_transit"

raw_object_read_error_transit=$(
    {
        rg -n -U --color=never \
            'pub struct SegmentStoredBytesRequest|pub use types::(?s:[^;]*)\bSegmentStoredBytesRequest\b|^[[:space:]]*pub[[:space:]]+((async|const|unsafe)[[:space:]]+)*fn[[:space:]]+[A-Za-z0-9_]+(?s:[^;{]{0,700})\bSegmentStoredBytesRequest\b' \
            crates/storage/src -g '*.rs' \
            || true
        awk '
        /^pub\(crate\) struct SegmentStoredBytesRequest[[:space:]]*\{/ {
            in_request = 1
            next
        }
        in_request && /^}/ {
            in_request = 0
            next
        }
        in_request && /^[[:space:]]*pub[[:space:]]+/ {
            print FILENAME ":" FNR ":" $0
        }
        ' crates/storage/src/types.rs
        if ! rg -q \
            '^pub\(crate\) struct SegmentStoredBytesRequest' \
            crates/storage/src/types.rs
        then
            printf '%s\n' \
                'crates/storage/src/types.rs: SegmentStoredBytesRequest must remain crate-private'
        fi
        if ! rg -q -U \
            '#\[cfg\(test\)\][[:space:]]*pub\(crate\) use types::SegmentStoredBytesRequest;' \
            crates/storage/src/lib.rs
        then
            printf '%s\n' \
                'crates/storage/src/lib.rs: SegmentStoredBytesRequest root alias must remain owner-test-only and crate-private'
        fi
        awk '
        /^impl ActiveObjectReadRoute/ {
            in_object_read_impl = 1
            next
        }
        /^impl / {
            in_object_read_impl = 0
            collecting_signature = 0
        }
        in_object_read_impl && /^[[:space:]]*pub[[:space:]]+((async|const|unsafe)[[:space:]]+)*fn[[:space:]]+/ {
            collecting_signature = 1
            signature = $0
            signature_start = FILENAME ":" FNR ":" $0
            if ($0 ~ /[{]/) {
                if (signature ~ /(ObjectPgActionError|StoreError)/) {
                    print signature_start
                }
                collecting_signature = 0
            }
            next
        }
        in_object_read_impl && collecting_signature {
            signature = signature " " $0
            if ($0 ~ /[{]/) {
                if (signature ~ /(ObjectPgActionError|StoreError)/) {
                    print signature_start
                }
                collecting_signature = 0
            }
        }
        ' crates/storage/src/cluster/operation_routes.rs
        rg -n -U --color=never \
            '^[[:space:]]*pub[[:space:]]+((async|const|unsafe)[[:space:]]+)*fn[[:space:]]+(load_object_if|load_object_read_snapshot_if|load_leased_object_read_snapshot_if|retain_object_payload_read|acquire_object_payload_read_lease|get_object_tags_if|get_object_legal_hold_if|get_object_retention_if|read_segment_payload_stored_bytes_into|read_object_payload_segment_stored_bytes_into|read_segment_payload_stored_bytes_at_placement_epoch_into)(?s:[^;{]{0,500})Result<[^;{]*(ObjectPgActionError|StoreError)' \
            crates/storage/src/cluster/operation_routes.rs \
            crates/storage/src/cluster/request_ops \
            crates/storage/src/cluster/shard_maintenance.rs \
            || true
        rg -n -U --color=never \
            'fn read_checked_segment_payload(?s:.{0,1800})map_store_error' \
            crates/server-core/src/coordinator/runtime.rs \
            || true
        rg -n --color=never '\bObjectPgActionError\b|\bMetadataError\b|\bStoreError\b' \
            crates/server-core/src/coordinator/authz.rs \
            crates/server-core/src/coordinator/authz/acl.rs \
            crates/server-core/src/coordinator/authz/modern.rs \
            || true
        rg -n --color=never \
            '\b(ObjectTagsForSubject|get_object_tags_for_subject|object_tags_for_subject)' \
            crates/storage/src \
            -g '*.rs' \
            || true
        if ! rg -q -U \
            'fn map_object_read_snapshot_error(?s:.{0,300})error: storage::ObjectReadFailure' \
            crates/server-core/src/coordinator/authz/acl.rs
        then
            printf '%s\n' \
                'crates/server-core/src/coordinator/authz/acl.rs: object-read response mapping must accept ObjectReadFailure'
        fi
        for method in \
            read_segment_payload_stored_bytes_into \
            read_object_payload_segment_stored_bytes_into
        do
            if ! rg -q -U \
                "^[[:space:]]*pub[[:space:]]+fn[[:space:]]+${method}(?s:[^;{]{0,400})Result<[[:space:]]*\\(\\),[[:space:]]*ObjectReadFailure>" \
                crates/storage/src/cluster
            then
                printf '%s\n' \
                    "crates/storage/src/cluster: public ${method} must return ObjectReadFailure"
            fi
        done
        if ! rg -q -U \
            '#\[cfg\(test\)\][[:space:]]*pub\(crate\)[[:space:]]+fn[[:space:]]+read_segment_payload_stored_bytes_into' \
            crates/storage/src/cluster/shard_maintenance.rs
        then
            printf '%s\n' \
                'crates/storage/src/cluster/shard_maintenance.rs: the unbound physical segment reader must remain owner-test-only'
        fi
    }
)
fail_with_matches \
    "Object-read authorization and payload reads must cross storage through opaque capabilities and ObjectReadFailure rather than forgeable physical requests or raw storage implementation errors" \
    "$raw_object_read_error_transit"

