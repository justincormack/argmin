            || true
        rg -n --color=never \
            'pub fn seal_session_credential_v[0-9]+\b|pub const (SESSION_TOKEN_V[0-9]+_PREFIX|MAX_DECODED_SESSION_TOKEN_FRAME_LEN|MAX_ENCODED_SESSION_TOKEN_LEN|MAX_ISSUED_V[0-9]+_TOKEN_LEN)\b' \
            crates/auth/src \
            -g '*.rs' \
