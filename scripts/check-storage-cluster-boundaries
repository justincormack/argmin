    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    in_test_module {
        next
    }
    function update_function_context() {
        if ($0 ~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            pending_test_cfg = 0
        } else if (pending_test_cfg \
            && $0 !~ /^[[:space:]]*$/ \
            && $0 !~ /^[[:space:]]*#\[/) {
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if (current_fn == "delete_bucket_from_acting_set" \
            && ($0 ~ /\.get_pg\(/ \
                || $0 ~ /PgMetadataStore::delete_finalized_bucket\(/ \
                || $0 ~ /\.refresh_metadata_command_state_digest\(/)) {
            print FILENAME ":" FNR ":" $0
        }
    }
    ' crates/storage/src/cluster.rs \
      crates/storage/src/cluster/request_ops.rs \
      crates/storage/src/cluster/local.rs
)
fail_with_matches \
    "Production finalized bucket deletion fanout must go through the node client boundary" \
    "$bucket_finalize_delete_bypasses"

