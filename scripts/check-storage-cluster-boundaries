                if (signature ~ /(ObjectPgActionError|MetadataError|StoreError)/) {
                    print signature_start
                }
                collecting_signature = 0
            }
        }
        ' crates/storage/src/cluster.rs
        rg -n -U --color=never \
            '^[[:space:]]*pub[[:space:]]+((async|const|unsafe)[[:space:]]+)*fn[[:space:]]+(list_objects_for_bucket|list_object_versions_for_bucket|list_multipart_uploads_for_bucket)(?s:.{0,500})Result<[^;{]*(ObjectPgActionError|MetadataError|StoreError)' \
            crates/storage/src/cluster/request_ops.rs \
            || true
        rg -n --color=never \
            '\.map_err\(Self::map_object_pg_action_error\)' \
            crates/server-core/src/coordinator/listing.rs \
            || true
        if ! rg -q -U \
            'fn map_object_metadata_listing_failure(?s:.{0,300})error: storage::ObjectMetadataListingFailure' \
            crates/server-core/src/coordinator/listing.rs
        then
            printf '%s\n' \
                'crates/server-core/src/coordinator/listing.rs: object-metadata listing response mapping must accept ObjectMetadataListingFailure'
        fi
        if ! rg -q 'ObjectMetadataListing\(ObjectMetadataListingFailure\)' \
            crates/server-core/src/error.rs
        then
            printf '%s\n' \
                'crates/server-core/src/error.rs: internal object-metadata listing failures must remain typed through ServerError'
        fi
    }
)
fail_with_matches \
    "Bucket-wide object, version, and multipart listing scans must cross storage through ObjectMetadataListingFailure" \
    "$raw_object_metadata_listing_error_transit"

