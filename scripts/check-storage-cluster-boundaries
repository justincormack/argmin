        if ($0 ~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            pending_test_cfg = 0
        } else if (pending_test_cfg \
            && $0 !~ /^[[:space:]]*$/ \
            && $0 !~ /^[[:space:]]*#\[/) {
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if (current_fn == "reserve_put_object_generation_with_route_validation" \
            && ($0 ~ /PgMetadataStore::get_object_generation_reservation\(/ \
                || $0 ~ /\.get_object_generation_reservation\(/)) {
            print FILENAME ":" FNR ":" $0
        }
    }
    ' crates/storage/src/cluster.rs \
      crates/storage/src/cluster/request_ops.rs \
      crates/storage/src/cluster/local.rs
)
fail_with_matches \
    "Production reserve-object-generation reservation lookup must go through the node client boundary" \
    "$object_generation_reservation_bypasses"

migrated_background_worker_bypasses=$(
    awk '
    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        in_test_hook = 0
        in_test_module = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    in_test_module {
        next
    }
    function update_function_context() {
        if ($0 ~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            in_test_hook = pending_test_cfg
            pending_test_cfg = 0
        } else if (pending_test_cfg \
            && $0 !~ /^[[:space:]]*$/ \
            && $0 !~ /^[[:space:]]*#\[/) {
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if (in_test_hook) {
            next
        }
        if ($0 ~ /PgMetadataStore::(get_bucket_payload_reclaim_root|get_payload_reclaim_root|get_object_segments_reclaim|get_multipart_reclaim|acquire_object_payload_reclaim_claim|release_object_payload_reclaim_claim|get_bucket_delete_finalize_roots|acquire_bucket_delete_finalize_claim|release_bucket_delete_finalize_claim|get_lifecycle_sweep_roots|list_buckets_with_lifecycle|list_aborting_multipart_upload_bucket_witnesses|acquire_lifecycle_sweep_claim|heartbeat_lifecycle_sweep_claim|record_lifecycle_sweep_claim_error|release_lifecycle_sweep_claim)/) {
            print FILENAME ":" FNR ":" $0
        }
    }
    ' crates/storage/src/cluster.rs \
      crates/storage/src/cluster/request_ops.rs \
      crates/storage/src/cluster/local.rs
)
fail_with_matches \
    "Production durable reclaim/finalizer/lifecycle worker roots and claims must go through the node client boundary" \
    "$migrated_background_worker_bypasses"

# Temporary migration prohibition: physical deletion stays behind the
# reclaim-fenced placed-delete implementation until capabilities enforce it.
payload_shard_delete_callers=$(
    awk '
    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        in_test_module = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    pending_test_cfg \
        && $0 !~ /^[[:space:]]*$/ \
        && $0 !~ /^[[:space:]]*#\[/ \
        && $0 !~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/ {
        pending_test_cfg = 0
    }
    in_test_module {
        next
    }
    function update_function_context() {
        if ($0 ~ /^    (pub(\([^)]*\))? |pub\(crate\) |pub\(super\) )?fn [A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
        }
    }
    {
        update_function_context()
        if ($0 ~ /\.[[:space:]]*delete_payload_shard\(/ && current_fn != "delete_payload_shard") {
            print FILENAME ":" current_fn
        }
    }
    ' $(find crates/storage/src -type f -name '*.rs' \
        ! -path '*/tests/*' \
        ! -name '*_tests.rs' \
        | sort) \
        | sort \
        | uniq -c \
        | sed 's/^ *//'
)
expected_payload_shard_delete_callers=$(cat <<'EOF'
1 crates/storage/src/cluster/shard_maintenance.rs:delete_placed_payload_shard_keys
EOF
)
if [[ "$payload_shard_delete_callers" != "$expected_payload_shard_delete_callers" ]]; then
    fail_with_matches \
        "Physical payload shard deletes must stay behind the placed-delete reclaim fence helper" \
        "$payload_shard_delete_callers"
fi

# Temporary migration prohibition: raw shard reads stay behind placed readers
# and health validation until shard-scoped read capabilities enforce it.
payload_shard_read_callers=$(
    awk '
    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        in_test_module = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    pending_test_cfg \
        && $0 !~ /^[[:space:]]*$/ \
        && $0 !~ /^[[:space:]]*#\[/ \
        && $0 !~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/ {
        pending_test_cfg = 0
    }
    in_test_module {
        next
    }
    function update_function_context() {
        if ($0 ~ /^    (pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            in_test_hook = pending_test_cfg
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if ($0 ~ /\.[[:space:]]*read_payload_shard(_into(_without_handle)?)?\(/ \
            && current_fn != "read_payload_shard" \
            && current_fn != "read_payload_shard_into" \
            && current_fn != "read_payload_shard_into_without_handle" \
            && !in_test_hook) {
            print FILENAME ":" current_fn
        }
    }
    ' $(find crates/storage/src crates/server-core/src -type f -name '*.rs' \
        ! -path '*/tests/*' \
        ! -name 'tests.rs' \
        ! -name '*_tests.rs' \
        | sort) \
        | sort \
        | uniq -c \
        | sed 's/^ *//'
)
expected_payload_shard_read_callers=$(cat <<'EOF'
1 crates/storage/src/cluster/payload_operations.rs:validate_payload_shard_acks
1 crates/storage/src/cluster/shard_maintenance.rs:placed_segment_payload_shard_health_at_locations
1 crates/storage/src/cluster/shard_maintenance.rs:try_load_placed_segment_shard
1 crates/storage/src/cluster/shard_maintenance.rs:try_read_placed_segment_direct_into
EOF
)
if [[ "$payload_shard_read_callers" != "$expected_payload_shard_read_callers" ]]; then
    fail_with_matches \
        "Placed payload shard reads must stay inside the storage segment reader or publish validator" \
        "$payload_shard_read_callers"
fi

