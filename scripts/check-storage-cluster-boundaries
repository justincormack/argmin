    {
        rg -n --color=never \
            '\bMultipartUploadIdKey\b|\bmultipart_upload_id_key\b|\b(MULTIPART_UPLOAD_ID_KEY_LEN|UPLOAD_ID_ALPHABET|UPLOAD_ID_LEN)\b|\bfrom_test_key_bytes\b' \
            crates \
            -g '*.rs' \
            -g '!crates/storage/**' \
            || true
        rg -n --color=never \
            '^[[:space:]]*pub[[:space:]]+(struct[[:space:]]+MultipartUploadIdKey|const[[:space:]]+(MULTIPART_UPLOAD_ID_KEY_LEN|UPLOAD_ID_ALPHABET|UPLOAD_ID_LEN)\b|use.*\b(MultipartUploadIdKey|MULTIPART_UPLOAD_ID_KEY_LEN|UPLOAD_ID_ALPHABET|UPLOAD_ID_LEN)\b)' \
            crates/storage/src/types.rs \
            crates/storage/src/lib.rs \
            || true
    }
)
fail_with_matches \
    "Multipart upload ID key material, durable encoding constants, and issuance are private to storage; higher layers may retain only MultipartUploadIdAuthority and logical test helpers" \
    "$multipart_upload_id_key_boundary_leaks"

