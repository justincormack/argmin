manual_pg_admin_opaque_surface_leaks=$(
    {
        rg -n -U --color=never \
            'pub struct (ControlPlanePgAdminClient|ControlPlanePgStatusClient|ControlPlanePgMetadataTransferInstall|ControlPlanePgAdminInputError|ControlPlanePgAdminError)\(pub|pub struct (ControlPlanePgAdminClient|ControlPlanePgStatusClient|ControlPlanePgMetadataTransferInstall|ControlPlanePgAdminInputError|ControlPlanePgAdminError)[[:space:]]*\{[^}]*[[:space:]]pub[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*:' \
            crates/storage/src/control_plane_pg_admin.rs \
            || true
        rg -n -U --color=never \
            '#\[derive\([^]]*(Debug|Clone|Copy|PartialEq|Eq)[^]]*\)\][[:space:]]*pub struct (ControlPlanePgAdminClient|ControlPlanePgStatusClient|ControlPlanePgMetadataTransferInstall|ControlPlanePgAdminInputError|ControlPlanePgAdminError)' \
            crates/storage/src/control_plane_pg_admin.rs \
            || true
        awk '
        /impl (ControlPlanePgAdminClient|ControlPlanePgStatusClient|ControlPlanePgMetadataTransferInstall|ControlPlanePgAdminInputError|ControlPlanePgAdminError)[[:space:]]*\{/ {
            in_pg_admin_impl = 1
            pg_admin_impl = $0
            sub(/^.*impl /, "", pg_admin_impl)
            sub(/[[:space:]]*\{.*/, "", pg_admin_impl)
            depth = 0
        }
        in_pg_admin_impl {
            if ($0 ~ /^[[:space:]]*pub[[:space:]]+([^[:space:]]+[[:space:]]+)*fn[[:space:]]+/) {
                method = $0
                sub(/^.*fn[[:space:]]+/, "", method)
                sub(/\(.*/, "", method)
                if ((pg_admin_impl == "ControlPlanePgAdminClient" && method != "from_bootstrap" && method != "set_acting_set" && method != "fence_for_metadata_transfer" && method != "install_metadata_transfer") || (pg_admin_impl == "ControlPlanePgStatusClient" && method != "from_frontend_client" && method != "serving_epochs") || (pg_admin_impl == "ControlPlanePgMetadataTransferInstall" && method != "new") || pg_admin_impl == "ControlPlanePgAdminInputError" || pg_admin_impl == "ControlPlanePgAdminError") {
                    print FILENAME ":" FNR ":" $0
                }
            }
            line = $0
            depth += gsub(/\{/, "{", line)
            depth -= gsub(/\}/, "}", line)
            if (depth == 0 && $0 ~ /\}/) {
                in_pg_admin_impl = 0
            }
        }
        ' crates/storage/src/control_plane_pg_admin.rs
        rg -n -U --color=never \
            'impl[^{]*ControlPlaneRuntimeMapSource[^{]*for[[:space:]]+ControlPlanePg(Admin|Status)' \
            crates/storage/src/control_plane_pg_admin.rs \
            || true
    }
)
