    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        pending_storage_client = 0
        pending_object_read_metadata_client = 0
        pending_object_mutation_metadata_client = 0
        pending_object_mutation_receiver = 0
        in_test_hook = 0
        in_test_module = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    in_test_module {
        next
    }
    function update_function_context() {
        if ($0 ~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            in_test_hook = pending_test_cfg
            pending_test_cfg = 0
        } else if (pending_test_cfg \
            && $0 !~ /^[[:space:]]*$/ \
            && $0 !~ /^[[:space:]]*#\[/) {
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if (in_test_hook) {
            next
        }
        if (current_fn == "load_bucket_delete_authorization_snapshot_with_route_validation") {
            next
        }
        if ($0 ~ /\.storage_client\(\)/) {
            pending_storage_client = 1
        }
        if ($0 ~ /\.bucket_metadata_client\(\)/ \
            || $0 ~ /bucket_metadata_client[[:space:]]*$/) {
            pending_bucket_metadata_client = 1
        }
        if ($0 ~ /\.(head_bucket_raw|head_bucket_record_raw)\(/) {
            if (pending_storage_client \
                || pending_bucket_metadata_client \
                || $0 ~ /\.storage_client\(\)/ \
                || $0 ~ /storage_client\./ \
                || $0 ~ /\.bucket_metadata_client\(\)/ \
                || $0 ~ /bucket_metadata_client\./) {
                pending_storage_client = 0
                pending_bucket_metadata_client = 0
                next
            }
            print FILENAME ":" FNR ":" $0
        }
        if ($0 ~ /PgMetadataStore::(head_bucket_raw|head_bucket_record_raw)\(/) {
            print FILENAME ":" FNR ":" $0
        }
        if ($0 ~ /;/) {
            pending_storage_client = 0
            pending_bucket_metadata_client = 0
        }
    }
    ' crates/storage/src/cluster.rs \
      crates/storage/src/cluster/request_ops.rs \
      crates/storage/src/cluster/local.rs
