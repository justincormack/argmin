    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        in_test_hook = 0
        in_test_module = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    in_test_module {
        next
    }
    function update_function_context() {
        if ($0 ~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            in_test_hook = pending_test_cfg
            pending_test_cfg = 0
        } else if (pending_test_cfg \
            && $0 !~ /^[[:space:]]*$/ \
            && $0 !~ /^[[:space:]]*#\[/) {
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if (in_test_hook) {
            next
        }
        if ($0 ~ /PgMetadataStore::(get_bucket_payload_reclaim_root|get_payload_reclaim_root|get_object_segments_reclaim|get_multipart_reclaim|acquire_object_payload_reclaim_claim|release_object_payload_reclaim_claim|get_bucket_delete_finalize_roots|acquire_bucket_delete_finalize_claim|release_bucket_delete_finalize_claim|get_lifecycle_sweep_roots|list_buckets_with_lifecycle|list_buckets_with_aborting_multipart_uploads|acquire_lifecycle_sweep_claim|heartbeat_lifecycle_sweep_claim|record_lifecycle_sweep_claim_error|release_lifecycle_sweep_claim)/) {
            print FILENAME ":" FNR ":" $0
        }
        if ($0 ~ /\.(list_buckets_with_lifecycle|list_buckets_with_aborting_multipart_uploads)\(/) {
            print FILENAME ":" FNR ":" $0
        }
    }
    ' crates/storage/src/cluster.rs \
      crates/storage/src/cluster/request_ops.rs \
      crates/storage/src/cluster/local.rs
)
fail_with_matches \
