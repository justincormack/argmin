route_authority_capability_leaks=$(
    {
        rg -n --color=never \
            '\bStorageCluster::(from_local_map|open_local_nodes)\b|pub fn (from_local_map|open_local_nodes)\b' \
            crates plans \
            -g '*.rs' \
            -g '*.md' \
            || true
        rg -n --color=never \
            '\bStorageClusterRuntimeMapHandle\b' \
            crates \
            -g '*.rs' \
            -g '!crates/storage/**' \
            -g '!crates/argmin-s3/src/main.rs' \
            -g '!crates/server-core/src/coordinator/core_tests.rs' \
            -g '!crates/server-core/src/coordinator/test_support.rs' \
            -g '!crates/server-http/src/http/serve.rs' \
            || true
        awk '
            /^mod tests \{/ { exit }
            /StorageClusterRuntimeMapHandle/ {
                print FILENAME ":" FNR ":" $0
            }
        ' crates/server-http/src/http/serve.rs
        rg -n --color=never \
            '\btest_from_route_handle\b|pub[[:space:]]+fn[[:space:]]+from_authorized_cluster\b' \
            crates \
            -g '*.rs' \
            || true
        rg -n --color=never \
            '\.argmin-standalone-route\.(identity|identity\.next|initializing|lock)' \
            crates \
            -g '*.rs' \
            -g '!crates/storage/**' \
            || true
        rg -n --color=never \
            '\b(StandaloneRouteIdentity|PreparedStandaloneEmbeddedTopology)\b' \
            crates \
            -g '*.rs' \
            -g '!crates/storage/**' \
            -g '!crates/argmin-s3/src/main.rs' \
            -g '!crates/argmin-s3/src/static_cluster_config.rs' \
            || true
        rg -n --color=never \
            'pub struct StandaloneRouteIdentity\(pub[[:space:]]' \
            crates/storage/src/standalone.rs \
            || true
        awk '
            /^#\[cfg\(test\)\]/ { exit }
            /fs::(rename|remove_file|write)\(/ {
                print FILENAME ":" FNR ":" $0
            }
        ' crates/storage/src/standalone.rs
        awk '
            /^mod tests \{/ { exit }
            /legacy-local|ProcessRole::Standalone/ {
                print FILENAME ":" FNR ":" $0
            }
        ' crates/argmin-s3/src/config.rs \
          crates/argmin-s3/src/main.rs \
          crates/argmin-s3/src/static_cluster_config.rs
    }
)
fail_with_matches \
    "Static construction and standalone durable binding must remain storage-owned and explicit; generic route-handle construction cannot be public, request consumers receive only StorageClusterRouteHandle, no request handle can be upgraded to dynamic publication authority, and the obsolete legacy-local role cannot return" \
    "$route_authority_capability_leaks"

