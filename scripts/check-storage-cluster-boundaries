#!/bin/env bash

set -euo pipefail

# The checked inventories are compared as ordered text. Locale collation can
# order `cluster.rs` and `cluster/request_ops.rs` differently, so make every
# sort and character-class match deterministic across caller environments.
export LC_ALL=C

if ! command -v rg >/dev/null 2>&1; then
    echo "error: rg is required for scripts/check-storage-cluster-boundaries" >&2
    exit 1
fi

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

failed=0

fail_with_matches() {
    local label=$1
    local matches=$2

    if [[ -n "$matches" ]]; then
        echo
        echo "== $label =="
        printf '%s\n' "$matches"
        failed=1
    fi
}

echo "Storage cluster boundary checks"

storage_test_feature_graph_failure=""
if ! storage_test_feature_graph_output=$(
    bash scripts/check-storage-test-feature-graph 2>&1
); then
    storage_test_feature_graph_failure=$storage_test_feature_graph_output
fi
fail_with_matches \
    "Workspace normal/build feature graphs must enable storage test support only for the exhaustive reviewed test-only package allowlist" \
    "$storage_test_feature_graph_failure"

# CreateMultipartUpload is the remaining root object-metadata command whose
# application creates its own generation reservation rather than validating a
# complete pre-existing durable subject. Canonical command decoding is already
# compiler-confined: returning an envelope requires an unforgeable authority
# minted only inside the private node runtime, including through RPC codecs.
multipart_root_command_mint_bypasses=$(
    rg -n \
        'CreateMultipartUploadCommand::from_request_with_bucket_write_reservation\(|CreateMultipartUploadCommand[[:space:]]*\{' \
        crates/storage/src/cluster.rs crates/storage/src/cluster \
        -g '*.rs' \
        -g '!**/tests/**' \
        -g '!tests.rs' \
        -g '!*_tests.rs' \
        || true
)
fail_with_matches \
    "Production multipart-upload root commands must use the scoped node-runtime builder, not direct construction" \
    "$multipart_root_command_mint_bypasses"

# Temporary migration prohibition: physical deletion stays behind the
# reclaim-fenced placed-delete implementation until capabilities enforce it.
payload_shard_delete_callers=$(
    awk '
    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        in_test_module = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    pending_test_cfg \
        && $0 !~ /^[[:space:]]*$/ \
        && $0 !~ /^[[:space:]]*#\[/ \
        && $0 !~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/ {
        pending_test_cfg = 0
    }
    in_test_module {
        next
    }
    function update_function_context() {
        if ($0 ~ /^    (pub(\([^)]*\))? |pub\(crate\) |pub\(super\) )?fn [A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
        }
    }
    {
        update_function_context()
        if ($0 ~ /\.[[:space:]]*delete_payload_shard\(/ && current_fn != "delete_payload_shard") {
            print FILENAME ":" current_fn
        }
    }
    ' $(find crates/storage/src -type f -name '*.rs' \
        ! -path '*/tests/*' \
        ! -name '*_tests.rs' \
        | sort) \
        | sort \
        | uniq -c \
        | sed 's/^ *//'
)
expected_payload_shard_delete_callers=$(cat <<'EOF'
1 crates/storage/src/cluster/shard_maintenance.rs:delete_placed_payload_shard_keys
EOF
)
if [[ "$payload_shard_delete_callers" != "$expected_payload_shard_delete_callers" ]]; then
    fail_with_matches \
        "Physical payload shard deletes must stay behind the placed-delete reclaim fence helper" \
        "$payload_shard_delete_callers"
fi

# Temporary migration prohibition: raw shard reads stay behind placed readers
# and health validation until shard-scoped read capabilities enforce it.
payload_shard_read_callers=$(
    awk '
    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        in_test_module = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    pending_test_cfg \
        && $0 !~ /^[[:space:]]*$/ \
        && $0 !~ /^[[:space:]]*#\[/ \
        && $0 !~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/ {
        pending_test_cfg = 0
    }
    in_test_module {
        next
    }
    function update_function_context() {
        if ($0 ~ /^    (pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            in_test_hook = pending_test_cfg
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if ($0 ~ /\.[[:space:]]*read_payload_shard(_into(_without_handle)?)?\(/ \
            && current_fn != "read_payload_shard" \
            && current_fn != "read_payload_shard_into" \
            && current_fn != "read_payload_shard_into_without_handle" \
            && !in_test_hook) {
            print FILENAME ":" current_fn
        }
    }
    ' $(find crates/storage/src crates/server-core/src -type f -name '*.rs' \
        ! -path '*/tests/*' \
        ! -name 'tests.rs' \
        ! -name '*_tests.rs' \
        | sort) \
        | sort \
        | uniq -c \
        | sed 's/^ *//'
)
expected_payload_shard_read_callers=$(cat <<'EOF'
1 crates/storage/src/cluster/payload_operations.rs:validate_payload_shard_acks
1 crates/storage/src/cluster/shard_maintenance.rs:placed_segment_payload_shard_health_at_locations
1 crates/storage/src/cluster/shard_maintenance.rs:try_load_placed_segment_shard
1 crates/storage/src/cluster/shard_maintenance.rs:try_read_placed_segment_direct_into
EOF
)
if [[ "$payload_shard_read_callers" != "$expected_payload_shard_read_callers" ]]; then
    fail_with_matches \
        "Placed payload shard reads must stay inside the storage segment reader or publish validator" \
        "$payload_shard_read_callers"
fi


segment_payload_read_callers=$(
    awk '
    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        in_test_module = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    pending_test_cfg \
        && $0 !~ /^[[:space:]]*$/ \
        && $0 !~ /^[[:space:]]*#\[/ \
        && $0 !~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/ {
        pending_test_cfg = 0
    }
    in_test_module {
        next
    }
    function update_function_context() {
        if ($0 ~ /^    (pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            in_test_hook = pending_test_cfg
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if ($0 ~ /\.[[:space:]]*read_segment_payload_stored_bytes_into\(/ \
            && current_fn != "read_segment_payload_stored_bytes_into" \
            && !in_test_hook) {
            print FILENAME ":" current_fn
        }
    }
    ' $(find crates/storage/src crates/server-core/src -type f -name '*.rs' \
        ! -path '*/tests/*' \
        ! -name '*_tests.rs' \
        | sort) \
        | sort \
        | uniq -c \
        | sed 's/^ *//'
)
expected_segment_payload_read_callers=$(cat <<'EOF'
1 crates/server-core/src/coordinator/runtime.rs:read_checked_segment_payload
EOF
)
if [[ "$segment_payload_read_callers" != "$expected_segment_payload_read_callers" ]]; then
    fail_with_matches \
        "Server-core payload bytes must be read only through ReadRuntime::read_checked_segment_payload after ReadHandle acquisition" \
        "$segment_payload_read_callers"
fi


coarse_payload_lease_callers=$(
    awk '
    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        in_test_module = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    pending_test_cfg \
        && $0 !~ /^[[:space:]]*$/ \
        && $0 !~ /^[[:space:]]*#\[/ \
        && $0 !~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/ {
        pending_test_cfg = 0
    }
    in_test_module {
        next
    }
    function update_function_context() {
        if ($0 ~ /^    (pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            in_test_hook = pending_test_cfg
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if ($0 ~ /\.[[:space:]]*acquire_object_payload_lease\(/ \
            && current_fn != "acquire_object_payload_lease" \
            && current_fn != "load_leased_object_read_snapshot_if_on_route<T, E>" \
            && current_fn != "try_acquire_object_payload_lease" \
            && current_fn != "try_acquire_object_payload_lease_inner" \
            && current_fn != "try_acquire_object_payload_lease_on_locations" \
            && current_fn != "try_acquire_object_payload_lease_on_locations_inner" \
            && current_fn != "acquire_object_payload_lease_session_admission" \
            && current_fn != "test_acquire_object_payload_lease_for_snapshot" \
            && current_fn != "object_payload_lease_control_response" \
            && !in_test_hook) {
            print FILENAME ":" current_fn
        }
    }
    ' $(find crates/storage/src crates/server-core/src -type f -name '*.rs' \
        ! -path '*/tests/*' \
        ! -name 'tests.rs' \
        ! -name 'test_rpc.rs' \
        ! -name '*_tests.rs' \
        | sort) \
        | sort \
        | uniq -c \
        | sed 's/^ *//'
)
fail_with_matches \
    "Production reads may use a coarse generation-wide lease only while loading an exact leased snapshot before shard-location handoff" \
    "$coarse_payload_lease_callers"


publisher_scan_output=$(
    awk -f scripts/check-storage-cluster-boundary-publishers.awk \
        $(find crates/storage/src -type f -name '*.rs' \
            ! -path '*/tests/*' \
            ! -name '*_tests.rs' \
            | sort)
)

pending_command_publishers=$(
    printf '%s\n' "$publisher_scan_output" \
        | awk -F '\t' '$1 == "PUBLISHER" { print $2 }' \
        | sort \
        | uniq -c \
        | sed 's/^ *//'
)

publisher_scanner_fixture=$(
    awk -f scripts/check-storage-cluster-boundary-publishers.awk \
        scripts/fixtures/storage-boundary-publishers/inline-test-items.rs
)
expected_publisher_scanner_fixture=$(cat <<'EOF'
MARKER	FixtureProductionPublisher:production_publisher_after_inline_test_module
PUBLISHER	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:production_publisher_after_inline_test_module:FixtureProductionPublisher:try_set_pending_metadata_command_for_bucket
MARKER	LiveFeaturePublisher:production_feature_publisher_must_remain_visible
PUBLISHER	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:production_feature_publisher_must_remain_visible:LiveFeaturePublisher:try_install_pending_metadata_command_for_bucket
MARKER	TypedSnapshotPublisher:typed_snapshot_sensitive_publisher_is_not_shell_inventoried
TYPED_MISSING_MARKER	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:typed_snapshot_sensitive_publisher_without_marker_is_rejected:install_snapshot_sensitive_metadata_command_or_drain
MARKER	TypedSnapshotBucketControlPublisher:typed_snapshot_sensitive_bucket_control_is_not_shell_inventoried
TYPED_MISSING_MARKER	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:typed_snapshot_sensitive_bucket_control_without_marker_is_rejected:install_snapshot_sensitive_bucket_control_command_or_drain
MARKER	TypedSnapshotBucketPgPublisher:typed_snapshot_sensitive_bucket_pg_is_not_shell_inventoried
TYPED_MISSING_MARKER	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:typed_snapshot_sensitive_bucket_pg_without_marker_is_rejected:install_snapshot_sensitive_bucket_pg_command_or_drain
MARKER	TypedAllocatorPublisher:typed_allocator_cleanup_publisher_is_not_shell_inventoried
TYPED_MISSING_MARKER	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:typed_allocator_cleanup_publisher_without_marker_is_rejected:install_allocator_cleanup_metadata_command_with_fresh_id
MARKER	TypedTerminalSessionPublisher:typed_terminal_session_publisher_is_not_shell_inventoried
TYPED_MISSING_MARKER	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:typed_terminal_session_publisher_without_marker_is_rejected:install_terminal_session_retry_metadata_command
MARKER	TypedMatchingOutcomePublisher:typed_matching_outcome_publisher_is_not_shell_inventoried
TYPED_MISSING_MARKER	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:typed_matching_outcome_publisher_without_marker_is_rejected:install_matching_outcome_retry_metadata_command
MARKER	TypedApplyValidatedPublisher:typed_apply_validated_publisher_is_not_shell_inventoried
TYPED_MISSING_MARKER	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:typed_apply_validated_publisher_without_marker_is_rejected:install_apply_validated_metadata_command_with_fresh_id
MARKER	TypedGenericDrainPublisher:typed_generic_drain_is_not_shell_inventoried
TYPED_MISSING_MARKER	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:typed_generic_drain_without_marker_is_rejected:drain_pending_object_metadata_commands_for_publisher
MARKER	RawGenericDrainPublisher:raw_generic_drain_from_publisher_is_rejected
PUBLISHER	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:raw_generic_drain_from_publisher_is_rejected:RawGenericDrainPublisher:raw_pending_object_metadata_command_drain
PUBLISHER	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:raw_generic_drain_from_unmarked_wrapper_is_rejected:<missing>:raw_pending_object_metadata_command_drain
RECOVERY_DRAIN_USE	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:raw_inner_drain_from_unmarked_wrapper_is_rejected:metadata_command_authorized_drain_primitive
RECOVERY_DRAIN_USE	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:recovery_authority_construction_from_unmarked_wrapper_is_rejected:metadata_command_recovery_authority_constructor
RECOVERY_DRAIN_USE	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:recovery_authority_constructor_function_item_is_rejected:metadata_command_recovery_authority_constructor
RECOVERY_DRAIN_USE	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:recovery_invocation_construction_from_unmarked_wrapper_is_rejected:metadata_command_recovery_invocation_constructor
RECOVERY_DRAIN_USE	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:recovery_wrapper_from_unmarked_wrapper_is_rejected:metadata_command_local_recovery_drain
RECOVERY_DRAIN_USE	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:recovery_execution_route_from_unmarked_wrapper_is_rejected:metadata_command_recovery_execution_route
PUBLISHER	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:recovery_execution_route_struct_literal_is_rejected:<missing>:metadata_command_execution_route_struct_literal
RECOVERY_DRAIN_USE	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:recovery_proof_derivation_from_unmarked_wrapper_is_rejected:metadata_command_recovery_proof_derivation
RECOVERY_DRAIN_USE	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:recovery_leader_construction_from_unmarked_wrapper_is_rejected:metadata_command_recovery_leader_constructor
RECOVERY_DRAIN_USE	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:recovery_apply_from_unmarked_wrapper_is_rejected:metadata_command_recovery_apply
RECOVERY_DRAIN_USE	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:recovery_reissued_apply_from_unmarked_wrapper_is_rejected:metadata_command_recovery_apply_reissued
RECOVERY_DRAIN_USE	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:recovery_abandon_from_unmarked_wrapper_is_rejected:metadata_command_recovery_record_abandoned
RECOVERY_DRAIN_USE	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:recovery_pending_removal_from_unmarked_wrapper_is_rejected:metadata_command_recovery_remove_pending
RECOVERY_DRAIN_USE	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:recovery_reissue_from_unmarked_wrapper_is_rejected:metadata_command_recovery_reissue
RECOVERY_DRAIN_USE	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:recovery_bucket_finisher_from_unmarked_wrapper_is_rejected:metadata_command_recovery_bucket_finisher
PUBLISHER	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:retired_recovery_finisher_from_unmarked_wrapper_is_rejected:<missing>:retired_metadata_command_recovery_finisher
EOF
)
if [[ "$publisher_scanner_fixture" != "$expected_publisher_scanner_fixture" ]]; then
    fail_with_matches \
        "Publisher scanner fixture changed; test-only scopes must be excluded without hiding production-feature publishers" \
        "$publisher_scanner_fixture"
fi

recovery_drain_authority_uses=$(
    printf '%s\n' "$publisher_scan_output" \
        | awk -F '\t' '$1 == "RECOVERY_DRAIN_USE" { print $2 }' \
        | sort
)
expected_recovery_drain_authority_uses=$(cat <<'EOF'
crates/storage/src/cluster/metadata_operations.rs:drain_pending_metadata_commands_for_current_map:metadata_command_local_recovery_drain
crates/storage/src/cluster/metadata_operations.rs:reissue_pending_metadata_command:metadata_command_recovery_reissue
crates/storage/src/cluster/payload_operations.rs:complete_abandoned_object_metadata_command:metadata_command_recovery_execution_route
crates/storage/src/cluster/payload_operations.rs:complete_abandoned_object_metadata_command:metadata_command_recovery_execution_route
crates/storage/src/cluster/payload_operations.rs:complete_abandoned_object_metadata_command:metadata_command_recovery_proof_derivation
