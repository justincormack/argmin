raft_durability_publication_surface_leaks=$(
    awk '
    /#\[derive\(/ {
        derive = $0
        next
    }
    /pub struct ControlPlaneRaftDurabilityPublication[[:space:]]*\{/ {
        if (derive ~ /Debug|PartialEq|Eq/) {
            print FILENAME ":" FNR ":" derive
        }
        in_publication = 1
        depth = 0
    }
    in_publication {
        if ($0 ~ /^[[:space:]]*pub([[:space:]]*\([^)]*\))?[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*:/) {
            print FILENAME ":" FNR ":" $0
        }
        line = $0
        depth += gsub(/\{/, "{", line)
        depth -= gsub(/\}/, "}", line)
        if (depth == 0 && $0 ~ /\}/) {
            in_publication = 0
        }
    }
    /impl ControlPlaneRaftDurabilityPublication[[:space:]]*\{/ {
        in_impl = 1
        depth = 0
    }
    in_impl {
        if ($0 ~ /^[[:space:]]*pub[[:space:]]+([^[:space:]]+[[:space:]]+)*fn[[:space:]]+/) {
            method = $0
            sub(/^.*fn[[:space:]]+/, "", method)
            sub(/\(.*/, "", method)
            if (method != "is_poisoned" && method != "ensure_available" && method != "poison") {
                print FILENAME ":" FNR ":" $0
            }
        }
        line = $0
        depth += gsub(/\{/, "{", line)
        depth -= gsub(/\}/, "}", line)
        if (depth == 0 && $0 ~ /\}/) {
            in_impl = 0
        }
    }
    {
        if ($0 !~ /^[[:space:]]*$/ && $0 !~ /^#\[derive\(/) {
            derive = ""
        }
    }
    ' crates/storage/src/control_plane_raft.rs
)
fail_with_matches \
    "The authority-bound Raft durability publication must remain opaque and expose only admission and poison operations" \
    "$raft_durability_publication_surface_leaks"

