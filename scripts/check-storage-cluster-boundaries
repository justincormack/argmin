1 crates/storage/src/cluster/request_ops.rs:insert_current_delete_marker_if_with_route_validation:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:next_bucket_metadata_command_id_or_drain:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:put_object_metadata_if_with_route_validation:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:reclaim_object_payload_if_unleased:metadata-command-log-conflict
2 crates/storage/src/cluster/request_ops.rs:try_set_bucket_control_pending_command_or_retry:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:try_set_bucket_pg_pending_command_or_retry:metadata-command-log-conflict
EOF
)
if [[ "$metadata_command_conflict_uses" != "$expected_metadata_command_conflict_uses" ]]; then
    fail_with_matches \
        "MetadataCommandLogConflict handling changed; update guides/metadata-command-stream.md finish/convergence classification and this allowlist" \
        "$metadata_command_conflict_uses"
fi

