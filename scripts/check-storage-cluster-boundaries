            pending_storage_client = 0
            pending_bucket_metadata_client = 0
            pending_reservation_node = 0
        }
    }
    ' crates/storage/src/cluster.rs \
      crates/storage/src/cluster/request_ops.rs \
      crates/storage/src/cluster/local.rs
