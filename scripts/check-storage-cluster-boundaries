#!/bin/env bash

set -euo pipefail

if ! command -v rg >/dev/null 2>&1; then
    echo "error: rg is required for scripts/check-storage-cluster-boundaries" >&2
    exit 1
fi

repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
cd "$repo_root"

failed=0

fail_with_matches() {
    local label=$1
    local matches=$2

    if [[ -n "$matches" ]]; then
        echo
        echo "== $label =="
        printf '%s\n' "$matches"
        failed=1
    fi
}

echo "Storage cluster boundary checks"

unexpected_single_node=$(
    awk '
    function update_function_context() {
        if ($0 ~ /^    #\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ || $0 ~ /^    #\[cfg\(test\)\]/) {
            pending_test_hook_cfg = 1
            return
        }
        if ($0 ~ /^    #\[/) {
            return
        }
        if ($0 ~ /^    (pub(\([^)]*\))? )?fn [A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            in_test_hook = pending_test_hook_cfg
            pending_test_hook_cfg = 0
            return
        }
        if ($0 !~ /^[[:space:]]*$/) {
            pending_test_hook_cfg = 0
        }
    }
    {
        update_function_context()
        if ($0 ~ /self\.single_node/ \
            && current_fn != "metadata_primary_bridge_node" \
            && current_fn != "metadata_primary_topology_node") {
            print FILENAME ":" FNR ":" $0
        }
    }
    ' crates/storage/src/cluster.rs crates/storage/src/cluster/request_ops.rs
)
fail_with_matches \
    "Unexpected direct self.single_node access outside approved StorageCluster helpers" \
    "$unexpected_single_node"

unexpected_metadata_bridge=$(
    awk '
    function update_function_context() {
        if ($0 ~ /^    #\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ || $0 ~ /^    #\[cfg\(test\)\]/) {
            pending_test_hook_cfg = 1
            return
        }
        if ($0 ~ /^    #\[/) {
            return
        }
        if ($0 ~ /^    (pub(\([^)]*\))? )?fn [A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            in_test_hook = pending_test_hook_cfg
            pending_test_hook_cfg = 0
            return
        }
        if ($0 !~ /^[[:space:]]*$/) {
            pending_test_hook_cfg = 0
        }
    }
    {
        update_function_context()
        if ($0 ~ /metadata_primary_bridge_node\(/ \
            && current_fn != "metadata_primary_bridge_node" \
            && !in_test_hook) {
            print FILENAME ":" FNR ":" $0
        }
    }
    ' crates/storage/src/cluster.rs crates/storage/src/cluster/request_ops.rs
)
fail_with_matches \
    "metadata_primary_bridge_node used outside cfg-gated test hooks" \
    "$unexpected_metadata_bridge"

legacy_object_pending_helpers=$(
    rg -n --color=never \
        'apply_pending_object_metadata_command_for_bucket|finish_pending_object_metadata_command_for_bucket' \
        crates/storage/src \
        -g '*.rs' \
        || true
)
fail_with_matches \
    "Use exact/drain object pending-command helpers; legacy bucket-named object finisher helpers are not allowed" \
    "$legacy_object_pending_helpers"

direct_shard_matches=$(
    rg -n --color=never '\.(write_shard|read_shard|delete_shard|write_shard_file|read_shard_file|read_shard_file_into|delete_shard_file)\(' \
        crates/storage/src \
        crates/server-core/src \
        -g '*.rs' \
        -g '!crates/storage/src/tests/**' \
        -g '!crates/storage/src/cluster.rs' \
        -g '!crates/storage/src/cluster/local.rs' \
        -g '!crates/storage/src/pg_store.rs' \
        -g '!crates/storage/src/traits.rs' \
        || true
)
unexpected_direct_shard=$(
    printf '%s\n' "$direct_shard_matches" \
        | awk -F: '($1 == "crates/storage/src/node.rs" && $2 >= 1570) { next } { print }'
)
fail_with_matches \
    "Production shard IO bypasses StorageCluster placed IO" \
    "$unexpected_direct_shard"

legacy_payload_matches=$(
    rg -n --color=never \
        'write_direct_put_segment_shards|PayloadShardStorage::MetadataPrimary|payload_storage:[[:space:]]*PayloadShardStorage::MetadataPrimary|write_erasure_coded_segment_shards\(' \
        crates/storage/src \
        crates/server-core/src \
        -g '*.rs' \
        || true
)
fail_with_matches \
    "Legacy metadata-primary payload write path reintroduced" \
    "$legacy_payload_matches"

production_metadata_methods=$(
    awk '
    function is_allowed_production_method(name) {
        return name == "delete_finalized_bucket" \
            || name == "acquire_bucket_write_reservation" \
            || name == "release_bucket_write_reservation" \
            || name == "begin_bucket_write_drain" \
            || name == "end_bucket_write_drain" \
            || name == "acquire_durable_bucket_write_reservation" \
            || name == "durable_bucket_write_reservation" \
            || name == "durable_bucket_write_reservations" \
            || name == "release_durable_bucket_write_reservation" \
            || name == "release_metadata_command_bucket_write_reservation" \
            || name == "begin_durable_bucket_write_drain" \
            || name == "durable_bucket_write_drain" \
            || name == "clear_durable_bucket_write_drain" \
            || name == "head_bucket" \
            || name == "head_bucket_raw" \
            || name == "head_bucket_record_raw" \
            || name == "list_buckets" \
            || name == "list_buckets_with_lifecycle" \
            || name == "list_buckets_with_aborting_multipart_uploads" \
            || name == "get_bucket_subresource" \
            || name == "get_object_meta" \
            || name == "get_object_version" \
            || name == "list_objects" \
            || name == "list_object_versions" \
            || name == "list_object_versions_for_key" \
            || name == "next_version_id" \
            || name == "next_generation_id" \
            || name == "allocate_stream_segment_vid" \
            || name == "get_object_generation_reservation" \
            || name == "get_object_segments_reclaim" \
            || name == "get_multipart_reclaim" \
            || name == "payload_reclaim_exists" \
            || name == "get_bucket_payload_reclaim_root" \
            || name == "get_object_tags" \
            || name == "get_multipart_upload" \
            || name == "get_completed_multipart_upload" \
            || name == "list_multipart_uploads" \
            || name == "get_multipart_part" \
            || name == "list_multipart_parts" \
            || name == "get_object_parts" \
            || name == "get_stream_upload" \
            || name == "list_all_stream_uploads" \
            || name == "list_stream_segments" \
            || name == "get_object_segments" \
            || name == "get_multipart_part_segments" \
            || name == "get_multipart_part_segments_for_upload_part" \
            || name == "get_all_multipart_part_segments_for_upload"
    }
    /^pub\(crate\) trait PgMetadataStore/ {
        in_pg_metadata_store = 1
        next
    }
    in_pg_metadata_store && /^}/ {
        in_pg_metadata_store = 0
        pending_test_hook_cfg = 0
        next
    }
    !in_pg_metadata_store {
        next
    }
    /^    #\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ || /^    #\[cfg\(test\)\]/ {
        pending_test_hook_cfg = 1
        next
    }
    /^    #\[/ {
        next
    }
    /^    fn [A-Za-z0-9_]+/ {
        method_name = $0
        sub(/^    fn /, "", method_name)
        sub(/\(.*/, "", method_name)
        if (!pending_test_hook_cfg && !is_allowed_production_method(method_name)) {
            print FILENAME ":" FNR ":" $0
        }
        pending_test_hook_cfg = 0
        next
    }
    $0 !~ /^[[:space:]]*$/ && $0 !~ /^    \/\// {
        pending_test_hook_cfg = 0
    }
    ' crates/storage/src/traits.rs
)
fail_with_matches \
    "Ungated production PgMetadataStore method outside the explicit allowlist" \
    "$production_metadata_methods"

pending_command_publishers=$(
    awk '
    function update_function_context() {
        if ($0 ~ /^    (pub(\([^)]*\))? |pub\(crate\) |pub\(super\) )?fn [A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
        }
    }
    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        in_test_module = 0
    }
    /^#\[cfg\(test\)\]/ || /^#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    pending_test_cfg && $0 !~ /^[[:space:]]*$/ && $0 !~ /^#\[/ {
        pending_test_cfg = 0
    }
    in_test_module {
        next
    }
    {
        update_function_context()
        helper = ""
        if ($0 ~ /try_set_pending_metadata_command_for_bucket\(/) {
            helper = "try_set_pending_metadata_command_for_bucket"
        } else if ($0 ~ /try_install_pending_metadata_command_for_bucket\(/) {
            helper = "try_install_pending_metadata_command_for_bucket"
        } else if ($0 ~ /install_snapshot_sensitive_metadata_command_or_drain\(/) {
            helper = "install_snapshot_sensitive_metadata_command_or_drain"
        } else if ($0 ~ /set_pending_metadata_command_for_bucket\(/) {
            helper = "set_pending_metadata_command_for_bucket"
        }
        if (helper == "") {
            next
        }
        if (current_fn == "set_pending_metadata_command_for_bucket" \
            || current_fn == "try_install_pending_metadata_command_for_bucket" \
            || current_fn == "install_snapshot_sensitive_metadata_command_or_drain" \
            || current_fn == "try_set_pending_metadata_command_for_bucket") {
            next
        }
        print FILENAME ":" current_fn ":" helper
    }
    ' $(find crates/storage/src -type f -name '*.rs' \
        ! -path 'crates/storage/src/tests/*' \
        ! -name '*_tests.rs' \
        | sort) \
        | sort \
        | uniq -c \
        | sed 's/^ *//'
)
# Pending command publisher inventory is intentionally explicit. Snapshot-
# sensitive multipart publishers normally use the snapshot-sensitive install wrapper;
# lower-level set/try_set helpers are reserved for apply-validated publishers,
# allocator cleanup, MatchingOutcomeRetry/terminal-session retry publishers
# with same-command install-race coverage, and explicitly documented
# non-multipart transitional paths.
expected_pending_command_publishers=$(cat <<'EOF'
1 crates/storage/src/cluster.rs:abort_stream_upload_session:try_install_pending_metadata_command_for_bucket
1 crates/storage/src/cluster.rs:commit_direct_put_object_from_payload_shards<E>:try_install_pending_metadata_command_for_bucket
1 crates/storage/src/cluster.rs:commit_stream_segment_append:set_pending_metadata_command_for_bucket
1 crates/storage/src/cluster.rs:create_put_object_stream_session_record_under_reservation:try_install_pending_metadata_command_for_bucket
1 crates/storage/src/cluster.rs:release_object_generation_reservation:try_set_pending_metadata_command_for_bucket
1 crates/storage/src/cluster.rs:release_object_generation_reservation_command_required:try_set_pending_metadata_command_for_bucket
1 crates/storage/src/cluster.rs:reserve_next_object_version:try_set_pending_metadata_command_for_bucket
1 crates/storage/src/cluster.rs:reserve_put_object_generation:try_set_pending_metadata_command_for_bucket
1 crates/storage/src/cluster/request_ops.rs:abort_authorized_multipart_upload_locked:try_install_pending_metadata_command_for_bucket
1 crates/storage/src/cluster/request_ops.rs:abort_multipart_upload_locked:try_install_pending_metadata_command_for_bucket
1 crates/storage/src/cluster/request_ops.rs:begin_bucket_delete:try_set_pending_metadata_command_for_bucket
1 crates/storage/src/cluster/request_ops.rs:begin_upload_part_stream_session<T, E>:install_snapshot_sensitive_metadata_command_or_drain
1 crates/storage/src/cluster/request_ops.rs:complete_multipart_upload_commit_serialized:try_install_pending_metadata_command_for_bucket
1 crates/storage/src/cluster/request_ops.rs:create_bucket_with_config_and_load_info:try_set_pending_metadata_command_for_bucket
1 crates/storage/src/cluster/request_ops.rs:create_multipart_upload<T, E>:install_snapshot_sensitive_metadata_command_or_drain
1 crates/storage/src/cluster/request_ops.rs:create_put_object_stream_session<T, E>:try_install_pending_metadata_command_for_bucket
1 crates/storage/src/cluster/request_ops.rs:create_upload_part_stream_session:install_snapshot_sensitive_metadata_command_or_drain
1 crates/storage/src/cluster/request_ops.rs:delete_completed_multipart_upload_record_with_command:try_set_pending_metadata_command_for_bucket
1 crates/storage/src/cluster/request_ops.rs:delete_current_object_if<T, E>:install_snapshot_sensitive_metadata_command_or_drain
1 crates/storage/src/cluster/request_ops.rs:delete_expired_delete_marker_if_due<E>:install_snapshot_sensitive_metadata_command_or_drain
1 crates/storage/src/cluster/request_ops.rs:delete_noncurrent_live_versions_if_due<E>:install_snapshot_sensitive_metadata_command_or_drain
1 crates/storage/src/cluster/request_ops.rs:delete_specific_object_version_if<T, E>:install_snapshot_sensitive_metadata_command_or_drain
1 crates/storage/src/cluster/request_ops.rs:expire_current_object_if_due<E>:install_snapshot_sensitive_metadata_command_or_drain
1 crates/storage/src/cluster/request_ops.rs:finalize_put_object_stream<T, E>:try_install_pending_metadata_command_for_bucket
1 crates/storage/src/cluster/request_ops.rs:finalize_upload_part_stream<T, E>:try_install_pending_metadata_command_for_bucket
1 crates/storage/src/cluster/request_ops.rs:insert_current_delete_marker_if<T, E>:install_snapshot_sensitive_metadata_command_or_drain
1 crates/storage/src/cluster/request_ops.rs:put_bucket_acl_and_load_info:try_set_pending_metadata_command_for_bucket
1 crates/storage/src/cluster/request_ops.rs:put_bucket_property_command_and_load_info:try_set_pending_metadata_command_for_bucket
1 crates/storage/src/cluster/request_ops.rs:put_bucket_subresource_command_and_load_info:try_set_pending_metadata_command_for_bucket
1 crates/storage/src/cluster/request_ops.rs:put_bucket_versioning_and_load_info:try_set_pending_metadata_command_for_bucket
1 crates/storage/src/cluster/request_ops.rs:put_object_metadata_if<T, E>:install_snapshot_sensitive_metadata_command_or_drain
1 crates/storage/src/cluster/request_ops.rs:reclaim_object_payload_if_unleased:set_pending_metadata_command_for_bucket
1 crates/storage/src/cluster/request_ops.rs:reserve_completed_multipart_upload_order:try_set_pending_metadata_command_for_bucket
EOF
)
if [[ "$pending_command_publishers" != "$expected_pending_command_publishers" ]]; then
    fail_with_matches \
        "Pending metadata command publisher inventory changed; update guides/metadata-command-stream.md classification and this allowlist" \
        "$pending_command_publishers"
fi

metadata_command_conflict_uses=$(
    awk '
    function update_function_context() {
        if ($0 ~ /^    (pub(\([^)]*\))? )?fn [A-Za-z0-9_]+/ || $0 ~ /^fn [A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
        }
    }
    {
        update_function_context()
        if ($0 ~ /metadata_command_log_conflict_matches\(/) {
            print FILENAME ":" current_fn ":exact-command-match"
        } else if ($0 ~ /MetadataCommandLogConflict/) {
            print FILENAME ":" current_fn ":metadata-command-log-conflict"
        }
    }
    ' crates/storage/src/cluster.rs crates/storage/src/cluster/request_ops.rs \
        | sort \
        | uniq -c \
        | sed 's/^ *//'
)
expected_metadata_command_conflict_uses=$(cat <<'EOF'
1 crates/storage/src/cluster.rs:abort_stream_upload_session:metadata-command-log-conflict
1 crates/storage/src/cluster.rs:apply_new_stream_append_command:exact-command-match
1 crates/storage/src/cluster.rs:commit_direct_put_object_from_payload_shards<E>:exact-command-match
1 crates/storage/src/cluster.rs:commit_direct_put_object_from_payload_shards<E>:metadata-command-log-conflict
1 crates/storage/src/cluster.rs:commit_stream_segment_append:metadata-command-log-conflict
1 crates/storage/src/cluster.rs:create_put_object_stream_session_record_under_reservation:metadata-command-log-conflict
2 crates/storage/src/cluster.rs:finish_object_pg_pending_slot:exact-command-match
1 crates/storage/src/cluster.rs:metadata_command_conflict:metadata-command-log-conflict
1 crates/storage/src/cluster.rs:metadata_command_log_conflict_matches:exact-command-match
1 crates/storage/src/cluster.rs:metadata_command_log_conflict_matches:metadata-command-log-conflict
2 crates/storage/src/cluster.rs:next_metadata_command_id_from_locked_pg_at_least:metadata-command-log-conflict
1 crates/storage/src/cluster.rs:next_object_metadata_command_id_or_drain:metadata-command-log-conflict
1 crates/storage/src/cluster.rs:reissue_pending_metadata_command:metadata-command-log-conflict
1 crates/storage/src/cluster.rs:release_object_generation_reservation:exact-command-match
1 crates/storage/src/cluster.rs:release_object_generation_reservation_command_required:exact-command-match
1 crates/storage/src/cluster.rs:reserve_put_object_generation:exact-command-match
1 crates/storage/src/cluster/request_ops.rs:abort_authorized_multipart_upload_locked:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:abort_multipart_upload_locked:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:apply_new_object_metadata_command_for_bucket:exact-command-match
1 crates/storage/src/cluster/request_ops.rs:begin_bucket_delete:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:begin_upload_part_stream_session<T, E>:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:complete_multipart_upload_commit_serialized:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:create_multipart_upload<T, E>:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:create_put_object_stream_session<T, E>:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:create_upload_part_stream_session:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:delete_current_object_if<T, E>:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:delete_expired_delete_marker_if_due<E>:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:delete_noncurrent_live_versions_if_due<E>:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:delete_specific_object_version_if<T, E>:metadata-command-log-conflict
3 crates/storage/src/cluster/request_ops.rs:expire_current_object_if_due<E>:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:finalize_put_object_stream<T, E>:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:finalize_upload_part_stream<T, E>:metadata-command-log-conflict
2 crates/storage/src/cluster/request_ops.rs:finish_pending_metadata_command_to_acting_set_inner:exact-command-match
1 crates/storage/src/cluster/request_ops.rs:insert_current_delete_marker_if<T, E>:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:next_bucket_metadata_command_id_or_drain:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:put_object_metadata_if<T, E>:metadata-command-log-conflict
1 crates/storage/src/cluster/request_ops.rs:reclaim_object_payload_if_unleased:metadata-command-log-conflict
EOF
)
if [[ "$metadata_command_conflict_uses" != "$expected_metadata_command_conflict_uses" ]]; then
    fail_with_matches \
        "MetadataCommandLogConflict handling changed; update guides/metadata-command-stream.md finish/convergence classification and this allowlist" \
        "$metadata_command_conflict_uses"
fi

mixed_stream_upload_cleanup_records=$(
    rg -n --color=never \
        'stream_uploads:[[:space:]]*Vec<StreamUploadRecord>' \
        crates/storage/src/types.rs \
        crates/storage/src/metadata_command.rs \
        || true
)
fail_with_matches \
    "Terminal stream cleanup payloads must use TerminalStreamCleanupRecord, not StreamUploadRecord" \
    "$mixed_stream_upload_cleanup_records"

stream_create_runtime_record_payloads=$(
    rg -n --color=never \
        'session:[[:space:]]*StreamUploadRecord' \
        crates/storage/src/metadata_command.rs \
        || true
)
fail_with_matches \
    "CreateStreamUploadCommand must use StreamUploadCommandRecord plus an explicit allocator floor, not StreamUploadRecord" \
    "$stream_create_runtime_record_payloads"

raw_stream_upload_vector_comparisons=$(
    awk '
    FNR == 1 {
        pending_test_cfg = 0
        in_test_module = 0
    }
    /^#\[cfg\(test\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    pending_test_cfg && $0 !~ /^[[:space:]]*$/ && $0 !~ /^#\[/ {
        pending_test_cfg = 0
    }
    in_test_module {
        next
    }
    $0 ~ /([A-Za-z_][A-Za-z0-9_]*\.)*stream_uploads[[:space:]]*(!=|==)/ \
        || $0 ~ /(!=|==)[[:space:]]*([A-Za-z_][A-Za-z0-9_]*\.)*stream_uploads/ {
        print FILENAME ":" FNR ":" $0
    }
    ' $(find crates/storage/src -type f -name '*.rs' \
        ! -path 'crates/storage/src/tests/*' \
        ! -path 'crates/storage/src/cluster/local.rs' \
        | sort)
)
fail_with_matches \
    "Production code compares stream_uploads vectors directly instead of command-owned cleanup records" \
    "$raw_stream_upload_vector_comparisons"

generic_route_io_matches=$(
    rg -n --color=never \
        'std::io::Error::other\((error|other)\.to_string\(\)\)|StoreError::Io[[:space:]]*\{[[:space:]]*context:[^}]*route|StoreError::Io[[:space:]]*\{[[:space:]]*context:[^}]*PG' \
        crates/storage/src/cluster.rs \
        crates/storage/src/cluster/local.rs \
        || true
)
allowed_generic_route_io=$(
    printf '%s\n' "$generic_route_io_matches" \
        | rg -v 'crates/storage/src/cluster.rs:.*source: std::io::Error::other\(other\.to_string\(\)\)' \
        || true
)
fail_with_matches \
    "Route/control-plane error converted through generic StoreError::Io" \
    "$allowed_generic_route_io"

if [[ "$failed" -ne 0 ]]; then
    echo
    echo "storage cluster boundary checks failed" >&2
    exit 1
fi

echo "storage cluster boundary checks passed"
