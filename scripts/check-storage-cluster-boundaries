                || $0 ~ /PgMetadataStore::get_object_version\(/ \
                || $0 ~ /PgMetadataStore::get_object_segments\(/ \
                || $0 ~ /PgMetadataStore::get_object_parts\(/ \
                || $0 ~ /PgMetadataStore::get_multipart_part_segments\(/ \
                || $0 ~ /object_node\.get_pg\(/ \
                || $0 ~ /next_object_metadata_command_id_from_locked_pg\(/ \
                || $0 ~ /CommitDirectPutObjectCommand[[:space:]]*\{/)) {
            print FILENAME ":" FNR ":" $0
        }
        if (current_fn == "complete_multipart_upload_commit_serialized_with_route_validation" \
            && ($0 ~ /PgMetadataStore::get_multipart_upload\(/ \
                || $0 ~ /PgMetadataStore::list_multipart_parts\(/ \
                || $0 ~ /PgMetadataStore::get_all_multipart_part_segments_for_upload\(/ \
                || $0 ~ /PgMetadataStore::list_all_stream_uploads\(/ \
                || $0 ~ /PgMetadataStore::list_stream_segments\(/ \
                || $0 ~ /PgMetadataStore::get_object_meta\(/ \
                || $0 ~ /PgMetadataStore::get_object_version\(/ \
                || $0 ~ /PgMetadataStore::get_object_segments\(/ \
                || $0 ~ /PgMetadataStore::get_object_parts\(/ \
                || $0 ~ /PgMetadataStore::get_multipart_part_segments\(/ \
                || $0 ~ /primary_node\.get_pg\(/ \
                || $0 ~ /next_object_metadata_command_id\(/ \
                || $0 ~ /next_object_metadata_command_id_from_locked_pg\(/ \
                || $0 ~ /CommitMultipartObjectCommand[[:space:]]*\{/)) {
            print FILENAME ":" FNR ":" $0
        }
        if (current_fn == "abort_multipart_upload_if_due" \
            && ($0 ~ /PgMetadataStore::get_multipart_upload\(/ \
                || $0 ~ /primary_node\.get_pg\(/)) {
            print FILENAME ":" FNR ":" $0
        }
        if ($0 ~ /SharedStorageNode::(load_existing_live_object_from_object_pg|load_object_read_auth_subject_from_object_pg|load_object_read_snapshot_for_subject_from_object_pg|load_stored_object_from_object_pg|load_object_tag_read_auth_subject_from_object_pg|get_object_tags_for_subject_from_object_pg|load_object_legal_hold_read_subject_from_object_pg|load_object_retention_read_subject_from_object_pg)\(/ \
            || $0 ~ /crate::SharedStorageNode::(load_existing_live_object_from_object_pg|load_object_read_auth_subject_from_object_pg|load_object_read_snapshot_for_subject_from_object_pg|load_stored_object_from_object_pg|load_object_tag_read_auth_subject_from_object_pg|get_object_tags_for_subject_from_object_pg|load_object_legal_hold_read_subject_from_object_pg|load_object_retention_read_subject_from_object_pg)\(/ \
            || $0 ~ /crate::node::SharedStorageNode::(load_existing_live_object_from_object_pg|load_object_read_auth_subject_from_object_pg|load_object_read_snapshot_for_subject_from_object_pg|load_stored_object_from_object_pg|load_object_tag_read_auth_subject_from_object_pg|get_object_tags_for_subject_from_object_pg|load_object_legal_hold_read_subject_from_object_pg|load_object_retention_read_subject_from_object_pg)\(/) {
            print FILENAME ":" FNR ":" $0
        }
        if (current_fn == "get_object_tags_for_subject_from_object_pg" \
            && $0 ~ /PgMetadataStore::get_object_tags\(/) {
            print FILENAME ":" FNR ":" $0
        }
        if (current_fn == "load_existing_live_object" \
            && $0 ~ /PgMetadataStore::get_object_meta\(/) {
            print FILENAME ":" FNR ":" $0
        }
        if (current_fn == "payload_reclaim_exists" \
            && $0 ~ /PgMetadataStore::payload_reclaim_exists\(/) {
            print FILENAME ":" FNR ":" $0
        }
        if ($0 ~ /;/) {
            pending_storage_client = 0
            pending_bucket_metadata_client = 0
            pending_object_read_metadata_client = 0
            pending_object_mutation_metadata_client = 0
            pending_object_mutation_receiver = 0
            pending_retained_object_mutation_receiver = 0
            pending_multipart_creation_route = 0
            pending_multipart_lookup_route = 0
            pending_authorized_multipart_route = 0
            pending_multipart_completion_route = 0
            pending_multipart_abort_route = 0
        }
    }
    ' crates/storage/src/cluster.rs \
      crates/storage/src/cluster/request_ops.rs \
      crates/storage/src/cluster/local.rs
