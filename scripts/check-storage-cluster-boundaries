raw_coordinator_payload_read_mapping=$(
    awk '
    FNR == 1 {
        pending_test_cfg = 0
        in_test_cfg = 0
        in_payload_read_call = 0
        payload_read_call_start = ""
        payload_read_has_object_read_mapper = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ || /^[[:space:]]*#\[cfg\(feature = "test-hooks"\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*#\[/ {
        next
    }
    function update_function_context() {
        if ($0 ~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            in_test_cfg = pending_test_cfg
            pending_test_cfg = 0
        } else if (pending_test_cfg \
            && $0 !~ /^[[:space:]]*$/ \
            && $0 !~ /^[[:space:]]*#\[/) {
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if (in_test_cfg) {
            next
        }
        if (!in_payload_read_call \
            && $0 ~ /(read_segment_payload_stored_bytes_into|read_object_payload_segment_stored_bytes_into)[[:space:]]*\(/) {
            in_payload_read_call = 1
            payload_read_call_start = FILENAME ":" FNR ":" $0
            payload_read_has_object_read_mapper = 0
        }
        if (in_payload_read_call \
            && $0 ~ /map_err[[:space:]]*\([[:space:]]*super::map_object_read_failure[[:space:]]*\)/) {
            payload_read_has_object_read_mapper = 1
        }
        if (in_payload_read_call && $0 ~ /[?][[:space:]]*;/) {
            if (!payload_read_has_object_read_mapper) {
                print payload_read_call_start
            }
            in_payload_read_call = 0
            payload_read_call_start = ""
            payload_read_has_object_read_mapper = 0
        } else if (in_payload_read_call && $0 ~ /;[[:space:]]*$/) {
            in_payload_read_call = 0
            payload_read_call_start = ""
            payload_read_has_object_read_mapper = 0
        }
    }
    ' $(find crates/server-core/src/coordinator -type f -name '*.rs' \
        ! -name '*_tests.rs' \
        ! -path '*/tests/*' \
        | sort)
)
fail_with_matches \
    "Production coordinator payload reads must map opaque storage failures through map_object_read_failure before using ?" \
    "$raw_coordinator_payload_read_mapping"


unbudgeted_request_work_helpers=$(
    awk '
    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        in_test_hook = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*#\[/ {
        next
    }
    /^[[:space:]]*(pub(\([^)]*\))?[[:space:]]+|pub\(super\)[[:space:]]+|pub\(crate\)[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/ {
        current_fn = $0
        sub(/^.*fn[[:space:]]+/, "", current_fn)
        sub(/\(.*/, "", current_fn)
        in_test_hook = pending_test_cfg
        pending_test_cfg = 0
    }
    pending_test_cfg && $0 !~ /^[[:space:]]*$/ {
        pending_test_cfg = 0
    }
    {
        if (in_test_hook || current_fn ~ /^test_/) {
            next
        }
        if (current_fn == "drain_unrelated_pending_metadata_command_for_bucket" \
            || current_fn == "drain_pending_metadata_command_pg_slot" \
            || current_fn == "drain_bucket_pg_pending_metadata_command" \
            || current_fn == "drain_pending_completed_multipart_sequence_command" \
            || current_fn == "next_bucket_metadata_command_id_or_drain" \
            || current_fn == "next_completion_bucket_metadata_command_id_or_drain" \
            || current_fn == "try_set_bucket_pg_pending_command_or_retry" \
            || current_fn == "try_set_bucket_control_pending_command_or_retry") {
            next
        }
        if ($0 ~ /\.(drain_unrelated_pending_metadata_command_for_bucket|drain_pending_metadata_command_pg_slot|drain_bucket_pg_pending_metadata_command|drain_pending_completed_multipart_sequence_command|next_bucket_metadata_command_id_or_drain|next_completion_bucket_metadata_command_id_or_drain|try_set_bucket_pg_pending_command_or_retry|try_set_bucket_control_pending_command_or_retry)\(/) {
            print FILENAME ":" FNR ":" $0
        }
    }
    ' crates/storage/src/cluster/request_ops.rs
)
fail_with_matches \
    "Production request paths must use request-work-budget variants for bucket metadata drain/retry helpers" \
    "$unbudgeted_request_work_helpers"

