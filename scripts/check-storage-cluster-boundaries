migrated_bucket_snapshot_read_bypasses=$(
    awk '
    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        pending_storage_client = 0
        pending_bucket_metadata_client = 0
        pending_reservation_node = 0
        in_test_hook = 0
        in_test_module = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    in_test_module {
        next
    }
    function update_function_context() {
        if ($0 ~ /^    (pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            in_test_hook = pending_test_cfg
            pending_test_cfg = 0
        } else if (pending_test_cfg \
            && $0 !~ /^[[:space:]]*$/ \
            && $0 !~ /^[[:space:]]*#\[/) {
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if (in_test_hook) {
            next
        }
        if ($0 ~ /\.storage_client\(\)/ \
            || $0 ~ /object_metadata_primary_client\(/ \
            || $0 ~ /storage_client[[:space:]]*$/) {
            pending_storage_client = 1
        }
        if ($0 ~ /\.bucket_metadata_client\(\)/ \
            || $0 ~ /bucket_metadata_client[[:space:]]*$/) {
            pending_bucket_metadata_client = 1
        }
        if ($0 ~ /reservation[[:space:]]*$/) {
            pending_reservation_node = 1
        } else if (pending_reservation_node && $0 ~ /^[[:space:]]*\.node[[:space:]]*$/) {
            pending_reservation_node = 2
        }
        if ($0 ~ /\.(load_bucket_execution_generations|load_bucket_fast_path_identities|load_bucket_execution_generations_for_pg|load_bucket_fast_path_identities_for_pg)\(/) {
