    fail_with_matches \
        "Publisher scanner fixture changed; test-only scopes must be excluded without hiding production-feature publishers" \
        "$publisher_scanner_fixture"
fi

registered_metadata_command_publishers=$(
    awk '
    /^define_metadata_command_publishers! \{/ {
        in_registry = 1
        next
    }
    in_registry && /^}/ {
        in_registry = 0
        next
    }
    in_registry && /^    [A-Za-z0-9_]+ => \(/ {
        publisher_id = $0
        sub(/^    /, "", publisher_id)
        sub(/ =>.*/, "", publisher_id)
        next
    }
    in_registry && publisher_id != "" && /^        "[A-Za-z0-9_]+",/ {
        canonical_name = $0
        gsub(/[ ",]/, "", canonical_name)
        print publisher_id ":" canonical_name
        publisher_id = ""
    }
    ' crates/storage/src/metadata_command.rs \
        | sort
)

live_metadata_command_publishers=$(
    printf '%s\n' "$publisher_scan_output" \
        | awk -F '\t' '$1 == "MARKER" { print $2 }' \
        | sort
)

if [[ "$live_metadata_command_publishers" != "$registered_metadata_command_publishers" ]]; then
    fail_with_matches \
        "Every registered metadata-command publisher must have exactly one live, canonical entry-point marker" \
        "$live_metadata_command_publishers"
fi

