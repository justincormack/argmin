coarse_payload_lease_callers=$(
    awk '
    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        in_test_module = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    pending_test_cfg \
        && $0 !~ /^[[:space:]]*$/ \
        && $0 !~ /^[[:space:]]*#\[/ \
        && $0 !~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/ {
        pending_test_cfg = 0
    }
    in_test_module {
        next
    }
    function update_function_context() {
        if ($0 ~ /^    (pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            in_test_hook = pending_test_cfg
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if ($0 ~ /\.[[:space:]]*acquire_object_payload_lease\(/ \
            && current_fn != "acquire_object_payload_lease" \
            && current_fn != "load_leased_object_read_snapshot_if_on_route<T, E>" \
            && current_fn != "try_acquire_object_payload_lease" \
            && current_fn != "try_acquire_object_payload_lease_on_locations" \
            && current_fn != "acquire_object_payload_lease_session_admission" \
            && current_fn != "object_payload_lease_control_response" \
            && !in_test_hook) {
            print FILENAME ":" current_fn
        }
    }
    ' $(find crates/storage/src crates/server-core/src -type f -name '*.rs' \
        ! -path '*/tests/*' \
        ! -name 'tests.rs' \
        ! -name '*_tests.rs' \
        | sort) \
        | sort \
        | uniq -c \
        | sed 's/^ *//'
)
fail_with_matches \
    "Production reads may use a coarse generation-wide lease only while loading an exact leased snapshot before shard-location handoff" \
    "$coarse_payload_lease_callers"

