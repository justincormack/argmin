multipart_management_opaque_capability_leaks=$(
    {
        rg -n --color=never \
            'pub struct (MultipartUploadAbortCandidate|AuthorizedMultipartUploadAbort|MultipartUploadListPartsCandidate|AuthorizedMultipartUploadListParts|MultipartUploadPartCandidate|AuthorizedMultipartUploadPart)\(pub|impl[[:space:]]+(Clone|PartialEq|Eq)[[:space:]]+for[[:space:]]+(MultipartUploadAbortCandidate|AuthorizedMultipartUploadAbort|MultipartUploadListPartsCandidate|AuthorizedMultipartUploadListParts|MultipartUploadPartCandidate|AuthorizedMultipartUploadPart)' \
            crates/storage/src/types.rs \
            || true
        awk '
        /impl (MultipartUploadAbortCandidate|AuthorizedMultipartUploadAbort|MultipartUploadListPartsCandidate|AuthorizedMultipartUploadListParts|MultipartUploadPartCandidate|AuthorizedMultipartUploadPart)[[:space:]]*\{/ {
            in_opaque_impl = 1
            opaque_impl = $0
            sub(/^.*impl /, "", opaque_impl)
            sub(/[[:space:]]*\{.*/, "", opaque_impl)
            depth = 0
        }
        in_opaque_impl {
            if ($0 ~ /^[[:space:]]*pub[[:space:]]+fn[[:space:]]+/) {
                method = $0
                sub(/^.*fn[[:space:]]+/, "", method)
                sub(/\(.*/, "", method)
                if ((opaque_impl == "MultipartUploadAbortCandidate" && method != "owner" && method != "initiator" && method != "into_authorized_abort") || (opaque_impl == "AuthorizedMultipartUploadAbort" && method != "upload_id") || (opaque_impl == "MultipartUploadListPartsCandidate" && method != "owner" && method != "initiator" && method != "into_authorized_list_parts") || opaque_impl == "AuthorizedMultipartUploadListParts" || (opaque_impl == "MultipartUploadPartCandidate" && method != "key" && method != "owner" && method != "initiator" && method != "checksum_config" && method != "encryption" && method != "into_authorized_part") || opaque_impl == "AuthorizedMultipartUploadPart") {
                    print FILENAME ":" FNR ":" $0
                }
            }
            line = $0
            depth += gsub(/\{/, "{", line)
            depth -= gsub(/\}/, "}", line)
            if (depth == 0 && $0 ~ /\}/) {
                in_opaque_impl = 0
            }
        }
        /#\[derive\(/ {
            derive = $0
            in_derive = ($0 !~ /\)\]/)
            next
        }
        in_derive {
            derive = derive $0
            if ($0 ~ /\)\]/) {
                in_derive = 0
            }
            next
        }
        /pub struct (MultipartUploadAbortCandidate|AuthorizedMultipartUploadAbort|MultipartUploadListPartsCandidate|AuthorizedMultipartUploadListParts|MultipartUploadPartCandidate|AuthorizedMultipartUploadPart)/ {
            if (derive ~ /Clone|PartialEq|Eq|Debug/) {
                print FILENAME ":" FNR ":" derive
            }
        }
        {
            if ($0 !~ /^[[:space:]]*$/ && $0 !~ /^#\[derive\(/) {
                derive = ""
            }
        }
        ' crates/storage/src/types.rs
    }
)
fail_with_matches \
    "Multipart management candidates and operation capabilities must not expose, derive Debug over, clone, or compare their retained durable upload records" \
    "$multipart_management_opaque_capability_leaks"

