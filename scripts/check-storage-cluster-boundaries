            || true
        awk '
        /impl (MultipartUploadCompletionContext|MultipartUploadCompletionCandidate|AuthorizedMultipartUploadCompletion|MultipartCompletionReplayCandidate|AuthorizedMultipartCompletionReplay|AuthorizedMultipartCompletionSnapshot)[[:space:]]*\{/ {
            in_completion_impl = 1
            completion_impl = $0
