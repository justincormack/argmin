test_support_api_scanner=scripts/check-storage-test-support-api.awk

scan_storage_test_support_api() {
    local inline_root=$1
    local module_root=$2
    local source_root=$3
    local -a sources=()

    while IFS= read -r source; do
        if [[ "$source" != "$inline_root" ]]; then
            sources+=("$source")
        fi
    done < <(find "$source_root" -type f -name '*.rs' -print | sort)

    awk -v inline_root="$inline_root" -v api_module_root="$module_root" \
        -f "$test_support_api_scanner" \
        "$inline_root" "${sources[@]}" | sort -u
}

test_support_physical_api_leaks=$(
    scan_storage_test_support_api \
        crates/storage/src/lib.rs \
        crates/storage/src/test_support \
        crates/storage/src
)
fail_with_matches \
    "Curated storage::test_support public signatures must not expose physical PG, node, shard, route, proof, claim, durable-row, generation, or EC-shape types" \
    "$test_support_physical_api_leaks"

test_support_physical_api_fixture=$(
    scan_storage_test_support_api \
        scripts/fixtures/storage-boundary-test-support-api/lib.rs \
        scripts/fixtures/storage-boundary-test-support-api/test_support \
        scripts/fixtures/storage-boundary-test-support-api
)
test_support_physical_api_fixture_failure=""
