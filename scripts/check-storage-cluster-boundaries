PUBLISHER	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:production_publisher_after_inline_test_module:FixtureProductionPublisher:try_set_pending_metadata_command_for_bucket
MARKER	LiveFeaturePublisher:production_feature_publisher_must_remain_visible
PUBLISHER	scripts/fixtures/storage-boundary-publishers/inline-test-items.rs:production_feature_publisher_must_remain_visible:LiveFeaturePublisher:try_install_pending_metadata_command_for_bucket
EOF
)
