session_token_format_leaks=$(
    {
        rg -n --color=never \
            '\bseal_session_credential_v[0-9]+\b|\b(SESSION_TOKEN_V[0-9]+_PREFIX|MAX_DECODED_SESSION_TOKEN_FRAME_LEN|MAX_ENCODED_SESSION_TOKEN_LEN|MAX_ISSUED_V[0-9]+_TOKEN_LEN)\b' \
