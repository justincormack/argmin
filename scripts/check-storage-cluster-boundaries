                sub(/^.*fn[[:space:]]+/, "", method)
                sub(/\(.*/, "", method)
                if ((completion_impl == "MultipartUploadCompletionContext" && method != "checksum_config" && method != "system_metadata_blob" && method != "object_lock") || (completion_impl == "MultipartUploadCompletionCandidate" && method != "key" && method != "owner" && method != "initiator" && method != "encryption" && method != "into_authorized_completion") || completion_impl == "AuthorizedMultipartUploadCompletion" || (completion_impl == "MultipartCompletionReplayCandidate" && method != "encryption" && method != "into_authorized_replay") || (completion_impl == "AuthorizedMultipartCompletionReplay" && method != "upload_id" && method != "fingerprint" && method != "version_id" && method != "etag" && method != "size" && method != "last_modified" && method != "tags" && method != "encryption") || (completion_impl == "AuthorizedMultipartCompletionSnapshot" && method != "existing_etag" && method != "parts" && method != "into_commit_request")) {
                    print FILENAME ":" FNR ":" $0
                }
            }
            line = $0
            depth += gsub(/\{/, "{", line)
            depth -= gsub(/\}/, "}", line)
            if (depth == 0 && $0 ~ /\}/) {
                in_completion_impl = 0
            }
        }
        /#\[derive\(/ {
            derive = $0
            in_derive = ($0 !~ /\)\]/)
            next
        }
        in_derive {
            derive = derive $0
            if ($0 ~ /\)\]/) {
                in_derive = 0
            }
            next
        }
        /pub struct (MultipartUploadCompletionContext|MultipartUploadCompletionCandidate|AuthorizedMultipartUploadCompletion|MultipartCompletionReplayCandidate|AuthorizedMultipartCompletionReplay|AuthorizedMultipartCompletionSnapshot)/ {
            if (derive ~ /Clone|PartialEq|Eq|Debug/) {
                print FILENAME ":" FNR ":" derive
            }
        }
        {
            if ($0 !~ /^[[:space:]]*$/ && $0 !~ /^#\[derive\(/) {
                derive = ""
            }
        }
        ' crates/storage/src/types.rs
    }
)
fail_with_matches \
    "Multipart completion candidates, contexts, replay projections, and operation capabilities must expose only their bounded logical API and must not clone or compare retained durable state" \
    "$multipart_completion_opaque_surface_leaks"

multipart_completion_debug_leaks=$(
    awk '
    /impl std::fmt::Debug for (MultipartUploadCompletionContext|MultipartUploadCompletionCandidate|AuthorizedMultipartUploadCompletion|MultipartCompletionReplayCandidate|AuthorizedMultipartCompletionReplay|AuthorizedMultipartCompletionSnapshot)[[:space:]]*\{/ {
        in_completion_debug = 1
        depth = 0
    }
    in_completion_debug {
        if ($0 ~ /self\.0|self\.system_metadata_blob|self\.defaults/) {
            print FILENAME ":" FNR ":" $0
        }
        line = $0
        depth += gsub(/\{/, "{", line)
        depth -= gsub(/\}/, "}", line)
        if (depth == 0 && $0 ~ /\}/) {
            in_completion_debug = 0
        }
    }
    ' crates/storage/src/types.rs
)
fail_with_matches \
    "Multipart completion Debug output must not reveal retained upload, serialized metadata, replay, or commit-default state" \
    "$multipart_completion_debug_leaks"

multipart_upload_id_authority_derived_equality=$(
    awk '
    /#\[derive\(/ {
        derive = $0
        next
    }
    /pub struct MultipartUploadIdAuthority/ {
        if (derive ~ /PartialEq|Eq/) {
            print FILENAME ":" FNR ":" derive
        }
    }
    {
        if ($0 !~ /^[[:space:]]*$/ && $0 !~ /^#\[derive\(/) {
            derive = ""
        }
    }
    ' crates/storage/src/types.rs
)
fail_with_matches \
    "Opaque multipart upload ID authority must not expose hidden signing-key equality" \
    "$multipart_upload_id_authority_derived_equality"

public_multipart_create_durable_request_surfaces=$(
    rg -n --color=never \
        '^[[:space:]]*pub[[:space:]]+(struct[[:space:]]+CreateMultipartUploadReq|use.*\bCreateMultipartUploadReq\b|fn[[:space:]]+create_multipart_upload(_with_ordered_id)?\b)' \
        crates/storage/src/types.rs \
        crates/storage/src/lib.rs \
        crates/storage/src/cluster/request_ops.rs \
        || true
)
fail_with_matches \
    "The durable multipart-create request and raw mutation entry points must remain private to storage" \
    "$public_multipart_create_durable_request_surfaces"

multipart_create_caller_supplied_subject_fields=$(
