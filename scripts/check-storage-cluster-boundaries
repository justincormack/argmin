# Semantic inventory that Rust does not yet enforce: every conflict branch
# must remain aligned with the publisher finish/convergence contract.
metadata_command_conflict_uses=$(
    awk '
    function canonicalize_function(name) {
        sub(/<.*/, "", name)
        if (name == "begin_bucket_delete_inner") {
            return "begin_bucket_delete"
        }
        if (name == "reclaim_object_payload_if_unleased_with_outcome") {
            return "reclaim_object_payload_if_unleased"
        }
        if (name == "next_bucket_metadata_command_id_or_drain_inner") {
            return "next_bucket_metadata_command_id_or_drain"
        }
        if (name == "next_object_metadata_command_id_or_drain_with_completion_admission") {
            return "next_object_metadata_command_id_or_drain"
        }
        if (name == "partial_exact_metadata_command_conflict_is_retryable_with_route_mode") {
            return "partial_exact_metadata_command_conflict_is_retryable"
        }
        if (name == "reissue_pending_metadata_command_with_route_mode") {
            return "reissue_pending_metadata_command"
        }
        if (name == "try_set_bucket_pg_pending_command_or_retry_with_work_budget") {
            return "try_set_bucket_pg_pending_command_or_retry"
        }
        if (name == "try_set_bucket_pg_pending_command_or_retry_with_work_budget_and_effect_fence") {
            return "try_set_bucket_pg_pending_command_or_retry"
        }
        if (name == "try_set_bucket_control_pending_command_or_retry_with_work_budget") {
            return "try_set_bucket_control_pending_command_or_retry"
        }
        if (name == "commit_stream_segment_append_with_work_budget") {
            return "commit_stream_segment_append"
        }
        return name
    }
    function update_function_context() {
        if ($0 ~ /^    (pub(\([^)]*\))? )?fn [A-Za-z0-9_]+/ || $0 ~ /^fn [A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            current_fn = canonicalize_function(current_fn)
        }
    }
    {
        update_function_context()
        if ($0 ~ /metadata_command_log_conflict_matches\(/) {
            print FILENAME ":" current_fn ":exact-command-match"
        } else if ($0 ~ /MetadataCommandLogConflict/) {
            print FILENAME ":" current_fn ":metadata-command-log-conflict"
        }
    }
    ' crates/storage/src/cluster.rs crates/storage/src/cluster/request_ops.rs \
        | sort \
        | uniq -c \
        | sed 's/^ *//'
)
