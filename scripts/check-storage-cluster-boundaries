            || $0 ~ /crate::node::SharedStorageNode::(load_existing_live_object_from_object_pg|load_object_read_auth_subject_from_object_pg|load_object_read_snapshot_for_subject_from_object_pg|load_stored_object_from_object_pg|load_object_tag_read_auth_subject_from_object_pg|get_object_tags_for_subject_from_object_pg|load_object_legal_hold_read_subject_from_object_pg|load_object_retention_read_subject_from_object_pg)\(/) {
            print FILENAME ":" FNR ":" $0
        }
        if (current_fn == "get_object_tags_for_subject_from_object_pg" \
            && $0 ~ /PgMetadataStore::get_object_tags\(/) {
            print FILENAME ":" FNR ":" $0
        }
        if (current_fn == "load_existing_live_object" \
            && $0 ~ /PgMetadataStore::get_object_meta\(/) {
            print FILENAME ":" FNR ":" $0
        }
        if (current_fn == "payload_reclaim_exists" \
