    }
    in_opaque_debug && /^}/ {
        in_opaque_debug = 0
    }
    ' crates/storage/src/types.rs
)
fail_with_matches \
    "Opaque multipart listing Debug output must not expose durable upload or part records" \
    "$multipart_listing_physical_debug_leaks"

