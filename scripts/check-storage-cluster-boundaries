            pending_storage_client = 0
            pending_bucket_metadata_client = 0
            pending_object_read_metadata_client = 0
            pending_object_mutation_metadata_client = 0
            pending_object_mutation_receiver = 0
            pending_retained_object_mutation_receiver = 0
