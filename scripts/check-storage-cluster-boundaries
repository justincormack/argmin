optional_bucket_write_proof_fields=$(
    awk '
    FNR == 1 {
        in_stream_upload_record = 0
    }
    /^[[:space:]]*pub struct StreamUploadRecord[[:space:]]*\{/ {
        in_stream_upload_record = 1
    }
    in_stream_upload_record && /^[[:space:]]*\}/ {
        in_stream_upload_record = 0
    }
    /bucket_write_reservation:[[:space:]]*Option<([^>]*::)?BucketWriteReservationProof>/ {
        if (FILENAME ~ /types\.rs$/ && in_stream_upload_record) {
            next
        }
        if ($0 ~ /stream_create_bucket_write_reservation/) {
            next
        }
        print FILENAME ":" FNR ":" $0
    }
    ' \
        crates/storage/src/types.rs \
        crates/storage/src/metadata_command.rs \
        crates/storage/src/cluster.rs \
        crates/storage/src/cluster/request_ops.rs \
        || true
)
fail_with_matches \
    "Bucket-write publishing request/command surfaces must require BucketWriteReservationProof" \
    "$optional_bucket_write_proof_fields"

raw_stream_upload_vector_comparisons=$(
    awk '
    FNR == 1 {
        pending_test_cfg = 0
        in_test_module = 0
    }
    /^#\[cfg\(test\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    pending_test_cfg && $0 !~ /^[[:space:]]*$/ && $0 !~ /^#\[/ {
        pending_test_cfg = 0
    }
    in_test_module {
        next
    }
    $0 ~ /([A-Za-z_][A-Za-z0-9_]*\.)*stream_uploads[[:space:]]*(!=|==)/ \
        || $0 ~ /(!=|==)[[:space:]]*([A-Za-z_][A-Za-z0-9_]*\.)*stream_uploads/ {
        print FILENAME ":" FNR ":" $0
    }
    ' $(find crates/storage/src -type f -name '*.rs' \
        ! -path '*/tests/*' \
        ! -path 'crates/storage/src/cluster/local.rs' \
        | sort)
