scan_test_storage_failure_method_leaks() {
    local source=$1
    local trait_name=${2:-StorageClusterObjectTestSupport}
    local method_pattern=${3:-.*}

    awk -v trait_name="$trait_name" -v method_pattern="$method_pattern" '
    function trim(value) {
        sub(/^[[:space:]]+/, "", value)
        sub(/[[:space:]]+$/, "", value)
        return value
    }
    function result_error_is_test_storage_failure(value, open_index, angle_depth, paren_depth, bracket_depth, brace_depth, error_start, i, character, previous, error_type) {
        if (!match(value, /->[[:space:]]*([[:alnum:]_]+::)*Result[[:space:]]*</)) {
            return 0
        }
        open_index = RSTART + RLENGTH - 1
        angle_depth = 1
        for (i = open_index + 1; i <= length(value); i++) {
            character = substr(value, i, 1)
            previous = substr(value, i - 1, 1)
            if (character == "<") {
                angle_depth++
            } else if (character == ">" && previous != "-") {
                angle_depth--
                if (angle_depth == 0) {
                    if (error_start == 0) {
                        return 0
                    }
                    error_type = trim(substr(value, error_start, i - error_start))
                    return error_type ~ /^([[:alnum:]_]+::)*TestStorageFailure$/
                }
            } else if (character == "(") {
                paren_depth++
            } else if (character == ")") {
                paren_depth--
            } else if (character == "[") {
                bracket_depth++
            } else if (character == "]") {
                bracket_depth--
            } else if (character == "{") {
                brace_depth++
            } else if (character == "}") {
                brace_depth--
            } else if (character == "," && angle_depth == 1 && paren_depth == 0 && bracket_depth == 0 && brace_depth == 0) {
                if (error_start != 0) {
                    return 0
                }
                error_start = i + 1
            }
        }
        return 0
    }
    function inspect_signature() {
        raw_error = signature ~ /(ObjectPgActionError|MetadataError|StoreError|ShardIoError)/
        fallible_result = signature ~ /->[[:space:]]*([[:alnum:]_]+::)*Result[[:space:]]*</
        opaque_result = result_error_is_test_storage_failure(signature)
        nonopaque_result = fallible_result && !opaque_result
        if (raw_error || nonopaque_result) {
            print signature_start
        }
        collecting_signature = 0
        signature = ""
        signature_start = ""
    }
    $0 ~ "^[[:space:]]*pub trait " trait_name "[[:space:]]*\\{" {
        in_test_support = 1
        next
    }
    in_test_support && /^[[:space:]]*((async|const|unsafe)[[:space:]]+)*fn[[:space:]]+/ {
        method_name = $0
        sub(/^[[:space:]]*((async|const|unsafe)[[:space:]]+)*fn[[:space:]]+/, "", method_name)
        sub(/\(.*/, "", method_name)
        if (method_name !~ method_pattern) {
            next
        }
        collecting_signature = 1
        signature = $0
        signature_start = FILENAME ":" FNR ":" $0
        if ($0 ~ /;/) {
            inspect_signature()
        }
        next
    }
    in_test_support && collecting_signature {
        signature = signature " " $0
        if ($0 ~ /;/) {
            inspect_signature()
        }
        next
    }
    in_test_support && /^[[:space:]]*\}/ {
        in_test_support = 0
    }
    ' "$source"
}

