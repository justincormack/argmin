        && $0 !~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/ {
        pending_test_cfg = 0
    }
    in_test_module {
        next
    }
    function update_function_context() {
