    local source_root=$1

    rg -n --color=never --sort path \
        '^[[:space:]]*pub[[:space:]]+((const|async|unsafe)[[:space:]]+)*(extern([[:space:]]+"[^"]*")?[[:space:]]+)?fn[[:space:]]+test_[A-Za-z0-9_]+' \
        "$source_root" \
        -g '*.rs' \
        -g '!**/test_support/**' \
        || true
}

