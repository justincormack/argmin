    'lib\.rs:[0-9]+:ExportedRoute$'
    'lib\.rs:[0-9]+:wildcard-import$'
    'lib\.rs:[0-9]+:ShardKey$'
    'lib\.rs:[0-9]+:LifecycleSweepClaimRecord$'
    'lib\.rs:[0-9]+:RawRouteObservation$'
    'lib\.rs:[0-9]+:PgId$'
    'nested/api\.rs:[0-9]+:NestedLayout$'
    'nested/api\.rs:[0-9]+:BucketWriteReservationProof$'
    'nested/split_alias\.rs:[0-9]+:SplitAlias$'
    'nested/split_alias\.rs:[0-9]+:EcShape$'
    'nested/split_wildcard\.rs:[0-9]+:wildcard-import$'
    'nested/split_function\.rs:[0-9]+:EcShape$'
    'nested/split_trait_method\.rs:[0-9]+:EcShape$'
    'nested/comment_alias\.rs:[0-9]+:CommentAlias$'
    'nested/comment_alias\.rs:[0-9]+:EcShape$'
    'nested/comment_wildcard\.rs:[0-9]+:wildcard-import$'
    'nested/comment_function\.rs:[0-9]+:EcShape$'
    'nested/union\.rs:[0-9]+:PgId$'
    'nested/associated_type\.rs:[0-9]+:Item$'
    'nested/associated_type\.rs:[0-9]+:PgId$'
    'nested/impl_header\.rs:[0-9]+:EcShape$'
)
for pattern in "${test_support_fixture_required_patterns[@]}"; do
    if ! rg -q -- "$pattern" <<<"$test_support_physical_api_fixture"; then
        test_support_physical_api_fixture_failure+="missing semantic fixture outcome: $pattern"$'\n'
    fi
done
if rg -q 'nested/safe_syntax\.rs:' <<<"$test_support_physical_api_fixture"; then
    test_support_physical_api_fixture_failure+="comments, literals, or implementation bodies produced a false public-API diagnostic"$'\n'
fi
fail_with_matches \
    "Curated test-support API scanner must reject every physical API shape without scanning comments, literals, or implementation bodies" \
    "${test_support_physical_api_fixture_failure%$'\n'}"

if [[ "$failed" -ne 0 ]]; then
    echo
    echo "storage cluster boundary checks failed" >&2
    exit 1
fi

echo "storage cluster boundary checks passed"
