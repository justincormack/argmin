#!/bin/env bash

set -euo pipefail

# The checked inventories are compared as ordered text. Locale collation can
# order `cluster.rs` and `cluster/request_ops.rs` differently, so make every
# sort and character-class match deterministic across caller environments.
export LC_ALL=C

if ! command -v rg >/dev/null 2>&1; then
    echo "error: rg is required for scripts/check-storage-cluster-boundaries" >&2
    exit 1
fi

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

failed=0

fail_with_matches() {
    local label=$1
    local matches=$2

    if [[ -n "$matches" ]]; then
        echo
        echo "== $label =="
        printf '%s\n' "$matches"
        failed=1
    fi
}

echo "Storage cluster boundary checks"

storage_test_feature_graph_failure=""
if ! storage_test_feature_graph_output=$(
    bash scripts/check-storage-test-feature-graph 2>&1
); then
    storage_test_feature_graph_failure=$storage_test_feature_graph_output
fi
fail_with_matches \
    "Workspace normal/build feature graphs must enable storage test support only for the exhaustive reviewed test-only package allowlist" \
    "$storage_test_feature_graph_failure"

publisher_scan_output=$(
    awk -f scripts/check-storage-cluster-boundary-publishers.awk \
        $(find crates/storage/src -type f -name '*.rs' \
            ! -path '*/tests/*' \
            ! -name '*_tests.rs' \
            | sort)
)

pending_command_publishers=$(
    printf '%s\n' "$publisher_scan_output" \
        | awk -F '\t' '$1 == "PUBLISHER" { print $2 }' \
        | sort \
        | uniq -c \
        | sed 's/^ *//'
)

publisher_scanner_fixture=$(
    awk -f scripts/check-storage-cluster-boundary-publishers.awk \
        scripts/fixtures/storage-boundary-publishers/inline-test-items.rs
)
publisher_scanner_fixture_failure=""
publisher_fixture_required_patterns=(
    $'^MARKER\tFixtureProductionPublisher:production_publisher_after_inline_test_module$'
    $'^PUBLISHER\t.*:production_publisher_after_inline_test_module:FixtureProductionPublisher:try_set_pending_metadata_command_for_bucket$'
    $'^MARKER\tLiveFeaturePublisher:production_feature_publisher_must_remain_visible$'
    $'^PUBLISHER\t.*:production_feature_publisher_must_remain_visible:LiveFeaturePublisher:try_install_pending_metadata_command_for_bucket$'
    $'^MARKER\tTypedSnapshotPublisher:typed_snapshot_sensitive_publisher_is_not_shell_inventoried$'
    $'^MARKER\tTypedSnapshotBucketControlPublisher:typed_snapshot_sensitive_bucket_control_is_not_shell_inventoried$'
    $'^MARKER\tTypedSnapshotBucketPgPublisher:typed_snapshot_sensitive_bucket_pg_is_not_shell_inventoried$'
    $'^MARKER\tTypedAllocatorPublisher:typed_allocator_cleanup_publisher_is_not_shell_inventoried$'
    $'^MARKER\tTypedTerminalSessionPublisher:typed_terminal_session_publisher_is_not_shell_inventoried$'
    $'^MARKER\tTypedMatchingOutcomePublisher:typed_matching_outcome_publisher_is_not_shell_inventoried$'
    $'^MARKER\tTypedApplyValidatedPublisher:typed_apply_validated_publisher_is_not_shell_inventoried$'
    $'^MARKER\tTypedGenericDrainPublisher:typed_generic_drain_is_not_shell_inventoried$'
    $'^TYPED_MISSING_MARKER\t.*:typed_snapshot_sensitive_publisher_without_marker_is_rejected:install_snapshot_sensitive_metadata_command_or_drain$'
    $'^TYPED_MISSING_MARKER\t.*:typed_snapshot_sensitive_bucket_control_without_marker_is_rejected:install_snapshot_sensitive_bucket_control_command_or_drain$'
    $'^TYPED_MISSING_MARKER\t.*:typed_snapshot_sensitive_bucket_pg_without_marker_is_rejected:install_snapshot_sensitive_bucket_pg_command_or_drain$'
    $'^TYPED_MISSING_MARKER\t.*:typed_allocator_cleanup_publisher_without_marker_is_rejected:install_allocator_cleanup_metadata_command_with_fresh_id$'
    $'^TYPED_MISSING_MARKER\t.*:typed_terminal_session_publisher_without_marker_is_rejected:install_terminal_session_retry_metadata_command$'
    $'^TYPED_MISSING_MARKER\t.*:typed_matching_outcome_publisher_without_marker_is_rejected:install_matching_outcome_retry_metadata_command$'
    $'^TYPED_MISSING_MARKER\t.*:typed_apply_validated_publisher_without_marker_is_rejected:install_apply_validated_metadata_command_with_fresh_id$'
    $'^TYPED_MISSING_MARKER\t.*:typed_generic_drain_without_marker_is_rejected:drain_pending_object_metadata_commands_for_publisher$'
    $'^MARKER\tRawGenericDrainPublisher:raw_generic_drain_from_publisher_is_rejected$'
    $'^PUBLISHER\t.*:raw_generic_drain_from_publisher_is_rejected:RawGenericDrainPublisher:raw_pending_object_metadata_command_drain$'
    $'^PUBLISHER\t.*:raw_generic_drain_from_unmarked_wrapper_is_rejected:<missing>:raw_pending_object_metadata_command_drain$'
    $'^RECOVERY_DRAIN_USE\t.*:raw_inner_drain_from_unmarked_wrapper_is_rejected:metadata_command_authorized_drain_primitive$'
    $'^RECOVERY_DRAIN_USE\t.*:recovery_authority_construction_from_unmarked_wrapper_is_rejected:metadata_command_recovery_authority_constructor$'
    $'^RECOVERY_DRAIN_USE\t.*:recovery_authority_constructor_function_item_is_rejected:metadata_command_recovery_authority_constructor$'
    $'^RECOVERY_DRAIN_USE\t.*:recovery_invocation_construction_from_unmarked_wrapper_is_rejected:metadata_command_recovery_invocation_constructor$'
    $'^RECOVERY_DRAIN_USE\t.*:recovery_wrapper_from_unmarked_wrapper_is_rejected:metadata_command_local_recovery_drain$'
    $'^RECOVERY_DRAIN_USE\t.*:recovery_execution_route_from_unmarked_wrapper_is_rejected:metadata_command_recovery_execution_route$'
    $'^PUBLISHER\t.*:recovery_execution_route_struct_literal_is_rejected:<missing>:metadata_command_execution_route_struct_literal$'
    $'^RECOVERY_DRAIN_USE\t.*:recovery_proof_derivation_from_unmarked_wrapper_is_rejected:metadata_command_recovery_proof_derivation$'
    $'^RECOVERY_DRAIN_USE\t.*:recovery_leader_construction_from_unmarked_wrapper_is_rejected:metadata_command_recovery_leader_constructor$'
    $'^RECOVERY_DRAIN_USE\t.*:recovery_apply_from_unmarked_wrapper_is_rejected:metadata_command_recovery_apply$'
    $'^RECOVERY_DRAIN_USE\t.*:recovery_reissued_apply_from_unmarked_wrapper_is_rejected:metadata_command_recovery_apply_reissued$'
    $'^RECOVERY_DRAIN_USE\t.*:recovery_abandon_from_unmarked_wrapper_is_rejected:metadata_command_recovery_record_abandoned$'
    $'^RECOVERY_DRAIN_USE\t.*:recovery_pending_removal_from_unmarked_wrapper_is_rejected:metadata_command_recovery_remove_pending$'
    $'^RECOVERY_DRAIN_USE\t.*:recovery_reissue_from_unmarked_wrapper_is_rejected:metadata_command_recovery_reissue$'
    $'^RECOVERY_DRAIN_USE\t.*:recovery_bucket_finisher_from_unmarked_wrapper_is_rejected:metadata_command_recovery_bucket_finisher$'
    $'^PUBLISHER\t.*:retired_recovery_finisher_from_unmarked_wrapper_is_rejected:<missing>:retired_metadata_command_recovery_finisher$'
)
for pattern in "${publisher_fixture_required_patterns[@]}"; do
    if ! rg -q -- "$pattern" <<<"$publisher_scanner_fixture"; then
        publisher_scanner_fixture_failure+="missing semantic fixture outcome: $pattern"$'\n'
    fi
done
if rg -q 'TestOnly(Module|Item)Publisher' <<<"$publisher_scanner_fixture"; then
    publisher_scanner_fixture_failure+="test-only publisher escaped cfg filtering"$'\n'
fi
if rg -q $'^(PUBLISHER|TYPED_MISSING_MARKER)\t.*:typed_.*_is_not_shell_inventoried:' \
    <<<"$publisher_scanner_fixture"; then
    publisher_scanner_fixture_failure+="typed publisher with a marker was misclassified"$'\n'
fi
fail_with_matches \
    "Publisher scanner fixture must reject every authority bypass while excluding test-only scopes" \
    "${publisher_scanner_fixture_failure%$'\n'}"

recovery_drain_authority_uses=$(
    printf '%s\n' "$publisher_scan_output" \
        | awk -F '\t' '$1 == "RECOVERY_DRAIN_USE" { print $2 }' \
        | sort
)
expected_recovery_drain_authority_uses=$(cat <<'EOF'
crates/storage/src/cluster/metadata_operations.rs:drain_pending_metadata_commands_for_current_map:metadata_command_local_recovery_drain
crates/storage/src/cluster/metadata_operations.rs:reissue_pending_metadata_command_until:metadata_command_recovery_reissue
crates/storage/src/cluster/payload_operations.rs:complete_abandoned_object_metadata_command:metadata_command_recovery_execution_route
crates/storage/src/cluster/payload_operations.rs:complete_abandoned_object_metadata_command:metadata_command_recovery_execution_route
crates/storage/src/cluster/payload_operations.rs:complete_abandoned_object_metadata_command:metadata_command_recovery_proof_derivation
crates/storage/src/cluster/payload_operations.rs:complete_abandoned_object_metadata_command:metadata_command_recovery_reissue
crates/storage/src/cluster/payload_operations.rs:complete_abandoned_object_metadata_command:metadata_command_recovery_remove_pending
crates/storage/src/cluster/payload_operations.rs:drain_pending_metadata_command_with_authority_inner:metadata_command_recovery_leader_constructor
crates/storage/src/cluster/payload_operations.rs:drain_pending_metadata_command_with_authorized_recovery_source:metadata_command_historical_recovery_drain
crates/storage/src/cluster/payload_operations.rs:drain_pending_metadata_command_with_authorized_recovery_source_and_work_budget:metadata_command_authorized_drain_primitive
crates/storage/src/cluster/payload_operations.rs:drain_pending_metadata_command_with_authorized_recovery_source_and_work_budget:metadata_command_recovery_authority_constructor
crates/storage/src/cluster/payload_operations.rs:drain_pending_metadata_command_with_authorized_recovery_source_and_work_budget:metadata_command_recovery_invocation_constructor
crates/storage/src/cluster/payload_operations.rs:drain_pending_metadata_command_with_local_recovery_route:metadata_command_authorized_drain_primitive
crates/storage/src/cluster/payload_operations.rs:drain_pending_metadata_command_with_local_recovery_route:metadata_command_recovery_authority_constructor
crates/storage/src/cluster/payload_operations.rs:drain_pending_metadata_command_with_local_recovery_route:metadata_command_recovery_invocation_constructor
crates/storage/src/cluster/payload_operations.rs:drain_pending_metadata_command_with_recovery_authority:metadata_command_recovery_authority_drain
crates/storage/src/cluster/payload_operations.rs:drain_pending_metadata_command_with_recovery_authority_and_requirement:metadata_command_authorized_drain_primitive
crates/storage/src/cluster/payload_operations.rs:drain_pending_metadata_command_with_recovery_authority_and_requirement:metadata_command_recovery_invocation_constructor
crates/storage/src/cluster/payload_operations.rs:drain_pending_object_metadata_command_outcome_with_work_budget:metadata_command_authorized_drain_primitive
crates/storage/src/cluster/payload_operations.rs:drain_pending_object_metadata_commands_for_exact_bucket_inner:metadata_command_recovery_authority_constructor
crates/storage/src/cluster/payload_operations.rs:drain_pending_object_metadata_commands_for_exact_bucket_inner:metadata_command_recovery_authority_drain
crates/storage/src/cluster/payload_operations.rs:finish_object_pg_pending_slot_inner:metadata_command_recovery_proof_derivation
crates/storage/src/cluster/payload_operations.rs:finish_object_pg_pending_slot_inner:metadata_command_recovery_record_abandoned
crates/storage/src/cluster/payload_operations.rs:finish_object_pg_pending_slot_inner:metadata_command_recovery_record_abandoned
crates/storage/src/cluster/payload_operations.rs:finish_object_pg_pending_slot_inner:metadata_command_recovery_remove_pending
crates/storage/src/cluster/payload_operations.rs:finish_object_pg_pending_slot_inner:metadata_command_recovery_remove_pending
crates/storage/src/cluster/payload_operations.rs:finish_pending_metadata_command_with_recovery_leader:metadata_command_recovery_bucket_finisher
crates/storage/src/cluster/payload_operations.rs:finish_pending_metadata_command_with_recovery_leader:metadata_command_recovery_execution_route
crates/storage/src/cluster/payload_operations.rs:prepare_stream_segment_append_with_route_validation:metadata_command_recovery_authority_constructor
crates/storage/src/cluster/payload_operations.rs:prepare_stream_segment_append_with_route_validation:metadata_command_recovery_authority_drain
crates/storage/src/cluster/payload_operations.rs:propagate_and_complete_abandoned_object_metadata_command:metadata_command_recovery_record_abandoned
crates/storage/src/cluster/request_ops/metadata_commands.rs:drain_pending_metadata_command_pg_slot_with_work_budget:metadata_command_recovery_authority_constructor
crates/storage/src/cluster/request_ops/metadata_commands.rs:drain_pending_metadata_command_pg_slot_with_work_budget:metadata_command_recovery_authority_drain
crates/storage/src/cluster/request_ops/metadata_commands.rs:finish_pending_metadata_command_to_acting_set_for_recovery_with_work_budget:metadata_command_recovery_execution_route
crates/storage/src/cluster/request_ops/metadata_commands.rs:finish_pending_metadata_command_to_acting_set_inner:metadata_command_recovery_proof_derivation
crates/storage/src/cluster/request_ops/metadata_commands.rs:finish_pending_metadata_command_to_acting_set_inner:metadata_command_recovery_record_abandoned
crates/storage/src/cluster/request_ops/metadata_commands.rs:finish_pending_metadata_command_to_acting_set_inner:metadata_command_recovery_record_abandoned
crates/storage/src/cluster/request_ops/metadata_commands.rs:finish_pending_metadata_command_to_acting_set_inner:metadata_command_recovery_reissue
crates/storage/src/cluster/request_ops/metadata_commands.rs:finish_pending_metadata_command_to_acting_set_inner:metadata_command_recovery_remove_pending
crates/storage/src/cluster/request_ops/metadata_commands.rs:finish_pending_metadata_command_to_acting_set_inner:metadata_command_recovery_remove_pending
crates/storage/src/cluster/request_ops/metadata_commands.rs:finish_pending_metadata_command_to_acting_set_inner:metadata_command_recovery_remove_pending
crates/storage/src/cluster/request_ops/metadata_commands.rs:finish_pending_metadata_command_to_acting_set_inner:metadata_command_recovery_remove_pending
crates/storage/src/cluster/request_ops/metadata_commands.rs:metadata_command_has_abandoned_log_on_acting_set_for_recovery_until:metadata_command_recovery_execution_route
crates/storage/src/cluster/request_ops/metadata_commands.rs:record_abandoned_metadata_command_to_acting_set_for_recovery_until:metadata_command_recovery_execution_route
crates/storage/src/cluster/request_ops/multipart_operations.rs:abort_multipart_upload_if_due_raw:metadata_command_recovery_authority_constructor
crates/storage/src/cluster/request_ops/multipart_operations.rs:abort_multipart_upload_if_due_raw:metadata_command_recovery_authority_drain
crates/storage/src/cluster/request_ops/multipart_operations.rs:lookup_multipart_upload_management_with_route_validation:metadata_command_recovery_authority_constructor
crates/storage/src/cluster/request_ops/multipart_operations.rs:lookup_multipart_upload_management_with_route_validation:metadata_command_recovery_authority_drain
crates/storage/src/cluster/runtime_map.rs:recover_reported_pending_metadata_command:metadata_command_historical_recovery_drain
EOF
)
if [[ "$recovery_drain_authority_uses" != "$expected_recovery_drain_authority_uses" ]]; then
    fail_with_matches \
        "Recovery-drain authority constructors, primitive, and wrappers are restricted to the audited storage-owned sites" \
        "$recovery_drain_authority_uses"
fi

typed_publishers_missing_markers=$(
    printf '%s\n' "$publisher_scan_output" \
        | awk -F '\t' '$1 == "TYPED_MISSING_MARKER" { print $2 }'
)
fail_with_matches \
    "Typed metadata-command publisher calls require an authoritative registry marker" \
    "$typed_publishers_missing_markers"

publisher_token_constructor_pattern='__from_registry_marker'
direct_publisher_token_construction=$(
    rg -n --color=never \
        "$publisher_token_constructor_pattern" \
        crates/storage/src \
        -g '*.rs' \
        -g '!metadata_command.rs' \
        || true
)
fail_with_matches \
    "Metadata-command publisher tokens must be obtained through metadata_command_publisher!" \
    "$direct_publisher_token_construction"
publisher_token_constructor_fixture=$(
    rg -n --color=never \
        "$publisher_token_constructor_pattern" \
        scripts/fixtures/storage-boundary-publishers/inline-test-items.rs \
        || true
)
if [[ -z "$publisher_token_constructor_fixture" ]] \
    || ! printf '%s\n' "$publisher_token_constructor_fixture" \
        | rg -q '__from_registry_marker[[:space:]]*;'; then
    fail_with_matches \
        "Publisher token-construction guard fixture no longer exercises the rejected function-item reference" \
        "$publisher_token_constructor_fixture"
fi

registered_metadata_command_publishers=$(
    awk '
    /^define_metadata_command_publishers! \{/ {
        in_registry = 1
        next
    }
    in_registry && /^}/ {
        in_registry = 0
        next
    }
    in_registry && /^    [A-Za-z0-9_]+ => \(/ {
        publisher_id = $0
        sub(/^    /, "", publisher_id)
        sub(/ =>.*/, "", publisher_id)
        next
    }
    in_registry && publisher_id != "" && /^        "[A-Za-z0-9_]+",/ {
        canonical_name = $0
        gsub(/[ ",]/, "", canonical_name)
        print publisher_id ":" canonical_name
        publisher_id = ""
    }
    ' crates/storage/src/metadata_command.rs \
        | sort
)

live_metadata_command_publishers=$(
    printf '%s\n' "$publisher_scan_output" \
        | awk -F '\t' '$1 == "MARKER" { print $2 }' \
        | sort
)

if [[ "$live_metadata_command_publishers" != "$registered_metadata_command_publishers" ]]; then
    fail_with_matches \
        "Every registered metadata-command publisher must have exactly one live, canonical entry-point marker" \
        "$live_metadata_command_publishers"
fi

fail_with_matches \
    "Production metadata-command publishers must use their compiler-classified typed installer" \
    "$pending_command_publishers"

generic_route_io_matches=$(
    rg -n --color=never \
        'std::io::Error::other\((error|other)\.to_string\(\)\)|StoreError::Io[[:space:]]*\{[[:space:]]*context:[^}]*route|StoreError::Io[[:space:]]*\{[[:space:]]*context:[^}]*PG' \
        crates/storage/src/cluster.rs \
        crates/storage/src/cluster/local.rs \
        || true
)
allowed_generic_route_io=$(
    printf '%s\n' "$generic_route_io_matches" \
        | rg -v 'crates/storage/src/cluster.rs:.*source: std::io::Error::other\(other\.to_string\(\)\)' \
        || true
)
fail_with_matches \
    "Route/control-plane error converted through generic StoreError::Io" \
    "$allowed_generic_route_io"


http_storage_debug_representation_leaks=$(
    {
        rg -n --color=never \
            '\b(PgId|raw_pg_id|MetadataCommandCheckpointRecordSummary|ObjectReadSnapshotMode|ObjectPayloadPlacementDiagnosticError)\b|record_current_metadata_command_checkpoint_for_pg|load_object_read_snapshot_if|\.payload_placement_diagnostic[[:space:]]*\(' \
            crates/server-http/src \
            -g '*.rs' \
            || true
        rg -n -U --color=never \
            '\bPgId\b|pub fn metadata_checkpoint_diagnostic(?s:.{0,160})(pg_id|u32)' \
            crates/server-core/src/coordinator/infra.rs \
            || true
        rg -n -U --color=never \
            'pub struct MetadataCommandCheckpointRecordSummary|^[[:space:]]*pub[[:space:]]+fn[[:space:]]+record_current_metadata_command_checkpoint_for_pg|pub enum ObjectPayloadPlacementDiagnosticError|^[[:space:]]*pub[[:space:]]+fn[[:space:]]+payload_placement_diagnostic' \
            crates/storage/src/cluster.rs crates/storage/src/types.rs \
            || true
        if ! rg -q -U \
            'pub fn metadata_checkpoint_diagnostic(?s:.{0,160})selector: &str' \
            crates/storage/src/cluster/request_ops/diagnostics_test_support.rs
        then
            printf '%s\n' \
                'crates/storage/src/cluster/request_ops/diagnostics_test_support.rs: metadata checkpoint diagnostic must accept an opaque selector string'
        fi
        if ! rg -q -U \
            'pub fn metadata_checkpoint_diagnostic(?s:.{0,160})selector: &str' \
            crates/server-core/src/coordinator/infra.rs
        then
            printf '%s\n' \
                'crates/server-core/src/coordinator/infra.rs: metadata checkpoint diagnostic must forward an opaque selector string'
        fi
    }
)
fail_with_matches \
    "Local HTTP diagnostics must use opaque storage-owned operations rather than PG, checkpoint-summary, object-snapshot, or placement-error representations" \
    "$http_storage_debug_representation_leaks"

http_ec_boundary_leaks=$(
    {
        rg -n --color=never \
            '^[[:space:]]*ec[[:space:]]*=|package[[:space:]]*=[[:space:]]*"ec"|path[[:space:]]*=[[:space:]]*"\.\./ec"' \
            crates/server-http/Cargo.toml \
            || true
        rg -n --color=never \
            '\bec(::|[[:space:]]+as\b)' \
            crates/server-http/src \
            -g '*.rs' \
            || true
    }
)
fail_with_matches \
    "server-http must use storage/server-core semantic test facilities rather than depend on or construct EC representations" \
    "$http_ec_boundary_leaks"

unbudgeted_request_work_helpers=$(
    awk '
    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        in_test_hook = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*#\[/ {
        next
    }
    /^[[:space:]]*(pub(\([^)]*\))?[[:space:]]+|pub\(super\)[[:space:]]+|pub\(crate\)[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/ {
        current_fn = $0
        sub(/^.*fn[[:space:]]+/, "", current_fn)
        sub(/\(.*/, "", current_fn)
        in_test_hook = pending_test_cfg
        pending_test_cfg = 0
    }
    pending_test_cfg && $0 !~ /^[[:space:]]*$/ {
        pending_test_cfg = 0
    }
    {
        if (in_test_hook || current_fn ~ /^test_/) {
            next
        }
        if (current_fn == "drain_unrelated_pending_metadata_command_for_bucket" \
            || current_fn == "drain_pending_metadata_command_pg_slot" \
            || current_fn == "drain_bucket_pg_pending_metadata_command" \
            || current_fn == "drain_pending_completed_multipart_sequence_command" \
            || current_fn == "next_bucket_metadata_command_id_or_drain" \
            || current_fn == "next_completion_bucket_metadata_command_id_or_drain" \
            || current_fn == "try_set_bucket_pg_pending_command_or_retry" \
            || current_fn == "try_set_bucket_control_pending_command_or_retry") {
            next
        }
        if ($0 ~ /\.(drain_unrelated_pending_metadata_command_for_bucket|drain_pending_metadata_command_pg_slot|drain_bucket_pg_pending_metadata_command|drain_pending_completed_multipart_sequence_command|next_bucket_metadata_command_id_or_drain|next_completion_bucket_metadata_command_id_or_drain|try_set_bucket_pg_pending_command_or_retry|try_set_bucket_control_pending_command_or_retry)\(/) {
            print FILENAME ":" FNR ":" $0
        }
    }
    ' crates/storage/src/cluster/request_ops.rs
)
fail_with_matches \
    "Production request paths must use request-work-budget variants for bucket metadata drain/retry helpers" \
    "$unbudgeted_request_work_helpers"

database_implementation_leaks=$(
    rg -n --color=never \
        'rusqlite::|use[[:space:]]+rusqlite|\.connection\(\)' \
        crates/storage/src \
        -g '*.rs' \
        -g '!crates/storage/src/pg_store.rs' \
        -g '!crates/storage/src/pg_store/**' \
        || true
)
fail_with_matches \
    "SQLite and raw PgStore connections are private to the pg_store module" \
    "$database_implementation_leaks"

storage_layout_leaks=$(
    rg -n --color=never \
        'SQLite format 3|metadata\.db|"pg-(\{|[0-9])|join\("shards"\)|STORAGE_NODE_DATA_DIR_LOCK_FILE_NAME|\.argmin-storage-node\.lock' \
        crates/argmin-s3/src \
        -g '*.rs' \
        || true
)
fail_with_matches \
    "Physical PG directories, metadata-store files, shard trees, and native locks are private to storage" \
