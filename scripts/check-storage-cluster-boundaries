            depth -= gsub(/\}/, "}", line)
            if (depth == 0 && $0 ~ /\}/) {
                in_pg_admin_impl = 0
            }
        }
        ' crates/storage/src/control_plane_pg_admin.rs
        rg -n -U --color=never \
