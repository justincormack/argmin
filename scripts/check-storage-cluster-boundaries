#!/bin/env bash

set -euo pipefail

# The checked inventories are compared as ordered text. Locale collation can
# order `cluster.rs` and `cluster/request_ops.rs` differently, so make every
# sort and character-class match deterministic across caller environments.
export LC_ALL=C

if ! command -v rg >/dev/null 2>&1; then
    echo "error: rg is required for scripts/check-storage-cluster-boundaries" >&2
    exit 1
fi

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

failed=0

fail_with_matches() {
    local label=$1
    local matches=$2

    if [[ -n "$matches" ]]; then
        echo
        echo "== $label =="
        printf '%s\n' "$matches"
        failed=1
    fi
}

echo "Storage cluster boundary checks"

public_node_read_boundary_bypasses=$(
    awk '
    FNR == 1 {
        pending_test_cfg = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*#\[/ {
        next
    }
    /^[[:space:]]*pub fn (load_bucket_snapshot_pair|load_multipart_upload|load_in_progress_multipart_upload|load_multipart_completion_snapshot|load_multipart_completion_preflight|load_in_progress_multipart_upload_for_listing|list_multipart_parts_for_authorized_upload|lookup_multipart_upload_management|load_stream_upload_session|prepare_stream_segment_append|list_all_stream_uploads_best_effort)\(/ {
        if (!pending_test_cfg) {
            print FILENAME ":" FNR ":" $0
        }
        pending_test_cfg = 0
        next
    }
    $0 !~ /^[[:space:]]*$/ {
        pending_test_cfg = 0
    }
    ' crates/storage/src/node/bucket_ops.rs \
      crates/storage/src/node/multipart_ops.rs \
      crates/storage/src/node/stream_ops.rs
)
fail_with_matches \
    "SharedStorageNode read convenience wrappers must stay cfg(test); production cluster code must use role-specific node-client interfaces, while process-local inspection uses the sanctioned raw-node test facade" \
    "$public_node_read_boundary_bypasses"

unexpected_single_node=$(
    awk '
    function update_function_context() {
        if ($0 ~ /^    #\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ || $0 ~ /^    #\[cfg\(test\)\]/) {
            pending_test_hook_cfg = 1
            return
        }
        if ($0 ~ /^    #\[/) {
            return
        }
        if ($0 ~ /^    (pub(\([^)]*\))? )?fn [A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            in_test_hook = pending_test_hook_cfg
            pending_test_hook_cfg = 0
            return
        }
        if ($0 !~ /^[[:space:]]*$/) {
            pending_test_hook_cfg = 0
        }
    }
    {
        update_function_context()
        if ($0 ~ /self\.single_node/ \
            && current_fn != "metadata_primary_bridge_node" \
            && current_fn != "metadata_primary_topology_node") {
            print FILENAME ":" FNR ":" $0
        }
    }
    ' crates/storage/src/cluster.rs crates/storage/src/cluster/request_ops.rs
)
fail_with_matches \
    "Unexpected direct self.single_node access outside approved StorageCluster helpers" \
    "$unexpected_single_node"

unexpected_metadata_bridge=$(
    awk '
    function update_function_context() {
        if ($0 ~ /^    #\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ || $0 ~ /^    #\[cfg\(test\)\]/) {
            pending_test_hook_cfg = 1
            return
        }
        if ($0 ~ /^    #\[/) {
            return
        }
        if ($0 ~ /^    (pub(\([^)]*\))? )?fn [A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            in_test_hook = pending_test_hook_cfg
            pending_test_hook_cfg = 0
            return
        }
        if ($0 !~ /^[[:space:]]*$/) {
            pending_test_hook_cfg = 0
        }
    }
    {
        update_function_context()
        if ($0 ~ /metadata_primary_bridge_node\(/ \
            && current_fn != "metadata_primary_bridge_node" \
            && !in_test_hook) {
            print FILENAME ":" FNR ":" $0
        }
    }
    ' crates/storage/src/cluster.rs crates/storage/src/cluster/request_ops.rs
)
fail_with_matches \
    "metadata_primary_bridge_node used outside cfg-gated test hooks" \
    "$unexpected_metadata_bridge"

removed_bucket_pg_lock_helpers=$(
    rg -n --color=never \
        'lock_bucket_on_bucket_metadata_primary|lock_bucket_on_object_metadata_primary|lock_bucket_on_metadata_pg_primary|lock_multipart_completion_bucket_on_bucket_metadata_primary|lock_multipart_completion_bucket_on_metadata_pg_primary|lock_two_pgs|lock_bucket_pair_pgs|BucketPairPgGuards' \
        crates/storage/src/lib.rs \
        crates/storage/src/node.rs \
        crates/storage/src/cluster.rs \
        crates/storage/src/cluster/request_ops.rs \
        crates/storage/src/cluster/local.rs \
        || true
)
fail_with_matches \
    "Bucket/object-PG request-path mutex helpers were removed for Phase 10.8; use durable reservations/drains and storage-node command serialization" \
    "$removed_bucket_pg_lock_helpers"

legacy_object_pending_helpers=$(
    rg -n --color=never \
        'apply_pending_object_metadata_command_for_bucket|finish_pending_object_metadata_command_for_bucket' \
        crates/storage/src \
        -g '*.rs' \
        || true
)
fail_with_matches \
    "Use exact/drain object pending-command helpers; legacy bucket-named object finisher helpers are not allowed" \
    "$legacy_object_pending_helpers"

migrated_shard_scavenger_metadata_bypasses=$(
    awk '
    FNR == 1 {
        pending_test_cfg = 0
        pending_storage_client = 0
        pending_shard_scavenger_client = 0
        pending_shard_scavenger_observation_client = 0
        in_test_hook = 0
        in_test_module = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    in_test_module {
        next
    }
    function update_function_context() {
        if ($0 ~ /^    (pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            in_test_hook = pending_test_cfg
            pending_test_cfg = 0
        } else if (pending_test_cfg \
            && $0 !~ /^[[:space:]]*$/ \
            && $0 !~ /^[[:space:]]*#\[/) {
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if (in_test_hook) {
            next
        }
        if ($0 ~ /\.storage_client\(\)/ || $0 ~ /storage_client[[:space:]]*$/) {
            pending_storage_client = 1
        }
        if ($0 ~ /\.shard_scavenger_client\(\)/ || $0 ~ /shard_scavenger_client[[:space:]]*$/ || $0 ~ /scavenger_client[[:space:]]*$/) {
            pending_shard_scavenger_client = 1
        }
        if ($0 ~ /\.shard_scavenger_observation_client\(\)/ || $0 ~ /shard_scavenger_observation_client[[:space:]]*$/ || $0 ~ /observation_client[[:space:]]*$/) {
            pending_shard_scavenger_observation_client = 1
        }
        if ($0 ~ /\.(list_scavenger_shard_files|list_scavenger_shard_rows|list_shard_scavenger_payload_references)\(/) {
            if (pending_storage_client || $0 ~ /\.storage_client\(\)/ || $0 ~ /storage_client\./) {
                pending_storage_client = 0
                print FILENAME ":" FNR ":" $0
                next
            }
            if (pending_shard_scavenger_client \
                || $0 ~ /\.shard_scavenger_client\(\)/ \
                || $0 ~ /shard_scavenger_client\./ \
                || $0 ~ /scavenger_client\./) {
                pending_shard_scavenger_client = 0
                next
            }
            print FILENAME ":" FNR ":" $0
        }
        if ($0 ~ /\.(record_shard_scavenger_observation|list_shard_scavenger_observations|resolve_shard_scavenger_observation)\(/) {
            if (pending_storage_client || $0 ~ /\.storage_client\(\)/ || $0 ~ /storage_client\./) {
                pending_storage_client = 0
                print FILENAME ":" FNR ":" $0
                next
            }
            if (pending_shard_scavenger_observation_client \
                || $0 ~ /\.shard_scavenger_observation_client\(\)/ \
                || $0 ~ /shard_scavenger_observation_client\./ \
                || $0 ~ /observation_client\./ \
                || $0 ~ /observation_route\./) {
                pending_shard_scavenger_observation_client = 0
                next
            }
            print FILENAME ":" FNR ":" $0
        }
        if ($0 ~ /;/) {
            pending_storage_client = 0
            pending_shard_scavenger_client = 0
            pending_shard_scavenger_observation_client = 0
        }
    }
    ' crates/storage/src/cluster.rs \
      crates/storage/src/cluster/request_ops.rs \
      crates/storage/src/cluster/local.rs
)
fail_with_matches \
    "Production shard scavenger metadata operations must go through the node client boundary" \
    "$migrated_shard_scavenger_metadata_bypasses"

migrated_payload_ack_bypasses=$(
    awk '
    FNR == 1 {
        pending_test_cfg = 0
        in_test_hook = 0
        in_test_module = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    in_test_module {
        next
    }
    function update_function_context() {
        if ($0 ~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            in_test_hook = pending_test_cfg
            pending_test_cfg = 0
        } else if (pending_test_cfg \
            && $0 !~ /^[[:space:]]*$/ \
            && $0 !~ /^[[:space:]]*#\[/) {
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if (in_test_hook) {
            next
        }
        if ($0 ~ /\.(register_written_shards_batch|stat_shard|delete_shard_record)\(/) {
            print FILENAME ":" FNR ":" $0
        }
        if ($0 ~ /\.register_written_shard_acks\(/ \
            && $0 !~ /shard_ack_client\.register_written_shard_acks\(/) {
            print FILENAME ":" FNR ":" $0
        }
        if ($0 ~ /\.validate_written_shard_ack\(/ \
            && $0 !~ /shard_ack_client\.validate_written_shard_ack\(/) {
            print FILENAME ":" FNR ":" $0
        }
        if ($0 ~ /\.load_written_shard_ack\(/ \
            && $0 !~ /shard_ack_client\.load_written_shard_ack\(/) {
            print FILENAME ":" FNR ":" $0
        }
        if ($0 ~ /\.delete_written_shard_ack\(/ \
            && $0 !~ /shard_ack_client\.delete_written_shard_ack\(/) {
            print FILENAME ":" FNR ":" $0
        }
    }
    ' crates/storage/src/cluster.rs \
      crates/storage/src/cluster/request_ops.rs \
      crates/storage/src/cluster/local.rs
)
fail_with_matches \
    "Production payload shard ack metadata operations must go through the node client boundary" \
    "$migrated_payload_ack_bypasses"

migrated_completed_multipart_tombstone_bypasses=$(
    awk '
    FNR == 1 {
        pending_test_cfg = 0
        pending_storage_client = 0
        in_test_hook = 0
        in_test_module = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    in_test_module {
        next
    }
    function update_function_context() {
        if ($0 ~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            in_test_hook = pending_test_cfg
            pending_test_cfg = 0
        } else if (pending_test_cfg \
            && $0 !~ /^[[:space:]]*$/ \
            && $0 !~ /^[[:space:]]*#\[/) {
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if (in_test_hook) {
            next
        }
        if ($0 ~ /\.storage_client\(\)/) {
            pending_storage_client = 1
        }
        if ($0 ~ /\.object_mutation_metadata_client\(\)/) {
            pending_object_mutation_metadata_client = 1
        }
        if ($0 ~ /\.list_completed_multipart_upload_records_for_bucket\(/) {
            if (pending_object_mutation_metadata_client \
                || $0 ~ /\.object_mutation_metadata_client\(\)/ \
                || $0 ~ /mutation_client\./) {
                pending_object_mutation_metadata_client = 0
                next
            }
            if (pending_storage_client || $0 ~ /\.storage_client\(\)/ || $0 ~ /storage_client\./) {
                pending_storage_client = 0
            }
            print FILENAME ":" FNR ":" $0
        }
        if ($0 ~ /;/) {
            pending_storage_client = 0
            pending_object_mutation_metadata_client = 0
        }
    }
    ' crates/storage/src/cluster.rs \
      crates/storage/src/cluster/request_ops.rs \
      crates/storage/src/cluster/local.rs
)
fail_with_matches \
    "Production completed multipart tombstone scans must go through the node client boundary" \
    "$migrated_completed_multipart_tombstone_bypasses"

migrated_bucket_listing_bypasses=$(
    awk '
    FNR == 1 {
        pending_test_cfg = 0
        pending_storage_client = 0
        in_test_hook = 0
        in_test_module = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    in_test_module {
        next
    }
    function update_function_context() {
        if ($0 ~ /^[[:space:]]*(pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            in_test_hook = pending_test_cfg
            pending_test_cfg = 0
        } else if (pending_test_cfg \
            && $0 !~ /^[[:space:]]*$/ \
            && $0 !~ /^[[:space:]]*#\[/) {
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if (in_test_hook) {
            next
        }
        if ($0 ~ /\.storage_client\(\)/ || $0 ~ /storage_client[[:space:]]*$/) {
            pending_storage_client = 1
        }
        if ($0 ~ /\.object_listing_metadata_client\(\)/ \
            || $0 ~ /object_listing_metadata_client[[:space:]]*$/ \
            || $0 ~ /listing_client[[:space:]]*$/ \
            || $0 ~ /listing_route[[:space:]]*$/) {
            pending_object_listing_metadata_client = 1
        }
        if ($0 ~ /\.(list_objects|list_object_versions|list_multipart_uploads|list_objects_page|list_object_versions_page|list_multipart_uploads_page)\(/) {
            if ($0 ~ /self\.list_(objects|object_versions|multipart_uploads)_page\(/) {
                next
            }
            if (pending_object_listing_metadata_client \
                || $0 ~ /\.object_listing_metadata_client\(\)/ \
                || $0 ~ /listing_client\./ \
                || $0 ~ /listing_route\./) {
                pending_object_listing_metadata_client = 0
                pending_storage_client = 0
                next
            }
            if (pending_storage_client || $0 ~ /\.storage_client\(\)/ || $0 ~ /storage_client\./) {
                pending_storage_client = 0
            }
            print FILENAME ":" FNR ":" $0
        }
        if ($0 ~ /;/) {
            pending_storage_client = 0
            pending_object_listing_metadata_client = 0
        }
    }
    ' crates/storage/src/cluster.rs \
      crates/storage/src/cluster/request_ops.rs \
      crates/storage/src/cluster/local.rs
)
fail_with_matches \
    "Production bucket listing reads must go through the node client boundary" \
    "$migrated_bucket_listing_bypasses"

migrated_metadata_pg_bypasses=$(
    awk '
    FNR == 1 {
        current_fn = ""
        pending_test_cfg = 0
        pending_metadata_command_client = 0
        in_test_hook = 0
        in_test_module = 0
    }
    /^[[:space:]]*#\[cfg\(test\)\]/ || /^[[:space:]]*#\[cfg\(any\(test, feature = "test-hooks"\)\)\]/ {
        pending_test_cfg = 1
        next
    }
    /^[[:space:]]*mod tests[[:space:]]*\{/ && pending_test_cfg {
        in_test_module = 1
        pending_test_cfg = 0
        next
    }
    in_test_module {
        next
    }
    function update_function_context() {
        if ($0 ~ /^    (pub[^[:space:]]*[[:space:]]+)?fn[[:space:]]+[A-Za-z0-9_]+/) {
            current_fn = $0
            sub(/^.*fn /, "", current_fn)
            sub(/\(.*/, "", current_fn)
            in_test_hook = pending_test_cfg
            pending_test_cfg = 0
        } else if (pending_test_cfg \
            && $0 !~ /^[[:space:]]*$/ \
            && $0 !~ /^[[:space:]]*#\[/) {
            pending_test_cfg = 0
        }
    }
    {
        update_function_context()
        if (in_test_hook) {
            next
        }
        if ($0 ~ /\.metadata_command_(inspection_|peering_|recovery_)?client\(\)/ \
            || $0 ~ /metadata_command_(inspection_|peering_|recovery_)?client[[:space:]]*$/ \
            || $0 ~ /(primary_metadata_client|metadata_client|peering_route|primary_critical_section|recovery_critical_section)[[:space:]]*$/) {
            pending_metadata_command_client = 1
        }
        if ($0 ~ /\.(max_metadata_command_log_index|pending_metadata_command_slot|pending_metadata_command_envelope|try_insert_pending_metadata_command_slot|try_insert_bucket_control_pending_metadata_command_slot|remove_pending_metadata_command_slot|replace_pending_metadata_command_slot_for_(reissue|recovery)|metadata_command_replica_state|validate_metadata_command_replay_state|validate_metadata_command_replay_state_preserving_pending_slot|metadata_command_acceptance|metadata_command_abandon_acceptance|applied_metadata_command_log_entry_hashes|has_matching_applied_metadata_command_log_entry|apply_metadata_command_and_record(_for_recovery)?|record_metadata_command_abandoned|metadata_command_abandoned)\(/) {
            if (pending_metadata_command_client \
                || $0 ~ /\.metadata_command_(inspection_|peering_|recovery_)?client\(\)/) {
                pending_metadata_command_client = 0
                next
            }
            if ($0 ~ /metadata_command_(inspection_|peering_|recovery_)?client\./) {
                next
            }
            if ($0 ~ /(primary_metadata_client|metadata_client|peering_route|primary_critical_section|recovery_critical_section)\./) {
                next
            }
            print FILENAME ":" FNR ":" $0
        }
        if ($0 ~ /;/) {
            pending_metadata_command_client = 0
        }
    }
    ' crates/storage/src/cluster.rs \
      crates/storage/src/cluster/request_ops.rs \
      crates/storage/src/cluster/local.rs
)
fail_with_matches \
    "Production metadata command operations must go through a role-specific node client boundary" \
    "$migrated_metadata_pg_bypasses"

