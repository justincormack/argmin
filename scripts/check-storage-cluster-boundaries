    "$cross_crate_raw_runtime_test_control_leaks"

runtime_test_control_public_surface_pattern='^[[:space:]]*pub[[:space:]]+(static[[:space:]]+(TIME_OVERRIDE_MILLIS|MONOTONIC_TIME_OVERRIDE_MILLIS)|struct[[:space:]]+TestTimeOverride(Guard|Control)|fn[[:space:]]+(test_time_override_guard|with_time_and_monotonic_override|test_topology_generation|test_raft_voters|test_logical_acting_sets))\b'

scan_public_runtime_test_control_surface() {
    local source_root=$1

    rg -n --color=never \
        "$runtime_test_control_public_surface_pattern" \
        "$source_root" \
        -g '*.rs' \
        -g '!**/test_support/**' \
        || true
}

public_runtime_test_control_surface_leaks=$(
    scan_public_runtime_test_control_surface crates/storage/src
)
fail_with_matches \
    "Raw mutable-clock and static-topology observations must remain crate-private behind storage::test_support" \
    "$public_runtime_test_control_surface_leaks"

