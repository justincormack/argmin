    {
        rg -n --color=never \
            '\b(PlacedSegmentShardBackfill(ClaimAcquireParams|ClaimAcquire|ClaimRecord|Record|WorkItem|CopyTarget|Plan)|record_placed_segment_shard_backfill|list_placed_segment_shard_backfills|placed_segment_shard_backfill_(exists|backlog_depth|source_is_referenced)|acquire_(next_)?placed_segment_shard_backfill_claim(_with_cursor)?|complete_placed_segment_shard_backfill_claim|record_placed_segment_shard_backfill_claim_error|resolve_placed_segment_shard_backfill|backfill_placed_segment_payload_shard_(direct_copies|for_work_item)|backfill_placed_segment_payload_shards)\b' \
            crates \
            -g '*.rs' \
            -g '!crates/storage/**' \
            || true
        rg -n --color=never \
            'pub[[:space:]]+fn[[:space:]]+(record_placed_segment_shard_backfill|list_placed_segment_shard_backfills|placed_segment_shard_backfill_(exists|backlog_depth|source_is_referenced)|acquire_(next_)?placed_segment_shard_backfill_claim(_with_cursor)?|complete_placed_segment_shard_backfill_claim|record_placed_segment_shard_backfill_claim_error|resolve_placed_segment_shard_backfill|backfill_placed_segment_payload_shard_(direct_copies|for_work_item)|backfill_placed_segment_payload_shards)\b' \
            crates/storage/src/cluster.rs \
            || true
        rg -n --color=never \
            'pub[[:space:]]+(struct[[:space:]]+PlacedSegmentShardBackfill(ClaimAcquireParams|ClaimAcquire|ClaimRecord|Record|WorkItem|CopyTarget|Plan)|const[[:space:]]+PLACED_SEGMENT_SHARD_BACKFILL_)' \
            crates/storage/src \
            -g '*.rs' \
            || true
        rg -n --color=never \
            'struct[[:space:]]+ShardBackfillSweeper\b|\bSHARD_BACKFILL_(DURABLE_SCAN_INTERVAL|CLAIM_LEASE_MILLIS|ERROR_BACKOFF_MILLIS|CLAIM_COUNTER|SWEEPER_REGISTRY)\b' \
            crates/server-core crates/server-http crates/argmin-s3 crates/s3-tests \
            -g '*.rs' \
            || true
    }
)
fail_with_matches \
    "Shard-backfill claims, fairness state, admission, retry policy, physical execution, scheduling, and telemetry are storage-owned; retain only the opaque StorageShardBackfillSweeper and logical test facilities outside storage" \
    "$shard_backfill_maintenance_leaks"

