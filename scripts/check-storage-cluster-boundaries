fail_with_matches \
    "Legacy bucket-row write-drain counter helper reintroduced" \
    "$legacy_bucket_counter_matches"

publisher_scan_output=$(
    awk -f scripts/check-storage-cluster-boundary-publishers.awk \
        $(find crates/storage/src -type f -name '*.rs' \
            ! -path '*/tests/*' \
            ! -name '*_tests.rs' \
            | sort)
)

pending_command_publishers=$(
    printf '%s\n' "$publisher_scan_output" \
        | awk -F '\t' '$1 == "PUBLISHER" { print $2 }' \
        | sort \
        | uniq -c \
        | sed 's/^ *//'
)

publisher_scanner_fixture=$(
    awk -f scripts/check-storage-cluster-boundary-publishers.awk \
        scripts/fixtures/storage-boundary-publishers/inline-test-items.rs
)
