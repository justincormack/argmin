    export STS_TEST_RECREATED_USER_ID="${recreated_role_stable_id}:${STS_TEST_RECREATED_ROLE_SESSION_NAME}"
    echo "same-account-recreated-role-session: ok"
    wait_for_deleted_role_session_invalid same-account-old-session-after-role-recreation

