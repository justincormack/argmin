    STS_TEST_SOURCE_IDENTITY_SECRET_KEY="$(jq -er '.Credentials.SecretAccessKey' <<<"$source_identity_session")"
    STS_TEST_SOURCE_IDENTITY_SESSION_TOKEN="$(jq -er '.Credentials.SessionToken' <<<"$source_identity_session")"
    [[ "$(jq -er '.SourceIdentity' <<<"$source_identity_session")" == \
        "$STS_TEST_SOURCE_IDENTITY" ]] || \
        external_s3_test_die \
            "temporary source-identity session did not preserve its source identity"
    echo "same-account-source-identity-session: ok"

    wait_for_assume_role_success \
        same-account-source-identity-target \
