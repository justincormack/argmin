        --output json)"
    [[ "$(jq -er '.Arn' <<<"$other_live_identity")" == \
        "arn:aws:sts::${primary_account}:assumed-role/${STS_TEST_ROLE_NAME}/token-binding-control" ]] || \
        external_s3_test_die "temporary token-binding control has an unexpected caller ARN"
    echo "same-account-other-live-session-identity: ok"
    wait_for_assume_role_success \
        same-account-chain-target \
        aws_chaining_source \
        "$STS_TEST_CHAIN_TARGET_ROLE_ARN"
    wait_for_assume_role_success \
