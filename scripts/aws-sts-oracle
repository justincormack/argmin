#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/_external-s3-test-env.sh
source "$ROOT/scripts/_external-s3-test-env.sh"

usage() {
    cat <<'EOF'
Usage: ./scripts/aws-sts-oracle [options]

Run the read-only AWS STS Query protocol oracle using the primary credentials
from `.env`. This command does not create or mutate IAM resources.

Options:
  --region REGION   Override the STS signing region (default: TEST_S3_REGION or us-east-1)
  --endpoint URL    Override the regional STS endpoint
  --dotenv PATH     Read AWS variables from a different env file
  -h, --help        Show this help

Examples:
  ./scripts/aws-sts-oracle
  ./scripts/aws-sts-oracle --region eu-west-1
EOF
}

region=""
endpoint=""
dotenv_path="$ROOT/.env"

while (($#)); do
    case "$1" in
        --region)
            [[ $# -ge 2 ]] || external_s3_test_die "--region requires a value"
            region="$2"
            shift 2
            ;;
        --endpoint)
            [[ $# -ge 2 ]] || external_s3_test_die "--endpoint requires a value"
            endpoint="$2"
            shift 2
            ;;
        --dotenv)
            [[ $# -ge 2 ]] || external_s3_test_die "--dotenv requires a value"
            dotenv_path="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            external_s3_test_die "unknown argument: $1"
            ;;
    esac
done

cd "$ROOT"
external_s3_test_load_dotenv "$dotenv_path"
external_s3_test_require_shell_var TEST_AWS_PRIMARY_ACCESS_KEY
external_s3_test_require_shell_var TEST_AWS_PRIMARY_SECRET_KEY
external_s3_test_require_shell_var TEST_AWS_PRIMARY_ACCOUNT_ID

region="${region:-${TEST_S3_REGION:-us-east-1}}"
endpoint="${endpoint:-https://sts.${region}.amazonaws.com}"
endpoint="${endpoint%/}"

export S3_TEST_ACCESS_KEY="$TEST_AWS_PRIMARY_ACCESS_KEY"
export S3_TEST_SECRET_KEY="$TEST_AWS_PRIMARY_SECRET_KEY"
export S3_TEST_ACCOUNT_ID="$TEST_AWS_PRIMARY_ACCOUNT_ID"
export S3_TEST_REGION="$region"
export S3_TEST_STS_ENDPOINT="$endpoint"
export S3_TEST_TIMEOUT_SECS="${TEST_S3_TIMEOUT_SECS:-120}"

cmd=(cargo run -p s3-tests --bin sts_oracle)
external_s3_test_print_command "AWS STS oracle" "${cmd[@]}"
exec "${cmd[@]}"
