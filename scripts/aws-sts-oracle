            "$STS_TEST_EXPIRED_DELETED_SECRET_KEY" \
            "$STS_TEST_EXPIRED_DELETED_SESSION_TOKEN"
        aws_primary iam delete-role --role-name "$STS_TEST_EXPIRY_ROLE_NAME"
        unregister_created_role "$STS_TEST_EXPIRY_ROLE_NAME"
        wait_for_session_invalid \
            same-account-expiry-role-liveness-control-after-delete \
            "$expiry_liveness_access_key" \
            "$expiry_liveness_secret_key" \
            "$expiry_liveness_session_token"
    fi
}

assert_identity_decision() {
    local label="$1"
    local aws_command="$2"
    local caller_arn="$3"
    local role_arn="$4"
    local expected_decision="$5"
    local actual_decision simulation

    simulation="$tmpdir/${label}-identity-simulation.json"
    "$aws_command" iam simulate-principal-policy \
        --policy-source-arn "$caller_arn" \
        --action-names sts:AssumeRole \
        --resource-arns "$role_arn" \
        --output json >"$simulation"
    [[ "$(jq -er '.EvaluationResults | length' "$simulation")" == 1 ]] || \
        external_s3_test_die "$label identity-policy simulation returned an unexpected result count"
    [[ "$(jq -er '.EvaluationResults[0].EvalActionName' "$simulation")" == "sts:AssumeRole" ]] || \
        external_s3_test_die "$label identity-policy simulation returned an unexpected action"
    [[ "$(jq -er '.EvaluationResults[0].EvalResourceName' "$simulation")" == "$role_arn" ]] || \
        external_s3_test_die "$label identity-policy simulation returned an unexpected resource"
    actual_decision="$(jq -er '.EvaluationResults[0].EvalDecision' "$simulation")"
    [[ "$actual_decision" == "$expected_decision" ]] || \
        external_s3_test_die \
            "$label requires $expected_decision from caller identity policies, got $actual_decision"
    echo "$label-identity-policy-$expected_decision: ok"
}

create_cross_account_role_fixtures() {
    local alt_identity alt_arn primary_identity primary_account primary_arn role_suffix trust_alt trust_alt_and_primary trust_primary trust_wildcard
    primary_identity="$(aws_primary sts get-caller-identity --output json)"
    primary_account="$(jq -er '.Account' <<<"$primary_identity")"
    primary_arn="$(jq -er '.Arn' <<<"$primary_identity")"
    alt_identity="$(aws_alt sts get-caller-identity --output json)"
    alt_arn="$(jq -er '.Arn' <<<"$alt_identity")"
    [[ "$(jq -er '.Account' <<<"$alt_identity")" == "$TEST_AWS_ALT_ACCOUNT_ID" ]] || \
        external_s3_test_die "alternate credential account does not match TEST_AWS_ALT_ACCOUNT_ID"
    [[ "$TEST_AWS_ALT_ACCOUNT_ID" != "$primary_account" ]] || \
        external_s3_test_die "cross-account STS oracle requires a genuinely different alternate account"
    [[ "$alt_arn" == "arn:aws:iam::${TEST_AWS_ALT_ACCOUNT_ID}:user/"* ]] || \
        external_s3_test_die "alternate credentials do not identify an IAM user"

    role_suffix="${tmpdir##*/}"
    role_suffix="${role_suffix#tmp.}"
    export STS_TEST_ALT_ACCESS_KEY="$TEST_AWS_ALT_ACCESS_KEY"
    export STS_TEST_ALT_SECRET_KEY="$TEST_AWS_ALT_SECRET_KEY"
    export STS_TEST_ALT_ARN="$alt_arn"
    export STS_TEST_CROSS_SESSION_NAME="cross-account-session"
    export STS_TEST_CROSS_SUCCESS_ROLE_NAME="cross-success-${role_suffix}"
    export STS_TEST_CROSS_SUCCESS_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/cross-account/${STS_TEST_CROSS_SUCCESS_ROLE_NAME}"
    export STS_TEST_CROSS_TRUST_DENIED_ROLE_NAME="cross-trust-denied-${role_suffix}"
    export STS_TEST_CROSS_TRUST_DENIED_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/cross-account/${STS_TEST_CROSS_TRUST_DENIED_ROLE_NAME}"
    export STS_TEST_CROSS_CALLER_DENIED_ROLE_NAME="cross-caller-denied-${role_suffix}"
    export STS_TEST_CROSS_CALLER_DENIED_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/caller-denied/${STS_TEST_CROSS_CALLER_DENIED_ROLE_NAME}"
    export STS_TEST_CROSS_WILDCARD_SUCCESS_ROLE_NAME="cross-wildcard-success-${role_suffix}"
    export STS_TEST_CROSS_WILDCARD_SUCCESS_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/cross-account/${STS_TEST_CROSS_WILDCARD_SUCCESS_ROLE_NAME}"
    export STS_TEST_CROSS_WILDCARD_CALLER_DENIED_ROLE_NAME="cross-wildcard-caller-denied-${role_suffix}"
    export STS_TEST_CROSS_WILDCARD_CALLER_DENIED_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/caller-denied/${STS_TEST_CROSS_WILDCARD_CALLER_DENIED_ROLE_NAME}"

    assert_identity_decision \
        cross-success \
        aws_alt \
        "$alt_arn" \
        "$STS_TEST_CROSS_SUCCESS_ROLE_ARN" \
        allowed
    assert_identity_decision \
        cross-trust-denied \
        aws_alt \
        "$alt_arn" \
        "$STS_TEST_CROSS_TRUST_DENIED_ROLE_ARN" \
        allowed
    assert_identity_decision \
        cross-caller-denied \
        aws_alt \
        "$alt_arn" \
        "$STS_TEST_CROSS_CALLER_DENIED_ROLE_ARN" \
        implicitDeny
    assert_identity_decision \
        cross-caller-denied-primary-control \
        aws_primary \
        "$primary_arn" \
        "$STS_TEST_CROSS_CALLER_DENIED_ROLE_ARN" \
        implicitDeny
    assert_identity_decision \
        cross-wildcard-success \
        aws_alt \
        "$alt_arn" \
        "$STS_TEST_CROSS_WILDCARD_SUCCESS_ROLE_ARN" \
        allowed
    assert_identity_decision \
        cross-wildcard-caller-denied \
        aws_alt \
        "$alt_arn" \
        "$STS_TEST_CROSS_WILDCARD_CALLER_DENIED_ROLE_ARN" \
        implicitDeny
    assert_identity_decision \
        cross-wildcard-caller-denied-primary-control \
        aws_primary \
        "$primary_arn" \
        "$STS_TEST_CROSS_WILDCARD_CALLER_DENIED_ROLE_ARN" \
        implicitDeny

    trust_alt="$tmpdir/cross-trust-alt.json"
    trust_alt_and_primary="$tmpdir/cross-trust-alt-and-primary.json"
    trust_primary="$tmpdir/cross-trust-primary.json"
    trust_wildcard="$tmpdir/cross-trust-wildcard.json"
    jq -n --arg principal "$alt_arn" '{
        Version: "2012-10-17",
        Statement: [{Effect: "Allow", Principal: {AWS: $principal}, Action: "sts:AssumeRole"}]
    }' >"$trust_alt"
    jq -n --arg principal "$primary_arn" '{
        Version: "2012-10-17",
        Statement: [{Effect: "Allow", Principal: {AWS: $principal}, Action: "sts:AssumeRole"}]
    }' >"$trust_primary"
    jq -n --arg alt_principal "$alt_arn" --arg primary_principal "$primary_arn" '{
        Version: "2012-10-17",
        Statement: [{
            Effect: "Allow",
            Principal: {AWS: [$alt_principal, $primary_principal]},
            Action: "sts:AssumeRole"
        }]
    }' >"$trust_alt_and_primary"
    jq -n '{
        Version: "2012-10-17",
        Statement: [{Effect: "Allow", Principal: {AWS: "*"}, Action: "sts:AssumeRole"}]
    }' >"$trust_wildcard"

    create_scoped_role \
        "$STS_TEST_CROSS_SUCCESS_ROLE_NAME" \
        /argmin-sts-oracle/cross-account/ \
        "$trust_alt" \
        "$STS_TEST_CROSS_SUCCESS_ROLE_ARN"
    create_scoped_role \
        "$STS_TEST_CROSS_TRUST_DENIED_ROLE_NAME" \
        /argmin-sts-oracle/cross-account/ \
        "$trust_alt" \
        "$STS_TEST_CROSS_TRUST_DENIED_ROLE_ARN"
    create_scoped_role \
        "$STS_TEST_CROSS_CALLER_DENIED_ROLE_NAME" \
        /argmin-sts-oracle/caller-denied/ \
        "$trust_alt_and_primary" \
        "$STS_TEST_CROSS_CALLER_DENIED_ROLE_ARN"
    create_scoped_role \
        "$STS_TEST_CROSS_WILDCARD_SUCCESS_ROLE_NAME" \
        /argmin-sts-oracle/cross-account/ \
        "$trust_wildcard" \
        "$STS_TEST_CROSS_WILDCARD_SUCCESS_ROLE_ARN"
    create_scoped_role \
        "$STS_TEST_CROSS_WILDCARD_CALLER_DENIED_ROLE_NAME" \
        /argmin-sts-oracle/caller-denied/ \
        "$trust_wildcard" \
        "$STS_TEST_CROSS_WILDCARD_CALLER_DENIED_ROLE_ARN"

    wait_for_assume_role_success \
        cross-account-success-role \
        aws_alt \
        "$STS_TEST_CROSS_SUCCESS_ROLE_ARN"
    wait_for_assume_role_success \
        cross-account-trust-denied-positive-control \
        aws_alt \
        "$STS_TEST_CROSS_TRUST_DENIED_ROLE_ARN"
    wait_for_assume_role_success \
        cross-account-caller-denied-positive-control \
        aws_primary \
        "$STS_TEST_CROSS_CALLER_DENIED_ROLE_ARN"
    wait_for_assume_role_success \
        cross-account-wildcard-success-role \
        aws_alt \
        "$STS_TEST_CROSS_WILDCARD_SUCCESS_ROLE_ARN"
    wait_for_assume_role_success \
        cross-account-wildcard-caller-denied-positive-control \
        aws_primary \
        "$STS_TEST_CROSS_WILDCARD_CALLER_DENIED_ROLE_ARN"

    aws_primary iam update-assume-role-policy \
        --role-name "$STS_TEST_CROSS_TRUST_DENIED_ROLE_NAME" \
        --policy-document "file://${trust_primary}"
    wait_for_assume_role_denied \
        cross-account-trust-denied-role \
        aws_alt \
        "$STS_TEST_CROSS_TRUST_DENIED_ROLE_ARN"
}

create_disabled_credential_fixture() {
    local access_key_fixture expected_user_arn primary_account role_suffix user_fixture
    primary_account="$TEST_AWS_PRIMARY_ACCOUNT_ID"
    role_suffix="${tmpdir##*/}"
    role_suffix="${role_suffix#tmp.}"
    role_suffix="${role_suffix,,}"
    export STS_TEST_DISABLED_USER_NAME="disabled-credential-${role_suffix}"
    expected_user_arn="arn:aws:iam::${primary_account}:user/argmin-sts-oracle/${STS_TEST_DISABLED_USER_NAME}"

    user_fixture="$tmpdir/disabled-credential-user.json"
    aws_primary iam create-user \
        --user-name "$STS_TEST_DISABLED_USER_NAME" \
        --path /argmin-sts-oracle/ \
        --output json >"$user_fixture"
    created_disabled_user="$STS_TEST_DISABLED_USER_NAME"
    export STS_TEST_DISABLED_USER_ARN
    STS_TEST_DISABLED_USER_ARN="$(jq -er '.User.Arn' "$user_fixture")"
    [[ "$STS_TEST_DISABLED_USER_ARN" == "$expected_user_arn" ]] || \
        external_s3_test_die "temporary disabled-credential user has an unexpected ARN"

    access_key_fixture="$tmpdir/disabled-credential-access-key.json"
    aws_primary iam create-access-key \
        --user-name "$STS_TEST_DISABLED_USER_NAME" \
        --output json >"$access_key_fixture"
    export STS_TEST_DISABLED_ACCESS_KEY STS_TEST_DISABLED_SECRET_KEY
    STS_TEST_DISABLED_ACCESS_KEY="$(jq -er '.AccessKey.AccessKeyId' "$access_key_fixture")"
    STS_TEST_DISABLED_SECRET_KEY="$(jq -er '.AccessKey.SecretAccessKey' "$access_key_fixture")"
    created_disabled_access_key="$STS_TEST_DISABLED_ACCESS_KEY"
    [[ "$(jq -er '.AccessKey.Status' "$access_key_fixture")" == Active ]] || \
        external_s3_test_die "temporary disabled-credential access key was not created active"
    echo "disabled-credential-user-fixture: ok"

    local -a active_cmd=(cargo run -p sts-tests --bin sts_oracle)
    external_s3_test_print_command "AWS disabled-credential active controls" "${active_cmd[@]}"
    STS_TEST_DISABLED_CREDENTIAL_STAGE=active "${active_cmd[@]}"

    aws_primary iam update-access-key \
        --user-name "$STS_TEST_DISABLED_USER_NAME" \
        --access-key-id "$STS_TEST_DISABLED_ACCESS_KEY" \
        --status Inactive
    export STS_TEST_DISABLED_CREDENTIAL_STAGE=inactive
    echo "disabled-credential-access-key-inactive: ok"
}

if [[ "$assume_role" == true ]]; then
    trap cleanup_assume_role_fixture EXIT
    create_assume_role_fixture
fi
if [[ "$cross_account" == true ]]; then
    create_cross_account_role_fixtures
fi
if [[ "$disabled_credential" == true ]]; then
    create_disabled_credential_fixture
fi

cmd=(cargo run -p sts-tests --bin sts_oracle)
external_s3_test_print_command "AWS STS oracle" "${cmd[@]}"
"${cmd[@]}"
