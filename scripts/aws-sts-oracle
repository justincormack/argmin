        "$STS_TEST_SOURCE_IDENTITY"
    wait_for_source_identity_assume_role_success \
        same-account-source-identity-condition-role \
        "$STS_TEST_SOURCE_IDENTITY_CONDITION_ROLE_ARN" \
        "$STS_TEST_SOURCE_IDENTITY"

    source_identity_session="$(aws_primary sts assume-role \
        --role-arn "$STS_TEST_SOURCE_IDENTITY_ROLE_ARN" \
