#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/_external-s3-test-env.sh
source "$ROOT/scripts/_external-s3-test-env.sh"

usage() {
    cat <<'EOF'
Usage: ./scripts/aws-sts-oracle [options]

Run the AWS STS Query protocol oracle using the primary credentials from
`.env`. The default probes are read-only. `--assume-role` creates and removes a
temporary path-bearing role using the primary test user.

Options:
  --assume-role     Include the self-cleaning same-account role probes
  --cross-account   Also include cross-account success and denial probes
  --region REGION   Override the STS signing region (default: TEST_S3_REGION or us-east-1)
  --endpoint URL    Override the regional STS endpoint
  --dotenv PATH     Read AWS variables from a different env file
  -h, --help        Show this help

Examples:
  ./scripts/aws-sts-oracle
  ./scripts/aws-sts-oracle --assume-role
  ./scripts/aws-sts-oracle --cross-account
EOF
}

assume_role=false
cross_account=false
region=""
endpoint=""
dotenv_path="$ROOT/.env"

while (($#)); do
    case "$1" in
        --assume-role)
            assume_role=true
            shift
            ;;
        --cross-account)
            assume_role=true
            cross_account=true
            shift
            ;;
        --region)
            [[ $# -ge 2 ]] || external_s3_test_die "--region requires a value"
            region="$2"
            shift 2
            ;;
        --endpoint)
            [[ $# -ge 2 ]] || external_s3_test_die "--endpoint requires a value"
            endpoint="$2"
            shift 2
            ;;
        --dotenv)
            [[ $# -ge 2 ]] || external_s3_test_die "--dotenv requires a value"
            dotenv_path="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            external_s3_test_die "unknown argument: $1"
            ;;
    esac
done

cd "$ROOT"
external_s3_test_load_dotenv "$dotenv_path"
external_s3_test_require_shell_var TEST_AWS_PRIMARY_ACCESS_KEY
external_s3_test_require_shell_var TEST_AWS_PRIMARY_SECRET_KEY
external_s3_test_require_shell_var TEST_AWS_PRIMARY_ACCOUNT_ID
if [[ "$cross_account" == true ]]; then
    external_s3_test_require_shell_var TEST_AWS_ALT_ACCESS_KEY
    external_s3_test_require_shell_var TEST_AWS_ALT_SECRET_KEY
    external_s3_test_require_shell_var TEST_AWS_ALT_ACCOUNT_ID
fi

region="${region:-${TEST_S3_REGION:-us-east-1}}"
endpoint="${endpoint:-https://sts.${region}.amazonaws.com}"
endpoint="${endpoint%/}"

export S3_TEST_ACCESS_KEY="$TEST_AWS_PRIMARY_ACCESS_KEY"
export S3_TEST_SECRET_KEY="$TEST_AWS_PRIMARY_SECRET_KEY"
export S3_TEST_ACCOUNT_ID="$TEST_AWS_PRIMARY_ACCOUNT_ID"
export S3_TEST_REGION="$region"
export S3_TEST_STS_ENDPOINT="$endpoint"
export S3_TEST_TIMEOUT_SECS="${TEST_S3_TIMEOUT_SECS:-120}"

aws_with_optional_session_credentials() {
    local access_key="$1"
    local secret_key="$2"
    local session_token="$3"
    shift 3

    (
        unset AWS_PROFILE
        export AWS_ACCESS_KEY_ID="$access_key"
        export AWS_SECRET_ACCESS_KEY="$secret_key"
        if [[ -n "$session_token" ]]; then
            export AWS_SESSION_TOKEN="$session_token"
        else
            unset AWS_SESSION_TOKEN
        fi
        export AWS_DEFAULT_REGION="$region"
        export AWS_REGION="$region"
        export AWS_PAGER=""
        aws "$@"
    )
}

aws_primary() {
    aws_with_optional_session_credentials \
        "$TEST_AWS_PRIMARY_ACCESS_KEY" \
        "$TEST_AWS_PRIMARY_SECRET_KEY" \
        "" \
        "$@"
}

aws_alt() {
    aws_with_optional_session_credentials \
        "$TEST_AWS_ALT_ACCESS_KEY" \
        "$TEST_AWS_ALT_SECRET_KEY" \
        "" \
        "$@"
}

aws_with_session_credentials() {
    local access_key="$1"
    local secret_key="$2"
    local session_token="$3"
    shift 3

    aws_with_optional_session_credentials \
        "$access_key" \
        "$secret_key" \
        "$session_token" \
        "$@"
}

aws_chaining_source() {
    aws_with_session_credentials \
        "$S3_TEST_STS_CHAIN_ACCESS_KEY" \
        "$S3_TEST_STS_CHAIN_SECRET_KEY" \
        "$S3_TEST_STS_CHAIN_SESSION_TOKEN" \
        "$@"
}

wait_for_assume_role_success() {
    local label="$1"
    local aws_command="$2"
    local role_arn="$3"
    local attempt ready=false

    for ((attempt = 1; attempt <= 15; attempt++)); do
        if "$aws_command" sts assume-role \
            --role-arn "$role_arn" \
            --role-session-name convergence-check >/dev/null 2>&1; then
            ready=true
            break
        fi
        sleep 2
    done
    [[ "$ready" == true ]] || external_s3_test_die "$label did not converge to STS success"
    echo "$label-sts-success: ok"
}

wait_for_assume_role_denied() {
    local label="$1"
    local aws_command="$2"
    local role_arn="$3"
    local attempt error_file ready=false

    error_file="$tmpdir/${label}-convergence.err"
    for ((attempt = 1; attempt <= 15; attempt++)); do
        if "$aws_command" sts assume-role \
            --role-arn "$role_arn" \
            --role-session-name convergence-check >/dev/null 2>"$error_file"; then
            :
        elif grep -Fq \
            'An error occurred (AccessDenied) when calling the AssumeRole operation:' \
            "$error_file"; then
            ready=true
            break
        fi
        sleep 2
    done
    if [[ "$ready" != true ]]; then
        cat "$error_file" >&2
        external_s3_test_die "$label did not converge to STS AccessDenied"
    fi
    echo "$label-sts-access-denied: ok"
}

declare -a created_role_names=()
tmpdir=""

cleanup_role_fixture() {
    local status=$?
    trap - EXIT

    local role_name
    for role_name in "${created_role_names[@]}"; do
        if ! aws_primary iam delete-role --role-name "$role_name"; then
            echo "error: failed to delete temporary STS oracle role $role_name" >&2
            ((status != 0)) || status=1
        fi
    done
    if [[ -n "$tmpdir" ]]; then
        rm -rf "$tmpdir"
    fi
    exit "$status"
}

create_scoped_role() {
    local role_name="$1"
    local role_path="$2"
    local trust_policy="$3"
    local expected_arn="$4"
    local max_session_duration="${5:-}"
    local retry_invalid_principal="${6:-false}"
    local attempt create_error created_arn role_created=false
    local -a create_args=(
        --role-name "$role_name"
        --path "$role_path"
        --assume-role-policy-document "file://${trust_policy}"
    )

    if [[ -n "$max_session_duration" ]]; then
        create_args+=(--max-session-duration "$max_session_duration")
    fi

    create_error="$tmpdir/create-${role_name}.err"
    for ((attempt = 1; attempt <= 15; attempt++)); do
        if created_arn="$(aws_primary iam create-role \
            "${create_args[@]}" \
            --query 'Role.Arn' \
            --output text 2>"$create_error")"; then
            role_created=true
            break
        fi
        if [[ "$retry_invalid_principal" == true ]] && \
            grep -Fq 'An error occurred (MalformedPolicyDocument)' "$create_error" && \
            grep -Fq 'Invalid principal in policy' "$create_error"; then
            sleep 2
            continue
        fi
        cat "$create_error" >&2
        external_s3_test_die "could not create temporary STS oracle role $expected_arn"
    done
    if [[ "$role_created" != true ]]; then
        cat "$create_error" >&2
        external_s3_test_die \
            "temporary STS oracle role principal did not converge for $expected_arn"
    fi
    created_role_names+=("$role_name")
    [[ "$created_arn" == "$expected_arn" ]] || \
        external_s3_test_die "CreateRole returned an unexpected role ARN"
    aws_primary iam wait role-exists --role-name "$role_name"
}

create_role_fixture() {
    command -v aws >/dev/null || external_s3_test_die "aws CLI is required for --assume-role"
    command -v jq >/dev/null || external_s3_test_die "jq is required for --assume-role"

    local chain_source_identity chain_source_session chain_target_max_duration default_max_duration identity_decision identity_simulation missing_role_error primary_identity primary_account primary_arn role_suffix trust_chain_source trust_default_max trust_policy
    primary_identity="$(aws_primary sts get-caller-identity --output json)"
    primary_account="$(jq -er '.Account' <<<"$primary_identity")"
    primary_arn="$(jq -er '.Arn' <<<"$primary_identity")"
    [[ "$primary_account" == "$TEST_AWS_PRIMARY_ACCOUNT_ID" ]] || \
        external_s3_test_die \
            "primary credential account $primary_account does not match TEST_AWS_PRIMARY_ACCOUNT_ID"
    [[ "$primary_arn" == "arn:aws:iam::${primary_account}:user/"* ]] || \
        external_s3_test_die "primary credentials do not identify an IAM user"
    export S3_TEST_STS_PRIMARY_ARN="$primary_arn"

    tmpdir="$(mktemp -d)"
    role_suffix="${tmpdir##*/}"
    role_suffix="${role_suffix#tmp.}"
    export S3_TEST_STS_ROLE_NAME="path-shape-${role_suffix}"
    export S3_TEST_STS_ROLE_SESSION_NAME="path-shape-session"
    export S3_TEST_STS_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/same-account/${S3_TEST_STS_ROLE_NAME}"
    export S3_TEST_STS_DEFAULT_MAX_ROLE_NAME="default-max-${role_suffix}"
    export S3_TEST_STS_DEFAULT_MAX_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/same-account/${S3_TEST_STS_DEFAULT_MAX_ROLE_NAME}"
    export S3_TEST_STS_CHAIN_SOURCE_SESSION_NAME="chaining-source"
    export S3_TEST_STS_CHAIN_TARGET_SESSION_NAME="chaining-target"
    export S3_TEST_STS_CHAIN_TARGET_ROLE_NAME="chain-target-${role_suffix}"
    export S3_TEST_STS_CHAIN_TARGET_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/same-account/${S3_TEST_STS_CHAIN_TARGET_ROLE_NAME}"

    trust_policy="$tmpdir/trust-policy.json"
    jq -n --arg principal "$primary_arn" '{
        Version: "2012-10-17",
        Statement: [{
            Effect: "Allow",
            Principal: {AWS: $principal},
            Action: "sts:AssumeRole"
        }]
    }' >"$trust_policy"

    identity_simulation="$tmpdir/identity-simulation.json"
    aws_primary iam simulate-principal-policy \
        --policy-source-arn "$primary_arn" \
        --action-names sts:AssumeRole \
        --resource-arns "$S3_TEST_STS_ROLE_ARN" \
        --output json >"$identity_simulation"
    [[ "$(jq -er '.EvaluationResults | length' "$identity_simulation")" == 1 ]] || \
        external_s3_test_die "same-account identity-policy simulation returned an unexpected result count"
    [[ "$(jq -er '.EvaluationResults[0].EvalActionName' "$identity_simulation")" == "sts:AssumeRole" ]] || \
        external_s3_test_die "same-account identity-policy simulation returned an unexpected action"
    [[ "$(jq -er '.EvaluationResults[0].EvalResourceName' "$identity_simulation")" == "$S3_TEST_STS_ROLE_ARN" ]] || \
        external_s3_test_die "same-account identity-policy simulation returned an unexpected resource"
    identity_decision="$(jq -er '.EvaluationResults[0].EvalDecision' "$identity_simulation")"
    [[ "$identity_decision" == "implicitDeny" ]] || \
        external_s3_test_die \
            "same-account role requires implicitDeny from caller identity policies, got $identity_decision"
    echo "same-account-identity-policy-implicit-deny: ok"

    missing_role_error="$tmpdir/get-missing-role.err"
    if aws_primary iam get-role \
        --role-name "$S3_TEST_STS_ROLE_NAME" \
        --query 'Role.Arn' \
        --output text >/dev/null 2>"$missing_role_error"; then
        external_s3_test_die \
            "unique temporary STS oracle role unexpectedly exists before creation"
    fi
    if ! grep -Fq \
        'An error occurred (AccessDenied) when calling the GetRole operation:' \
        "$missing_role_error"; then
        cat "$missing_role_error" >&2
        external_s3_test_die \
            "missing path-scoped role did not produce the expected GetRole AccessDenied"
    fi
    echo "missing-path-role-get-access-denied: ok"

    create_scoped_role \
        "$S3_TEST_STS_ROLE_NAME" \
        /argmin-sts-oracle/same-account/ \
        "$trust_policy" \
        "$S3_TEST_STS_ROLE_ARN" \
        43200

    assert_identity_decision \
        same-account-default-max \
        aws_primary \
        "$primary_arn" \
        "$S3_TEST_STS_DEFAULT_MAX_ROLE_ARN" \
        implicitDeny
    trust_default_max="$tmpdir/trust-default-max.json"
    jq -n \
        --arg primary_principal "$primary_arn" \
        --arg source_role_principal "$S3_TEST_STS_ROLE_ARN" \
        '{
            Version: "2012-10-17",
            Statement: [{
                Effect: "Allow",
                Principal: {AWS: [$primary_principal, $source_role_principal]},
                Action: "sts:AssumeRole"
            }]
        }' >"$trust_default_max"
    create_scoped_role \
        "$S3_TEST_STS_DEFAULT_MAX_ROLE_NAME" \
        /argmin-sts-oracle/same-account/ \
        "$trust_default_max" \
        "$S3_TEST_STS_DEFAULT_MAX_ROLE_ARN" \
        "" \
        true
    default_max_duration="$(aws_primary iam get-role \
        --role-name "$S3_TEST_STS_DEFAULT_MAX_ROLE_NAME" \
        --query 'Role.MaxSessionDuration' \
        --output text)"
    [[ "$default_max_duration" == 3600 ]] || \
        external_s3_test_die \
            "temporary STS oracle role has unexpected default maximum session duration $default_max_duration"
    echo "same-account-default-max-duration: ok"

    trust_chain_source="$tmpdir/trust-chain-source.json"
    jq -n --arg principal "$S3_TEST_STS_ROLE_ARN" '{
        Version: "2012-10-17",
        Statement: [{
            Effect: "Allow",
            Principal: {AWS: $principal},
            Action: "sts:AssumeRole"
        }]
    }' >"$trust_chain_source"
    assert_identity_decision \
        same-account-chain-target \
        aws_primary \
        "$primary_arn" \
        "$S3_TEST_STS_CHAIN_TARGET_ROLE_ARN" \
        implicitDeny
    create_scoped_role \
        "$S3_TEST_STS_CHAIN_TARGET_ROLE_NAME" \
        /argmin-sts-oracle/same-account/ \
        "$trust_chain_source" \
        "$S3_TEST_STS_CHAIN_TARGET_ROLE_ARN" \
        43200
    chain_target_max_duration="$(aws_primary iam get-role \
        --role-name "$S3_TEST_STS_CHAIN_TARGET_ROLE_NAME" \
        --query 'Role.MaxSessionDuration' \
        --output text)"
    [[ "$chain_target_max_duration" == 43200 ]] || \
        external_s3_test_die \
            "temporary STS chain target has unexpected maximum session duration $chain_target_max_duration"
    echo "same-account-chain-target-max-duration: ok"

    wait_for_assume_role_success \
        same-account-role \
        aws_primary \
        "$S3_TEST_STS_ROLE_ARN"
    wait_for_assume_role_success \
        same-account-default-max-role \
        aws_primary \
        "$S3_TEST_STS_DEFAULT_MAX_ROLE_ARN"

    chain_source_session="$(aws_primary sts assume-role \
        --role-arn "$S3_TEST_STS_ROLE_ARN" \
        --role-session-name "$S3_TEST_STS_CHAIN_SOURCE_SESSION_NAME" \
        --duration-seconds 3600 \
        --output json)"
    export S3_TEST_STS_CHAIN_ACCESS_KEY
    export S3_TEST_STS_CHAIN_SECRET_KEY
    export S3_TEST_STS_CHAIN_SESSION_TOKEN
    S3_TEST_STS_CHAIN_ACCESS_KEY="$(jq -er '.Credentials.AccessKeyId' <<<"$chain_source_session")"
    S3_TEST_STS_CHAIN_SECRET_KEY="$(jq -er '.Credentials.SecretAccessKey' <<<"$chain_source_session")"
    S3_TEST_STS_CHAIN_SESSION_TOKEN="$(jq -er '.Credentials.SessionToken' <<<"$chain_source_session")"
    chain_source_identity="$(aws_chaining_source sts get-caller-identity --output json)"
    [[ "$(jq -er '.Arn' <<<"$chain_source_identity")" == \
        "arn:aws:sts::${primary_account}:assumed-role/${S3_TEST_STS_ROLE_NAME}/${S3_TEST_STS_CHAIN_SOURCE_SESSION_NAME}" ]] || \
        external_s3_test_die "temporary STS chaining source has an unexpected caller ARN"
    echo "same-account-chain-source-identity: ok"
    wait_for_assume_role_success \
        same-account-chain-target \
        aws_chaining_source \
        "$S3_TEST_STS_CHAIN_TARGET_ROLE_ARN"
    wait_for_assume_role_success \
        same-account-chain-default-max-target \
        aws_chaining_source \
        "$S3_TEST_STS_DEFAULT_MAX_ROLE_ARN"
}

assert_identity_decision() {
    local label="$1"
    local aws_command="$2"
    local caller_arn="$3"
    local role_arn="$4"
    local expected_decision="$5"
    local actual_decision simulation

    simulation="$tmpdir/${label}-identity-simulation.json"
    "$aws_command" iam simulate-principal-policy \
        --policy-source-arn "$caller_arn" \
        --action-names sts:AssumeRole \
        --resource-arns "$role_arn" \
        --output json >"$simulation"
    [[ "$(jq -er '.EvaluationResults | length' "$simulation")" == 1 ]] || \
        external_s3_test_die "$label identity-policy simulation returned an unexpected result count"
    [[ "$(jq -er '.EvaluationResults[0].EvalActionName' "$simulation")" == "sts:AssumeRole" ]] || \
        external_s3_test_die "$label identity-policy simulation returned an unexpected action"
    [[ "$(jq -er '.EvaluationResults[0].EvalResourceName' "$simulation")" == "$role_arn" ]] || \
        external_s3_test_die "$label identity-policy simulation returned an unexpected resource"
    actual_decision="$(jq -er '.EvaluationResults[0].EvalDecision' "$simulation")"
    [[ "$actual_decision" == "$expected_decision" ]] || \
        external_s3_test_die \
            "$label requires $expected_decision from caller identity policies, got $actual_decision"
    echo "$label-identity-policy-$expected_decision: ok"
}

create_cross_account_role_fixtures() {
    local alt_identity alt_arn primary_identity primary_account primary_arn role_suffix trust_alt trust_alt_and_primary trust_primary
    primary_identity="$(aws_primary sts get-caller-identity --output json)"
    primary_account="$(jq -er '.Account' <<<"$primary_identity")"
    primary_arn="$(jq -er '.Arn' <<<"$primary_identity")"
    alt_identity="$(aws_alt sts get-caller-identity --output json)"
    alt_arn="$(jq -er '.Arn' <<<"$alt_identity")"
    [[ "$(jq -er '.Account' <<<"$alt_identity")" == "$TEST_AWS_ALT_ACCOUNT_ID" ]] || \
        external_s3_test_die "alternate credential account does not match TEST_AWS_ALT_ACCOUNT_ID"
    [[ "$TEST_AWS_ALT_ACCOUNT_ID" != "$primary_account" ]] || \
        external_s3_test_die "cross-account STS oracle requires a genuinely different alternate account"
    [[ "$alt_arn" == "arn:aws:iam::${TEST_AWS_ALT_ACCOUNT_ID}:user/"* ]] || \
        external_s3_test_die "alternate credentials do not identify an IAM user"

    role_suffix="${tmpdir##*/}"
    role_suffix="${role_suffix#tmp.}"
    export S3_TEST_STS_ALT_ACCESS_KEY="$TEST_AWS_ALT_ACCESS_KEY"
    export S3_TEST_STS_ALT_SECRET_KEY="$TEST_AWS_ALT_SECRET_KEY"
    export S3_TEST_STS_ALT_ARN="$alt_arn"
    export S3_TEST_STS_CROSS_SESSION_NAME="cross-account-session"
    export S3_TEST_STS_CROSS_SUCCESS_ROLE_NAME="cross-success-${role_suffix}"
    export S3_TEST_STS_CROSS_SUCCESS_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/cross-account/${S3_TEST_STS_CROSS_SUCCESS_ROLE_NAME}"
    export S3_TEST_STS_CROSS_TRUST_DENIED_ROLE_NAME="cross-trust-denied-${role_suffix}"
    export S3_TEST_STS_CROSS_TRUST_DENIED_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/cross-account/${S3_TEST_STS_CROSS_TRUST_DENIED_ROLE_NAME}"
    export S3_TEST_STS_CROSS_CALLER_DENIED_ROLE_NAME="cross-caller-denied-${role_suffix}"
    export S3_TEST_STS_CROSS_CALLER_DENIED_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/caller-denied/${S3_TEST_STS_CROSS_CALLER_DENIED_ROLE_NAME}"

    assert_identity_decision \
        cross-success \
        aws_alt \
        "$alt_arn" \
        "$S3_TEST_STS_CROSS_SUCCESS_ROLE_ARN" \
        allowed
    assert_identity_decision \
        cross-trust-denied \
        aws_alt \
        "$alt_arn" \
        "$S3_TEST_STS_CROSS_TRUST_DENIED_ROLE_ARN" \
        allowed
    assert_identity_decision \
        cross-caller-denied \
        aws_alt \
        "$alt_arn" \
        "$S3_TEST_STS_CROSS_CALLER_DENIED_ROLE_ARN" \
        implicitDeny
    assert_identity_decision \
        cross-caller-denied-primary-control \
        aws_primary \
        "$primary_arn" \
        "$S3_TEST_STS_CROSS_CALLER_DENIED_ROLE_ARN" \
        implicitDeny

    trust_alt="$tmpdir/cross-trust-alt.json"
    trust_alt_and_primary="$tmpdir/cross-trust-alt-and-primary.json"
    trust_primary="$tmpdir/cross-trust-primary.json"
    jq -n --arg principal "$alt_arn" '{
        Version: "2012-10-17",
        Statement: [{Effect: "Allow", Principal: {AWS: $principal}, Action: "sts:AssumeRole"}]
    }' >"$trust_alt"
    jq -n --arg principal "$primary_arn" '{
        Version: "2012-10-17",
        Statement: [{Effect: "Allow", Principal: {AWS: $principal}, Action: "sts:AssumeRole"}]
    }' >"$trust_primary"
    jq -n --arg alt_principal "$alt_arn" --arg primary_principal "$primary_arn" '{
        Version: "2012-10-17",
        Statement: [{
            Effect: "Allow",
            Principal: {AWS: [$alt_principal, $primary_principal]},
            Action: "sts:AssumeRole"
        }]
    }' >"$trust_alt_and_primary"

    create_scoped_role \
        "$S3_TEST_STS_CROSS_SUCCESS_ROLE_NAME" \
        /argmin-sts-oracle/cross-account/ \
        "$trust_alt" \
        "$S3_TEST_STS_CROSS_SUCCESS_ROLE_ARN"
    create_scoped_role \
        "$S3_TEST_STS_CROSS_TRUST_DENIED_ROLE_NAME" \
        /argmin-sts-oracle/cross-account/ \
        "$trust_alt" \
        "$S3_TEST_STS_CROSS_TRUST_DENIED_ROLE_ARN"
    create_scoped_role \
        "$S3_TEST_STS_CROSS_CALLER_DENIED_ROLE_NAME" \
        /argmin-sts-oracle/caller-denied/ \
        "$trust_alt_and_primary" \
        "$S3_TEST_STS_CROSS_CALLER_DENIED_ROLE_ARN"

    wait_for_assume_role_success \
        cross-account-success-role \
        aws_alt \
        "$S3_TEST_STS_CROSS_SUCCESS_ROLE_ARN"
    wait_for_assume_role_success \
        cross-account-trust-denied-positive-control \
        aws_alt \
        "$S3_TEST_STS_CROSS_TRUST_DENIED_ROLE_ARN"
    wait_for_assume_role_success \
        cross-account-caller-denied-positive-control \
        aws_primary \
        "$S3_TEST_STS_CROSS_CALLER_DENIED_ROLE_ARN"

    aws_primary iam update-assume-role-policy \
        --role-name "$S3_TEST_STS_CROSS_TRUST_DENIED_ROLE_NAME" \
        --policy-document "file://${trust_primary}"
    wait_for_assume_role_denied \
        cross-account-trust-denied-role \
        aws_alt \
        "$S3_TEST_STS_CROSS_TRUST_DENIED_ROLE_ARN"
}

if [[ "$assume_role" == true ]]; then
    trap cleanup_role_fixture EXIT
    create_role_fixture
fi
if [[ "$cross_account" == true ]]; then
    create_cross_account_role_fixtures
fi

cmd=(cargo run -p s3-tests --bin sts_oracle)
