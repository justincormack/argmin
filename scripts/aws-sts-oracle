    export STS_TEST_RECREATED_ROLE_SECRET_KEY
    export STS_TEST_RECREATED_ROLE_SESSION_TOKEN
    STS_TEST_RECREATED_ROLE_ACCESS_KEY="$(jq -er '.Credentials.AccessKeyId' <<<"$recreated_role_session")"
    STS_TEST_RECREATED_ROLE_SECRET_KEY="$(jq -er '.Credentials.SecretAccessKey' <<<"$recreated_role_session")"
    STS_TEST_RECREATED_ROLE_SESSION_TOKEN="$(jq -er '.Credentials.SessionToken' <<<"$recreated_role_session")"
    [[ "$(jq -er '.AssumedRoleUser.AssumedRoleId' <<<"$recreated_role_session")" == \
        "${recreated_role_stable_id}:${STS_TEST_RECREATED_ROLE_SESSION_NAME}" ]] || \
        external_s3_test_die "recreated-role session has an unexpected stable role ID"
    recreated_role_identity="$(aws_with_session_credentials \
