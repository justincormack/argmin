#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/_external-s3-test-env.sh
source "$ROOT/scripts/_external-s3-test-env.sh"

usage() {
    cat <<'EOF'
Usage: ./scripts/aws-sts-oracle [options]

Run the AWS STS Query protocol oracle using the primary credentials from
`.env`. The default probes are read-only. `--assume-role` creates and removes a
set of temporary path-bearing roles, one path-bearing IAM user, and one prefixed
S3 bucket using the primary test user.

Options:
  --assume-role     Include the self-cleaning same-account role probes
  --expiry          Include the 15-minute expiry/deleted-issuer probes
  --disabled-credential
                     Create and consume a real expired-token fixture for a
                     self-cleaning, permissionless IAM-user access-key
                     deactivation matrix; does not run the ordinary expiry suite
  --cross-account   Also include cross-account success and denial probes
  --region REGION   Override the STS signing region (default: TEST_S3_REGION or us-east-1)
  --endpoint URL    Override the regional STS endpoint
  --s3-control-endpoint URL
                     Override the regional S3 Control endpoint
  --timeout-secs SECS
                     Override the shared HTTP timeout (default: TEST_S3_TIMEOUT_SECS or 120)
  --dotenv PATH     Read AWS variables from a different env file
  -h, --help        Show this help

Examples:
  ./scripts/aws-sts-oracle
  ./scripts/aws-sts-oracle --assume-role
  ./scripts/aws-sts-oracle --expiry
  ./scripts/aws-sts-oracle --disabled-credential
  ./scripts/aws-sts-oracle --cross-account
EOF
}

require_https_endpoint() {
    local label="$1"
    local value="$2"
    [[ "$value" == https://?* ]] || \
        external_s3_test_die "$label oracle endpoint must use https://"
}

assume_role=false
cross_account=false
disabled_credential=false
expiry_collision=false
region=""
endpoint=""
s3_control_endpoint=""
timeout_secs=""
dotenv_path="$ROOT/.env"

while (($#)); do
    case "$1" in
        --assume-role)
            assume_role=true
            shift
            ;;
        --expiry)
            assume_role=true
            expiry_collision=true
            shift
            ;;
        --disabled-credential)
            assume_role=true
            expiry_collision=true
            disabled_credential=true
            shift
            ;;
        --cross-account)
            assume_role=true
            cross_account=true
            shift
            ;;
        --region)
            [[ $# -ge 2 ]] || external_s3_test_die "--region requires a value"
            region="$2"
            shift 2
            ;;
        --endpoint)
            [[ $# -ge 2 ]] || external_s3_test_die "--endpoint requires a value"
            endpoint="$2"
            require_https_endpoint STS "$endpoint"
            shift 2
            ;;
        --s3-control-endpoint)
            [[ $# -ge 2 ]] || \
                external_s3_test_die "--s3-control-endpoint requires a value"
            s3_control_endpoint="$2"
            require_https_endpoint "S3 Control" "$s3_control_endpoint"
            shift 2
            ;;
        --timeout-secs)
            [[ $# -ge 2 ]] || external_s3_test_die "--timeout-secs requires a value"
            timeout_secs="$2"
            shift 2
            ;;
        --dotenv)
            [[ $# -ge 2 ]] || external_s3_test_die "--dotenv requires a value"
            dotenv_path="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            external_s3_test_die "unknown argument: $1"
            ;;
    esac
done

cd "$ROOT"
external_s3_test_load_dotenv "$dotenv_path"
external_s3_test_require_shell_var TEST_AWS_PRIMARY_ACCESS_KEY
external_s3_test_require_shell_var TEST_AWS_PRIMARY_SECRET_KEY
external_s3_test_require_shell_var TEST_AWS_PRIMARY_ACCOUNT_ID
if [[ "$cross_account" == true ]]; then
    external_s3_test_require_shell_var TEST_AWS_ALT_ACCESS_KEY
    external_s3_test_require_shell_var TEST_AWS_ALT_SECRET_KEY
    external_s3_test_require_shell_var TEST_AWS_ALT_ACCOUNT_ID
fi

region="${region:-${TEST_S3_REGION:-us-east-1}}"
timeout_secs="${timeout_secs:-${TEST_S3_TIMEOUT_SECS:-120}}"
endpoint="${endpoint:-https://sts.${region}.amazonaws.com}"
endpoint="${endpoint%/}"
s3_control_endpoint="${s3_control_endpoint:-${TEST_S3_CONTROL_ENDPOINT:-https://${TEST_AWS_PRIMARY_ACCOUNT_ID}.s3-control.${region}.amazonaws.com}}"
s3_control_endpoint="${s3_control_endpoint%/}"
require_https_endpoint STS "$endpoint"
require_https_endpoint "S3 Control" "$s3_control_endpoint"

export AWS_TEST_ACCESS_KEY="$TEST_AWS_PRIMARY_ACCESS_KEY"
export AWS_TEST_SECRET_KEY="$TEST_AWS_PRIMARY_SECRET_KEY"
export AWS_TEST_ACCOUNT_ID="$TEST_AWS_PRIMARY_ACCOUNT_ID"
export AWS_TEST_REGION="$region"
export STS_TEST_ENDPOINT="$endpoint"
export S3_CONTROL_TEST_ENDPOINT="$s3_control_endpoint"
export S3_TEST_TIMEOUT_SECS="$timeout_secs"

aws_with_optional_session_credentials() {
    local access_key="$1"
    local secret_key="$2"
    local session_token="$3"
    shift 3

    (
        unset AWS_PROFILE
        export AWS_ACCESS_KEY_ID="$access_key"
        export AWS_SECRET_ACCESS_KEY="$secret_key"
        if [[ -n "$session_token" ]]; then
            export AWS_SESSION_TOKEN="$session_token"
        else
            unset AWS_SESSION_TOKEN
        fi
        export AWS_DEFAULT_REGION="$region"
        export AWS_REGION="$region"
        export AWS_PAGER=""
        aws "$@"
    )
}

aws_primary() {
    aws_with_optional_session_credentials \
        "$TEST_AWS_PRIMARY_ACCESS_KEY" \
        "$TEST_AWS_PRIMARY_SECRET_KEY" \
        "" \
        "$@"
}

aws_alt() {
    aws_with_optional_session_credentials \
        "$TEST_AWS_ALT_ACCESS_KEY" \
        "$TEST_AWS_ALT_SECRET_KEY" \
        "" \
        "$@"
}

aws_with_session_credentials() {
    local access_key="$1"
    local secret_key="$2"
    local session_token="$3"
    shift 3

    aws_with_optional_session_credentials \
        "$access_key" \
        "$secret_key" \
        "$session_token" \
        "$@"
}

aws_chaining_source() {
    aws_with_session_credentials \
        "$STS_TEST_CHAIN_ACCESS_KEY" \
        "$STS_TEST_CHAIN_SECRET_KEY" \
        "$STS_TEST_CHAIN_SESSION_TOKEN" \
        "$@"
}

aws_source_identity_session() {
    aws_with_session_credentials \
        "$STS_TEST_SOURCE_IDENTITY_ACCESS_KEY" \
        "$STS_TEST_SOURCE_IDENTITY_SECRET_KEY" \
        "$STS_TEST_SOURCE_IDENTITY_SESSION_TOKEN" \
        "$@"
}

aws_iam_user_context() {
    aws_with_optional_session_credentials \
        "$STS_TEST_IAM_USER_CONTEXT_ACCESS_KEY" \
        "$STS_TEST_IAM_USER_CONTEXT_SECRET_KEY" \
        "" \
        "$@"
}

aws_deleted_role_session() {
    aws_with_session_credentials \
        "$STS_TEST_DELETED_ROLE_ACCESS_KEY" \
        "$STS_TEST_DELETED_ROLE_SECRET_KEY" \
        "$STS_TEST_DELETED_ROLE_SESSION_TOKEN" \
        "$@"
}

wait_for_assume_role_success() {
    local label="$1"
    local aws_command="$2"
    local role_arn="$3"
    local attempt consecutive_successes=0 ready=false

    for ((attempt = 1; attempt <= 30; attempt++)); do
        if "$aws_command" sts assume-role \
            --role-arn "$role_arn" \
            --role-session-name convergence-check >/dev/null 2>&1; then
            ((consecutive_successes += 1))
            if ((consecutive_successes == 3)); then
                ready=true
                break
            fi
        else
            consecutive_successes=0
        fi
        sleep 2
    done
    [[ "$ready" == true ]] || external_s3_test_die "$label did not converge to STS success"
    echo "$label-sts-success: ok"
}

wait_for_external_id_assume_role_success() {
    local label="$1"
    local role_arn="$2"
    local external_id="$3"
    local attempt consecutive_successes=0 ready=false

    for ((attempt = 1; attempt <= 30; attempt++)); do
        if aws_primary sts assume-role \
            --role-arn "$role_arn" \
            --role-session-name convergence-check \
            --external-id "$external_id" >/dev/null 2>&1; then
            ((consecutive_successes += 1))
            if ((consecutive_successes == 3)); then
                ready=true
                break
            fi
        else
            consecutive_successes=0
        fi
        sleep 2
    done
    [[ "$ready" == true ]] || \
        external_s3_test_die "$label did not converge to STS success"
    echo "$label-sts-success: ok"
}

wait_for_source_identity_assume_role_success() {
    local label="$1"
    local role_arn="$2"
    local source_identity="$3"
    local attempt consecutive_successes=0 ready=false

    for ((attempt = 1; attempt <= 30; attempt++)); do
        if aws_primary sts assume-role \
            --role-arn "$role_arn" \
            --role-session-name convergence-check \
            --source-identity "$source_identity" >/dev/null 2>&1; then
            ((consecutive_successes += 1))
            if ((consecutive_successes == 3)); then
                ready=true
                break
            fi
        else
            consecutive_successes=0
        fi
        sleep 2
    done
    [[ "$ready" == true ]] || \
        external_s3_test_die "$label did not converge to STS success"
    echo "$label-sts-success: ok"
}

wait_for_assume_role_denied() {
    local label="$1"
    local aws_command="$2"
    local role_arn="$3"
    local attempt consecutive_denials=0 error_file ready=false

    error_file="$tmpdir/${label}-convergence.err"
    for ((attempt = 1; attempt <= 30; attempt++)); do
        if "$aws_command" sts assume-role \
            --role-arn "$role_arn" \
            --role-session-name convergence-check >/dev/null 2>"$error_file"; then
            consecutive_denials=0
        elif grep -Fq \
            'An error occurred (AccessDenied) when calling the AssumeRole operation:' \
            "$error_file"; then
            ((consecutive_denials += 1))
            if ((consecutive_denials == 3)); then
                ready=true
                break
            fi
        else
            consecutive_denials=0
        fi
        sleep 2
    done
    if [[ "$ready" != true ]]; then
        cat "$error_file" >&2
        external_s3_test_die "$label did not converge to STS AccessDenied"
    fi
    echo "$label-sts-access-denied: ok"
}

wait_for_deleted_role_session_invalid() {
    local label="$1"
    local attempt error_file ready=false

    error_file="$tmpdir/${label}-convergence.err"
    for ((attempt = 1; attempt <= 15; attempt++)); do
        if aws_deleted_role_session sts get-caller-identity >/dev/null 2>"$error_file"; then
            :
        elif grep -Fq \
            'An error occurred (InvalidClientTokenId) when calling the GetCallerIdentity operation:' \
            "$error_file"; then
            ready=true
            break
        fi
        sleep 2
    done
    if [[ "$ready" != true ]]; then
        cat "$error_file" >&2
        external_s3_test_die \
            "deleted-role session did not converge to STS InvalidClientTokenId"
    fi
    echo "$label-invalid: ok"
}

wait_for_session_expired() {
    local label="$1"
    local access_key="$2"
    local secret_key="$3"
    local session_token="$4"
    local attempt consecutive_expirations=0 error_file ready=false

    error_file="$tmpdir/${label}-convergence.err"
    for ((attempt = 1; attempt <= 190; attempt++)); do
        if aws_with_session_credentials \
            "$access_key" \
            "$secret_key" \
            "$session_token" \
            sts get-caller-identity >/dev/null 2>"$error_file"; then
            consecutive_expirations=0
        elif grep -Fq \
            'An error occurred (ExpiredToken) when calling the GetCallerIdentity operation:' \
            "$error_file"; then
            ((consecutive_expirations += 1))
            if ((consecutive_expirations == 3)); then
                ready=true
                break
            fi
        else
            consecutive_expirations=0
        fi
        sleep 5
    done
    if [[ "$ready" != true ]]; then
        cat "$error_file" >&2
        external_s3_test_die "$label did not converge to STS ExpiredToken"
    fi
    echo "$label-expired: ok"
}

wait_for_session_invalid() {
    local label="$1"
    local access_key="$2"
    local secret_key="$3"
    local session_token="$4"
    local attempt consecutive_invalid=0 error_file ready=false

    error_file="$tmpdir/${label}-convergence.err"
    for ((attempt = 1; attempt <= 30; attempt++)); do
        if aws_with_session_credentials \
            "$access_key" \
            "$secret_key" \
            "$session_token" \
            sts get-caller-identity >/dev/null 2>"$error_file"; then
            consecutive_invalid=0
        elif grep -Fq \
            'An error occurred (InvalidClientTokenId) when calling the GetCallerIdentity operation:' \
            "$error_file"; then
            ((consecutive_invalid += 1))
            if ((consecutive_invalid == 3)); then
                ready=true
                break
            fi
        else
            consecutive_invalid=0
        fi
        sleep 2
    done
    if [[ "$ready" != true ]]; then
        cat "$error_file" >&2
        external_s3_test_die "$label did not converge to STS InvalidClientTokenId"
    fi
    echo "$label-invalid: ok"
}

wait_for_streaming_bucket_policy_success() {
    local attempt empty_body error_file ready=false

    empty_body="$tmpdir/streaming-empty-body"
    error_file="$tmpdir/streaming-bucket-policy-convergence.err"
    : >"$empty_body"
    for ((attempt = 1; attempt <= 15; attempt++)); do
        if aws_with_session_credentials \
            "$STS_TEST_RECREATED_ROLE_ACCESS_KEY" \
            "$STS_TEST_RECREATED_ROLE_SECRET_KEY" \
            "$STS_TEST_RECREATED_ROLE_SESSION_TOKEN" \
            s3api put-object \
            --bucket "$STS_TEST_POST_BUCKET" \
            --key streaming-policy-convergence \
            --body "$empty_body" >/dev/null 2>"$error_file"; then
            ready=true
            break
        fi
        sleep 2
    done
    if [[ "$ready" != true ]]; then
        cat "$error_file" >&2
        external_s3_test_die "streaming bucket policy did not converge to PutObject success"
    fi
    echo "streaming-bucket-policy-success: ok"
}

wait_for_streaming_head_absence_success() {
    local attempt consecutive_not_found=0 error_file ready=false

    error_file="$tmpdir/streaming-head-absence-convergence.err"
    : >"$error_file"
    for ((attempt = 1; attempt <= 15; attempt++)); do
        if aws_primary s3api head-object \
            --bucket "$STS_TEST_POST_BUCKET" \
            --key streaming-presigned-head-absence-convergence \
            >/dev/null 2>"$error_file"; then
            consecutive_not_found=0
        elif grep -Fq \
            '(404) when calling the HeadObject operation' \
            "$error_file"; then
            ((consecutive_not_found += 1))
            if ((consecutive_not_found == 3)); then
                ready=true
                break
            fi
        else
            consecutive_not_found=0
        fi
        sleep 2
    done
    if [[ "$ready" != true ]]; then
        cat "$error_file" >&2
        external_s3_test_die "streaming bucket policy did not converge to HeadObject not found"
    fi
    echo "streaming-head-absence-success: ok"
}

wait_for_session_context_bucket_policy_success() {
    local attempt consecutive_successes=0 empty_body error_file key ready=false
    local -a keys=(
        context-role-principal
        context-session-principal
        context-principal-arn-role
        context-userid-match
        context-token-issue-after-lower
        context-token-issue-before-upper
        context-token-issue-deny-before-lower
    )

    empty_body="$tmpdir/session-context-empty-body"
    error_file="$tmpdir/session-context-bucket-policy-convergence.err"
    : >"$empty_body"
    for ((attempt = 1; attempt <= 30; attempt++)); do
        local all_succeeded=true
        for key in "${keys[@]}"; do
            if ! aws_with_session_credentials \
                "$STS_TEST_RECREATED_ROLE_ACCESS_KEY" \
                "$STS_TEST_RECREATED_ROLE_SECRET_KEY" \
                "$STS_TEST_RECREATED_ROLE_SESSION_TOKEN" \
                s3api put-object \
                --bucket "$STS_TEST_POST_BUCKET" \
                --key "$key" \
                --body "$empty_body" >/dev/null 2>"$error_file"; then
                all_succeeded=false
                break
            fi
        done
        if [[ "$all_succeeded" == true ]]; then
            ((consecutive_successes += 1))
            if ((consecutive_successes == 3)); then
                ready=true
                break
            fi
        else
            consecutive_successes=0
        fi
        sleep 2
    done
    if [[ "$ready" != true ]]; then
        cat "$error_file" >&2
        external_s3_test_die \
            "session-context bucket policy did not converge to PutObject success"
    fi
    echo "session-context-bucket-policy-success: ok"
}

wait_for_iam_user_context_bucket_policy_success() {
    local attempt consecutive_results=0 empty_body error_file ready=false

    empty_body="$tmpdir/iam-user-context-empty-body"
    error_file="$tmpdir/iam-user-context-bucket-policy-convergence.err"
    : >"$empty_body"
    for ((attempt = 1; attempt <= 30; attempt++)); do
        if aws_iam_user_context s3api put-object \
            --bucket "$STS_TEST_POST_BUCKET" \
            --key context-iam-user-principal-arn-allow \
            --body "$empty_body" >/dev/null 2>"$error_file" && \
            aws_iam_user_context s3api put-object \
                --bucket "$STS_TEST_POST_BUCKET" \
                --key context-iam-user-principal-arn-deny-mismatch \
                --body "$empty_body" >/dev/null 2>"$error_file" && \
            ! aws_iam_user_context s3api put-object \
                --bucket "$STS_TEST_POST_BUCKET" \
                --key context-iam-user-principal-arn-deny \
                --body "$empty_body" >/dev/null 2>"$error_file" && \
            grep -Fq \
                'An error occurred (AccessDenied) when calling the PutObject operation:' \
                "$error_file"; then
            ((consecutive_results += 1))
            if ((consecutive_results == 3)); then
                ready=true
                break
            fi
        else
            consecutive_results=0
        fi
        sleep 2
    done
    if [[ "$ready" != true ]]; then
        cat "$error_file" >&2
        external_s3_test_die \
            "IAM-user-context bucket policy did not converge to the expected results"
    fi
    echo "iam-user-context-bucket-policy-success: ok"
}

wait_for_list_tags_for_resource_success() {
    local label="$1"
    local account_id="$2"
    local resource_arn="$3"
    local attempt consecutive_successes=0 error_file ready=false response_file
    response_file="$tmpdir/${label}-list-tags.out"
    error_file="$tmpdir/${label}-list-tags.err"

    for ((attempt = 1; attempt <= 30; attempt++)); do
        if aws_primary s3control list-tags-for-resource \
            --account-id "$account_id" \
            --resource-arn "$resource_arn" \
            --output json >"$response_file" 2>"$error_file" && \
            jq -e \
                '.Tags == [{"Key":"routing-key","Value":"routing-value"}]' \
                "$response_file" >/dev/null; then
            ((consecutive_successes += 1))
            if ((consecutive_successes == 3)); then
                ready=true
                break
            fi
        else
            consecutive_successes=0
        fi
        sleep 2
    done
    if [[ "$ready" != true ]]; then
        if [[ -s "$response_file" ]]; then
            echo "$label ListTagsForResource last stdout:" >&2
            cat "$response_file" >&2
        fi
        if [[ -s "$error_file" ]]; then
            echo "$label ListTagsForResource last stderr:" >&2
            cat "$error_file" >&2
        fi
        external_s3_test_die "$label ListTagsForResource did not converge"
    fi
    echo "$label-list-tags-for-resource: ok"
}

wait_for_get_bucket_tagging_denied() {
    local label="$1"
    local bucket="$2"
    local attempt consecutive_denials=0 error_file ready=false
    error_file="$tmpdir/${label}-get-bucket-tagging.err"

    for ((attempt = 1; attempt <= 30; attempt++)); do
        if aws_primary s3api get-bucket-tagging \
            --bucket "$bucket" >/dev/null 2>"$error_file"; then
            consecutive_denials=0
        elif grep -Fq \
            'An error occurred (AccessDenied) when calling the GetBucketTagging operation:' \
            "$error_file"; then
            ((consecutive_denials += 1))
            if ((consecutive_denials == 3)); then
                ready=true
                break
            fi
        else
            consecutive_denials=0
        fi
        sleep 2
    done
    if [[ "$ready" != true ]]; then
        cat "$error_file" >&2
        external_s3_test_die "$label GetBucketTagging deny did not converge"
    fi
    echo "$label-get-bucket-tagging-access-denied: ok"
}

declare -a created_role_names=()
declare -a created_multipart_keys=()
declare -a created_multipart_upload_ids=()
created_disabled_access_key=""
created_disabled_user=""
created_iam_user_context_access_key=""
created_iam_user_context_user=""
created_bucket=""
tmpdir=""

cleanup_assume_role_fixture() {
    local status=$?
    trap - EXIT

    local inline_policies_file policy_name role_name
    if [[ -n "$created_iam_user_context_access_key" && -n "$created_iam_user_context_user" ]]; then
        if ! aws_primary iam delete-access-key \
            --user-name "$created_iam_user_context_user" \
            --access-key-id "$created_iam_user_context_access_key"; then
            echo "error: failed to delete temporary IAM-user-context access key from $created_iam_user_context_user" >&2
            ((status != 0)) || status=1
        fi
        created_iam_user_context_access_key=""
    fi
    if [[ -n "$created_iam_user_context_user" ]]; then
        if ! aws_primary iam delete-user --user-name "$created_iam_user_context_user"; then
            echo "error: failed to delete temporary IAM-user-context user $created_iam_user_context_user" >&2
            ((status != 0)) || status=1
        fi
        created_iam_user_context_user=""
    fi
    if [[ -n "$created_disabled_access_key" && -n "$created_disabled_user" ]]; then
        if ! aws_primary iam delete-access-key \
            --user-name "$created_disabled_user" \
            --access-key-id "$created_disabled_access_key"; then
            echo "error: failed to delete temporary disabled-credential access key from $created_disabled_user" >&2
            ((status != 0)) || status=1
        fi
        created_disabled_access_key=""
    fi
    if [[ -n "$created_disabled_user" ]]; then
        if ! aws_primary iam delete-user --user-name "$created_disabled_user"; then
            echo "error: failed to delete temporary disabled-credential user $created_disabled_user" >&2
            ((status != 0)) || status=1
        fi
        created_disabled_user=""
    fi
    for role_name in "${created_role_names[@]}"; do
        inline_policies_file="$tmpdir/cleanup-${role_name}-inline-policies.json"
        if aws_primary iam list-role-policies \
            --role-name "$role_name" \
            --output json >"$inline_policies_file"; then
            while IFS= read -r policy_name; do
                [[ -n "$policy_name" ]] || continue
                if ! aws_primary iam delete-role-policy \
                    --role-name "$role_name" \
                    --policy-name "$policy_name"; then
                    echo "error: failed to delete inline policy $policy_name from temporary STS oracle role $role_name" >&2
                    ((status != 0)) || status=1
                fi
            done < <(jq -r '.PolicyNames[]' "$inline_policies_file")
        else
            echo "error: failed to list inline policies for temporary STS oracle role $role_name" >&2
            ((status != 0)) || status=1
        fi
        if ! aws_primary iam delete-role --role-name "$role_name"; then
            echo "error: failed to delete temporary STS oracle role $role_name" >&2
            ((status != 0)) || status=1
        fi
    done
    local multipart_index
    for multipart_index in "${!created_multipart_upload_ids[@]}"; do
        if ! aws_primary s3api abort-multipart-upload \
            --bucket "$created_bucket" \
            --key "${created_multipart_keys[$multipart_index]}" \
            --upload-id "${created_multipart_upload_ids[$multipart_index]}"; then
            echo "error: failed to abort temporary STS oracle multipart upload ${created_multipart_upload_ids[$multipart_index]}" >&2
            ((status != 0)) || status=1
        fi
    done
    if [[ -n "$created_bucket" ]]; then
        if ! aws_primary s3 rm "s3://${created_bucket}" --recursive; then
            echo "error: failed to empty temporary STS oracle bucket $created_bucket" >&2
            ((status != 0)) || status=1
        fi
        if ! aws_primary s3api delete-bucket --bucket "$created_bucket"; then
            echo "error: failed to delete temporary STS oracle bucket $created_bucket" >&2
            ((status != 0)) || status=1
        fi
    fi
    if [[ -n "$tmpdir" ]]; then
        rm -rf "$tmpdir"
    fi
    exit "$status"
}

unregister_created_role() {
    local deleted_role_name="$1"
    local role_name found=false
    local -a retained_role_names=()

    for role_name in "${created_role_names[@]}"; do
        if [[ "$role_name" == "$deleted_role_name" ]]; then
            found=true
        else
            retained_role_names+=("$role_name")
        fi
    done
    [[ "$found" == true ]] || \
        external_s3_test_die \
            "deliberately deleted STS oracle role was not registered for cleanup"
    created_role_names=("${retained_role_names[@]}")
}

create_scoped_role() {
    local role_name="$1"
    local role_path="$2"
    local trust_policy="$3"
    local expected_arn="$4"
    local max_session_duration="${5:-}"
    local retry_invalid_principal="${6:-false}"
    local permissions_boundary="${7:-}"
    local attempt create_error created_arn role_created=false
    local -a create_args=(
        --role-name "$role_name"
        --path "$role_path"
        --assume-role-policy-document "file://${trust_policy}"
    )

    if [[ -n "$max_session_duration" ]]; then
        create_args+=(--max-session-duration "$max_session_duration")
    fi
    if [[ -n "$permissions_boundary" ]]; then
        create_args+=(--permissions-boundary "$permissions_boundary")
    fi

    create_error="$tmpdir/create-${role_name}.err"
    for ((attempt = 1; attempt <= 15; attempt++)); do
        if created_arn="$(aws_primary iam create-role \
            "${create_args[@]}" \
            --query 'Role.Arn' \
            --output text 2>"$create_error")"; then
            role_created=true
            break
        fi
        if [[ "$retry_invalid_principal" == true ]] && \
            grep -Fq 'An error occurred (MalformedPolicyDocument)' "$create_error" && \
            grep -Fq 'Invalid principal in policy' "$create_error"; then
            sleep 2
            continue
        fi
        cat "$create_error" >&2
        external_s3_test_die "could not create temporary STS oracle role $expected_arn"
    done
    if [[ "$role_created" != true ]]; then
        cat "$create_error" >&2
        external_s3_test_die \
            "temporary STS oracle role principal did not converge for $expected_arn"
    fi
    created_role_names+=("$role_name")
    [[ "$created_arn" == "$expected_arn" ]] || \
        external_s3_test_die "CreateRole returned an unexpected role ARN"
    aws_primary iam wait role-exists --role-name "$role_name"
}

wait_for_role_policy_session_s3_result() {
    local label="$1"
    local access_key="$2"
    local secret_key="$3"
    local session_token="$4"
    local key="$5"
    local expected="$6"
    local attempt consecutive_results=0 empty_body error_file ready=false

    empty_body="$tmpdir/role-policy-empty-body"
    error_file="$tmpdir/${label}-convergence.err"
    : >"$empty_body"
    for ((attempt = 1; attempt <= 30; attempt++)); do
        if aws_with_session_credentials \
            "$access_key" \
            "$secret_key" \
            "$session_token" \
            s3api put-object \
            --bucket "$STS_TEST_POST_BUCKET" \
            --key "$key" \
            --body "$empty_body" >/dev/null 2>"$error_file"; then
            if [[ "$expected" == success ]]; then
                ((consecutive_results += 1))
            else
                consecutive_results=0
            fi
        elif [[ "$expected" == explicit-deny ]] && \
            grep -Fq \
                'An error occurred (AccessDenied) when calling the PutObject operation:' \
                "$error_file" && \
            grep -Fq 'with an explicit deny in an identity-based policy' "$error_file"; then
            ((consecutive_results += 1))
        else
            consecutive_results=0
        fi
        if ((consecutive_results == 3)); then
            ready=true
            break
        fi
        sleep 2
    done
    if [[ "$ready" != true ]]; then
        cat "$error_file" >&2
        external_s3_test_die "$label did not converge to three consecutive S3 $expected responses"
    fi
    echo "$label-s3-$expected: ok"
}

converged_role_policy_session=""

issue_converged_role_policy_session() {
    local label="$1"
    local role_arn="$2"
    local session_name="$3"
    local key="$4"
    local expected="$5"
    local access_key attempt consecutive_results=0 empty_body error_file ready=false secret_key session session_token

    empty_body="$tmpdir/role-policy-empty-body"
    error_file="$tmpdir/${label}-issuance-convergence.err"
    : >"$empty_body"
    for ((attempt = 1; attempt <= 30; attempt++)); do
        session="$(aws_primary sts assume-role \
            --role-arn "$role_arn" \
            --role-session-name "$session_name" \
            --duration-seconds 3600 \
            --output json)"
        access_key="$(jq -er '.Credentials.AccessKeyId' <<<"$session")"
        secret_key="$(jq -er '.Credentials.SecretAccessKey' <<<"$session")"
        session_token="$(jq -er '.Credentials.SessionToken' <<<"$session")"
        if aws_with_session_credentials \
            "$access_key" \
            "$secret_key" \
            "$session_token" \
            s3api put-object \
            --bucket "$STS_TEST_POST_BUCKET" \
            --key "$key" \
            --body "$empty_body" >/dev/null 2>"$error_file"; then
            if [[ "$expected" == success ]]; then
                ((consecutive_results += 1))
            else
                consecutive_results=0
            fi
        elif [[ "$expected" == explicit-deny ]] && \
            grep -Fq \
                'An error occurred (AccessDenied) when calling the PutObject operation:' \
                "$error_file" && \
            grep -Fq 'with an explicit deny in an identity-based policy' "$error_file"; then
            ((consecutive_results += 1))
        else
            consecutive_results=0
        fi
        if ((consecutive_results == 3)); then
            converged_role_policy_session="$session"
            ready=true
            break
        fi
        sleep 2
    done
    if [[ "$ready" != true ]]; then
        cat "$error_file" >&2
        external_s3_test_die "$label did not converge while issuing sessions for S3 $expected"
    fi
    echo "$label-issuance-s3-$expected: ok"
}

wait_for_role_policy_session_sts_success() {
    local label="$1"
    local access_key="$2"
    local secret_key="$3"
    local session_token="$4"
    local attempt consecutive_successes=0 ready=false

    for ((attempt = 1; attempt <= 30; attempt++)); do
        if aws_with_session_credentials \
            "$access_key" \
            "$secret_key" \
            "$session_token" \
            sts get-caller-identity >/dev/null 2>&1; then
            ((consecutive_successes += 1))
            if ((consecutive_successes == 3)); then
                ready=true
                break
            fi
        else
            consecutive_successes=0
        fi
        sleep 2
    done
    [[ "$ready" == true ]] || \
        external_s3_test_die "$label did not remain valid through STS authentication"
    echo "$label-sts-success: ok"
}

wait_for_role_get_object_result() {
    local label="$1"
    local access_key="$2"
    local secret_key="$3"
    local session_token="$4"
    local key="$5"
    local expected="$6"
    local attempt consecutive_results=0 error_file output_file ready=false

    error_file="$tmpdir/${label}-convergence.err"
    output_file="$tmpdir/${label}-object"
    for ((attempt = 1; attempt <= 30; attempt++)); do
        : >"$error_file"
        if aws_with_session_credentials \
            "$access_key" \
            "$secret_key" \
            "$session_token" \
            s3api get-object \
            --bucket "$STS_TEST_POST_BUCKET" \
            --key "$key" \
            "$output_file" >/dev/null 2>"$error_file"; then
            if [[ "$expected" == success ]]; then
                ((consecutive_results += 1))
            else
                consecutive_results=0
            fi
        elif [[ "$expected" == explicit-identity-deny ]] && \
            grep -Fq \
                'An error occurred (AccessDenied) when calling the GetObject operation:' \
                "$error_file" && \
            grep -Fq 'with an explicit deny in an identity-based policy' "$error_file"; then
            ((consecutive_results += 1))
        elif [[ "$expected" == explicit-resource-deny ]] && \
            grep -Fq \
                'An error occurred (AccessDenied) when calling the GetObject operation:' \
                "$error_file" && \
            grep -Fq 'with an explicit deny in a resource-based policy' "$error_file"; then
            ((consecutive_results += 1))
        elif [[ "$expected" == implicit-deny ]] && \
            grep -Fq \
                'An error occurred (AccessDenied) when calling the GetObject operation:' \
                "$error_file" && \
            grep -Fq 'because no identity-based policy allows the s3:GetObject action' \
                "$error_file"; then
            ((consecutive_results += 1))
        else
            consecutive_results=0
        fi
        if ((consecutive_results == 3)); then
            ready=true
            break
        fi
        sleep 2
    done
    if [[ "$ready" != true ]]; then
        cat "$error_file" >&2
        external_s3_test_die \
            "$label did not converge to three consecutive S3 $expected responses"
    fi
    echo "$label-s3-$expected: ok"
}

create_role_get_object_fixture() {
    local primary_arn="$1"
    local primary_account="$2"
    local role_suffix="$3"
    local trust_policy="$4"
    local allow_policy allow_session boundary_arn deny_policy deny_session empty_body key observed_policy

    boundary_arn="arn:aws:iam::${primary_account}:policy/argmin-s3-tests/sts-oracle-role-boundary"
    export STS_TEST_GET_ALLOW_ROLE_NAME="policy-mutation-get-allow-${role_suffix}"
    export STS_TEST_GET_ALLOW_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/same-account/${STS_TEST_GET_ALLOW_ROLE_NAME}"
    export STS_TEST_GET_ALLOW_SESSION_NAME="get-object-identity-allow"
    export STS_TEST_GET_DENY_ROLE_NAME="policy-mutation-get-deny-${role_suffix}"
    export STS_TEST_GET_DENY_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/same-account/${STS_TEST_GET_DENY_ROLE_NAME}"
    export STS_TEST_GET_DENY_SESSION_NAME="get-object-identity-deny"

    for key in \
        role-get-identity-allow \
        role-get-resource-allow \
        role-get-identity-deny \
        role-get-resource-deny \
        role-get-neither; do
        empty_body="$tmpdir/${key}-body"
        : >"$empty_body"
        aws_primary s3api put-object \
            --bucket "$STS_TEST_POST_BUCKET" \
            --key "$key" \
            --content-type application/octet-stream \
            --body "$empty_body" >/dev/null
    done

    assert_identity_decision \
        same-account-get-allow-role \
        aws_primary \
        "$primary_arn" \
        "$STS_TEST_GET_ALLOW_ROLE_ARN" \
        implicitDeny
    create_scoped_role \
        "$STS_TEST_GET_ALLOW_ROLE_NAME" \
        /argmin-sts-oracle/same-account/ \
        "$trust_policy" \
        "$STS_TEST_GET_ALLOW_ROLE_ARN" \
        "" \
        false \
        "$boundary_arn"
    [[ "$(aws_primary iam get-role \
        --role-name "$STS_TEST_GET_ALLOW_ROLE_NAME" \
        --query 'Role.PermissionsBoundary.PermissionsBoundaryArn' \
        --output text)" == "$boundary_arn" ]] || \
        external_s3_test_die "GetObject allow role does not have the required permissions boundary"
    allow_policy="$tmpdir/role-get-object-allow.json"
    jq -n \
        --arg identity_allow "arn:aws:s3:::${STS_TEST_POST_BUCKET}/role-get-identity-allow" \
        --arg resource_deny "arn:aws:s3:::${STS_TEST_POST_BUCKET}/role-get-resource-deny" \
        '{
            Version: "2012-10-17",
            Statement: [{
                Effect: "Allow",
                Action: "s3:GetObject",
                Resource: [$identity_allow, $resource_deny]
            }]
        }' >"$allow_policy"
    aws_primary iam put-role-policy \
        --role-name "$STS_TEST_GET_ALLOW_ROLE_NAME" \
        --policy-name get-object-allow \
        --policy-document "file://${allow_policy}"
    observed_policy="$tmpdir/role-get-object-observed.json"
    aws_primary iam get-role-policy \
        --role-name "$STS_TEST_GET_ALLOW_ROLE_NAME" \
        --policy-name get-object-allow \
        --query PolicyDocument \
        --output json >"$observed_policy"
    [[ "$(jq -S -c . "$observed_policy")" == "$(jq -S -c . "$allow_policy")" ]] || \
        external_s3_test_die "GetObject allow role policy did not round trip through IAM"
    wait_for_assume_role_success \
        same-account-get-allow-role \
        aws_primary \
        "$STS_TEST_GET_ALLOW_ROLE_ARN"
    allow_session="$(aws_primary sts assume-role \
        --role-arn "$STS_TEST_GET_ALLOW_ROLE_ARN" \
        --role-session-name "$STS_TEST_GET_ALLOW_SESSION_NAME" \
        --duration-seconds 3600 \
        --output json)"
    export STS_TEST_GET_ALLOW_ACCESS_KEY STS_TEST_GET_ALLOW_SECRET_KEY
    export STS_TEST_GET_ALLOW_SESSION_TOKEN STS_TEST_GET_ALLOW_SESSION_ARN
    STS_TEST_GET_ALLOW_ACCESS_KEY="$(jq -er '.Credentials.AccessKeyId' <<<"$allow_session")"
    STS_TEST_GET_ALLOW_SECRET_KEY="$(jq -er '.Credentials.SecretAccessKey' <<<"$allow_session")"
    STS_TEST_GET_ALLOW_SESSION_TOKEN="$(jq -er '.Credentials.SessionToken' <<<"$allow_session")"
    STS_TEST_GET_ALLOW_SESSION_ARN="$(jq -er '.AssumedRoleUser.Arn' <<<"$allow_session")"
    [[ "$STS_TEST_GET_ALLOW_SESSION_ARN" == \
        "arn:aws:sts::${primary_account}:assumed-role/${STS_TEST_GET_ALLOW_ROLE_NAME}/${STS_TEST_GET_ALLOW_SESSION_NAME}" ]] || \
        external_s3_test_die "GetObject allow session has an unexpected ARN"
    wait_for_role_get_object_result \
        role-get-identity-allow-control \
        "$STS_TEST_GET_ALLOW_ACCESS_KEY" \
        "$STS_TEST_GET_ALLOW_SECRET_KEY" \
        "$STS_TEST_GET_ALLOW_SESSION_TOKEN" \
        role-get-identity-allow \
        success

    assert_identity_decision \
        same-account-get-deny-role \
        aws_primary \
        "$primary_arn" \
        "$STS_TEST_GET_DENY_ROLE_ARN" \
        implicitDeny
    create_scoped_role \
        "$STS_TEST_GET_DENY_ROLE_NAME" \
        /argmin-sts-oracle/same-account/ \
        "$trust_policy" \
        "$STS_TEST_GET_DENY_ROLE_ARN" \
        "" \
        false \
        "$boundary_arn"
    [[ "$(aws_primary iam get-role \
        --role-name "$STS_TEST_GET_DENY_ROLE_NAME" \
        --query 'Role.PermissionsBoundary.PermissionsBoundaryArn' \
        --output text)" == "$boundary_arn" ]] || \
        external_s3_test_die "GetObject deny role does not have the required permissions boundary"
    deny_policy="$tmpdir/role-get-object-deny.json"
    jq -n \
        --arg resource "arn:aws:s3:::${STS_TEST_POST_BUCKET}/role-get-identity-deny" \
        '{
            Version: "2012-10-17",
            Statement: [{Effect: "Deny", Action: "s3:GetObject", Resource: $resource}]
        }' >"$deny_policy"
    aws_primary iam put-role-policy \
        --role-name "$STS_TEST_GET_DENY_ROLE_NAME" \
        --policy-name get-object-deny \
        --policy-document "file://${deny_policy}"
    aws_primary iam get-role-policy \
        --role-name "$STS_TEST_GET_DENY_ROLE_NAME" \
        --policy-name get-object-deny \
        --query PolicyDocument \
        --output json >"$observed_policy"
    [[ "$(jq -S -c . "$observed_policy")" == "$(jq -S -c . "$deny_policy")" ]] || \
        external_s3_test_die "GetObject deny role policy did not round trip through IAM"
    wait_for_assume_role_success \
        same-account-get-deny-role \
        aws_primary \
        "$STS_TEST_GET_DENY_ROLE_ARN"
    deny_session="$(aws_primary sts assume-role \
        --role-arn "$STS_TEST_GET_DENY_ROLE_ARN" \
        --role-session-name "$STS_TEST_GET_DENY_SESSION_NAME" \
        --duration-seconds 3600 \
        --output json)"
    export STS_TEST_GET_DENY_ACCESS_KEY STS_TEST_GET_DENY_SECRET_KEY
    export STS_TEST_GET_DENY_SESSION_TOKEN STS_TEST_GET_DENY_SESSION_ARN
    STS_TEST_GET_DENY_ACCESS_KEY="$(jq -er '.Credentials.AccessKeyId' <<<"$deny_session")"
    STS_TEST_GET_DENY_SECRET_KEY="$(jq -er '.Credentials.SecretAccessKey' <<<"$deny_session")"
    STS_TEST_GET_DENY_SESSION_TOKEN="$(jq -er '.Credentials.SessionToken' <<<"$deny_session")"
    STS_TEST_GET_DENY_SESSION_ARN="$(jq -er '.AssumedRoleUser.Arn' <<<"$deny_session")"
    [[ "$STS_TEST_GET_DENY_SESSION_ARN" == \
        "arn:aws:sts::${primary_account}:assumed-role/${STS_TEST_GET_DENY_ROLE_NAME}/${STS_TEST_GET_DENY_SESSION_NAME}" ]] || \
        external_s3_test_die "GetObject deny session has an unexpected ARN"
    wait_for_role_get_object_result \
        role-get-identity-deny-control \
        "$STS_TEST_GET_DENY_ACCESS_KEY" \
        "$STS_TEST_GET_DENY_SECRET_KEY" \
        "$STS_TEST_GET_DENY_SESSION_TOKEN" \
        role-get-identity-deny \
        explicit-identity-deny
}

create_role_policy_mutation_fixture() {
    local primary_arn="$1"
    local primary_account="$2"
    local role_suffix="$3"
    local trust_policy="$4"
    local allow_policy boundary_delete_error deny_policy forbidden_policy_error observed_policy post_session pre_session

    export STS_TEST_POLICY_MUTATION_ROLE_NAME="policy-mutation-${role_suffix}"
    export STS_TEST_POLICY_MUTATION_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/same-account/${STS_TEST_POLICY_MUTATION_ROLE_NAME}"
    export STS_TEST_POLICY_MUTATION_POLICY_NAME="put-object-mutation"
    export STS_TEST_POLICY_MUTATION_BOUNDARY_ARN="arn:aws:iam::${primary_account}:policy/argmin-s3-tests/sts-oracle-role-boundary"
    export STS_TEST_POLICY_MUTATION_PRE_SESSION_NAME="policy-before-mutation"
    export STS_TEST_POLICY_MUTATION_POST_SESSION_NAME="policy-after-mutation"

    assert_identity_decision \
        same-account-policy-mutation \
        aws_primary \
        "$primary_arn" \
        "$STS_TEST_POLICY_MUTATION_ROLE_ARN" \
        implicitDeny
    create_scoped_role \
        "$STS_TEST_POLICY_MUTATION_ROLE_NAME" \
        /argmin-sts-oracle/same-account/ \
        "$trust_policy" \
        "$STS_TEST_POLICY_MUTATION_ROLE_ARN" \
        "" \
        false \
        "$STS_TEST_POLICY_MUTATION_BOUNDARY_ARN"
    [[ "$(aws_primary iam get-role \
        --role-name "$STS_TEST_POLICY_MUTATION_ROLE_NAME" \
        --query 'Role.PermissionsBoundary.PermissionsBoundaryArn' \
        --output text)" == "$STS_TEST_POLICY_MUTATION_BOUNDARY_ARN" ]] || \
        external_s3_test_die "policy-mutation role does not have the required permissions boundary"

    allow_policy="$tmpdir/role-policy-mutation-allow.json"
    deny_policy="$tmpdir/role-policy-mutation-deny.json"
    jq -n \
        --arg resource "arn:aws:s3:::${STS_TEST_POST_BUCKET}/role-policy-mutation-*" \
        '{
            Version: "2012-10-17",
            Statement: [{Effect: "Allow", Action: "s3:PutObject", Resource: $resource}]
        }' >"$allow_policy"
    jq -n \
        --arg resource "arn:aws:s3:::${STS_TEST_POST_BUCKET}/role-policy-mutation-*" \
        '{
            Version: "2012-10-17",
            Statement: [{Effect: "Deny", Action: "s3:PutObject", Resource: $resource}]
        }' >"$deny_policy"

    forbidden_policy_error="$tmpdir/role-policy-mutation-forbidden-target.err"
    if aws_primary iam put-role-policy \
        --role-name "$STS_TEST_ROLE_NAME" \
        --policy-name forbidden-mutation \
        --policy-document "file://${deny_policy}" \
        >/dev/null 2>"$forbidden_policy_error"; then
        external_s3_test_die \
            "test user unexpectedly mutated an unbounded STS oracle role"
    fi
    if ! grep -Fq \
        'An error occurred (AccessDenied) when calling the PutRolePolicy operation:' \
        "$forbidden_policy_error"; then
        cat "$forbidden_policy_error" >&2
        external_s3_test_die \
            "unbounded STS oracle role mutation did not produce AccessDenied"
    fi
    echo "same-account-policy-mutation-unbounded-target-access-denied: ok"

    boundary_delete_error="$tmpdir/role-policy-mutation-delete-boundary.err"
    if aws_primary iam delete-role-permissions-boundary \
        --role-name "$STS_TEST_POLICY_MUTATION_ROLE_NAME" \
        >/dev/null 2>"$boundary_delete_error"; then
        external_s3_test_die \
            "test user unexpectedly removed the mutation role permissions boundary"
    fi
    if ! grep -Fq \
        'An error occurred (AccessDenied) when calling the DeleteRolePermissionsBoundary operation:' \
        "$boundary_delete_error"; then
        cat "$boundary_delete_error" >&2
        external_s3_test_die \
            "mutation role boundary removal did not produce AccessDenied"
    fi
    echo "same-account-policy-mutation-boundary-delete-access-denied: ok"

    aws_primary iam put-role-policy \
        --role-name "$STS_TEST_POLICY_MUTATION_ROLE_NAME" \
        --policy-name "$STS_TEST_POLICY_MUTATION_POLICY_NAME" \
        --policy-document "file://${allow_policy}"
    observed_policy="$tmpdir/role-policy-mutation-observed.json"
    aws_primary iam get-role-policy \
        --role-name "$STS_TEST_POLICY_MUTATION_ROLE_NAME" \
        --policy-name "$STS_TEST_POLICY_MUTATION_POLICY_NAME" \
        --query PolicyDocument \
        --output json >"$observed_policy"
    [[ "$(jq -S -c . "$observed_policy")" == "$(jq -S -c . "$allow_policy")" ]] || \
        external_s3_test_die "role policy allow document did not round trip through IAM"

    wait_for_assume_role_success \
        same-account-policy-mutation-role \
        aws_primary \
        "$STS_TEST_POLICY_MUTATION_ROLE_ARN"
    issue_converged_role_policy_session \
        same-account-policy-mutation-before \
        "$STS_TEST_POLICY_MUTATION_ROLE_ARN" \
        "$STS_TEST_POLICY_MUTATION_PRE_SESSION_NAME" \
        role-policy-mutation-before-control \
        success
    pre_session="$converged_role_policy_session"
    export STS_TEST_POLICY_MUTATION_PRE_ACCESS_KEY
    export STS_TEST_POLICY_MUTATION_PRE_SECRET_KEY
    export STS_TEST_POLICY_MUTATION_PRE_SESSION_TOKEN
    export STS_TEST_POLICY_MUTATION_PRE_SESSION_ARN
    STS_TEST_POLICY_MUTATION_PRE_ACCESS_KEY="$(jq -er '.Credentials.AccessKeyId' <<<"$pre_session")"
    STS_TEST_POLICY_MUTATION_PRE_SECRET_KEY="$(jq -er '.Credentials.SecretAccessKey' <<<"$pre_session")"
    STS_TEST_POLICY_MUTATION_PRE_SESSION_TOKEN="$(jq -er '.Credentials.SessionToken' <<<"$pre_session")"
    STS_TEST_POLICY_MUTATION_PRE_SESSION_ARN="$(jq -er '.AssumedRoleUser.Arn' <<<"$pre_session")"
    [[ "$STS_TEST_POLICY_MUTATION_PRE_SESSION_ARN" == \
        "arn:aws:sts::${primary_account}:assumed-role/${STS_TEST_POLICY_MUTATION_ROLE_NAME}/${STS_TEST_POLICY_MUTATION_PRE_SESSION_NAME}" ]] || \
        external_s3_test_die "pre-mutation role session has an unexpected ARN"
    wait_for_role_policy_session_s3_result \
        same-account-policy-mutation-before-session \
        "$STS_TEST_POLICY_MUTATION_PRE_ACCESS_KEY" \
        "$STS_TEST_POLICY_MUTATION_PRE_SECRET_KEY" \
        "$STS_TEST_POLICY_MUTATION_PRE_SESSION_TOKEN" \
        role-policy-mutation-before-session-control \
        success

    aws_primary iam put-role-policy \
        --role-name "$STS_TEST_POLICY_MUTATION_ROLE_NAME" \
        --policy-name "$STS_TEST_POLICY_MUTATION_POLICY_NAME" \
        --policy-document "file://${deny_policy}"
    aws_primary iam get-role-policy \
        --role-name "$STS_TEST_POLICY_MUTATION_ROLE_NAME" \
        --policy-name "$STS_TEST_POLICY_MUTATION_POLICY_NAME" \
        --query PolicyDocument \
        --output json >"$observed_policy"
    [[ "$(jq -S -c . "$observed_policy")" == "$(jq -S -c . "$deny_policy")" ]] || \
        external_s3_test_die "role policy deny document did not round trip through IAM"

    issue_converged_role_policy_session \
        same-account-policy-mutation-after \
        "$STS_TEST_POLICY_MUTATION_ROLE_ARN" \
        "$STS_TEST_POLICY_MUTATION_POST_SESSION_NAME" \
        role-policy-mutation-after-control \
        explicit-deny
    post_session="$converged_role_policy_session"
    export STS_TEST_POLICY_MUTATION_POST_ACCESS_KEY
    export STS_TEST_POLICY_MUTATION_POST_SECRET_KEY
    export STS_TEST_POLICY_MUTATION_POST_SESSION_TOKEN
    export STS_TEST_POLICY_MUTATION_POST_SESSION_ARN
    STS_TEST_POLICY_MUTATION_POST_ACCESS_KEY="$(jq -er '.Credentials.AccessKeyId' <<<"$post_session")"
    STS_TEST_POLICY_MUTATION_POST_SECRET_KEY="$(jq -er '.Credentials.SecretAccessKey' <<<"$post_session")"
    STS_TEST_POLICY_MUTATION_POST_SESSION_TOKEN="$(jq -er '.Credentials.SessionToken' <<<"$post_session")"
    STS_TEST_POLICY_MUTATION_POST_SESSION_ARN="$(jq -er '.AssumedRoleUser.Arn' <<<"$post_session")"
    [[ "$STS_TEST_POLICY_MUTATION_POST_SESSION_ARN" == \
        "arn:aws:sts::${primary_account}:assumed-role/${STS_TEST_POLICY_MUTATION_ROLE_NAME}/${STS_TEST_POLICY_MUTATION_POST_SESSION_NAME}" ]] || \
        external_s3_test_die "post-mutation role session has an unexpected ARN"

    wait_for_role_policy_session_s3_result \
        same-account-policy-mutation-after-session \
        "$STS_TEST_POLICY_MUTATION_POST_ACCESS_KEY" \
        "$STS_TEST_POLICY_MUTATION_POST_SECRET_KEY" \
        "$STS_TEST_POLICY_MUTATION_POST_SESSION_TOKEN" \
        role-policy-mutation-after-session-control \
        explicit-deny
    wait_for_role_policy_session_sts_success \
        same-account-policy-mutation-before-session-after-update \
        "$STS_TEST_POLICY_MUTATION_PRE_ACCESS_KEY" \
        "$STS_TEST_POLICY_MUTATION_PRE_SECRET_KEY" \
        "$STS_TEST_POLICY_MUTATION_PRE_SESSION_TOKEN"
    wait_for_role_policy_session_s3_result \
        same-account-policy-mutation-before-session-after-update \
        "$STS_TEST_POLICY_MUTATION_PRE_ACCESS_KEY" \
        "$STS_TEST_POLICY_MUTATION_PRE_SECRET_KEY" \
        "$STS_TEST_POLICY_MUTATION_PRE_SESSION_TOKEN" \
        role-policy-mutation-before-session-after-update-control \
        explicit-deny
}

create_assume_role_fixture() {
    command -v aws >/dev/null || external_s3_test_die "aws CLI is required for --assume-role"
    command -v jq >/dev/null || external_s3_test_die "jq is required for --assume-role"

    local chain_source_identity chain_source_session chain_target_max_duration default_max_duration
    local deleted_role_identity deleted_role_session deleted_role_stable_id expired_role_session expiry_liveness_session identity_decision identity_simulation missing_role_error
    local expiry_liveness_access_key expiry_liveness_secret_key expiry_liveness_session_token
    local other_live_access_key other_live_identity other_live_secret_key other_live_session other_live_session_token
    local recreated_expiration recreated_expiration_epoch recreated_issue_epoch
    local iam_user_context_access_key_fixture iam_user_context_expected_arn iam_user_context_user_fixture
    local old_assumed_role_id primary_identity primary_account primary_arn recreated_role_identity recreated_role_session recreated_role_stable_id role_suffix source_identity_session streaming_bucket_policy trust_chain_source trust_chain_source_with_set trust_default_max trust_external_id trust_policy trust_recreated_role_revoked trust_source_identity trust_source_identity_condition trust_source_identity_target trust_wildcard
    primary_identity="$(aws_primary sts get-caller-identity --output json)"
    primary_account="$(jq -er '.Account' <<<"$primary_identity")"
    primary_arn="$(jq -er '.Arn' <<<"$primary_identity")"
    [[ "$primary_account" == "$TEST_AWS_PRIMARY_ACCOUNT_ID" ]] || \
        external_s3_test_die \
            "primary credential account $primary_account does not match TEST_AWS_PRIMARY_ACCOUNT_ID"
    [[ "$primary_arn" == "arn:aws:iam::${primary_account}:user/"* ]] || \
        external_s3_test_die "primary credentials do not identify an IAM user"
    export STS_TEST_PRIMARY_ARN="$primary_arn"

    tmpdir="$(mktemp -d)"
    role_suffix="${tmpdir##*/}"
    role_suffix="${role_suffix#tmp.}"
    role_suffix="${role_suffix,,}"
    export STS_TEST_IAM_USER_CONTEXT_USER_NAME="iam-user-context-${role_suffix}"
    iam_user_context_expected_arn="arn:aws:iam::${primary_account}:user/argmin-sts-oracle/${STS_TEST_IAM_USER_CONTEXT_USER_NAME}"
    iam_user_context_user_fixture="$tmpdir/iam-user-context-user.json"
    aws_primary iam create-user \
        --user-name "$STS_TEST_IAM_USER_CONTEXT_USER_NAME" \
        --path /argmin-sts-oracle/ \
        --output json >"$iam_user_context_user_fixture"
    created_iam_user_context_user="$STS_TEST_IAM_USER_CONTEXT_USER_NAME"
    export STS_TEST_IAM_USER_CONTEXT_ARN
    STS_TEST_IAM_USER_CONTEXT_ARN="$(jq -er '.User.Arn' "$iam_user_context_user_fixture")"
    [[ "$STS_TEST_IAM_USER_CONTEXT_ARN" == "$iam_user_context_expected_arn" ]] || \
        external_s3_test_die "temporary IAM-user-context user has an unexpected ARN"
    iam_user_context_access_key_fixture="$tmpdir/iam-user-context-access-key.json"
    aws_primary iam create-access-key \
        --user-name "$STS_TEST_IAM_USER_CONTEXT_USER_NAME" \
        --output json >"$iam_user_context_access_key_fixture"
    export STS_TEST_IAM_USER_CONTEXT_ACCESS_KEY STS_TEST_IAM_USER_CONTEXT_SECRET_KEY
    STS_TEST_IAM_USER_CONTEXT_ACCESS_KEY="$(jq -er '.AccessKey.AccessKeyId' "$iam_user_context_access_key_fixture")"
    STS_TEST_IAM_USER_CONTEXT_SECRET_KEY="$(jq -er '.AccessKey.SecretAccessKey' "$iam_user_context_access_key_fixture")"
    created_iam_user_context_access_key="$STS_TEST_IAM_USER_CONTEXT_ACCESS_KEY"
    [[ "$(jq -er '.AccessKey.Status' "$iam_user_context_access_key_fixture")" == Active ]] || \
        external_s3_test_die "temporary IAM-user-context access key was not created active"
    echo "iam-user-context-user-fixture: ok"

    export STS_TEST_POST_BUCKET="claude-s3-sts-oracle-${role_suffix}"
    local -a create_bucket_args=(
        s3api create-bucket
        --bucket "$STS_TEST_POST_BUCKET"
    )
    if [[ "$region" != us-east-1 ]]; then
        create_bucket_args+=(
            --create-bucket-configuration "LocationConstraint=${region}"
        )
    fi
    aws_primary "${create_bucket_args[@]}" >/dev/null
    created_bucket="$STS_TEST_POST_BUCKET"
    aws_primary s3api wait bucket-exists --bucket "$created_bucket"
    echo "post-object-bucket-fixture: ok"
    aws_primary s3control tag-resource \
        --account-id "$primary_account" \
        --resource-arn "arn:aws:s3:::${created_bucket}" \
        --tags Key=routing-key,Value=routing-value
    wait_for_list_tags_for_resource_success \
        initial-tag-fixture \
        "$primary_account" \
        "arn:aws:s3:::${created_bucket}"
    export STS_TEST_ROLE_NAME="path-shape-${role_suffix}"
    export STS_TEST_ROLE_SESSION_NAME="path-shape-session"
    export STS_TEST_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/same-account/${STS_TEST_ROLE_NAME}"
    export STS_TEST_WILDCARD_ROLE_NAME="wildcard-trust-${role_suffix}"
    export STS_TEST_WILDCARD_ROLE_SESSION_NAME="wildcard-trust-session"
    export STS_TEST_WILDCARD_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/same-account/${STS_TEST_WILDCARD_ROLE_NAME}"
    export STS_TEST_DEFAULT_MAX_ROLE_NAME="default-max-${role_suffix}"
    export STS_TEST_DEFAULT_MAX_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/same-account/${STS_TEST_DEFAULT_MAX_ROLE_NAME}"
    export STS_TEST_EXTERNAL_ID="argmin-sts-oracle-external-id"
    export STS_TEST_EXTERNAL_ID_ROLE_NAME="external-id-${role_suffix}"
    export STS_TEST_EXTERNAL_ID_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/same-account/${STS_TEST_EXTERNAL_ID_ROLE_NAME}"
    export STS_TEST_SOURCE_IDENTITY="argmin-sts-oracle-source"
    export STS_TEST_SOURCE_IDENTITY_ROLE_NAME="source-identity-${role_suffix}"
    export STS_TEST_SOURCE_IDENTITY_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/same-account/${STS_TEST_SOURCE_IDENTITY_ROLE_NAME}"
    export STS_TEST_SOURCE_IDENTITY_CONDITION_ROLE_NAME="source-identity-condition-${role_suffix}"
    export STS_TEST_SOURCE_IDENTITY_CONDITION_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/same-account/${STS_TEST_SOURCE_IDENTITY_CONDITION_ROLE_NAME}"
    export STS_TEST_SOURCE_IDENTITY_TARGET_ROLE_NAME="source-identity-target-${role_suffix}"
    export STS_TEST_SOURCE_IDENTITY_TARGET_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/same-account/${STS_TEST_SOURCE_IDENTITY_TARGET_ROLE_NAME}"
    export STS_TEST_SOURCE_IDENTITY_SESSION_NAME="source-identity-source"
    export STS_TEST_SOURCE_IDENTITY_TARGET_SESSION_NAME="source-identity-target"
    export STS_TEST_CHAIN_SOURCE_SESSION_NAME="chaining-source"
    export STS_TEST_CHAIN_TARGET_SESSION_NAME="chaining-target"
    export STS_TEST_CHAIN_TARGET_ROLE_NAME="chain-target-${role_suffix}"
    export STS_TEST_CHAIN_TARGET_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/same-account/${STS_TEST_CHAIN_TARGET_ROLE_NAME}"
    export STS_TEST_DELETED_ROLE_NAME="deleted-role-${role_suffix}"
    export STS_TEST_DELETED_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/same-account/${STS_TEST_DELETED_ROLE_NAME}"
    export STS_TEST_DELETED_ROLE_SESSION_NAME="deleted-role-session"
    export STS_TEST_RECREATED_ROLE_SESSION_NAME="recreated-role-session"
    if [[ "$expiry_collision" == true ]]; then
        export STS_TEST_EXPIRY_ROLE_NAME="expiry-role-${role_suffix}"
        export STS_TEST_EXPIRY_ROLE_ARN="arn:aws:iam::${primary_account}:role/argmin-sts-oracle/same-account/${STS_TEST_EXPIRY_ROLE_NAME}"
        export STS_TEST_EXPIRED_DELETED_ROLE_SESSION_NAME="expired-deleted-role-session"
    fi

    trust_policy="$tmpdir/trust-policy.json"
    jq -n --arg principal "$primary_arn" '{
        Version: "2012-10-17",
        Statement: [{
            Effect: "Allow",
            Principal: {AWS: $principal},
            Action: "sts:AssumeRole"
        }]
    }' >"$trust_policy"

    identity_simulation="$tmpdir/identity-simulation.json"
    aws_primary iam simulate-principal-policy \
        --policy-source-arn "$primary_arn" \
        --action-names sts:AssumeRole \
        --resource-arns "$STS_TEST_ROLE_ARN" \
        --output json >"$identity_simulation"
    [[ "$(jq -er '.EvaluationResults | length' "$identity_simulation")" == 1 ]] || \
        external_s3_test_die "same-account identity-policy simulation returned an unexpected result count"
    [[ "$(jq -er '.EvaluationResults[0].EvalActionName' "$identity_simulation")" == "sts:AssumeRole" ]] || \
        external_s3_test_die "same-account identity-policy simulation returned an unexpected action"
    [[ "$(jq -er '.EvaluationResults[0].EvalResourceName' "$identity_simulation")" == "$STS_TEST_ROLE_ARN" ]] || \
        external_s3_test_die "same-account identity-policy simulation returned an unexpected resource"
    identity_decision="$(jq -er '.EvaluationResults[0].EvalDecision' "$identity_simulation")"
    [[ "$identity_decision" == "implicitDeny" ]] || \
        external_s3_test_die \
            "same-account role requires implicitDeny from caller identity policies, got $identity_decision"
    echo "same-account-identity-policy-implicit-deny: ok"

    missing_role_error="$tmpdir/get-missing-role.err"
    if aws_primary iam get-role \
        --role-name "$STS_TEST_ROLE_NAME" \
        --query 'Role.Arn' \
        --output text >/dev/null 2>"$missing_role_error"; then
        external_s3_test_die \
            "unique temporary STS oracle role unexpectedly exists before creation"
    fi
    if ! grep -Fq \
        'An error occurred (AccessDenied) when calling the GetRole operation:' \
        "$missing_role_error"; then
        cat "$missing_role_error" >&2
        external_s3_test_die \
            "missing path-scoped role did not produce the expected GetRole AccessDenied"
    fi
    echo "missing-path-role-get-access-denied: ok"

    create_scoped_role \
        "$STS_TEST_ROLE_NAME" \
        /argmin-sts-oracle/same-account/ \
        "$trust_policy" \
        "$STS_TEST_ROLE_ARN" \
        43200

    assert_identity_decision \
        same-account-wildcard-trust \
        aws_primary \
        "$primary_arn" \
        "$STS_TEST_WILDCARD_ROLE_ARN" \
        implicitDeny
    trust_wildcard="$tmpdir/trust-wildcard.json"
    jq -n '{
        Version: "2012-10-17",
        Statement: [{
            Effect: "Allow",
            Principal: {AWS: "*"},
            Action: "sts:AssumeRole"
        }]
    }' >"$trust_wildcard"
    create_scoped_role \
        "$STS_TEST_WILDCARD_ROLE_NAME" \
        /argmin-sts-oracle/same-account/ \
        "$trust_wildcard" \
        "$STS_TEST_WILDCARD_ROLE_ARN"

    assert_identity_decision \
        same-account-default-max \
        aws_primary \
        "$primary_arn" \
        "$STS_TEST_DEFAULT_MAX_ROLE_ARN" \
        implicitDeny
    trust_default_max="$tmpdir/trust-default-max.json"
    jq -n \
        --arg primary_principal "$primary_arn" \
        --arg source_role_principal "$STS_TEST_ROLE_ARN" \
        '{
            Version: "2012-10-17",
            Statement: [{
                Effect: "Allow",
                Principal: {AWS: [$primary_principal, $source_role_principal]},
                Action: "sts:AssumeRole"
            }]
        }' >"$trust_default_max"
    create_scoped_role \
        "$STS_TEST_DEFAULT_MAX_ROLE_NAME" \
        /argmin-sts-oracle/same-account/ \
        "$trust_default_max" \
        "$STS_TEST_DEFAULT_MAX_ROLE_ARN" \
        "" \
        true
    default_max_duration="$(aws_primary iam get-role \
        --role-name "$STS_TEST_DEFAULT_MAX_ROLE_NAME" \
        --query 'Role.MaxSessionDuration' \
        --output text)"
    [[ "$default_max_duration" == 3600 ]] || \
        external_s3_test_die \
            "temporary STS oracle role has unexpected default maximum session duration $default_max_duration"
    echo "same-account-default-max-duration: ok"

    assert_identity_decision \
        same-account-external-id \
        aws_primary \
        "$primary_arn" \
        "$STS_TEST_EXTERNAL_ID_ROLE_ARN" \
        implicitDeny
    trust_external_id="$tmpdir/trust-external-id.json"
    jq -n \
        --arg principal "$primary_arn" \
        --arg external_id "$STS_TEST_EXTERNAL_ID" \
        '{
            Version: "2012-10-17",
            Statement: [{
                Effect: "Allow",
                Principal: {AWS: $principal},
                Action: "sts:AssumeRole",
                Condition: {StringEquals: {"sts:ExternalId": $external_id}}
            }]
        }' >"$trust_external_id"
    create_scoped_role \
        "$STS_TEST_EXTERNAL_ID_ROLE_NAME" \
        /argmin-sts-oracle/same-account/ \
        "$trust_external_id" \
        "$STS_TEST_EXTERNAL_ID_ROLE_ARN"

    assert_identity_decision \
        same-account-source-identity \
        aws_primary \
        "$primary_arn" \
        "$STS_TEST_SOURCE_IDENTITY_ROLE_ARN" \
        implicitDeny
    trust_source_identity="$tmpdir/trust-source-identity.json"
    jq -n --arg principal "$primary_arn" '{
        Version: "2012-10-17",
        Statement: [{
            Effect: "Allow",
            Principal: {AWS: $principal},
            Action: ["sts:AssumeRole", "sts:SetSourceIdentity"]
        }]
    }' >"$trust_source_identity"
    create_scoped_role \
        "$STS_TEST_SOURCE_IDENTITY_ROLE_NAME" \
        /argmin-sts-oracle/same-account/ \
        "$trust_source_identity" \
        "$STS_TEST_SOURCE_IDENTITY_ROLE_ARN"

    assert_identity_decision \
        same-account-source-identity-condition \
        aws_primary \
        "$primary_arn" \
        "$STS_TEST_SOURCE_IDENTITY_CONDITION_ROLE_ARN" \
        implicitDeny
    trust_source_identity_condition="$tmpdir/trust-source-identity-condition.json"
    jq -n \
        --arg principal "$primary_arn" \
        --arg source_identity "$STS_TEST_SOURCE_IDENTITY" \
        '{
            Version: "2012-10-17",
            Statement: [{
                Effect: "Allow",
                Principal: {AWS: $principal},
                Action: ["sts:AssumeRole", "sts:SetSourceIdentity"],
                Condition: {StringEquals: {"sts:SourceIdentity": $source_identity}}
            }]
        }' >"$trust_source_identity_condition"
    create_scoped_role \
        "$STS_TEST_SOURCE_IDENTITY_CONDITION_ROLE_NAME" \
        /argmin-sts-oracle/same-account/ \
        "$trust_source_identity_condition" \
        "$STS_TEST_SOURCE_IDENTITY_CONDITION_ROLE_ARN"

    trust_source_identity_target="$tmpdir/trust-source-identity-target.json"
    jq -n \
        --arg principal "$STS_TEST_SOURCE_IDENTITY_ROLE_ARN" \
        --arg source_identity "$STS_TEST_SOURCE_IDENTITY" \
        '{
            Version: "2012-10-17",
            Statement: [{
                Effect: "Allow",
                Principal: {AWS: $principal},
                Action: ["sts:AssumeRole", "sts:SetSourceIdentity"],
                Condition: {StringEquals: {"sts:SourceIdentity": $source_identity}}
            }]
        }' >"$trust_source_identity_target"
    create_scoped_role \
        "$STS_TEST_SOURCE_IDENTITY_TARGET_ROLE_NAME" \
        /argmin-sts-oracle/same-account/ \
        "$trust_source_identity_target" \
        "$STS_TEST_SOURCE_IDENTITY_TARGET_ROLE_ARN" \
        "" \
        true

    trust_chain_source="$tmpdir/trust-chain-source.json"
    trust_chain_source_with_set="$tmpdir/trust-chain-source-with-set.json"
    jq -n \
        --arg principal "$STS_TEST_ROLE_ARN" \
        --arg source_identity_principal "$STS_TEST_SOURCE_IDENTITY_ROLE_ARN" \
        '{
        Version: "2012-10-17",
        Statement: [{
            Effect: "Allow",
            Principal: {AWS: [$principal, $source_identity_principal]},
            Action: "sts:AssumeRole"
        }]
    }' >"$trust_chain_source"
    jq -n \
        --arg principal "$STS_TEST_ROLE_ARN" \
        --arg source_identity_principal "$STS_TEST_SOURCE_IDENTITY_ROLE_ARN" \
        '{
        Version: "2012-10-17",
        Statement: [{
            Effect: "Allow",
            Principal: {AWS: [$principal, $source_identity_principal]},
            Action: ["sts:AssumeRole", "sts:SetSourceIdentity"]
        }]
    }' >"$trust_chain_source_with_set"
    assert_identity_decision \
        same-account-chain-target \
        aws_primary \
        "$primary_arn" \
        "$STS_TEST_CHAIN_TARGET_ROLE_ARN" \
        implicitDeny
    create_scoped_role \
        "$STS_TEST_CHAIN_TARGET_ROLE_NAME" \
        /argmin-sts-oracle/same-account/ \
        "$trust_chain_source_with_set" \
        "$STS_TEST_CHAIN_TARGET_ROLE_ARN" \
        43200
    chain_target_max_duration="$(aws_primary iam get-role \
        --role-name "$STS_TEST_CHAIN_TARGET_ROLE_NAME" \
        --query 'Role.MaxSessionDuration' \
        --output text)"
    [[ "$chain_target_max_duration" == 43200 ]] || \
        external_s3_test_die \
            "temporary STS chain target has unexpected maximum session duration $chain_target_max_duration"
    echo "same-account-chain-target-max-duration: ok"

    assert_identity_decision \
        same-account-deleted-role \
        aws_primary \
        "$primary_arn" \
        "$STS_TEST_DELETED_ROLE_ARN" \
        implicitDeny
    create_scoped_role \
        "$STS_TEST_DELETED_ROLE_NAME" \
        /argmin-sts-oracle/same-account/ \
        "$trust_policy" \
        "$STS_TEST_DELETED_ROLE_ARN"
    deleted_role_stable_id="$(aws_primary iam get-role \
        --role-name "$STS_TEST_DELETED_ROLE_NAME" \
        --query 'Role.RoleId' \
        --output text)"

    if [[ "$expiry_collision" == true ]]; then
        assert_identity_decision \
            same-account-expiry-role \
            aws_primary \
            "$primary_arn" \
            "$STS_TEST_EXPIRY_ROLE_ARN" \
            implicitDeny
        create_scoped_role \
            "$STS_TEST_EXPIRY_ROLE_NAME" \
            /argmin-sts-oracle/same-account/ \
            "$trust_policy" \
            "$STS_TEST_EXPIRY_ROLE_ARN"
        wait_for_assume_role_success \
            same-account-expiry-role \
            aws_primary \
            "$STS_TEST_EXPIRY_ROLE_ARN"

        expired_role_session="$(aws_primary sts assume-role \
            --role-arn "$STS_TEST_EXPIRY_ROLE_ARN" \
            --role-session-name "$STS_TEST_EXPIRED_DELETED_ROLE_SESSION_NAME" \
            --duration-seconds 900 \
            --output json)"
        export STS_TEST_EXPIRED_DELETED_ACCESS_KEY
        export STS_TEST_EXPIRED_DELETED_SECRET_KEY
        export STS_TEST_EXPIRED_DELETED_SESSION_TOKEN
        STS_TEST_EXPIRED_DELETED_ACCESS_KEY="$(jq -er '.Credentials.AccessKeyId' <<<"$expired_role_session")"
        STS_TEST_EXPIRED_DELETED_SECRET_KEY="$(jq -er '.Credentials.SecretAccessKey' <<<"$expired_role_session")"
        STS_TEST_EXPIRED_DELETED_SESSION_TOKEN="$(jq -er '.Credentials.SessionToken' <<<"$expired_role_session")"

        expiry_liveness_session="$(aws_primary sts assume-role \
            --role-arn "$STS_TEST_EXPIRY_ROLE_ARN" \
            --role-session-name expiry-liveness-control \
            --duration-seconds 3600 \
            --output json)"
        export STS_TEST_EXPIRY_LIVENESS_ACCESS_KEY
        export STS_TEST_EXPIRY_LIVENESS_SECRET_KEY
        export STS_TEST_EXPIRY_LIVENESS_SESSION_TOKEN
        STS_TEST_EXPIRY_LIVENESS_ACCESS_KEY="$(jq -er '.Credentials.AccessKeyId' <<<"$expiry_liveness_session")"
        STS_TEST_EXPIRY_LIVENESS_SECRET_KEY="$(jq -er '.Credentials.SecretAccessKey' <<<"$expiry_liveness_session")"
        STS_TEST_EXPIRY_LIVENESS_SESSION_TOKEN="$(jq -er '.Credentials.SessionToken' <<<"$expiry_liveness_session")"
        expiry_liveness_access_key="$STS_TEST_EXPIRY_LIVENESS_ACCESS_KEY"
        expiry_liveness_secret_key="$STS_TEST_EXPIRY_LIVENESS_SECRET_KEY"
        expiry_liveness_session_token="$STS_TEST_EXPIRY_LIVENESS_SESSION_TOKEN"
        echo "same-account-expiry-sessions-issued: ok"
    fi

    wait_for_assume_role_success \
        same-account-role \
        aws_primary \
        "$STS_TEST_ROLE_ARN"
    wait_for_assume_role_success \
        same-account-wildcard-trust-role \
