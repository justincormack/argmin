        same-account-source-identity-no-set \
        aws_source_identity_session \
        "$STS_TEST_CHAIN_TARGET_ROLE_ARN"

    chain_source_session="$(aws_primary sts assume-role \
        --role-arn "$STS_TEST_ROLE_ARN" \
        --role-session-name "$STS_TEST_CHAIN_SOURCE_SESSION_NAME" \
        --duration-seconds 3600 \
        --output json)"
    export STS_TEST_CHAIN_ACCESS_KEY
    export STS_TEST_CHAIN_SECRET_KEY
    export STS_TEST_CHAIN_SESSION_TOKEN
