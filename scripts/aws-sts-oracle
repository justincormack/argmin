        --query 'Role.RoleId' \
        --output text)"
    [[ "$recreated_role_stable_id" != "$deleted_role_stable_id" ]] || \
        external_s3_test_die "recreated STS oracle role reused the deleted role's stable ID"
    export STS_TEST_RECREATED_ROLE_ID="$recreated_role_stable_id"
