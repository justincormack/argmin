    export STS_TEST_TOKEN_ISSUE_UPPER_BOUND
    recreated_expiration="$(jq -er '.Credentials.Expiration' <<<"$recreated_role_session")"
    recreated_expiration_epoch="$(date -u -d "$recreated_expiration" '+%s')"
    recreated_issue_epoch=$((recreated_expiration_epoch - 3600))
    STS_TEST_TOKEN_ISSUE_LOWER_BOUND="$(date -u \
        -d "@$((recreated_issue_epoch - 1))" '+%Y-%m-%dT%H:%M:%SZ')"
    STS_TEST_TOKEN_ISSUE_UPPER_BOUND="$(date -u \
        -d "@$((recreated_issue_epoch + 1))" '+%Y-%m-%dT%H:%M:%SZ')"

    create_role_get_object_fixture \
