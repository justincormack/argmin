    STS_TEST_CHAIN_SECRET_KEY="$(jq -er '.Credentials.SecretAccessKey' <<<"$chain_source_session")"
    STS_TEST_CHAIN_SESSION_TOKEN="$(jq -er '.Credentials.SessionToken' <<<"$chain_source_session")"
    chain_source_identity="$(aws_chaining_source sts get-caller-identity --output json)"
    [[ "$(jq -er '.Arn' <<<"$chain_source_identity")" == \
        "arn:aws:sts::${primary_account}:assumed-role/${STS_TEST_ROLE_NAME}/${STS_TEST_CHAIN_SOURCE_SESSION_NAME}" ]] || \
        external_s3_test_die "temporary STS chaining source has an unexpected caller ARN"
    echo "same-account-chain-source-identity: ok"
    other_live_session="$(aws_primary sts assume-role \
        --role-arn "$STS_TEST_ROLE_ARN" \
        --role-session-name token-binding-control \
        --duration-seconds 3600 \
        --output json)"
    other_live_access_key="$(jq -er '.Credentials.AccessKeyId' <<<"$other_live_session")"
    other_live_secret_key="$(jq -er '.Credentials.SecretAccessKey' <<<"$other_live_session")"
    other_live_session_token="$(jq -er '.Credentials.SessionToken' <<<"$other_live_session")"
    export STS_TEST_OTHER_LIVE_SESSION_TOKEN="$other_live_session_token"
    other_live_identity="$(aws_with_session_credentials \
        "$other_live_access_key" \
