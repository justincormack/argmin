#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/_external-s3-test-env.sh
source "$ROOT/scripts/_external-s3-test-env.sh"

usage() {
  cat <<'EOF'
Usage: ./scripts/cleanup [options]

Delete leftover AWS-backed test buckets, stale STS oracle roles, and stale
permissionless STS oracle users using the primary credentials from `.env`
(`TEST_AWS_PRIMARY_ACCESS_KEY` / `TEST_AWS_PRIMARY_SECRET_KEY`).

Options:
  --region REGION                 Override AWS region for API calls (default: TEST_S3_REGION or us-east-1)
  --endpoint URL                  Override the S3 endpoint URL (default: TEST_S3_ENDPOINT if set)
  --bucket-prefix PREFIX          Only clean buckets with this prefix (default: TEST_S3_BUCKET_PREFIX or claude-s3-)
  --sts-role-min-age-seconds N    Only delete matching STS fixtures at least N seconds old (default: 3600)
  --dotenv PATH                   Read AWS variables from a different env file
  -h, --help                      Show this help

Examples:
  ./scripts/cleanup
  ./scripts/cleanup --bucket-prefix claude-s3-
  ./scripts/cleanup --region us-west-2
EOF
}

region=""
endpoint=""
bucket_prefix=""
sts_role_min_age_seconds=3600
dotenv_path="$ROOT/.env"

while (($#)); do
  case "$1" in
    --region)
      [[ $# -ge 2 ]] || external_s3_test_die "--region requires a value"
      region="$2"
      shift 2
      ;;
    --endpoint)
      [[ $# -ge 2 ]] || external_s3_test_die "--endpoint requires a value"
      endpoint="$2"
      shift 2
      ;;
    --bucket-prefix)
      [[ $# -ge 2 ]] || external_s3_test_die "--bucket-prefix requires a value"
      bucket_prefix="$2"
      shift 2
      ;;
    --sts-role-min-age-seconds)
      [[ $# -ge 2 ]] || external_s3_test_die "--sts-role-min-age-seconds requires a value"
      sts_role_min_age_seconds="$2"
      shift 2
      ;;
    --dotenv)
      [[ $# -ge 2 ]] || external_s3_test_die "--dotenv requires a value"
      dotenv_path="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      external_s3_test_die "unknown argument: $1"
      ;;
  esac
done

cd "$ROOT"
external_s3_test_load_dotenv "$dotenv_path"
region="${region:-${TEST_S3_REGION:-us-east-1}}"
bucket_prefix="${bucket_prefix:-${TEST_S3_BUCKET_PREFIX:-claude-s3-}}"
endpoint="${endpoint:-${TEST_S3_ENDPOINT:-}}"
external_s3_test_require_shell_var TEST_AWS_PRIMARY_ACCESS_KEY
external_s3_test_require_shell_var TEST_AWS_PRIMARY_SECRET_KEY
[[ "$sts_role_min_age_seconds" =~ ^[0-9]+$ ]] || \
  external_s3_test_die "--sts-role-min-age-seconds must be a non-negative integer"

export AWS_ACCESS_KEY_ID="$TEST_AWS_PRIMARY_ACCESS_KEY"
export AWS_SECRET_ACCESS_KEY="$TEST_AWS_PRIMARY_SECRET_KEY"
export AWS_DEFAULT_REGION="$region"
export AWS_REGION="$region"
export AWS_PAGER=""

aws_s3api() {
  if [[ -n "$endpoint" ]]; then
    aws --endpoint-url "$endpoint" s3api "$@"
  else
    aws s3api "$@"
  fi
}

cleanup_stale_sts_oracle_roles() {
  local age_seconds created_at created_epoch inline_policies_file list_error now_epoch policy_name role role_count role_name role_path roles_file roles_rows

  roles_file="$tmpdir/sts-oracle-roles.json"
  roles_rows="$tmpdir/sts-oracle-role-rows.txt"
  list_error="$tmpdir/sts-oracle-list-roles.err"
  if ! aws iam list-roles \
    --path-prefix /argmin-sts-oracle/ \
    --output json > "$roles_file" 2> "$list_error"; then
    echo "Failed to list stale STS oracle roles; continuing bucket cleanup" >&2
    cat "$list_error" >&2
    failed=1
    return
  fi
  jq -r \
    '.Roles[] | select(
        (.Path == "/argmin-sts-oracle/same-account/" and
            ((.RoleName | startswith("path-shape-")) or
             (.RoleName | startswith("wildcard-trust-")) or
             (.RoleName | startswith("default-max-")) or
             (.RoleName | startswith("external-id-")) or
             (.RoleName | startswith("source-identity-")) or
             (.RoleName | startswith("chain-target-")) or
             (.RoleName | startswith("policy-mutation-")) or
             (.RoleName | startswith("expiry-role-")) or
             (.RoleName | startswith("deleted-role-")))) or
        (.Path == "/argmin-sts-oracle/cross-account/" and
            ((.RoleName | startswith("cross-success-")) or
             (.RoleName | startswith("cross-wildcard-success-")) or
             (.RoleName | startswith("cross-trust-denied-")))) or
        (.Path == "/argmin-sts-oracle/caller-denied/" and
            ((.RoleName | startswith("cross-caller-denied-")) or
             (.RoleName | startswith("cross-wildcard-caller-denied-"))))
    ) | @base64' \
    "$roles_file" > "$roles_rows"

  role_count=$(grep -c . "$roles_rows" 2>/dev/null || true)
  echo "$role_count STS oracle roles found..."
  now_epoch=$(date +%s)

  while IFS= read -r role; do
    [[ -n "$role" ]] || continue
    role=$(printf '%s' "$role" | base64 -d)
    role_name=$(jq -er '.RoleName' <<<"$role")
    role_path=$(jq -er '.Path' <<<"$role")
    created_at=$(jq -er '.CreateDate' <<<"$role")

    case "$role_path:$role_name" in
      /argmin-sts-oracle/same-account/:path-shape-* | \
        /argmin-sts-oracle/same-account/:wildcard-trust-* | \
        /argmin-sts-oracle/same-account/:default-max-* | \
        /argmin-sts-oracle/same-account/:external-id-* | \
        /argmin-sts-oracle/same-account/:source-identity-* | \
        /argmin-sts-oracle/same-account/:chain-target-* | \
        /argmin-sts-oracle/same-account/:policy-mutation-* | \
        /argmin-sts-oracle/same-account/:expiry-role-* | \
        /argmin-sts-oracle/same-account/:deleted-role-* | \
        /argmin-sts-oracle/cross-account/:cross-success-* | \
        /argmin-sts-oracle/cross-account/:cross-wildcard-success-* | \
        /argmin-sts-oracle/cross-account/:cross-trust-denied-* | \
        /argmin-sts-oracle/caller-denied/:cross-caller-denied-* | \
        /argmin-sts-oracle/caller-denied/:cross-wildcard-caller-denied-*) ;;
      *) continue ;;
    esac
    created_epoch=$(date -d "$created_at" +%s)
    age_seconds=$((now_epoch - created_epoch))
    if ((age_seconds < sts_role_min_age_seconds)); then
      echo "Kept recent STS oracle role $role_name (${age_seconds}s old)"
      continue
    fi

    inline_policies_file="$tmpdir/sts-oracle-${role_name}-inline-policies.json"
    if ! aws iam list-role-policies \
      --role-name "$role_name" \
      --output json > "$inline_policies_file"; then
      echo "Failed to list inline policies for stale STS oracle role $role_name" >&2
      failed=1
      continue
    fi
    while IFS= read -r policy_name; do
      [[ -n "$policy_name" ]] || continue
      if ! aws iam delete-role-policy \
        --role-name "$role_name" \
        --policy-name "$policy_name"; then
        echo "Failed to delete inline policy $policy_name from stale STS oracle role $role_name" >&2
        failed=1
      fi
    done < <(jq -r '.PolicyNames[]' "$inline_policies_file")

    if aws iam delete-role --role-name "$role_name"; then
      echo "Deleted stale STS oracle role $role_name"
    else
      echo "Failed to delete stale STS oracle role $role_name" >&2
      failed=1
    fi
  done < "$roles_rows"
}

cleanup_stale_sts_oracle_users() {
  local access_key_id access_keys_file age_seconds created_at created_epoch list_error now_epoch user user_count user_name user_path users_file users_rows

  users_file="$tmpdir/sts-oracle-users.json"
  users_rows="$tmpdir/sts-oracle-user-rows.txt"
  list_error="$tmpdir/sts-oracle-list-users.err"
  if ! aws iam list-users \
    --path-prefix /argmin-sts-oracle/ \
    --output json > "$users_file" 2> "$list_error"; then
    echo "Failed to list stale STS oracle users; continuing role and bucket cleanup" >&2
    cat "$list_error" >&2
    failed=1
    return
  fi
  jq -r \
    '.Users[] | select(
        .Path == "/argmin-sts-oracle/" and
        (.UserName | startswith("disabled-credential-"))
    ) | @base64' \
    "$users_file" > "$users_rows"

  user_count=$(grep -c . "$users_rows" 2>/dev/null || true)
  echo "$user_count STS oracle users found..."
  now_epoch=$(date +%s)

  while IFS= read -r user; do
    [[ -n "$user" ]] || continue
    user=$(printf '%s' "$user" | base64 -d)
    user_name=$(jq -er '.UserName' <<<"$user")
    user_path=$(jq -er '.Path' <<<"$user")
    created_at=$(jq -er '.CreateDate' <<<"$user")

    case "$user_path:$user_name" in
      /argmin-sts-oracle/:disabled-credential-*) ;;
      *) continue ;;
    esac
    created_epoch=$(date -d "$created_at" +%s)
    age_seconds=$((now_epoch - created_epoch))
    if ((age_seconds < sts_role_min_age_seconds)); then
      echo "Kept recent STS oracle user $user_name (${age_seconds}s old)"
      continue
    fi

    access_keys_file="$tmpdir/sts-oracle-${user_name}-access-keys.json"
    if ! aws iam list-access-keys \
      --user-name "$user_name" \
      --output json > "$access_keys_file"; then
      echo "Failed to list access keys for stale STS oracle user $user_name" >&2
      failed=1
      continue
    fi
    while IFS= read -r access_key_id; do
      [[ -n "$access_key_id" ]] || continue
      if ! aws iam delete-access-key \
        --user-name "$user_name" \
        --access-key-id "$access_key_id"; then
        echo "Failed to delete access key $access_key_id from stale STS oracle user $user_name" >&2
        failed=1
      fi
    done < <(jq -r '.AccessKeyMetadata[].AccessKeyId' "$access_keys_file")

    if aws iam delete-user --user-name "$user_name"; then
      echo "Deleted stale STS oracle user $user_name"
    else
      echo "Failed to delete stale STS oracle user $user_name" >&2
      failed=1
    fi
  done < "$users_rows"
}

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT INT TERM

disable_legal_hold() {
  bucket=$1
  key=$2
  version_id=$3

  [ -n "$version_id" ] || return 0
  [ "$version_id" != "null" ] || return 0

  aws_s3api put-object-legal-hold \
    --bucket "$bucket" \
    --key "$key" \
    --version-id "$version_id" \
    --legal-hold Status=OFF \
    >/dev/null 2>&1 || true
}

delete_version() {
  bucket=$1
  key=$2
  version_id=$3

  if [ -z "$version_id" ]; then
    return 1
  fi

  aws_s3api delete-object \
    --bucket "$bucket" \
    --key "$key" \
    --version-id "$version_id" \
    --bypass-governance-retention \
    >/dev/null 2>&1 && return 0

  aws_s3api delete-object \
    --bucket "$bucket" \
    --key "$key" \
    --version-id "$version_id" \
    >/dev/null 2>&1 && return 0

  if [ "$version_id" = "null" ]; then
    aws_s3api delete-object \
      --bucket "$bucket" \
      --key "$key" \
      --bypass-governance-retention \
      >/dev/null 2>&1 && return 0

    aws_s3api delete-object \
      --bucket "$bucket" \
      --key "$key" \
      >/dev/null 2>&1 && return 0
  fi

  return 1
}

delete_marker() {
  bucket=$1
  key=$2
  version_id=$3

  aws_s3api delete-object \
    --bucket "$bucket" \
    --key "$key" \
    --version-id "$version_id" \
    >/dev/null 2>&1
}

delete_current_object() {
  bucket=$1
  key=$2

  aws_s3api delete-object \
    --bucket "$bucket" \
    --key "$key" \
    --bypass-governance-retention \
    >/dev/null 2>&1 && return 0

  aws_s3api delete-object \
    --bucket "$bucket" \
    --key "$key" \
    >/dev/null 2>&1
}

bucketlist="$tmpdir/bucketlist"
aws_s3api list-buckets --query 'Buckets[].Name' --output text \
  | tr '\t' '\n' \
  | grep "^$bucket_prefix" > "$bucketlist" || true

echo "$(grep -c . "$bucketlist" 2>/dev/null || true) buckets to go..."

failed=0
cleanup_stale_sts_oracle_users
cleanup_stale_sts_oracle_roles

for bucket in $(head -100 "$bucketlist")
do
  versions_file="$tmpdir/$bucket-versions.json"
  version_rows="$tmpdir/$bucket-version-rows.txt"
  marker_rows="$tmpdir/$bucket-marker-rows.txt"
  objects_file="$tmpdir/$bucket-objects.json"
  object_rows="$tmpdir/$bucket-object-rows.txt"
  bucket_failed=0

  aws_s3api list-object-versions \
    --bucket "$bucket" \
    --output json \
    > "$versions_file"

  jq -r '.Versions[]? | @base64' "$versions_file" > "$version_rows"
  jq -r '.DeleteMarkers[]? | @base64' "$versions_file" > "$marker_rows"

  versions_count=$(jq '(.Versions // []) | length' "$versions_file")
  markers_count=$(jq '(.DeleteMarkers // []) | length' "$versions_file")

  if [ "$versions_count" -gt 0 ]; then
    while IFS= read -r row
    do
      [ -n "$row" ] || continue

      entry=$(printf '%s' "$row" | base64 -d)
      key=$(printf '%s' "$entry" | jq -r '.Key')
      version_id=$(printf '%s' "$entry" | jq -r '.VersionId')

      disable_legal_hold "$bucket" "$key" "$version_id"

      if ! delete_version "$bucket" "$key" "$version_id"; then
        retention_mode=$(
          aws_s3api get-object-retention \
            --bucket "$bucket" \
            --key "$key" \
            --version-id "$version_id" \
            --output json \
            2>/dev/null \
            | jq -r '.Retention.Mode // empty' 2>/dev/null || true
        )

        if [ "$retention_mode" = "COMPLIANCE" ]; then
          echo "Failed to delete $bucket/$key@$version_id: compliance retention is still active" >&2
        else
          echo "Failed to delete $bucket/$key@$version_id" >&2
        fi

        bucket_failed=1
      fi
    done < "$version_rows"
  fi

  if [ "$markers_count" -gt 0 ]; then
    while IFS= read -r row
    do
      [ -n "$row" ] || continue

      entry=$(printf '%s' "$row" | base64 -d)
      key=$(printf '%s' "$entry" | jq -r '.Key')
      version_id=$(printf '%s' "$entry" | jq -r '.VersionId')

      if ! delete_marker "$bucket" "$key" "$version_id"; then
        echo "Failed to delete delete-marker $bucket/$key@$version_id" >&2
        bucket_failed=1
      fi
    done < "$marker_rows"
  fi

  aws_s3api list-objects-v2 \
    --bucket "$bucket" \
    --output json \
    > "$objects_file"

  jq -r '.Contents[]? | @base64' "$objects_file" > "$object_rows"

  while IFS= read -r row
  do
    [ -n "$row" ] || continue

    entry=$(printf '%s' "$row" | base64 -d)
    key=$(printf '%s' "$entry" | jq -r '.Key')

    if ! delete_current_object "$bucket" "$key"; then
      echo "Failed to delete current object $bucket/$key" >&2
      bucket_failed=1
    fi
  done < "$object_rows"

  if [ "$bucket_failed" -eq 0 ] && aws_s3api delete-bucket --bucket "$bucket" >/dev/null 2>&1; then
    echo "Deleted $bucket"
  else
    echo "Skipped deleting $bucket" >&2
    failed=1
  fi
done

exit "$failed"
