#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

echo "== release control-plane invariant boundary =="
cargo nextest run --release -p storage \
    control_plane_raft_checkpoint_rejects_capture_from_another_authority \
    control_plane_raft_checkpoint_rejects_stale_capture_before_publication \
    control_plane_raft_captured_checkpoint_preserves_post_capture_wal_suffix \
    command_apply_rejects_invalid_snapshot_before_publication \
    direct_snapshot_commit_validates_control_plane_invariants \
    captured_checkpoint_is_bound_to_its_store_instance \
    captured_checkpoint_persists_without_authority_mutex \
    captured_checkpoint_preserves_conservative_suffix_age \
    captured_checkpoint_rebases_commands_appended_during_persistence \
    checkpoint_capture_uses_tracked_offset_without_scanning_journal \
    checkpoint_failure_latches_poison_before_concurrent_command_can_append \
    file_backed_authority_checkpoint_is_due_at_time_bound \
    file_backed_authority_checkpoints_at_command_and_byte_bounds \
    stale_captured_checkpoint_is_rejected_before_publication \
    control_plane_raft_captured_checkpoint_persists_outside_state_machine_boundary \
    control_plane_raft_wal_monitor_does_not_enter_state_machine \
    open_validates_control_plane_invariants_before_saving \
    replicated_control_plane_state_machine_fatal_invariant_does_not_advance \
    replicated_state_machine_constructor_validates_control_plane_invariants \
    replicated_snapshot_install_validates_control_plane_invariants_before_mutation

echo
echo "== release control-plane write-amplification boundary =="
cargo nextest run --release -p argmin-s3 --bin argmin-s3 \
    raft_production_shaped_heartbeat_write_amplification_gate \
    raft_peer_vote_acks_from_wal_then_bounded_checkpoint_compacts \
    raft_wal_checkpoint_observer_captures_local_election_without_peer_rpc \
    --success-output immediate

echo
echo "== release control-plane process suite =="
# Release binaries accept the environment-shaped split-process fixture only
# through its explicit test compatibility feature.
cargo nextest run --release -p argmin-s3 --test raft_process \
    --features test-unauthenticated-internal-rpc
