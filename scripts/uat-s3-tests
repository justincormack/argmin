#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
    cat <<'EOF'
Usage: ./scripts/uat-s3-tests [options] [cargo test args...]

Start the standalone `argmin-s3` binary with UAT-only test credentials, then
run `s3-tests` against that process as an external S3 endpoint.

Options:
  --listen ADDR          Server listen address (default: 127.0.0.1:19000)
  --data-dir PATH        Server data directory (default: temporary directory)
  --bucket-prefix PREFIX Bucket prefix for s3-tests (default: argmin-s3-)
  --timeout-secs SECS    S3 client timeout (default: 30)
  --release              Run the release binary via cargo run --release
  --no-cleanup           Keep the temporary data directory after the run
  -h, --help             Show this help

Examples:
  ./scripts/uat-s3-tests --test bucket_crud -- --nocapture
  ./scripts/uat-s3-tests --release
EOF
}

die() {
    echo "error: $*" >&2
    exit 2
}

listen_addr="${ARGMIN_UAT_LISTEN_ADDR:-127.0.0.1:19000}"
data_dir="${ARGMIN_UAT_DATA_DIR:-}"
bucket_prefix="${S3_TEST_BUCKET_PREFIX:-argmin-s3-}"
timeout_secs="${S3_TEST_TIMEOUT_SECS:-30}"
release=0
cleanup=1
cargo_args=()

while (($#)); do
    case "$1" in
        --listen)
            [[ $# -ge 2 ]] || die "--listen requires a value"
            listen_addr="$2"
            shift 2
            ;;
        --data-dir)
            [[ $# -ge 2 ]] || die "--data-dir requires a value"
            data_dir="$2"
            cleanup=0
            shift 2
            ;;
        --bucket-prefix)
            [[ $# -ge 2 ]] || die "--bucket-prefix requires a value"
            bucket_prefix="$2"
            shift 2
            ;;
        --timeout-secs)
            [[ $# -ge 2 ]] || die "--timeout-secs requires a value"
            timeout_secs="$2"
            shift 2
            ;;
        --release)
            release=1
            shift
            ;;
        --no-cleanup)
            cleanup=0
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            cargo_args+=("$@")
            break
            ;;
        *)
            cargo_args+=("$1")
            shift
            ;;
    esac
done

cd "$ROOT"

if [[ -z "$data_dir" ]]; then
    data_dir="$(mktemp -d "${TMPDIR:-/tmp}/argmin-s3-uat.XXXXXX")"
fi
server_log="$data_dir/argmin-s3.log"

host="${listen_addr%:*}"
port="${listen_addr##*:}"
if [[ "$host" == "$listen_addr" || -z "$port" ]]; then
    die "--listen must be host:port"
fi

endpoint="https://localhost:$port"
cert_path="$ROOT/crates/s3-tests/testdata/localhost-cert.pem"
key_path="$ROOT/crates/s3-tests/testdata/localhost-key.pem"
ca_path="$ROOT/crates/s3-tests/testdata/ca-cert.pem"

export ARGMIN_ACCOUNT_ID="${ARGMIN_ACCOUNT_ID:-111122223333}"
export ARGMIN_ACCESS_KEY_ID="${ARGMIN_ACCESS_KEY_ID:-argmin-primary}"
export ARGMIN_SECRET_ACCESS_KEY="${ARGMIN_SECRET_ACCESS_KEY:-argmin-primary-secret}"
export ARGMIN_UAT_ALT_ACCOUNT_ID="${ARGMIN_UAT_ALT_ACCOUNT_ID:-444455556666}"
export ARGMIN_UAT_ALT_ACCESS_KEY_ID="${ARGMIN_UAT_ALT_ACCESS_KEY_ID:-argmin-alt}"
export ARGMIN_UAT_ALT_SECRET_ACCESS_KEY="${ARGMIN_UAT_ALT_SECRET_ACCESS_KEY:-argmin-alt-secret}"
export ARGMIN_UAT_SECOND_ACCESS_KEY_ID="${ARGMIN_UAT_SECOND_ACCESS_KEY_ID:-argmin-second}"
export ARGMIN_UAT_SECOND_SECRET_ACCESS_KEY="${ARGMIN_UAT_SECOND_SECRET_ACCESS_KEY:-argmin-second-secret}"
export ARGMIN_UAT_OWNER_ROOT_ACCESS_KEY_ID="${ARGMIN_UAT_OWNER_ROOT_ACCESS_KEY_ID:-argmin-owner-root}"
export ARGMIN_UAT_OWNER_ROOT_SECRET_ACCESS_KEY="${ARGMIN_UAT_OWNER_ROOT_SECRET_ACCESS_KEY:-argmin-owner-root-secret}"
export ARGMIN_SSE_S3_WRAPPING_KEY="${ARGMIN_SSE_S3_WRAPPING_KEY:-MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=}"
export ARGMIN_SSE_C_VALIDATOR_KEY="${ARGMIN_SSE_C_VALIDATOR_KEY:-MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=}"
export ARGMIN_LISTEN_ADDR="$listen_addr"
export ARGMIN_DATA_DIR="$data_dir"
export ARGMIN_TLS_CERT_PATH="${ARGMIN_TLS_CERT_PATH:-$cert_path}"
export ARGMIN_TLS_KEY_PATH="${ARGMIN_TLS_KEY_PATH:-$key_path}"
export ARGMIN_REGION="${ARGMIN_REGION:-us-east-1}"

export S3_TEST_ENDPOINT="$endpoint"
export S3_TEST_ACCESS_KEY="$ARGMIN_ACCESS_KEY_ID"
export S3_TEST_SECRET_KEY="$ARGMIN_SECRET_ACCESS_KEY"
export S3_TEST_ACCOUNT_ID="$ARGMIN_ACCOUNT_ID"
export S3_TEST_ALT_ACCESS_KEY="$ARGMIN_UAT_ALT_ACCESS_KEY_ID"
export S3_TEST_ALT_SECRET_KEY="$ARGMIN_UAT_ALT_SECRET_ACCESS_KEY"
export S3_TEST_ALT_ACCOUNT_ID="$ARGMIN_UAT_ALT_ACCOUNT_ID"
export S3_TEST_SECOND_ACCESS_KEY="$ARGMIN_UAT_SECOND_ACCESS_KEY_ID"
export S3_TEST_SECOND_SECRET_KEY="$ARGMIN_UAT_SECOND_SECRET_ACCESS_KEY"
export S3_TEST_OWNER_ROOT_ACCESS_KEY="$ARGMIN_UAT_OWNER_ROOT_ACCESS_KEY_ID"
export S3_TEST_OWNER_ROOT_SECRET_KEY="$ARGMIN_UAT_OWNER_ROOT_SECRET_ACCESS_KEY"
export S3_TEST_REGION="$ARGMIN_REGION"
export S3_TEST_BUCKET_PREFIX="$bucket_prefix"
export S3_TEST_TIMEOUT_SECS="$timeout_secs"
export S3_TEST_TLS_CA_CERT_PATH="${S3_TEST_TLS_CA_CERT_PATH:-$ca_path}"

server_cmd=(cargo run -p argmin-s3)
if ((release)); then
    server_cmd+=(--release)
fi
server_cmd+=(--)

echo "== argmin-s3 UAT server =="
printf '+'
printf ' %q' "${server_cmd[@]}"
printf '\n'
"${server_cmd[@]}" >"$server_log" 2>&1 &
server_pid=$!

cleanup_server() {
    local status=$?
    if kill -0 "$server_pid" 2>/dev/null; then
        kill "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
    if ((cleanup)); then
        rm -rf "$data_dir"
    else
        echo "UAT data directory kept at $data_dir" >&2
        echo "UAT server log kept at $server_log" >&2
    fi
    exit "$status"
}
trap cleanup_server EXIT INT TERM

for _ in {1..200}; do
    if ! kill -0 "$server_pid" 2>/dev/null; then
        cat "$server_log" >&2 || true
        die "argmin-s3 exited before becoming ready"
    fi
    if curl -k -sS "$endpoint/" >/dev/null 2>&1; then
        break
    fi
    sleep 0.1
done

if ! curl -k -sS "$endpoint/" >/dev/null 2>&1; then
    cat "$server_log" >&2 || true
    die "argmin-s3 did not become ready at $endpoint"
fi

cmd=(cargo test -p s3-tests --no-fail-fast)
cmd+=("${cargo_args[@]}")

echo "== argmin-s3 UAT s3-tests =="
printf '+'
printf ' %q' "${cmd[@]}"
printf '\n'
"${cmd[@]}"
