        latest_metric_family_top "$metrics_log" background_work_admission_by_class_elapsed_us_total 10 >&2 || true
    else
        echo "metrics unavailable" >&2
    fi
    local slowdown_log_match_lines
    local slowdown_log_match_count=0
    if ((${#server_logs[@]})); then
        slowdown_log_match_lines="$(grep -hE "request_error .*status=503|SlowDown|slow_down" "${server_logs[@]}" 2>/dev/null || true)"
        if [[ -n "$slowdown_log_match_lines" ]]; then
            slowdown_log_match_count="$(printf '%s\n' "$slowdown_log_match_lines" | wc -l | tr -d ' ')"
        fi
    fi
    echo "log_matches status_503_or_slowdown=$slowdown_log_match_count" >&2
}

cleanup_server() {
    local status=$?
    if [[ -n "${metrics_sampler_pid:-}" ]] && kill -0 "$metrics_sampler_pid" 2>/dev/null; then
        kill "$metrics_sampler_pid" 2>/dev/null || true
        wait "$metrics_sampler_pid" 2>/dev/null || true
    fi
    if ((status != 0)) && [[ -n "${frontend_pid:-}" ]] && kill -0 "$frontend_pid" 2>/dev/null; then
        echo "== argmin-s3 UAT frontend flight recorder dump request ==" >&2
        if ! curl -k -sS -X POST "$endpoint/__argmin/debug/flight-recorder/dump" >/dev/null 2>&1; then
            echo "frontend flight recorder dump request failed" >&2
        fi
    fi
    for pid in "${server_pids[@]}"; do
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
        fi
    done
    for pid in "${server_pids[@]}"; do
        wait "$pid" 2>/dev/null || true
    done
    print_slowdown_summary
    if ((status != 0)); then
        echo "== argmin-s3 UAT failure diagnostics ==" >&2
        local found_diagnostics=0
        for index in "${!server_logs[@]}"; do
            local log_path="${server_logs[$index]}"
            local name="${server_names[$index]}"
            if [[ ! -s "$log_path" ]]; then
                continue
            fi
            local matches
            matches="$(
                grep -nE \
                    "server produced HTTP 500|HTTP response conversion produced InternalError|dispatch_internal_error|request_error .*status=(409|500)|OperationAborted|cause_label=|request_admission_(wait|timeout)|metadata_command_conflict|metadata_command_pending_slot_action|storage_rpc_error|flight .*request_error|bucket delete (begin|finalize) found visible data|panicked at|panic|aborted" \
                    "$log_path" \
                    | head -n 120 \
                    || true
            )"
            if [[ -n "$matches" ]]; then
                found_diagnostics=1
                echo "== argmin-s3 UAT $name diagnostic matches ==" >&2
                printf '%s\n' "$matches" >&2
            fi
        done
        if ((found_diagnostics == 0)); then
            echo "no HTTP error, cause-label, metadata-command, panic, or abort diagnostics found in server logs" >&2
        fi
        local metrics_log="$logs_dir/frontend-metrics-samples.log"
        if [[ -s "$metrics_log" ]]; then
            echo "== argmin-s3 UAT frontend metrics sample tail ==" >&2
            tail -n 120 "$metrics_log" >&2 || true
        fi
        for index in "${!server_logs[@]}"; do
            local log_path="${server_logs[$index]}"
            local name="${server_names[$index]}"
            echo "== argmin-s3 UAT $name log ==" >&2
            if [[ -s "$log_path" ]]; then
                tail -n 200 "$log_path" >&2 || true
            else
                echo "server log is empty: $log_path" >&2
            fi
        done
    fi
    if ((cleanup)); then
        rm -rf "$data_dir"
    else
        echo "UAT data directory kept at $data_dir" >&2
        echo "UAT server logs kept at $logs_dir" >&2
    fi
    exit "$status"
}
trap cleanup_server EXIT INT TERM

if [[ -n "$server_binary" ]]; then
    server_cmd=("$server_binary")
elif [[ "$topology" == "multihost" ]]; then
    build_cmd=(cargo build -p argmin-s3)
    if [[ -n "${ARGMIN_TRACE:-}" || -n "${ARGMIN_TRACE_FILE:-}" ]]; then
        build_cmd+=(--features deep-tracing)
    fi
    if ((release)); then
        build_cmd+=(--release)
        built_binary="$ROOT/target/release/argmin-s3"
    else
        built_binary="$ROOT/target/debug/argmin-s3"
    fi
    echo "== argmin-s3 UAT build =="
    print_command "${build_cmd[@]}"
    "${build_cmd[@]}"
    server_cmd=("$built_binary")
else
    server_cmd=(cargo run -p argmin-s3)
    if [[ -n "${ARGMIN_TRACE:-}" || -n "${ARGMIN_TRACE_FILE:-}" ]]; then
        server_cmd+=(--features deep-tracing)
    fi
    if ((release)); then
        server_cmd+=(--release)
    fi
    server_cmd+=(--)
fi

if [[ "$smoke" == "shard-repair" ]]; then
    echo "== argmin-s3 UAT shard repair smoke helper build =="
    print_command cargo build -p s3-tests --bin uat_shard_repair_smoke
    cargo build -p s3-tests --bin uat_shard_repair_smoke
    shard_repair_smoke_cmd=("$ROOT/target/debug/uat_shard_repair_smoke")
elif [[ "$smoke" == "pg-backfill-migration" ]]; then
    echo "== argmin-s3 UAT PG backfill smoke helper build =="
    print_command cargo build -p s3-tests --bin uat_pg_backfill_smoke
    cargo build -p s3-tests --bin uat_pg_backfill_smoke
    pg_backfill_smoke_cmd=("$ROOT/target/debug/uat_pg_backfill_smoke")
fi

if [[ "$topology" == "local" ]]; then
    start_process "local server" "$server_log" env \
        -u ARGMIN_STORAGE_NODE_ID \
        -u ARGMIN_STORAGE_NODE_DATA_DIR \
        -u ARGMIN_STORAGE_NODE_SOCKET_PATH \
        -u ARGMIN_STORAGE_NODE_SOCKETS \
        ARGMIN_PROCESS_ROLE=legacy-local \
        ARGMIN_BUCKET_DELETE_VISIBLE_DATA_DIAGNOSTICS=1 \
        ARGMIN_METADATA_COMMAND_CONFLICT_DIAGNOSTICS=1 \
        ARGMIN_LOCAL_DEBUG_ENDPOINT="$uat_local_debug_endpoint" \
        ARGMIN_DATA_DIR="$data_dir" \
        ARGMIN_LISTEN_ADDR="$listen_addr" \
        "${server_cmd[@]}"
else
    socket_entries=()
    for ((node_id = 0; node_id < ARGMIN_LOCAL_NODE_COUNT; node_id++)); do
        socket_path="$sockets_dir/node-$(printf '%04d' "$node_id").sock"
        socket_entries+=("$node_id=$socket_path")
    done
    storage_node_sockets="$(
        IFS=,
        echo "${socket_entries[*]}"
    )"

    if [[ "$smoke" == "control-plane-runtime-map" || "$smoke" == "pg-backfill-migration" ]]; then
        start_control_plane
        wait_for_control_plane_socket
        if [[ "$smoke" == "pg-backfill-migration" ]]; then
            set_all_pg_acting_sets "initial old placement nodes 0,1" 0 1
        fi
    fi

    for ((node_id = 0; node_id < ARGMIN_LOCAL_NODE_COUNT; node_id++)); do
        start_storage_node "$node_id"
    done

    for ((node_id = 0; node_id < ARGMIN_LOCAL_NODE_COUNT; node_id++)); do
        wait_for_storage_node_socket "$node_id"
    done

    if [[ "$smoke" == "pg-backfill-migration" ]]; then
        wait_for_control_plane_node_epochs_aligned 10
        wait_for_control_plane_runtime_map_ready 10 "$(control_plane_node_aligned_epoch)"
    fi

    frontend_log="$logs_dir/frontend.log"
    if [[ "$smoke" == "control-plane-runtime-map" || "$smoke" == "pg-backfill-migration" ]]; then
        start_process "frontend" "$frontend_log" env \
            -u ARGMIN_STORAGE_NODE_ID \
            -u ARGMIN_STORAGE_NODE_DATA_DIR \
            -u ARGMIN_STORAGE_NODE_SOCKET_PATH \
            -u ARGMIN_STORAGE_NODE_SOCKETS \
            ARGMIN_PROCESS_ROLE=frontend \
            ARGMIN_BUCKET_DELETE_VISIBLE_DATA_DIAGNOSTICS=1 \
            ARGMIN_METADATA_COMMAND_CONFLICT_DIAGNOSTICS=1 \
            ARGMIN_LOCAL_DEBUG_ENDPOINT="$uat_local_debug_endpoint" \
            ARGMIN_CONTROL_PLANE_SOCKET_PATH="$control_plane_socket_path" \
            ARGMIN_DATA_DIR="$data_dir/frontend" \
            "${server_cmd[@]}"
    else
        start_process "frontend" "$frontend_log" env \
            -u ARGMIN_STORAGE_NODE_ID \
            -u ARGMIN_STORAGE_NODE_DATA_DIR \
            -u ARGMIN_STORAGE_NODE_SOCKET_PATH \
            ARGMIN_PROCESS_ROLE=frontend \
            ARGMIN_BUCKET_DELETE_VISIBLE_DATA_DIAGNOSTICS=1 \
            ARGMIN_METADATA_COMMAND_CONFLICT_DIAGNOSTICS=1 \
            ARGMIN_LOCAL_DEBUG_ENDPOINT="$uat_local_debug_endpoint" \
            ARGMIN_STORAGE_NODE_SOCKETS="$storage_node_sockets" \
            ARGMIN_DATA_DIR="$data_dir/frontend" \
            "${server_cmd[@]}"
    fi
fi

frontend_index=$((${#server_pids[@]} - 1))
frontend_pid="${server_pids[$frontend_index]}"
frontend_log="${server_logs[$frontend_index]}"
readiness_url="$endpoint/"
case "$uat_local_debug_endpoint" in
    1|true|TRUE|True|yes|YES|Yes|on|ON|On)
        readiness_url="$endpoint/__argmin/debug/metrics"
        ;;
esac

for _ in {1..200}; do
    wait_for_process "$frontend_pid" "$frontend_log" "frontend"
    if curl -k -sS "$readiness_url" >/dev/null 2>&1; then
        wait_for_process "$frontend_pid" "$frontend_log" "frontend"
        break
    fi
    sleep 0.1
done

wait_for_process "$frontend_pid" "$frontend_log" "frontend"
if ! curl -k -sS "$readiness_url" >/dev/null 2>&1; then
    cat "$frontend_log" >&2 || true
    die "argmin-s3 did not become ready at $endpoint"
fi

start_metrics_sampler() {
    local metrics_url="$endpoint/__argmin/debug/metrics"
    local metrics_log="$logs_dir/frontend-metrics-samples.log"
    (
        while true; do
            printf 'ts=%(%s)T\n' -1
            curl -k -sS "$metrics_url" || true
            printf '\n'
            sleep 1
        done
    ) >"$metrics_log" 2>&1 &
    metrics_sampler_pid="$!"
    echo "== argmin-s3 UAT frontend metrics samples: $metrics_log =="
}

case "$uat_local_debug_endpoint" in
    1|true|TRUE|True|yes|YES|Yes|on|ON|On)
        start_metrics_sampler
        ;;
esac

run_nextest() {
    local label="$1"
    shift
    local cmd=(cargo nextest run -p s3-tests)
    if (($#)); then
        cmd+=("$@")
    fi

    for ((iteration = 1; iteration <= repeat_count; iteration++)); do
        if ((repeat_count > 1)); then
            echo "== argmin-s3 UAT $label iteration $iteration/$repeat_count =="
        else
            echo "== argmin-s3 UAT $label =="
        fi
        printf '+'
        printf ' %q' "${cmd[@]}"
        printf '\n'
        set +e
        "${cmd[@]}"
        local status=$?
        set -e
        if ((status != 0)); then
            print_slowdown_summary
            return "$status"
        fi
    done
}

run_nextest_expect_failure() {
    local label="$1"
    shift
    local cmd=(cargo nextest run -p s3-tests)
    if (($#)); then
        cmd+=("$@")
    fi
    local failure_log="$logs_dir/${label// /-}.log"

    echo "== argmin-s3 UAT $label =="
    printf '+'
    printf ' %q' "${cmd[@]}"
    printf '\n'
    set +e
    "${cmd[@]}" >"$failure_log" 2>&1
    local status=$?
    set -e
    if ((status == 0)); then
        cat "$failure_log" >&2 || true
        die "$label unexpectedly passed"
    fi
    if ! grep -Eq "InternalError|DispatchFailure|ServiceError" "$failure_log"; then
        cat "$failure_log" >&2 || true
        die "$label failed without a clear S3/client error"
    fi
    echo "== argmin-s3 UAT $label expected failure observed =="
    if grep -m1 -E "InternalError|DispatchFailure|ServiceError" "$failure_log"; then
        :
    fi
    echo "PASS: $label failed closed as expected"
    echo "Captured expected-failure log: $failure_log"
    echo "Summary: expected failure observed; UAT smoke passed"
}

run_shard_repair_smoke() {
    local smoke_dir="$data_dir/shard-repair-smoke"
    local bucket_file="$smoke_dir/bucket"
    local body_file="$smoke_dir/body.bin"
    local corrupted_path_file="$smoke_dir/corrupted-shard-path"
    local corrupted_copy="$smoke_dir/corrupted-shard.bin"
    local metrics_path="$smoke_dir/metrics.prom"
    local shard_marker="$smoke_dir/pre-put-shard-marker"
    local key="uat-shard-repair-object"
    mkdir -p "$smoke_dir"
    printf 'argmin shard repair UAT payload\n%.0s' {1..512} >"$body_file"
    : >"$shard_marker"

    echo "== argmin-s3 UAT shard repair put =="
    printf '+'
    printf ' %q' "${shard_repair_smoke_cmd[@]}" put "$bucket_file" "$key" "$body_file"
    printf '\n'
    "${shard_repair_smoke_cmd[@]}" put "$bucket_file" "$key" "$body_file"

    wait_for_storage_shard_files "$((ARGMIN_EC_K + ARGMIN_EC_M))" 10 "$shard_marker"
    corrupt_storage_data_shard_file "$corrupted_path_file" "$shard_marker"
    cp "$(cat "$corrupted_path_file")" "$corrupted_copy"

    echo "== argmin-s3 UAT shard repair foreground recovery read =="
    printf '+'
    printf ' %q' "${shard_repair_smoke_cmd[@]}" get "$bucket_file" "$key" "$body_file"
    printf '\n'
    "${shard_repair_smoke_cmd[@]}" get "$bucket_file" "$key" "$body_file"

    wait_for_shard_repair_completion_metrics "$metrics_path" 20
    if cmp -s "$(cat "$corrupted_path_file")" "$corrupted_copy"; then
        die "shard repair metrics completed but corrupted shard file did not change"
    fi

    echo "== argmin-s3 UAT shard repair post-repair read =="
    printf '+'
    printf ' %q' "${shard_repair_smoke_cmd[@]}" get "$bucket_file" "$key" "$body_file"
    printf '\n'
    "${shard_repair_smoke_cmd[@]}" get "$bucket_file" "$key" "$body_file"

    echo "== argmin-s3 UAT shard repair cleanup =="
    printf '+'
    printf ' %q' "${shard_repair_smoke_cmd[@]}" cleanup "$bucket_file" "$key"
    printf '\n'
    "${shard_repair_smoke_cmd[@]}" cleanup "$bucket_file" "$key"
    echo "PASS: shard repair UAT smoke repaired a read-discovered corrupt shard"
}

run_pg_backfill_migration_smoke() {
    local iteration="${1:-1}"
    local smoke_dir="$data_dir/pg-backfill-migration-smoke/iteration-$iteration"
    local bucket_file="$smoke_dir/bucket"
    local old_key_file="$smoke_dir/old-key"
    local new_key_file="$smoke_dir/new-key"
    local data_pg_file="$smoke_dir/data-pg"
    local old_body_file="$smoke_dir/old-body.bin"
    local new_body_file="$smoke_dir/new-body.bin"
    local metrics_path="$smoke_dir/metrics.prom"
    local target_data_pg=$((iteration - 1))
    mkdir -p "$smoke_dir"
    printf 'argmin PG backfill old-placement payload\n%.0s' {1..512} >"$old_body_file"
    printf 'argmin PG backfill new-placement payload\n%.0s' {1..512} >"$new_body_file"

    if ((repeat_count > 1)); then
        echo "== argmin-s3 UAT PG backfill migration iteration $iteration/$repeat_count =="
    fi

    set_pg_acting_set "old placement nodes 0,1 for PG backfill iteration $iteration" "$target_data_pg" 0 1
    wait_for_control_plane_pg_active "$target_data_pg" 10 "0:1"
    wait_for_control_plane_node_epochs_aligned 10
    wait_for_control_plane_runtime_map_ready 10 "$(control_plane_node_aligned_epoch)"
    wait_for_frontend_storage_epoch_at_least "$(control_plane_node_aligned_epoch)" 10 "$metrics_path"
    sample_frontend_metrics "$metrics_path"
    local reset_min_scan_total
    local reset_min_enqueued
    local reset_min_written
    local reset_min_completed
    local reset_min_routine_admitted
    local reset_min_routine_finished
    local reset_max_candidate_failed
    local reset_max_scan_error
    local reset_max_complete_failed
    local reset_max_failed
    local reset_max_record_error_failed
    reset_min_scan_total="$(($(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_scan_total) + 1))"
    reset_min_enqueued="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_enqueued_total)"
    reset_min_written="$(latest_metric_sample_value "$metrics_path" shard_backfill_shards_written_total)"
    reset_min_completed="$(latest_metric_family_label_sum "$metrics_path" shard_backfill_event_by_pg_total event complete_succeeded)"
    reset_min_routine_admitted="$(latest_metric_family_label_sum "$metrics_path" background_work_admission_by_class_total event admitted class routine_backfill)"
    reset_min_routine_finished="$(latest_metric_family_label_sum "$metrics_path" background_work_admission_by_class_total event finished class routine_backfill)"
    reset_max_candidate_failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_failed_total)"
    reset_max_scan_error="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_scan_error_total)"
    reset_max_complete_failed="$(latest_metric_family_label_sum "$metrics_path" shard_backfill_event_by_pg_total event complete_failed)"
    reset_max_failed="$(latest_metric_family_label_sum "$metrics_path" shard_backfill_event_by_pg_total event failed)"
    reset_max_record_error_failed="$(latest_metric_family_label_sum "$metrics_path" shard_backfill_event_by_pg_total event record_error_failed)"
    wait_for_shard_backfill_completion_metrics \
        "$metrics_path" \
        20 \
        "$reset_min_scan_total" \
        "$reset_min_enqueued" \
        "$reset_min_written" \
        "$reset_min_completed" \
        "$reset_min_routine_admitted" \
        "$reset_min_routine_finished" \
        "$reset_max_candidate_failed" \
        "$reset_max_scan_error" \
        "$reset_max_complete_failed" \
        "$reset_max_failed" \
        "$reset_max_record_error_failed"

    echo "== argmin-s3 UAT PG backfill old-placement put =="
    print_command "${pg_backfill_smoke_cmd[@]}" create-put-distinct-data-pg "$bucket_file" "$old_key_file" "$data_pg_file" "uat-pg-backfill-old-object-$iteration" "$old_body_file" "$target_data_pg"
    "${pg_backfill_smoke_cmd[@]}" create-put-distinct-data-pg "$bucket_file" "$old_key_file" "$data_pg_file" "uat-pg-backfill-old-object-$iteration" "$old_body_file" "$target_data_pg"
    local old_key
    old_key="$(tr -d '[:space:]' <"$old_key_file")"
    local data_pg
    data_pg="$(tr -d '[:space:]' <"$data_pg_file")"

    echo "== argmin-s3 UAT PG backfill old-placement read =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"

    sample_frontend_metrics "$metrics_path"
    local min_scan_total
    local min_enqueued
    local min_written
    local min_completed
    local min_routine_admitted
    local min_routine_finished
    local max_candidate_failed
    local max_scan_error
    local max_complete_failed
    local max_failed
    local max_record_error_failed
    local min_pg_backfilled
    local min_pg_completed
    min_scan_total="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_scan_total)"
    min_enqueued="$(($(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_enqueued_total) + 1))"
    min_written="$(($(latest_metric_sample_value "$metrics_path" shard_backfill_shards_written_total) + 1))"
    min_completed="$(($(latest_metric_family_label_sum "$metrics_path" shard_backfill_event_by_pg_total event complete_succeeded) + 1))"
    min_routine_admitted="$(($(latest_metric_family_label_sum "$metrics_path" background_work_admission_by_class_total event admitted class routine_backfill) + 1))"
    min_routine_finished="$(($(latest_metric_family_label_sum "$metrics_path" background_work_admission_by_class_total event finished class routine_backfill) + 1))"
    min_pg_backfilled="$(($(latest_metric_family_label_sum "$metrics_path" shard_backfill_event_by_pg_total pg_id "$data_pg" event backfilled) + 1))"
    min_pg_completed="$(($(latest_metric_family_label_sum "$metrics_path" shard_backfill_event_by_pg_total pg_id "$data_pg" event complete_succeeded) + 1))"

    set_pg_acting_set "desired placement nodes 0,2" "$data_pg" 0 2
    wait_for_control_plane_pg_active "$data_pg" 10 "0:2"
    wait_for_control_plane_node_epochs_aligned 10
    wait_for_control_plane_runtime_map_ready 10 "$(control_plane_node_aligned_epoch)"
    wait_for_frontend_storage_epoch_at_least "$(control_plane_node_aligned_epoch)" 10 "$metrics_path"
    max_candidate_failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_failed_total)"
    max_scan_error="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_scan_error_total)"
    max_complete_failed="$(latest_metric_family_label_sum "$metrics_path" shard_backfill_event_by_pg_total event complete_failed)"
    max_failed="$(latest_metric_family_label_sum "$metrics_path" shard_backfill_event_by_pg_total event failed)"
    max_record_error_failed="$(latest_metric_family_label_sum "$metrics_path" shard_backfill_event_by_pg_total event record_error_failed)"

    echo "== argmin-s3 UAT PG backfill historical read after acting-set change =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"

    echo "== argmin-s3 UAT PG backfill new-placement put =="
    print_command "${pg_backfill_smoke_cmd[@]}" put-for-data-pg "$bucket_file" "$new_key_file" "uat-pg-backfill-new-object-$iteration" "$new_body_file" "$data_pg"
    "${pg_backfill_smoke_cmd[@]}" put-for-data-pg "$bucket_file" "$new_key_file" "uat-pg-backfill-new-object-$iteration" "$new_body_file" "$data_pg"
    local new_key
    new_key="$(tr -d '[:space:]' <"$new_key_file")"

    echo "== argmin-s3 UAT PG backfill new-placement read =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"

    wait_for_shard_backfill_completion_metrics \
        "$metrics_path" \
        30 \
        "$min_scan_total" \
        "$min_enqueued" \
        "$min_written" \
        "$min_completed" \
        "$min_routine_admitted" \
        "$min_routine_finished" \
        "$max_candidate_failed" \
        "$max_scan_error" \
        "$max_complete_failed" \
        "$max_failed" \
        "$max_record_error_failed" \
        "$data_pg" \
        "$min_pg_backfilled" \
        "$min_pg_completed"

    echo "== argmin-s3 UAT PG backfill post-backfill reads =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"

    echo "PASS: PG backfill migration UAT smoke migrated an old-placement object after an acting-set change"
}

cleanup_pg_backfill_migration_smoke() {
    local iteration="$1"
    local smoke_dir="$data_dir/pg-backfill-migration-smoke/iteration-$iteration"
    local bucket_file="$smoke_dir/bucket"
    local old_key_file="$smoke_dir/old-key"
    local new_key_file="$smoke_dir/new-key"
    [[ -s "$bucket_file" && -s "$old_key_file" && -s "$new_key_file" ]] || return 0

    local old_key
    local new_key
    old_key="$(tr -d '[:space:]' <"$old_key_file")"
    new_key="$(tr -d '[:space:]' <"$new_key_file")"

    echo "== argmin-s3 UAT PG backfill cleanup iteration $iteration =="
    print_command "${pg_backfill_smoke_cmd[@]}" cleanup "$bucket_file" "$old_key" "$new_key"
    "${pg_backfill_smoke_cmd[@]}" cleanup "$bucket_file" "$old_key" "$new_key"
}

assert_pg_backfill_migration_final_clean() {
    local metrics_path="$1"
    local max_candidate_failed="$2"
    local max_scan_error="$3"
    local max_complete_failed="$4"
    local max_failed="$5"
    local max_record_error_failed="$6"
    sample_frontend_metrics "$metrics_path"
    local queue_depth
    local candidate_failed
    local scan_error
    local complete_failed
    local failed
    local record_error_failed
    queue_depth="$(latest_metric_sample_value "$metrics_path" shard_backfill_queue_depth)"
    candidate_failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_failed_total)"
    scan_error="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_scan_error_total)"
    complete_failed="$(latest_metric_family_label_sum "$metrics_path" shard_backfill_event_by_pg_total event complete_failed)"
    failed="$(latest_metric_family_label_sum "$metrics_path" shard_backfill_event_by_pg_total event failed)"
    record_error_failed="$(latest_metric_family_label_sum "$metrics_path" shard_backfill_event_by_pg_total event record_error_failed)"
    if ((queue_depth != 0 || candidate_failed > max_candidate_failed || scan_error > max_scan_error || complete_failed > max_complete_failed || failed > max_failed || record_error_failed > max_record_error_failed)); then
        cat "$metrics_path" >&2 || true
        die "PG backfill smoke left hard-failure state: queue_depth=$queue_depth candidate_failed=$candidate_failed scan_error=$scan_error complete_failed=$complete_failed failed=$failed record_error_failed=$record_error_failed"
    fi
}

if [[ "$smoke" == "storage-node-restart" ]]; then
    run_nextest "pre-restart s3-tests smoke" test_object_default_content_type
    restart_storage_node 0
    run_nextest "post-restart s3-tests smoke" test_object_read_not_exist
elif [[ "$smoke" == "storage-node-kill-fails-closed" ]]; then
    run_nextest "pre-kill s3-tests smoke" test_object_default_content_type
    kill_storage_node 0
    run_nextest_expect_failure "post-kill s3-tests smoke" test_object_read_not_exist
elif [[ "$smoke" == "control-plane-runtime-map" ]]; then
    sleep 1
    run_nextest "control-plane runtime-map pre-restart s3-tests smoke" test_object_default_content_type
    run_nextest "control-plane runtime-map metadata-progress s3-tests smoke" test_object_write_read_update_read_delete
    sleep 2
    run_nextest "control-plane runtime-map post-metadata-refresh s3-tests smoke" test_object_read_not_exist
    restart_storage_node 0
    sleep 1
    run_nextest "control-plane runtime-map post-restart s3-tests smoke" test_object_read_not_exist
elif [[ "$smoke" == "shard-repair" ]]; then
    for ((iteration = 1; iteration <= repeat_count; iteration++)); do
        if ((repeat_count > 1)); then
            echo "== argmin-s3 UAT shard repair iteration $iteration/$repeat_count =="
        fi
        run_shard_repair_smoke
    done
elif [[ "$smoke" == "pg-backfill-migration" ]]; then
    pg_backfill_metrics_log="$logs_dir/frontend-metrics-samples.log"
    sample_frontend_metrics "$pg_backfill_metrics_log"
    pg_backfill_initial_candidate_failed="$(latest_metric_sample_value "$pg_backfill_metrics_log" shard_backfill_candidate_failed_total)"
    pg_backfill_initial_scan_error="$(latest_metric_sample_value "$pg_backfill_metrics_log" shard_backfill_candidate_scan_error_total)"
    pg_backfill_initial_complete_failed="$(latest_metric_family_label_sum "$pg_backfill_metrics_log" shard_backfill_event_by_pg_total event complete_failed)"
    pg_backfill_initial_failed="$(latest_metric_family_label_sum "$pg_backfill_metrics_log" shard_backfill_event_by_pg_total event failed)"
    pg_backfill_initial_record_error_failed="$(latest_metric_family_label_sum "$pg_backfill_metrics_log" shard_backfill_event_by_pg_total event record_error_failed)"
    for ((iteration = 1; iteration <= repeat_count; iteration++)); do
        run_pg_backfill_migration_smoke "$iteration"
    done
    for ((iteration = 1; iteration <= repeat_count; iteration++)); do
        cleanup_pg_backfill_migration_smoke "$iteration"
    done
    assert_pg_backfill_migration_final_clean \
        "$pg_backfill_metrics_log" \
        "$pg_backfill_initial_candidate_failed" \
        "$pg_backfill_initial_scan_error" \
        "$pg_backfill_initial_complete_failed" \
        "$pg_backfill_initial_failed" \
        "$pg_backfill_initial_record_error_failed"
else
    run_nextest "s3-tests" "${cargo_args[@]}"
fi
