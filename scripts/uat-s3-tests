        latest_metric_family_top "$metrics_log" metadata_command_budget_exhausted_by_pg_context_elapsed_us_total 10 >&2 || true
        echo "metadata_backoff_top count" >&2
        latest_metric_family_top "$metrics_log" metadata_command_backoff_by_pg_context_total 10 >&2 || true
        echo "metadata_backoff_top sleep_us" >&2
        latest_metric_family_top "$metrics_log" metadata_command_backoff_by_pg_context_sleep_us_total 10 >&2 || true
        echo "reclaim_queue_top action" >&2
        latest_metric_family_top "$metrics_log" reclaim_work_queue_action_by_kind_total 10 >&2 || true
        echo "object_payload_reclaim_top event" >&2
        latest_metric_family_top "$metrics_log" object_payload_reclaim_event_by_pg_total 10 >&2 || true
        echo "object_payload_reclaim_top durable_scan" >&2
        latest_metric_family_top "$metrics_log" object_payload_reclaim_durable_scan_by_pg_total 10 >&2 || true
        echo "shard_repair_top event" >&2
        latest_metric_family_top "$metrics_log" shard_repair_event_by_pg_total 10 >&2 || true
        echo "shard_backfill_top event" >&2
