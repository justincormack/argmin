#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
    cat <<'EOF'
Usage: ./scripts/uat-s3-tests [options] [cargo nextest args...]

Start `argmin-s3` with UAT-only test credentials, then run `s3-tests` against
that process group as an external S3 endpoint. The default topology is
multi-process `multihost`; use `--topology local` for the older single-process
local server.

Options:
  --listen ADDR          Server listen address (default: 127.0.0.1:19000)
  --data-dir PATH        Server data directory (default: temporary directory)
  --bucket-prefix PREFIX Bucket prefix for s3-tests (default: argmin-s3-)
  --timeout-secs SECS    S3 client timeout (default: 30)
  --topology NAME        Test topology: multihost or local (default: multihost)
  --repeat N            Repeat the selected s3-tests command N times (default: 1)
  --smoke NAME           Run a focused smoke instead of the full suite:
                         storage-node-restart, storage-node-kill-fails-closed,
                         control-plane-runtime-map
  --binary PATH          Run an already-built argmin-s3-compatible binary
  --release              Use a release argmin-s3 binary
  --no-cleanup           Keep the temporary data directory after the run
  -h, --help             Show this help

Examples:
  ./scripts/uat-s3-tests --test bucket_crud
  ./scripts/uat-s3-tests --topology local --test bucket_crud
  ./scripts/uat-s3-tests --binary ./target/debug/argmin-s3 --test bucket_crud
  ./scripts/uat-s3-tests --release
EOF
}

die() {
    echo "error: $*" >&2
    exit 2
}

listen_addr="${ARGMIN_UAT_LISTEN_ADDR:-127.0.0.1:19000}"
data_dir="${ARGMIN_UAT_DATA_DIR:-}"
bucket_prefix="${S3_TEST_BUCKET_PREFIX:-argmin-s3-}"
timeout_secs="${S3_TEST_TIMEOUT_SECS:-30}"
topology="${ARGMIN_UAT_TOPOLOGY:-multihost}"
smoke="${ARGMIN_UAT_SMOKE:-}"
repeat_count="${ARGMIN_UAT_REPEAT:-1}"
release=0
cleanup=0
keep_temp_data_dir=0
server_binary=""
cargo_args=()

while (($#)); do
    case "$1" in
        --listen)
            [[ $# -ge 2 ]] || die "--listen requires a value"
            listen_addr="$2"
            shift 2
            ;;
        --data-dir)
            [[ $# -ge 2 ]] || die "--data-dir requires a value"
            data_dir="$2"
            cleanup=0
            shift 2
            ;;
        --bucket-prefix)
            [[ $# -ge 2 ]] || die "--bucket-prefix requires a value"
            bucket_prefix="$2"
            shift 2
            ;;
        --timeout-secs)
            [[ $# -ge 2 ]] || die "--timeout-secs requires a value"
            timeout_secs="$2"
            shift 2
            ;;
        --topology)
            [[ $# -ge 2 ]] || die "--topology requires a value"
            topology="$2"
            shift 2
            ;;
        --repeat)
            [[ $# -ge 2 ]] || die "--repeat requires a value"
            repeat_count="$2"
            shift 2
            ;;
        --smoke)
            [[ $# -ge 2 ]] || die "--smoke requires a value"
            smoke="$2"
            shift 2
            ;;
        --binary)
            [[ $# -ge 2 ]] || die "--binary requires a value"
            server_binary="$2"
            shift 2
            ;;
        --release)
            release=1
            shift
            ;;
        --no-cleanup)
            keep_temp_data_dir=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            cargo_args+=("$@")
            break
            ;;
        *)
            cargo_args+=("$1")
            shift
            ;;
    esac
done

cd "$ROOT"

if [[ -n "$server_binary" && "$release" -eq 1 ]]; then
    die "--binary cannot be combined with --release"
fi
case "$topology" in
    multihost|local)
        ;;
    *)
        die "--topology must be multihost or local"
        ;;
esac
case "$smoke" in
    ""|storage-node-restart|storage-node-kill-fails-closed|control-plane-runtime-map)
        ;;
    *)
        die "--smoke must be storage-node-restart, storage-node-kill-fails-closed, or control-plane-runtime-map"
        ;;
esac
if [[ -n "$smoke" && "$topology" != "multihost" ]]; then
    die "--smoke $smoke requires --topology multihost"
fi
if [[ -n "$smoke" && ${#cargo_args[@]} -ne 0 ]]; then
    die "--smoke cannot be combined with cargo nextest args"
fi
if ! [[ "$repeat_count" =~ ^[1-9][0-9]*$ ]]; then
    die "--repeat must be a positive integer"
fi
if [[ -n "$smoke" && "$repeat_count" != "1" ]]; then
    die "--repeat cannot be combined with --smoke"
fi
if [[ -n "$server_binary" ]]; then
    if [[ "$server_binary" == */* ]]; then
        [[ -x "$server_binary" ]] || die "--binary path is not executable: $server_binary"
    else
        command -v "$server_binary" >/dev/null 2>&1 || die "--binary command not found: $server_binary"
    fi
fi

if [[ -z "$data_dir" ]]; then
    data_dir="$(mktemp -d "${TMPDIR:-/tmp}/argmin-s3-uat.XXXXXX")"
    if ((keep_temp_data_dir == 0)); then
        cleanup=1
    fi
fi

if [[ "$smoke" == "storage-node-restart" || "$smoke" == "storage-node-kill-fails-closed" ]]; then
    export ARGMIN_EC_K=1
    export ARGMIN_EC_M=0
    export ARGMIN_LOCAL_NODE_COUNT=1
    export ARGMIN_PG_COUNT=1
fi
if [[ "$smoke" == "control-plane-runtime-map" ]]; then
    export ARGMIN_EC_K=1
    export ARGMIN_EC_M=1
    export ARGMIN_LOCAL_NODE_COUNT=2
    export ARGMIN_PG_COUNT=2
    export ARGMIN_CONTROL_PLANE_REFRESH_MS="${ARGMIN_CONTROL_PLANE_REFRESH_MS:-100}"
    export ARGMIN_CONTROL_PLANE_LEASE_SCAN_MS="${ARGMIN_CONTROL_PLANE_LEASE_SCAN_MS:-100}"
    export ARGMIN_CONTROL_PLANE_HEARTBEAT_LEASE_MS="${ARGMIN_CONTROL_PLANE_HEARTBEAT_LEASE_MS:-1000}"
fi
if [[ "$smoke" == "storage-node-kill-fails-closed" ]]; then
    export ARGMIN_ABORT_ON_500=0
fi

logs_dir="$data_dir/logs"
sockets_dir="$data_dir/sockets"
mkdir -p "$logs_dir"
mkdir -p "$sockets_dir"
chmod 700 "$sockets_dir"
server_log="$logs_dir/argmin-s3.log"

host="${listen_addr%:*}"
port="${listen_addr##*:}"
if [[ "$host" == "$listen_addr" || -z "$port" ]]; then
    die "--listen must be host:port"
fi

endpoint="https://localhost:$port"
cert_path="$ROOT/crates/s3-tests/testdata/localhost-cert.pem"
key_path="$ROOT/crates/s3-tests/testdata/localhost-key.pem"
ca_path="$ROOT/crates/s3-tests/testdata/ca-cert.pem"

export ARGMIN_ACCOUNT_ID="${ARGMIN_ACCOUNT_ID:-111122223333}"
export ARGMIN_ACCESS_KEY_ID="${ARGMIN_ACCESS_KEY_ID:-argmin-primary}"
export ARGMIN_SECRET_ACCESS_KEY="${ARGMIN_SECRET_ACCESS_KEY:-argmin-primary-secret}"
export ARGMIN_UAT_ALT_ACCOUNT_ID="${ARGMIN_UAT_ALT_ACCOUNT_ID:-444455556666}"
export ARGMIN_UAT_ALT_ACCESS_KEY_ID="${ARGMIN_UAT_ALT_ACCESS_KEY_ID:-argmin-alt}"
export ARGMIN_UAT_ALT_SECRET_ACCESS_KEY="${ARGMIN_UAT_ALT_SECRET_ACCESS_KEY:-argmin-alt-secret}"
export ARGMIN_UAT_SECOND_ACCESS_KEY_ID="${ARGMIN_UAT_SECOND_ACCESS_KEY_ID:-argmin-second}"
export ARGMIN_UAT_SECOND_SECRET_ACCESS_KEY="${ARGMIN_UAT_SECOND_SECRET_ACCESS_KEY:-argmin-second-secret}"
export ARGMIN_UAT_OWNER_ROOT_ACCESS_KEY_ID="${ARGMIN_UAT_OWNER_ROOT_ACCESS_KEY_ID:-argmin-owner-root}"
export ARGMIN_UAT_OWNER_ROOT_SECRET_ACCESS_KEY="${ARGMIN_UAT_OWNER_ROOT_SECRET_ACCESS_KEY:-argmin-owner-root-secret}"
export ARGMIN_SSE_S3_WRAPPING_KEY="${ARGMIN_SSE_S3_WRAPPING_KEY:-MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=}"
export ARGMIN_SSE_C_VALIDATOR_KEY="${ARGMIN_SSE_C_VALIDATOR_KEY:-MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=}"
export ARGMIN_LISTEN_ADDR="$listen_addr"
export ARGMIN_DATA_DIR="$data_dir"
export ARGMIN_TLS_CERT_PATH="${ARGMIN_TLS_CERT_PATH:-$cert_path}"
export ARGMIN_TLS_KEY_PATH="${ARGMIN_TLS_KEY_PATH:-$key_path}"
export ARGMIN_REGION="${ARGMIN_REGION:-us-east-1}"
export ARGMIN_ABORT_ON_500="${ARGMIN_ABORT_ON_500:-1}"
export ARGMIN_EC_K="${ARGMIN_EC_K:-4}"
export ARGMIN_EC_M="${ARGMIN_EC_M:-2}"
export ARGMIN_LOCAL_NODE_COUNT="${ARGMIN_LOCAL_NODE_COUNT:-$((ARGMIN_EC_K + ARGMIN_EC_M))}"
export ARGMIN_PG_COUNT="${ARGMIN_PG_COUNT:-16}"
export ARGMIN_STORAGE_CLUSTER_EPOCH="${ARGMIN_STORAGE_CLUSTER_EPOCH:-1}"
uat_local_debug_endpoint="${ARGMIN_LOCAL_DEBUG_ENDPOINT:-1}"

if [[ -n "${S3_TEST_TRACE:-}" && -z "${ARGMIN_TRACE:-}" ]]; then
    export ARGMIN_TRACE="$S3_TEST_TRACE"
fi
if [[ -n "${S3_TEST_TRACE_FILTER:-}" && -z "${ARGMIN_TRACE_FILTER:-}" ]]; then
    export ARGMIN_TRACE_FILTER="$S3_TEST_TRACE_FILTER"
fi
if [[ -n "${S3_TEST_TRACE_FILE:-}" && -z "${ARGMIN_TRACE_FILE:-}" ]]; then
    export ARGMIN_TRACE_FILE="$S3_TEST_TRACE_FILE"
elif [[ -n "${S3_TEST_TRACE_DIR:-}" && -z "${ARGMIN_TRACE_FILE:-}" ]]; then
    export ARGMIN_TRACE_FILE="${S3_TEST_TRACE_DIR%/}/argmin-s3.trace"
fi
if [[ -n "${S3_TEST_TRACE_SYNC:-}" && -z "${ARGMIN_TRACE_SYNC:-}" ]]; then
    export ARGMIN_TRACE_SYNC="$S3_TEST_TRACE_SYNC"
fi

export S3_TEST_ENDPOINT="$endpoint"
export S3_TEST_ACCESS_KEY="$ARGMIN_ACCESS_KEY_ID"
export S3_TEST_SECRET_KEY="$ARGMIN_SECRET_ACCESS_KEY"
export S3_TEST_ACCOUNT_ID="$ARGMIN_ACCOUNT_ID"
export S3_TEST_ALT_ACCESS_KEY="$ARGMIN_UAT_ALT_ACCESS_KEY_ID"
export S3_TEST_ALT_SECRET_KEY="$ARGMIN_UAT_ALT_SECRET_ACCESS_KEY"
export S3_TEST_ALT_ACCOUNT_ID="$ARGMIN_UAT_ALT_ACCOUNT_ID"
export S3_TEST_SECOND_ACCESS_KEY="$ARGMIN_UAT_SECOND_ACCESS_KEY_ID"
export S3_TEST_SECOND_SECRET_KEY="$ARGMIN_UAT_SECOND_SECRET_ACCESS_KEY"
export S3_TEST_SECOND_PRINCIPAL="arn:aws:iam::${ARGMIN_ACCOUNT_ID}:user/limited"
export S3_TEST_OWNER_ROOT_ACCESS_KEY="$ARGMIN_UAT_OWNER_ROOT_ACCESS_KEY_ID"
export S3_TEST_OWNER_ROOT_SECRET_KEY="$ARGMIN_UAT_OWNER_ROOT_SECRET_ACCESS_KEY"
export S3_TEST_REGION="$ARGMIN_REGION"
export S3_TEST_BUCKET_PREFIX="$bucket_prefix"
export S3_TEST_TIMEOUT_SECS="$timeout_secs"
export S3_TEST_TLS_CA_CERT_PATH="${S3_TEST_TLS_CA_CERT_PATH:-$ca_path}"

server_pids=()
server_logs=()
server_names=()
storage_node_pids=()
storage_node_logs=()
frontend_pid=""
frontend_log=""
metrics_sampler_pid=""
slowdown_summary_printed=0
control_plane_state_path=""
control_plane_socket_path=""

print_command() {
    printf '+'
    printf ' %q' "$@"
    printf '\n'
}

server_cmd=()

start_process() {
    local name="$1"
    local log_path="$2"
    shift 2
    echo "== argmin-s3 UAT $name =="
    print_command "$@"
    "$@" >"$log_path" 2>&1 &
    server_pids+=("$!")
    server_logs+=("$log_path")
    server_names+=("$name")
}

start_storage_node() {
    local node_id="$1"
    local socket_path
    local node_data_dir
    local node_log
    socket_path="$sockets_dir/node-$(printf '%04d' "$node_id").sock"
    node_data_dir="$data_dir/storage-node-$(printf '%04d' "$node_id")"
    node_log="$logs_dir/storage-node-$(printf '%04d' "$node_id").log"
    local control_plane_env=()
    if [[ -n "$control_plane_socket_path" ]]; then
        control_plane_env=(ARGMIN_CONTROL_PLANE_SOCKET_PATH="$control_plane_socket_path")
    fi
    start_process "storage-node-$node_id" "$node_log" env \
        -u ARGMIN_STORAGE_NODE_SOCKETS \
        ARGMIN_PROCESS_ROLE=storage-node \
        ARGMIN_STORAGE_NODE_ID="$node_id" \
        ARGMIN_STORAGE_NODE_DATA_DIR="$node_data_dir" \
        ARGMIN_STORAGE_NODE_SOCKET_PATH="$socket_path" \
        "${control_plane_env[@]}" \
        ARGMIN_METADATA_COMMAND_CONFLICT_DIAGNOSTICS=1 \
        ARGMIN_DATA_DIR="$data_dir" \
        ARGMIN_LISTEN_ADDR="$listen_addr" \
        "${server_cmd[@]}"
    local index=$((${#server_pids[@]} - 1))
    storage_node_pids[node_id]="${server_pids[$index]}"
    storage_node_logs[node_id]="${server_logs[$index]}"
}

start_control_plane() {
    control_plane_state_path="$data_dir/control-plane.state"
    control_plane_socket_path="$sockets_dir/control-plane.sock"
    local control_plane_log="$logs_dir/control-plane.log"
    start_process "control-plane" "$control_plane_log" env \
        ARGMIN_PROCESS_ROLE=control-plane \
        ARGMIN_CONTROL_PLANE_STATE_PATH="$control_plane_state_path" \
        ARGMIN_CONTROL_PLANE_SOCKET_PATH="$control_plane_socket_path" \
        ARGMIN_STORAGE_NODE_SOCKETS="$storage_node_sockets" \
        ARGMIN_DATA_DIR="$data_dir/control-plane" \
        ARGMIN_LISTEN_ADDR="$listen_addr" \
        "${server_cmd[@]}"
}

wait_for_process() {
    local pid="$1"
    local log_path="$2"
    local name="$3"
    local state
    state="$(ps -o stat= -p "$pid" 2>/dev/null | tr -d '[:space:]' || true)"
    if [[ -z "$state" || "$state" == Z* ]]; then
        cat "$log_path" >&2 || true
        die "$name exited before becoming ready"
    fi
}

wait_for_storage_node_socket() {
    local node_id="$1"
    local pid="${storage_node_pids[$node_id]}"
    local log_path="${storage_node_logs[$node_id]}"
    local socket_path
    socket_path="$sockets_dir/node-$(printf '%04d' "$node_id").sock"
    for ((attempt = 0; attempt < 200; attempt++)); do
        wait_for_process "$pid" "$log_path" "storage-node-$node_id"
        if [[ -S "$socket_path" ]] && grep -q "storage-node $node_id listening" "$log_path"; then
            return 0
        fi
        sleep 0.1
    done
    cat "$log_path" >&2 || true
    die "storage-node-$node_id did not become ready at $socket_path"
}

wait_for_control_plane_socket() {
    local pid="${server_pids[$((${#server_pids[@]} - 1))]}"
    local log_path="${server_logs[$((${#server_logs[@]} - 1))]}"
    for ((attempt = 0; attempt < 200; attempt++)); do
        wait_for_process "$pid" "$log_path" "control-plane"
        if [[ -S "$control_plane_socket_path" ]] \
            && grep -q "control-plane manager using state" "$log_path"; then
            return 0
        fi
        sleep 0.1
    done
    cat "$log_path" >&2 || true
    die "control-plane did not become ready at $control_plane_socket_path"
}

restart_storage_node() {
    local node_id="$1"
    local pid="${storage_node_pids[$node_id]}"
    echo "== argmin-s3 UAT restart storage-node-$node_id =="
    if kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
    fi
    start_storage_node "$node_id"
    wait_for_storage_node_socket "$node_id"
}

kill_storage_node() {
    local node_id="$1"
    local pid="${storage_node_pids[$node_id]}"
    echo "== argmin-s3 UAT kill storage-node-$node_id =="
    if kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
    fi
}

latest_metric_sample_value() {
    local metrics_log="$1"
    local metric_name="$2"
    awk -v metric="$metric_name" '$1 == metric { value = $2 } END { if (value != "") print value; else print "0" }' "$metrics_log"
}

latest_metric_family_top() {
    local metrics_log="$1"
    local metric_name="$2"
    local limit="$3"
    awk -v metric="$metric_name" '
        index($1, metric "{") == 1 { values[$1] = $2 }
        END {
            for (sample in values) {
                print values[sample], sample
            }
        }
    ' "$metrics_log" | sort -nr | head -n "$limit"
}

print_slowdown_summary() {
    if ((slowdown_summary_printed)); then
        return 0
    fi
    slowdown_summary_printed=1

    local metrics_log="$logs_dir/frontend-metrics-samples.log"
    echo "== argmin-s3 UAT SlowDown summary ==" >&2
    if [[ -s "$metrics_log" ]]; then
        local slow_down
        local admission_timeout
        local admission_wait
        local admission_wait_us
        local operation_aborted
        local request_errors
        local storage_rpc_errors
        local storage_rpc_admission_total
        local storage_rpc_admission_wait
        local storage_rpc_admission_wait_us
        local storage_rpc_admission_timeout
        local storage_rpc_admission_wait_percent
        local storage_rpc_active_total
        local storage_rpc_active_completion
        local storage_rpc_pending_envelope_active
        local storage_rpc_pending_envelope_oldest_active_us
        local storage_rpc_pending_envelope_oldest_active_node_id
        local storage_rpc_pending_envelope_oldest_active_request_id
        local metadata_recovery_leader
        local metadata_recovery_wait
        local metadata_recovery_wait_us
        local metadata_recovery_wait_us_max
        local metadata_recovery_timeout
        local metadata_recovery_outcome
        local metadata_budget_exhausted
        local metadata_backoff
        local metadata_backoff_us
        local metadata_backoff_us_max
        local reclaim_queue_depth
        local object_payload_reclaim_queue_depth
        local object_payload_reclaim_outstanding_depth
        local bucket_delete_finalize_queue_depth
        local reclaim_queue_action
        local object_payload_reclaim_event
        local object_payload_reclaim_durable_scan
        slow_down="$(latest_metric_sample_value "$metrics_log" slow_down_response_total)"
        admission_timeout="$(latest_metric_sample_value "$metrics_log" request_admission_timeout_total)"
        admission_wait="$(latest_metric_sample_value "$metrics_log" request_admission_wait_total)"
        admission_wait_us="$(latest_metric_sample_value "$metrics_log" request_admission_wait_us_total)"
        operation_aborted="$(latest_metric_sample_value "$metrics_log" operation_aborted_response_total)"
        request_errors="$(latest_metric_sample_value "$metrics_log" request_error_total)"
        storage_rpc_errors="$(latest_metric_sample_value "$metrics_log" storage_rpc_error_total)"
        storage_rpc_admission_total="$(latest_metric_sample_value "$metrics_log" storage_rpc_admission_total)"
        storage_rpc_admission_wait="$(latest_metric_sample_value "$metrics_log" storage_rpc_admission_wait_total)"
        storage_rpc_admission_wait_us="$(latest_metric_sample_value "$metrics_log" storage_rpc_admission_wait_us_total)"
        storage_rpc_admission_timeout="$(latest_metric_sample_value "$metrics_log" storage_rpc_admission_timeout_total)"
        storage_rpc_active_total="$(latest_metric_sample_value "$metrics_log" storage_rpc_active_total)"
        storage_rpc_active_completion="$(latest_metric_sample_value "$metrics_log" storage_rpc_active_completion)"
        storage_rpc_pending_envelope_active="$(latest_metric_sample_value "$metrics_log" storage_rpc_pending_envelope_active)"
        storage_rpc_pending_envelope_oldest_active_us="$(latest_metric_sample_value "$metrics_log" storage_rpc_pending_envelope_oldest_active_us)"
        storage_rpc_pending_envelope_oldest_active_node_id="$(latest_metric_sample_value "$metrics_log" storage_rpc_pending_envelope_oldest_active_node_id)"
        storage_rpc_pending_envelope_oldest_active_request_id="$(latest_metric_sample_value "$metrics_log" storage_rpc_pending_envelope_oldest_active_request_id)"
        metadata_recovery_leader="$(latest_metric_sample_value "$metrics_log" metadata_command_recovery_leader_total)"
        metadata_recovery_wait="$(latest_metric_sample_value "$metrics_log" metadata_command_recovery_wait_total)"
        metadata_recovery_wait_us="$(latest_metric_sample_value "$metrics_log" metadata_command_recovery_wait_us_total)"
        metadata_recovery_wait_us_max="$(latest_metric_sample_value "$metrics_log" metadata_command_recovery_wait_us_max)"
        metadata_recovery_timeout="$(latest_metric_sample_value "$metrics_log" metadata_command_recovery_timeout_total)"
        metadata_recovery_outcome="$(latest_metric_sample_value "$metrics_log" metadata_command_recovery_outcome_total)"
        metadata_budget_exhausted="$(latest_metric_sample_value "$metrics_log" metadata_command_budget_exhausted_total)"
        metadata_backoff="$(latest_metric_sample_value "$metrics_log" metadata_command_backoff_total)"
        metadata_backoff_us="$(latest_metric_sample_value "$metrics_log" metadata_command_backoff_us_total)"
        metadata_backoff_us_max="$(latest_metric_sample_value "$metrics_log" metadata_command_backoff_us_max)"
        reclaim_queue_depth="$(latest_metric_sample_value "$metrics_log" reclaim_work_queue_depth)"
        object_payload_reclaim_queue_depth="$(latest_metric_sample_value "$metrics_log" object_payload_reclaim_queue_depth)"
        object_payload_reclaim_outstanding_depth="$(latest_metric_sample_value "$metrics_log" object_payload_reclaim_outstanding_depth)"
        bucket_delete_finalize_queue_depth="$(latest_metric_sample_value "$metrics_log" bucket_delete_finalize_queue_depth)"
        reclaim_queue_action="$(latest_metric_sample_value "$metrics_log" reclaim_work_queue_action_total)"
        object_payload_reclaim_event="$(latest_metric_sample_value "$metrics_log" object_payload_reclaim_event_total)"
        object_payload_reclaim_durable_scan="$(latest_metric_sample_value "$metrics_log" object_payload_reclaim_durable_scan_total)"
        if ((storage_rpc_admission_total > 0)); then
            storage_rpc_admission_wait_percent="$(awk -v waited="$storage_rpc_admission_wait" -v total="$storage_rpc_admission_total" 'BEGIN { printf "%.2f", (waited * 100.0) / total }')"
        else
            storage_rpc_admission_wait_percent="0.00"
        fi
        echo "metrics slow_down_response_total=$slow_down request_admission_timeout_total=$admission_timeout request_admission_wait_total=$admission_wait request_admission_wait_us_total=$admission_wait_us operation_aborted_response_total=$operation_aborted request_error_total=$request_errors storage_rpc_error_total=$storage_rpc_errors storage_rpc_admission_total=$storage_rpc_admission_total storage_rpc_admission_wait_total=$storage_rpc_admission_wait storage_rpc_admission_wait_us_total=$storage_rpc_admission_wait_us storage_rpc_admission_wait_percent=$storage_rpc_admission_wait_percent storage_rpc_admission_timeout_total=$storage_rpc_admission_timeout" >&2
        echo "storage_rpc_active total=$storage_rpc_active_total completion=$storage_rpc_active_completion pending_envelope_active=$storage_rpc_pending_envelope_active pending_envelope_oldest_active_us=$storage_rpc_pending_envelope_oldest_active_us pending_envelope_oldest_active_node_id=$storage_rpc_pending_envelope_oldest_active_node_id pending_envelope_oldest_active_request_id=$storage_rpc_pending_envelope_oldest_active_request_id" >&2
        echo "metadata_recovery leader_total=$metadata_recovery_leader wait_total=$metadata_recovery_wait wait_us_total=$metadata_recovery_wait_us wait_us_max=$metadata_recovery_wait_us_max timeout_total=$metadata_recovery_timeout outcome_total=$metadata_recovery_outcome" >&2
        echo "metadata_budget exhausted_total=$metadata_budget_exhausted backoff_total=$metadata_backoff backoff_us_total=$metadata_backoff_us backoff_us_max=$metadata_backoff_us_max" >&2
        echo "reclaim queue_depth=$reclaim_queue_depth object_payload_queue_depth=$object_payload_reclaim_queue_depth object_payload_outstanding_depth=$object_payload_reclaim_outstanding_depth bucket_delete_queue_depth=$bucket_delete_finalize_queue_depth queue_action_total=$reclaim_queue_action object_payload_event_total=$object_payload_reclaim_event durable_scan_total=$object_payload_reclaim_durable_scan" >&2
        echo "metadata_recovery_top admission" >&2
        latest_metric_family_top "$metrics_log" metadata_command_recovery_admission_by_pg_command_total 10 >&2 || true
        echo "metadata_recovery_top outcome" >&2
        latest_metric_family_top "$metrics_log" metadata_command_recovery_outcome_by_pg_command_total 10 >&2 || true
        echo "metadata_pending_slot_top action" >&2
        latest_metric_family_top "$metrics_log" metadata_command_pending_slot_action_by_pg_command_total 10 >&2 || true
        echo "metadata_budget_top exhausted" >&2
        latest_metric_family_top "$metrics_log" metadata_command_budget_exhausted_by_pg_context_total 10 >&2 || true
        echo "metadata_budget_top elapsed_us" >&2
        latest_metric_family_top "$metrics_log" metadata_command_budget_exhausted_by_pg_context_elapsed_us_total 10 >&2 || true
        echo "metadata_backoff_top count" >&2
        latest_metric_family_top "$metrics_log" metadata_command_backoff_by_pg_context_total 10 >&2 || true
        echo "metadata_backoff_top sleep_us" >&2
        latest_metric_family_top "$metrics_log" metadata_command_backoff_by_pg_context_sleep_us_total 10 >&2 || true
        echo "reclaim_queue_top action" >&2
        latest_metric_family_top "$metrics_log" reclaim_work_queue_action_by_kind_total 10 >&2 || true
        echo "object_payload_reclaim_top event" >&2
        latest_metric_family_top "$metrics_log" object_payload_reclaim_event_by_pg_total 10 >&2 || true
        echo "object_payload_reclaim_top durable_scan" >&2
        latest_metric_family_top "$metrics_log" object_payload_reclaim_durable_scan_by_pg_total 10 >&2 || true
    else
        echo "metrics unavailable" >&2
    fi
    local slowdown_log_match_lines
    local slowdown_log_match_count=0
    if ((${#server_logs[@]})); then
        slowdown_log_match_lines="$(grep -hE "request_error .*status=503|SlowDown|slow_down" "${server_logs[@]}" 2>/dev/null || true)"
        if [[ -n "$slowdown_log_match_lines" ]]; then
            slowdown_log_match_count="$(printf '%s\n' "$slowdown_log_match_lines" | wc -l | tr -d ' ')"
        fi
    fi
    echo "log_matches status_503_or_slowdown=$slowdown_log_match_count" >&2
}

cleanup_server() {
    local status=$?
    if [[ -n "${metrics_sampler_pid:-}" ]] && kill -0 "$metrics_sampler_pid" 2>/dev/null; then
        kill "$metrics_sampler_pid" 2>/dev/null || true
        wait "$metrics_sampler_pid" 2>/dev/null || true
    fi
    if ((status != 0)) && [[ -n "${frontend_pid:-}" ]] && kill -0 "$frontend_pid" 2>/dev/null; then
        echo "== argmin-s3 UAT frontend flight recorder dump request ==" >&2
        if ! curl -k -sS -X POST "$endpoint/__argmin/debug/flight-recorder/dump" >/dev/null 2>&1; then
            echo "frontend flight recorder dump request failed" >&2
        fi
    fi
    for pid in "${server_pids[@]}"; do
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
        fi
    done
    for pid in "${server_pids[@]}"; do
        wait "$pid" 2>/dev/null || true
    done
    print_slowdown_summary
    if ((status != 0)); then
        echo "== argmin-s3 UAT failure diagnostics ==" >&2
        local found_diagnostics=0
        for index in "${!server_logs[@]}"; do
            local log_path="${server_logs[$index]}"
            local name="${server_names[$index]}"
            if [[ ! -s "$log_path" ]]; then
                continue
            fi
            local matches
            matches="$(
                grep -nE \
                    "server produced HTTP 500|HTTP response conversion produced InternalError|dispatch_internal_error|request_error .*status=(409|500)|OperationAborted|cause_label=|request_admission_(wait|timeout)|metadata_command_conflict|metadata_command_pending_slot_action|storage_rpc_error|flight .*request_error|bucket delete (begin|finalize) found visible data|panicked at|panic|aborted" \
                    "$log_path" \
                    | head -n 120 \
                    || true
            )"
            if [[ -n "$matches" ]]; then
                found_diagnostics=1
                echo "== argmin-s3 UAT $name diagnostic matches ==" >&2
                printf '%s\n' "$matches" >&2
            fi
        done
        if ((found_diagnostics == 0)); then
            echo "no HTTP error, cause-label, metadata-command, panic, or abort diagnostics found in server logs" >&2
        fi
        local metrics_log="$logs_dir/frontend-metrics-samples.log"
        if [[ -s "$metrics_log" ]]; then
            echo "== argmin-s3 UAT frontend metrics sample tail ==" >&2
            tail -n 120 "$metrics_log" >&2 || true
        fi
        for index in "${!server_logs[@]}"; do
            local log_path="${server_logs[$index]}"
            local name="${server_names[$index]}"
            echo "== argmin-s3 UAT $name log ==" >&2
            if [[ -s "$log_path" ]]; then
                tail -n 200 "$log_path" >&2 || true
            else
                echo "server log is empty: $log_path" >&2
            fi
        done
    fi
    if ((cleanup)); then
        rm -rf "$data_dir"
    else
        echo "UAT data directory kept at $data_dir" >&2
        echo "UAT server logs kept at $logs_dir" >&2
    fi
    exit "$status"
}
trap cleanup_server EXIT INT TERM

if [[ -n "$server_binary" ]]; then
    server_cmd=("$server_binary")
elif [[ "$topology" == "multihost" ]]; then
    build_cmd=(cargo build -p argmin-s3)
    if [[ -n "${ARGMIN_TRACE:-}" || -n "${ARGMIN_TRACE_FILE:-}" ]]; then
        build_cmd+=(--features deep-tracing)
    fi
    if ((release)); then
        build_cmd+=(--release)
        built_binary="$ROOT/target/release/argmin-s3"
    else
        built_binary="$ROOT/target/debug/argmin-s3"
    fi
    echo "== argmin-s3 UAT build =="
    print_command "${build_cmd[@]}"
    "${build_cmd[@]}"
    server_cmd=("$built_binary")
else
    server_cmd=(cargo run -p argmin-s3)
    if [[ -n "${ARGMIN_TRACE:-}" || -n "${ARGMIN_TRACE_FILE:-}" ]]; then
        server_cmd+=(--features deep-tracing)
    fi
    if ((release)); then
        server_cmd+=(--release)
    fi
    server_cmd+=(--)
fi

if [[ "$topology" == "local" ]]; then
    start_process "local server" "$server_log" env \
        -u ARGMIN_STORAGE_NODE_ID \
        -u ARGMIN_STORAGE_NODE_DATA_DIR \
        -u ARGMIN_STORAGE_NODE_SOCKET_PATH \
        -u ARGMIN_STORAGE_NODE_SOCKETS \
        ARGMIN_PROCESS_ROLE=legacy-local \
        ARGMIN_BUCKET_DELETE_VISIBLE_DATA_DIAGNOSTICS=1 \
        ARGMIN_METADATA_COMMAND_CONFLICT_DIAGNOSTICS=1 \
        ARGMIN_LOCAL_DEBUG_ENDPOINT="$uat_local_debug_endpoint" \
        ARGMIN_DATA_DIR="$data_dir" \
        ARGMIN_LISTEN_ADDR="$listen_addr" \
        "${server_cmd[@]}"
else
    socket_entries=()
    for ((node_id = 0; node_id < ARGMIN_LOCAL_NODE_COUNT; node_id++)); do
        socket_path="$sockets_dir/node-$(printf '%04d' "$node_id").sock"
        socket_entries+=("$node_id=$socket_path")
    done
    storage_node_sockets="$(
        IFS=,
        echo "${socket_entries[*]}"
    )"

    if [[ "$smoke" == "control-plane-runtime-map" ]]; then
        start_control_plane
        wait_for_control_plane_socket
    fi

    for ((node_id = 0; node_id < ARGMIN_LOCAL_NODE_COUNT; node_id++)); do
        start_storage_node "$node_id"
    done

    for ((node_id = 0; node_id < ARGMIN_LOCAL_NODE_COUNT; node_id++)); do
        wait_for_storage_node_socket "$node_id"
    done

    frontend_log="$logs_dir/frontend.log"
    if [[ "$smoke" == "control-plane-runtime-map" ]]; then
        start_process "frontend" "$frontend_log" env \
            -u ARGMIN_STORAGE_NODE_ID \
            -u ARGMIN_STORAGE_NODE_DATA_DIR \
            -u ARGMIN_STORAGE_NODE_SOCKET_PATH \
            -u ARGMIN_STORAGE_NODE_SOCKETS \
            ARGMIN_PROCESS_ROLE=frontend \
            ARGMIN_BUCKET_DELETE_VISIBLE_DATA_DIAGNOSTICS=1 \
            ARGMIN_METADATA_COMMAND_CONFLICT_DIAGNOSTICS=1 \
            ARGMIN_LOCAL_DEBUG_ENDPOINT="$uat_local_debug_endpoint" \
            ARGMIN_CONTROL_PLANE_SOCKET_PATH="$control_plane_socket_path" \
            ARGMIN_DATA_DIR="$data_dir/frontend" \
            "${server_cmd[@]}"
    else
        start_process "frontend" "$frontend_log" env \
            -u ARGMIN_STORAGE_NODE_ID \
            -u ARGMIN_STORAGE_NODE_DATA_DIR \
            -u ARGMIN_STORAGE_NODE_SOCKET_PATH \
            ARGMIN_PROCESS_ROLE=frontend \
            ARGMIN_BUCKET_DELETE_VISIBLE_DATA_DIAGNOSTICS=1 \
            ARGMIN_METADATA_COMMAND_CONFLICT_DIAGNOSTICS=1 \
            ARGMIN_LOCAL_DEBUG_ENDPOINT="$uat_local_debug_endpoint" \
            ARGMIN_STORAGE_NODE_SOCKETS="$storage_node_sockets" \
            ARGMIN_DATA_DIR="$data_dir/frontend" \
            "${server_cmd[@]}"
    fi
fi

frontend_index=$((${#server_pids[@]} - 1))
frontend_pid="${server_pids[$frontend_index]}"
frontend_log="${server_logs[$frontend_index]}"
readiness_url="$endpoint/"
case "$uat_local_debug_endpoint" in
    1|true|TRUE|True|yes|YES|Yes|on|ON|On)
        readiness_url="$endpoint/__argmin/debug/metrics"
        ;;
esac

for _ in {1..200}; do
    wait_for_process "$frontend_pid" "$frontend_log" "frontend"
    if curl -k -sS "$readiness_url" >/dev/null 2>&1; then
        wait_for_process "$frontend_pid" "$frontend_log" "frontend"
        break
    fi
    sleep 0.1
done

wait_for_process "$frontend_pid" "$frontend_log" "frontend"
if ! curl -k -sS "$readiness_url" >/dev/null 2>&1; then
    cat "$frontend_log" >&2 || true
    die "argmin-s3 did not become ready at $endpoint"
fi

start_metrics_sampler() {
    local metrics_url="$endpoint/__argmin/debug/metrics"
    local metrics_log="$logs_dir/frontend-metrics-samples.log"
    (
        while true; do
            printf 'ts=%(%s)T\n' -1
            curl -k -sS "$metrics_url" || true
            printf '\n'
            sleep 1
        done
    ) >"$metrics_log" 2>&1 &
    metrics_sampler_pid="$!"
    echo "== argmin-s3 UAT frontend metrics samples: $metrics_log =="
}

case "$uat_local_debug_endpoint" in
    1|true|TRUE|True|yes|YES|Yes|on|ON|On)
        start_metrics_sampler
        ;;
esac

run_nextest() {
    local label="$1"
    shift
    local cmd=(cargo nextest run -p s3-tests)
    if (($#)); then
        cmd+=("$@")
    fi

    for ((iteration = 1; iteration <= repeat_count; iteration++)); do
        if ((repeat_count > 1)); then
            echo "== argmin-s3 UAT $label iteration $iteration/$repeat_count =="
        else
            echo "== argmin-s3 UAT $label =="
        fi
        printf '+'
        printf ' %q' "${cmd[@]}"
        printf '\n'
        set +e
        "${cmd[@]}"
        local status=$?
        set -e
        if ((status != 0)); then
            print_slowdown_summary
            return "$status"
        fi
    done
}

run_nextest_expect_failure() {
    local label="$1"
    shift
    local cmd=(cargo nextest run -p s3-tests)
    if (($#)); then
        cmd+=("$@")
    fi
    local failure_log="$logs_dir/${label// /-}.log"

    echo "== argmin-s3 UAT $label =="
    printf '+'
    printf ' %q' "${cmd[@]}"
    printf '\n'
    set +e
    "${cmd[@]}" >"$failure_log" 2>&1
    local status=$?
    set -e
    if ((status == 0)); then
        cat "$failure_log" >&2 || true
        die "$label unexpectedly passed"
    fi
    if ! grep -Eq "InternalError|DispatchFailure|ServiceError" "$failure_log"; then
        cat "$failure_log" >&2 || true
        die "$label failed without a clear S3/client error"
    fi
    echo "== argmin-s3 UAT $label expected failure observed =="
    if grep -m1 -E "InternalError|DispatchFailure|ServiceError" "$failure_log"; then
        :
    fi
    echo "PASS: $label failed closed as expected"
    echo "Captured expected-failure log: $failure_log"
    echo "Summary: expected failure observed; UAT smoke passed"
}

if [[ "$smoke" == "storage-node-restart" ]]; then
    run_nextest "pre-restart s3-tests smoke" test_object_default_content_type
    restart_storage_node 0
    run_nextest "post-restart s3-tests smoke" test_object_read_not_exist
elif [[ "$smoke" == "storage-node-kill-fails-closed" ]]; then
    run_nextest "pre-kill s3-tests smoke" test_object_default_content_type
    kill_storage_node 0
    run_nextest_expect_failure "post-kill s3-tests smoke" test_object_read_not_exist
elif [[ "$smoke" == "control-plane-runtime-map" ]]; then
    sleep 1
    run_nextest "control-plane runtime-map pre-restart s3-tests smoke" test_object_default_content_type
    run_nextest "control-plane runtime-map metadata-progress s3-tests smoke" test_object_write_read_update_read_delete
    sleep 2
    run_nextest "control-plane runtime-map post-metadata-refresh s3-tests smoke" test_object_read_not_exist
    restart_storage_node 0
    sleep 1
    run_nextest "control-plane runtime-map post-restart s3-tests smoke" test_object_read_not_exist
else
    run_nextest "s3-tests" "${cargo_args[@]}"
fi
