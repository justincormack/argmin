#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
    cat <<'EOF'
Usage: ./scripts/uat-s3-tests [options] [cargo nextest args...]

Start `argmin-s3` with UAT-only test credentials, then run `s3-tests` against
that process group as an external S3 endpoint. The default topology is
multi-process `multihost`; use `--topology local` for the older single-process
local server.

Options:
  --listen ADDR          Server listen address (default: auto-selected 127.0.0.1 port)
  --data-dir PATH        Server data directory (default: temporary directory)
  --bucket-prefix PREFIX Bucket prefix for s3-tests (default: argmin-s3-)
  --timeout-secs SECS    S3 client timeout (default: 30)
  --topology NAME        Test topology: multihost or local (default: multihost)
  --repeat N            Repeat the selected s3-tests command N times (default: 1)
  --smoke NAME           Run a focused smoke instead of the full suite:
                         storage-node-restart, storage-node-kill-fails-closed,
                         storage-node-primary-kill-fails-closed,
                         control-plane-runtime-map, shard-repair,
                         shard-repair-restart,
                         route-change, route-change-node-restart,
                         route-change-restart,
                         route-change-control-plane-restart,
                         route-change-frontend-restart,
                         route-change-full-restart, pg-backfill-migration,
                         metadata-pg-migration, metadata-pg-migration-failover,
                         cleanup-versioned-stress
  --binary PATH          Run an already-built argmin-s3-compatible binary
                         (local debug endpoint defaults off unless explicitly enabled)
  --release              Use a release argmin-s3 binary
  --no-cleanup           Keep the temporary data directory after the run
  --no-cleanup-fail      Keep the temporary data directory only when the run fails
  -h, --help             Show this help

Examples:
  ./scripts/uat-s3-tests --test bucket_crud
  ./scripts/uat-s3-tests --topology local --test bucket_crud
  ./scripts/uat-s3-tests --binary ./target/debug/argmin-s3 --test bucket_crud
  ./scripts/uat-s3-tests --release
EOF
}

die() {
    echo "error: $*" >&2
    exit 2
}

listen_addr="${ARGMIN_UAT_LISTEN_ADDR:-}"
data_dir="${ARGMIN_UAT_DATA_DIR:-}"
bucket_prefix="${S3_TEST_BUCKET_PREFIX:-argmin-s3-}"
timeout_secs="${S3_TEST_TIMEOUT_SECS:-30}"
topology="${ARGMIN_UAT_TOPOLOGY:-multihost}"
smoke="${ARGMIN_UAT_SMOKE:-}"
repeat_count="${ARGMIN_UAT_REPEAT:-1}"
release=0
cleanup=0
keep_temp_data_dir=0
keep_failed_temp_data_dir=0
server_binary=""
cargo_args=()

while (($#)); do
    case "$1" in
        --listen)
            [[ $# -ge 2 ]] || die "--listen requires a value"
            listen_addr="$2"
            shift 2
            ;;
        --data-dir)
            [[ $# -ge 2 ]] || die "--data-dir requires a value"
            data_dir="$2"
            cleanup=0
            shift 2
            ;;
        --bucket-prefix)
            [[ $# -ge 2 ]] || die "--bucket-prefix requires a value"
            bucket_prefix="$2"
            shift 2
            ;;
        --timeout-secs)
            [[ $# -ge 2 ]] || die "--timeout-secs requires a value"
            timeout_secs="$2"
            shift 2
            ;;
        --topology)
            [[ $# -ge 2 ]] || die "--topology requires a value"
            topology="$2"
            shift 2
            ;;
        --repeat)
            [[ $# -ge 2 ]] || die "--repeat requires a value"
            repeat_count="$2"
            shift 2
            ;;
        --smoke)
            [[ $# -ge 2 ]] || die "--smoke requires a value"
            smoke="$2"
            shift 2
            ;;
        --binary)
            [[ $# -ge 2 ]] || die "--binary requires a value"
            server_binary="$2"
            shift 2
            ;;
        --release)
            release=1
            shift
            ;;
        --no-cleanup)
            keep_temp_data_dir=1
            shift
            ;;
        --no-cleanup-fail)
            keep_failed_temp_data_dir=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            cargo_args+=("$@")
            break
            ;;
        *)
            cargo_args+=("$1")
            shift
            ;;
    esac
done

cd "$ROOT"

if [[ -n "$server_binary" && "$release" -eq 1 ]]; then
    die "--binary cannot be combined with --release"
fi
case "$topology" in
    multihost|local)
        ;;
    *)
        die "--topology must be multihost or local"
        ;;
esac
case "$smoke" in
    ""|storage-node-restart|storage-node-kill-fails-closed|storage-node-primary-kill-fails-closed|control-plane-runtime-map|shard-repair|shard-repair-restart|route-change|route-change-node-restart|route-change-restart|route-change-control-plane-restart|route-change-frontend-restart|route-change-full-restart|pg-backfill-migration|metadata-pg-migration|metadata-pg-migration-failover|cleanup-versioned-stress)
        ;;
    *)
        die "--smoke must be storage-node-restart, storage-node-kill-fails-closed, storage-node-primary-kill-fails-closed, control-plane-runtime-map, shard-repair, shard-repair-restart, route-change, route-change-node-restart, route-change-restart, route-change-control-plane-restart, route-change-frontend-restart, route-change-full-restart, pg-backfill-migration, metadata-pg-migration, metadata-pg-migration-failover, or cleanup-versioned-stress"
        ;;
esac
if [[ -n "$smoke" && "$topology" != "multihost" ]]; then
    die "--smoke $smoke requires --topology multihost"
fi
if [[ -n "$smoke" && ${#cargo_args[@]} -ne 0 ]]; then
    die "--smoke cannot be combined with cargo nextest args"
fi
if ! [[ "$repeat_count" =~ ^[1-9][0-9]*$ ]]; then
    die "--repeat must be a positive integer"
fi
if [[ -n "$server_binary" ]]; then
    if [[ "$server_binary" == */* ]]; then
        [[ -x "$server_binary" ]] || die "--binary path is not executable: $server_binary"
    else
        command -v "$server_binary" >/dev/null 2>&1 || die "--binary command not found: $server_binary"
    fi
fi

if [[ -z "$data_dir" ]]; then
    data_dir="$(mktemp -d "${TMPDIR:-/tmp}/argmin-s3-uat.XXXXXX")"
    if ((keep_temp_data_dir == 0)); then
        cleanup=1
    fi
fi

port_is_listening() {
    local candidate_host="$1"
    local candidate_port="$2"
    (echo >"/dev/tcp/$candidate_host/$candidate_port") >/dev/null 2>&1
}

choose_listen_addr() {
    local candidate_host="127.0.0.1"
    local candidate_port
    for ((attempt = 0; attempt < 100; attempt++)); do
        candidate_port=$((20000 + ((RANDOM << 15 | RANDOM) + $$ + attempt) % 40000))
        if ! port_is_listening "$candidate_host" "$candidate_port"; then
            printf '%s:%s\n' "$candidate_host" "$candidate_port"
            return 0
        fi
    done
    die "could not find an unused localhost listen port"
}

if [[ -z "$listen_addr" ]]; then
    listen_addr="$(choose_listen_addr)"
    echo "== argmin-s3 UAT selected listen address: $listen_addr =="
fi

if [[ "$smoke" == "storage-node-restart" ]]; then
    export ARGMIN_EC_K=1
    export ARGMIN_EC_M=0
    export ARGMIN_LOCAL_NODE_COUNT=1
    export ARGMIN_PG_COUNT=1
fi
if [[ "$smoke" == "storage-node-kill-fails-closed" || "$smoke" == "storage-node-primary-kill-fails-closed" ]]; then
    export ARGMIN_EC_K=1
    export ARGMIN_EC_M=1
    export ARGMIN_LOCAL_NODE_COUNT=2
    export ARGMIN_PG_COUNT=1
fi
if [[ "$smoke" == "control-plane-runtime-map" ]]; then
    export ARGMIN_EC_K=1
    export ARGMIN_EC_M=1
    export ARGMIN_LOCAL_NODE_COUNT=2
    export ARGMIN_PG_COUNT=2
    export ARGMIN_CONTROL_PLANE_FRONTEND_REFRESH_MS="${ARGMIN_CONTROL_PLANE_FRONTEND_REFRESH_MS:-100}"
    export ARGMIN_CONTROL_PLANE_LEASE_SCAN_MS="${ARGMIN_CONTROL_PLANE_LEASE_SCAN_MS:-100}"
    export ARGMIN_CONTROL_PLANE_HEARTBEAT_LEASE_MS="${ARGMIN_CONTROL_PLANE_HEARTBEAT_LEASE_MS:-2000}"
fi
if [[ "$smoke" == "route-change" || "$smoke" == "route-change-node-restart" || "$smoke" == "route-change-restart" || "$smoke" == "route-change-control-plane-restart" || "$smoke" == "route-change-frontend-restart" || "$smoke" == "route-change-full-restart" ]]; then
    export ARGMIN_EC_K=1
    export ARGMIN_EC_M=1
    export ARGMIN_LOCAL_NODE_COUNT=3
    route_change_metadata_pg_slack=16
    route_change_default_pg_count=$((repeat_count + route_change_metadata_pg_slack))
    ((route_change_default_pg_count >= 16)) || route_change_default_pg_count=16
    export ARGMIN_PG_COUNT="${ARGMIN_PG_COUNT:-$route_change_default_pg_count}"
    export ARGMIN_CONTROL_PLANE_FRONTEND_REFRESH_MS="${ARGMIN_CONTROL_PLANE_FRONTEND_REFRESH_MS:-100}"
    export ARGMIN_CONTROL_PLANE_LEASE_SCAN_MS="${ARGMIN_CONTROL_PLANE_LEASE_SCAN_MS:-100}"
    export ARGMIN_CONTROL_PLANE_HEARTBEAT_LEASE_MS="${ARGMIN_CONTROL_PLANE_HEARTBEAT_LEASE_MS:-10000}"
    route_change_required_pg_count=$((repeat_count + route_change_metadata_pg_slack))
    if ((route_change_required_pg_count > ARGMIN_PG_COUNT)); then
        die "$smoke --repeat requires ARGMIN_PG_COUNT >= $route_change_required_pg_count"
    fi
    route_change_target_pgs=()
    for ((iteration = 1; iteration <= repeat_count; iteration++)); do
        route_change_target_pgs+=("$((iteration - 1))")
    done
    ARGMIN_ROUTE_CHANGE_TARGET_PGS="$(
        IFS=,
        echo "${route_change_target_pgs[*]}"
    )"
    export ARGMIN_ROUTE_CHANGE_TARGET_PGS
fi
if [[ "$smoke" == "pg-backfill-migration" ]]; then
    export ARGMIN_EC_K=1
    export ARGMIN_EC_M=1
    export ARGMIN_LOCAL_NODE_COUNT=3
    pg_backfill_metadata_pg_slack=16
    pg_backfill_default_pg_count=$((repeat_count + pg_backfill_metadata_pg_slack))
    ((pg_backfill_default_pg_count >= 16)) || pg_backfill_default_pg_count=16
    export ARGMIN_PG_COUNT="${ARGMIN_PG_COUNT:-$pg_backfill_default_pg_count}"
    export ARGMIN_CONTROL_PLANE_FRONTEND_REFRESH_MS="${ARGMIN_CONTROL_PLANE_FRONTEND_REFRESH_MS:-100}"
    export ARGMIN_CONTROL_PLANE_LEASE_SCAN_MS="${ARGMIN_CONTROL_PLANE_LEASE_SCAN_MS:-100}"
    export ARGMIN_CONTROL_PLANE_HEARTBEAT_LEASE_MS="${ARGMIN_CONTROL_PLANE_HEARTBEAT_LEASE_MS:-10000}"
    export ARGMIN_SHARD_SCAVENGER_SWEEP_INTERVAL_MS="${ARGMIN_SHARD_SCAVENGER_SWEEP_INTERVAL_MS:-200}"
    pg_backfill_required_pg_count=$((repeat_count + pg_backfill_metadata_pg_slack))
    if ((pg_backfill_required_pg_count > ARGMIN_PG_COUNT)); then
        die "pg-backfill-migration --repeat requires ARGMIN_PG_COUNT >= $pg_backfill_required_pg_count"
    fi
    pg_backfill_target_pgs=()
    for ((iteration = 1; iteration <= repeat_count; iteration++)); do
        pg_backfill_target_pgs+=("$((iteration - 1))")
    done
    ARGMIN_PG_BACKFILL_TARGET_PGS="$(
        IFS=,
        echo "${pg_backfill_target_pgs[*]}"
    )"
    export ARGMIN_PG_BACKFILL_TARGET_PGS
fi
if [[ "$smoke" == "metadata-pg-migration" || "$smoke" == "metadata-pg-migration-failover" ]]; then
    export ARGMIN_EC_K=1
    export ARGMIN_EC_M=1
    export ARGMIN_LOCAL_NODE_COUNT=4
    metadata_migration_default_pg_count="$repeat_count"
    ((metadata_migration_default_pg_count >= 16)) || metadata_migration_default_pg_count=16
    export ARGMIN_PG_COUNT="${ARGMIN_PG_COUNT:-$metadata_migration_default_pg_count}"
    export ARGMIN_CONTROL_PLANE_FRONTEND_REFRESH_MS="${ARGMIN_CONTROL_PLANE_FRONTEND_REFRESH_MS:-100}"
    export ARGMIN_CONTROL_PLANE_LEASE_SCAN_MS="${ARGMIN_CONTROL_PLANE_LEASE_SCAN_MS:-100}"
    export ARGMIN_CONTROL_PLANE_HEARTBEAT_LEASE_MS="${ARGMIN_CONTROL_PLANE_HEARTBEAT_LEASE_MS:-10000}"
    export ARGMIN_SHARD_SCAVENGER_SWEEP_INTERVAL_MS="${ARGMIN_SHARD_SCAVENGER_SWEEP_INTERVAL_MS:-200}"
    if ((repeat_count > ARGMIN_PG_COUNT)); then
        die "$smoke --repeat requires ARGMIN_PG_COUNT >= repeat count"
    fi
fi
if [[ "$smoke" == "cleanup-versioned-stress" ]]; then
    export ARGMIN_EC_K=1
    export ARGMIN_EC_M=1
    export ARGMIN_LOCAL_NODE_COUNT=3
    cleanup_stress_default_pg_count="$repeat_count"
    ((cleanup_stress_default_pg_count >= 16)) || cleanup_stress_default_pg_count=16
    export ARGMIN_PG_COUNT="${ARGMIN_PG_COUNT:-$cleanup_stress_default_pg_count}"
    export ARGMIN_CONTROL_PLANE_FRONTEND_REFRESH_MS="${ARGMIN_CONTROL_PLANE_FRONTEND_REFRESH_MS:-100}"
    export ARGMIN_CONTROL_PLANE_LEASE_SCAN_MS="${ARGMIN_CONTROL_PLANE_LEASE_SCAN_MS:-100}"
    export ARGMIN_CONTROL_PLANE_HEARTBEAT_LEASE_MS="${ARGMIN_CONTROL_PLANE_HEARTBEAT_LEASE_MS:-10000}"
    export ARGMIN_SHARD_SCAVENGER_SWEEP_INTERVAL_MS="${ARGMIN_SHARD_SCAVENGER_SWEEP_INTERVAL_MS:-200}"
fi
if [[ "$smoke" == "route-change-control-plane-restart" || "$smoke" == "route-change-full-restart" || "$smoke" == "pg-backfill-migration" ]]; then
    control_plane_storage_auth_credentials=""
    for ((node_id = 0; node_id < ARGMIN_LOCAL_NODE_COUNT; node_id++)); do
        [[ -z "$control_plane_storage_auth_credentials" ]] ||
            control_plane_storage_auth_credentials+=","
        control_plane_storage_auth_credentials+="$node_id=uat-storage-$node_id:1:uat-storage-secret-$node_id"
    done
    export ARGMIN_CONTROL_PLANE_AUTH_CLUSTER_ID="uat-control-plane"
    export ARGMIN_CONTROL_PLANE_STORAGE_AUTH_CREDENTIALS="$control_plane_storage_auth_credentials"
    export ARGMIN_CONTROL_PLANE_FRONTEND_AUTH_INSTANCE_ID="uat-frontend"
    export ARGMIN_CONTROL_PLANE_FRONTEND_AUTH_CREDENTIALS="uat-frontend=uat-frontend:1:uat-frontend-secret"
    export ARGMIN_CONTROL_PLANE_ADMIN_AUTH_INSTANCE_ID="uat-admin"
    export ARGMIN_CONTROL_PLANE_ADMIN_AUTH_CREDENTIALS="uat-admin=uat-admin:1:uat-admin-secret"
fi
if [[ "$smoke" == "storage-node-kill-fails-closed" || "$smoke" == "storage-node-primary-kill-fails-closed" ]]; then
    export ARGMIN_ABORT_ON_500=0
fi

logs_dir="$data_dir/logs"
sockets_dir="$data_dir/sockets"
mkdir -p "$logs_dir"
mkdir -p "$sockets_dir"
chmod 700 "$sockets_dir"
server_log="$logs_dir/argmin-s3.log"
shard_repair_smoke_cmd=()
pg_backfill_smoke_cmd=()

host="${listen_addr%:*}"
port="${listen_addr##*:}"
if [[ "$host" == "$listen_addr" || -z "$port" ]]; then
    die "--listen must be host:port"
fi

endpoint="https://localhost:$port"
cert_path="$ROOT/crates/s3-tests/testdata/localhost-cert.pem"
key_path="$ROOT/crates/s3-tests/testdata/localhost-key.pem"
ca_path="$ROOT/crates/s3-tests/testdata/ca-cert.pem"

export ARGMIN_ACCOUNT_ID="${ARGMIN_ACCOUNT_ID:-111122223333}"
export ARGMIN_ACCESS_KEY_ID="${ARGMIN_ACCESS_KEY_ID:-argmin-primary}"
export ARGMIN_SECRET_ACCESS_KEY="${ARGMIN_SECRET_ACCESS_KEY:-argmin-primary-secret}"
export ARGMIN_UAT_ALT_ACCOUNT_ID="${ARGMIN_UAT_ALT_ACCOUNT_ID:-444455556666}"
export ARGMIN_UAT_ALT_ACCESS_KEY_ID="${ARGMIN_UAT_ALT_ACCESS_KEY_ID:-argmin-alt}"
export ARGMIN_UAT_ALT_SECRET_ACCESS_KEY="${ARGMIN_UAT_ALT_SECRET_ACCESS_KEY:-argmin-alt-secret}"
export ARGMIN_UAT_SECOND_ACCESS_KEY_ID="${ARGMIN_UAT_SECOND_ACCESS_KEY_ID:-argmin-second}"
export ARGMIN_UAT_SECOND_SECRET_ACCESS_KEY="${ARGMIN_UAT_SECOND_SECRET_ACCESS_KEY:-argmin-second-secret}"
export ARGMIN_UAT_OWNER_ROOT_ACCESS_KEY_ID="${ARGMIN_UAT_OWNER_ROOT_ACCESS_KEY_ID:-argmin-owner-root}"
export ARGMIN_UAT_OWNER_ROOT_SECRET_ACCESS_KEY="${ARGMIN_UAT_OWNER_ROOT_SECRET_ACCESS_KEY:-argmin-owner-root-secret}"
export ARGMIN_SSE_S3_WRAPPING_KEY="${ARGMIN_SSE_S3_WRAPPING_KEY:-MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=}"
export ARGMIN_SSE_C_VALIDATOR_KEY="${ARGMIN_SSE_C_VALIDATOR_KEY:-MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=}"
export ARGMIN_LISTEN_ADDR="$listen_addr"
export ARGMIN_DATA_DIR="$data_dir"
export ARGMIN_TLS_CERT_PATH="${ARGMIN_TLS_CERT_PATH:-$cert_path}"
export ARGMIN_TLS_KEY_PATH="${ARGMIN_TLS_KEY_PATH:-$key_path}"
export ARGMIN_REGION="${ARGMIN_REGION:-us-east-1}"
export ARGMIN_ABORT_ON_500="${ARGMIN_ABORT_ON_500:-1}"
export ARGMIN_EC_K="${ARGMIN_EC_K:-4}"
export ARGMIN_EC_M="${ARGMIN_EC_M:-2}"
export ARGMIN_LOCAL_NODE_COUNT="${ARGMIN_LOCAL_NODE_COUNT:-$((ARGMIN_EC_K + ARGMIN_EC_M))}"
export ARGMIN_PG_COUNT="${ARGMIN_PG_COUNT:-16}"
export ARGMIN_STORAGE_CLUSTER_EPOCH="${ARGMIN_STORAGE_CLUSTER_EPOCH:-1}"
if [[ -n "${ARGMIN_LOCAL_DEBUG_ENDPOINT+x}" ]]; then
    uat_local_debug_endpoint="$ARGMIN_LOCAL_DEBUG_ENDPOINT"
elif [[ -n "$server_binary" || "$release" -eq 1 ]]; then
    uat_local_debug_endpoint=0
else
    uat_local_debug_endpoint=1
fi

if [[ -n "${S3_TEST_TRACE:-}" && -z "${ARGMIN_TRACE:-}" ]]; then
    export ARGMIN_TRACE="$S3_TEST_TRACE"
fi
if [[ -n "${S3_TEST_TRACE_FILTER:-}" && -z "${ARGMIN_TRACE_FILTER:-}" ]]; then
    export ARGMIN_TRACE_FILTER="$S3_TEST_TRACE_FILTER"
fi
if [[ -n "${S3_TEST_TRACE_FILE:-}" && -z "${ARGMIN_TRACE_FILE:-}" ]]; then
    export ARGMIN_TRACE_FILE="$S3_TEST_TRACE_FILE"
elif [[ -n "${S3_TEST_TRACE_DIR:-}" && -z "${ARGMIN_TRACE_FILE:-}" ]]; then
    export ARGMIN_TRACE_FILE="${S3_TEST_TRACE_DIR%/}/argmin-s3.trace"
fi
if [[ -n "${S3_TEST_TRACE_SYNC:-}" && -z "${ARGMIN_TRACE_SYNC:-}" ]]; then
    export ARGMIN_TRACE_SYNC="$S3_TEST_TRACE_SYNC"
fi

export S3_TEST_ENDPOINT="$endpoint"
export S3_CONTROL_TEST_ENDPOINT="$endpoint"
export S3_CONTROL_ALT_TEST_ENDPOINT="$endpoint"
export AWS_TEST_ACCESS_KEY="$ARGMIN_ACCESS_KEY_ID"
export AWS_TEST_SECRET_KEY="$ARGMIN_SECRET_ACCESS_KEY"
export AWS_TEST_ACCOUNT_ID="$ARGMIN_ACCOUNT_ID"
export AWS_TEST_ALT_ACCESS_KEY="$ARGMIN_UAT_ALT_ACCESS_KEY_ID"
export AWS_TEST_ALT_SECRET_KEY="$ARGMIN_UAT_ALT_SECRET_ACCESS_KEY"
export AWS_TEST_ALT_ACCOUNT_ID="$ARGMIN_UAT_ALT_ACCOUNT_ID"
export AWS_TEST_SECOND_ACCESS_KEY="$ARGMIN_UAT_SECOND_ACCESS_KEY_ID"
export AWS_TEST_SECOND_SECRET_KEY="$ARGMIN_UAT_SECOND_SECRET_ACCESS_KEY"
export AWS_TEST_SECOND_PRINCIPAL="arn:aws:iam::${ARGMIN_ACCOUNT_ID}:user/limited"
export AWS_TEST_OWNER_ROOT_ACCESS_KEY="$ARGMIN_UAT_OWNER_ROOT_ACCESS_KEY_ID"
export AWS_TEST_OWNER_ROOT_SECRET_KEY="$ARGMIN_UAT_OWNER_ROOT_SECRET_ACCESS_KEY"
export AWS_TEST_REGION="$ARGMIN_REGION"
export S3_TEST_BUCKET_PREFIX="$bucket_prefix"
export S3_TEST_TIMEOUT_SECS="$timeout_secs"
export S3_TEST_TLS_CA_CERT_PATH="${S3_TEST_TLS_CA_CERT_PATH:-$ca_path}"

server_pids=()
server_logs=()
server_names=()
storage_node_pids=()
storage_node_logs=()
frontend_pid=""
frontend_log=""
metrics_sampler_pid=""
slowdown_summary_printed=0
control_plane_state_path=""
control_plane_socket_path=""
control_plane_client_socket_paths=""
replicated_control_plane=0
control_plane_raft_node_ids=(101 102 103)
control_plane_pids=()
control_plane_logs=()
control_plane_socket_paths=()
control_plane_peer_socket_paths=()

print_command() {
    printf '+'
    printf ' %q' "$@"
    printf '\n'
}

print_final_result() {
    local status="$1"
    local test_label
    if [[ -n "$smoke" ]]; then
        test_label="$smoke smoke"
    else
        test_label="$topology s3-tests"
    fi
    if ((status == 0)); then
        if [[ -t 2 ]]; then
            printf '\033[32mOK\033[0m: argmin-s3 UAT %s passed\n' "$test_label" >&2
        else
            echo "OK: argmin-s3 UAT $test_label passed" >&2
        fi
    else
        if [[ -t 2 ]]; then
            printf '\033[31mFAIL\033[0m: argmin-s3 UAT %s failed with status %s\n' "$test_label" "$status" >&2
        else
            echo "FAIL: argmin-s3 UAT $test_label failed with status $status" >&2
        fi
    fi
}

server_cmd=()

start_process() {
    local name="$1"
    local log_path="$2"
    shift 2
    echo "== argmin-s3 UAT $name =="
    print_command "$@"
    "$@" >"$log_path" 2>&1 &
    server_pids+=("$!")
    server_logs+=("$log_path")
    server_names+=("$name")
}

start_storage_node() {
    local node_id="$1"
    local socket_path
    local node_data_dir
    local node_log
    socket_path="$sockets_dir/node-$(printf '%04d' "$node_id").sock"
    node_data_dir="$data_dir/storage-node-$(printf '%04d' "$node_id")"
    node_log="$logs_dir/storage-node-$(printf '%04d' "$node_id").log"
    local control_plane_env=()
    if [[ -n "$control_plane_socket_path" ]]; then
        control_plane_env=(
            ARGMIN_CONTROL_PLANE_SOCKET_PATH="$control_plane_socket_path"
            ARGMIN_CONTROL_PLANE_CLIENT_SOCKET_PATHS="$control_plane_client_socket_paths"
        )
    fi
    start_process "storage-node-$node_id" "$node_log" env \
        -u ARGMIN_STORAGE_NODE_SOCKETS \
        ARGMIN_PROCESS_ROLE=storage-node \
        ARGMIN_STORAGE_NODE_ID="$node_id" \
        ARGMIN_STORAGE_NODE_DATA_DIR="$node_data_dir" \
        ARGMIN_STORAGE_NODE_SOCKET_PATH="$socket_path" \
        "${control_plane_env[@]}" \
        ARGMIN_METADATA_COMMAND_CONFLICT_DIAGNOSTICS=1 \
        ARGMIN_DATA_DIR="$data_dir" \
        ARGMIN_LISTEN_ADDR="$listen_addr" \
        "${server_cmd[@]}"
    local index=$((${#server_pids[@]} - 1))
    storage_node_pids[node_id]="${server_pids[$index]}"
    storage_node_logs[node_id]="${server_logs[$index]}"
}

configure_replicated_control_plane() {
    replicated_control_plane=1
    local client_paths=()
    local peer_entries=()
    local auth_entries=()
    local raft_node_id
    for raft_node_id in "${control_plane_raft_node_ids[@]}"; do
        control_plane_socket_paths[raft_node_id]="$sockets_dir/control-plane-$raft_node_id.sock"
        control_plane_peer_socket_paths[raft_node_id]="$sockets_dir/control-plane-raft-$raft_node_id.sock"
        client_paths+=("${control_plane_socket_paths[$raft_node_id]}")
        peer_entries+=("$raft_node_id=${control_plane_peer_socket_paths[$raft_node_id]}")
        auth_entries+=("$raft_node_id=uat-raft-$raft_node_id:1:uat-raft-secret-$raft_node_id")
    done
    control_plane_socket_path="${control_plane_socket_paths[101]}"
    control_plane_state_path="$data_dir/control-plane-101.state"
    control_plane_client_socket_paths="$(IFS=,; echo "${client_paths[*]}")"
    control_plane_raft_peer_sockets="$(IFS=,; echo "${peer_entries[*]}")"
    control_plane_raft_auth_credentials="$(IFS=,; echo "${auth_entries[*]}")"
    export ARGMIN_CONTROL_PLANE_CLIENT_SOCKET_PATHS="$control_plane_client_socket_paths"
}

start_control_plane_node() {
    local raft_node_id="$1"
    local state_path="$data_dir/control-plane-$raft_node_id.state"
    local socket_path="${control_plane_socket_paths[$raft_node_id]}"
    local peer_socket_path="${control_plane_peer_socket_paths[$raft_node_id]}"
    local control_plane_log="$logs_dir/control-plane-$raft_node_id.log"
    start_process "control-plane-$raft_node_id" "$control_plane_log" env \
        ARGMIN_PROCESS_ROLE=control-plane \
        ARGMIN_CONTROL_PLANE_STATE_PATH="$state_path" \
        ARGMIN_CONTROL_PLANE_SOCKET_PATH="$socket_path" \
        ARGMIN_CONTROL_PLANE_CLIENT_SOCKET_PATHS="$control_plane_client_socket_paths" \
        ARGMIN_CONTROL_PLANE_EXPERIMENTAL_RAFT=1 \
        ARGMIN_CONTROL_PLANE_RAFT_CLUSTER_NAME=uat-control-plane-raft \
        ARGMIN_CONTROL_PLANE_RAFT_NODE_ID="$raft_node_id" \
        ARGMIN_CONTROL_PLANE_RAFT_PEER_SOCKET_PATH="$peer_socket_path" \
        ARGMIN_CONTROL_PLANE_RAFT_PEER_SOCKETS="$control_plane_raft_peer_sockets" \
        ARGMIN_CONTROL_PLANE_RAFT_AUTH_CREDENTIALS="$control_plane_raft_auth_credentials" \
        ARGMIN_STORAGE_NODE_SOCKETS="$storage_node_sockets" \
        ARGMIN_DATA_DIR="$data_dir/control-plane-$raft_node_id" \
        ARGMIN_LISTEN_ADDR="$listen_addr" \
        "${server_cmd[@]}"
    local index=$((${#server_pids[@]} - 1))
    control_plane_pids[raft_node_id]="${server_pids[$index]}"
    control_plane_logs[raft_node_id]="${server_logs[$index]}"
}

start_control_plane() {
    if ((replicated_control_plane)); then
        # Followers bind first so the deterministic bootstrap node can form the
        # initial quorum without relying on startup timing.
        start_control_plane_node 102
        start_control_plane_node 103
        start_control_plane_node 101
        return
    fi
    control_plane_state_path="$data_dir/control-plane.state"
    control_plane_socket_path="$sockets_dir/control-plane.sock"
    control_plane_client_socket_paths="$control_plane_socket_path"
    local control_plane_log="$logs_dir/control-plane.log"
    start_process "control-plane" "$control_plane_log" env \
        ARGMIN_PROCESS_ROLE=control-plane \
        ARGMIN_CONTROL_PLANE_STATE_PATH="$control_plane_state_path" \
        ARGMIN_CONTROL_PLANE_SOCKET_PATH="$control_plane_socket_path" \
        ARGMIN_CONTROL_PLANE_CLIENT_SOCKET_PATHS="$control_plane_client_socket_paths" \
        ARGMIN_STORAGE_NODE_SOCKETS="$storage_node_sockets" \
        ARGMIN_DATA_DIR="$data_dir/control-plane" \
        ARGMIN_LISTEN_ADDR="$listen_addr" \
        "${server_cmd[@]}"
}

start_frontend() {
    frontend_log="$logs_dir/frontend.log"
    if [[ "$smoke" == "control-plane-runtime-map" || "$smoke" == "route-change" || "$smoke" == "route-change-node-restart" || "$smoke" == "route-change-restart" || "$smoke" == "route-change-control-plane-restart" || "$smoke" == "route-change-frontend-restart" || "$smoke" == "route-change-full-restart" || "$smoke" == "pg-backfill-migration" || "$smoke" == "metadata-pg-migration" || "$smoke" == "metadata-pg-migration-failover" || "$smoke" == "cleanup-versioned-stress" ]]; then
        start_process "frontend" "$frontend_log" env \
            -u ARGMIN_STORAGE_NODE_ID \
            -u ARGMIN_STORAGE_NODE_DATA_DIR \
            -u ARGMIN_STORAGE_NODE_SOCKET_PATH \
            -u ARGMIN_STORAGE_NODE_SOCKETS \
            ARGMIN_PROCESS_ROLE=frontend \
            ARGMIN_BUCKET_DELETE_VISIBLE_DATA_DIAGNOSTICS=1 \
            ARGMIN_METADATA_COMMAND_CONFLICT_DIAGNOSTICS=1 \
            ARGMIN_LOCAL_DEBUG_ENDPOINT="$uat_local_debug_endpoint" \
            ARGMIN_CONTROL_PLANE_SOCKET_PATH="$control_plane_socket_path" \
            ARGMIN_CONTROL_PLANE_CLIENT_SOCKET_PATHS="$control_plane_client_socket_paths" \
            ARGMIN_DATA_DIR="$data_dir/frontend" \
            "${server_cmd[@]}"
    else
        start_process "frontend" "$frontend_log" env \
            -u ARGMIN_STORAGE_NODE_ID \
            -u ARGMIN_STORAGE_NODE_DATA_DIR \
            -u ARGMIN_STORAGE_NODE_SOCKET_PATH \
            ARGMIN_PROCESS_ROLE=frontend \
            ARGMIN_BUCKET_DELETE_VISIBLE_DATA_DIAGNOSTICS=1 \
            ARGMIN_METADATA_COMMAND_CONFLICT_DIAGNOSTICS=1 \
            ARGMIN_LOCAL_DEBUG_ENDPOINT="$uat_local_debug_endpoint" \
            ARGMIN_STORAGE_NODE_SOCKETS="$storage_node_sockets" \
            ARGMIN_DATA_DIR="$data_dir/frontend" \
            "${server_cmd[@]}"
    fi
    local index=$((${#server_pids[@]} - 1))
    frontend_pid="${server_pids[$index]}"
    frontend_log="${server_logs[$index]}"
}

wait_for_process() {
    local pid="$1"
    local log_path="$2"
    local name="$3"
    local state
    state="$(ps -o stat= -p "$pid" 2>/dev/null | tr -d '[:space:]' || true)"
    if [[ -z "$state" || "$state" == Z* ]]; then
        cat "$log_path" >&2 || true
        die "$name exited before becoming ready"
    fi
}

wait_for_storage_node_socket() {
    local node_id="$1"
    local pid="${storage_node_pids[$node_id]}"
    local log_path="${storage_node_logs[$node_id]}"
    local socket_path
    socket_path="$sockets_dir/node-$(printf '%04d' "$node_id").sock"
    for ((attempt = 0; attempt < 200; attempt++)); do
        wait_for_process "$pid" "$log_path" "storage-node-$node_id"
        if [[ -S "$socket_path" ]] && grep -q "storage-node $node_id listening" "$log_path"; then
            return 0
        fi
        sleep 0.1
    done
    cat "$log_path" >&2 || true
    die "storage-node-$node_id did not become ready at $socket_path"
}

wait_for_control_plane_socket() {
    if ((replicated_control_plane)); then
        local raft_node_id
        for raft_node_id in "${control_plane_raft_node_ids[@]}"; do
            wait_for_control_plane_node_socket "$raft_node_id"
        done
        return
    fi
    local pid="${server_pids[$((${#server_pids[@]} - 1))]}"
    local log_path="${server_logs[$((${#server_logs[@]} - 1))]}"
    for ((attempt = 0; attempt < 200; attempt++)); do
        wait_for_process "$pid" "$log_path" "control-plane"
        if [[ -S "$control_plane_socket_path" ]] \
            && grep -q "control-plane manager using state" "$log_path"; then
            return 0
        fi
        sleep 0.1
    done
    cat "$log_path" >&2 || true
    die "control-plane did not become ready at $control_plane_socket_path"
}

wait_for_control_plane_node_socket() {
    local raft_node_id="$1"
    local pid="${control_plane_pids[$raft_node_id]}"
    local log_path="${control_plane_logs[$raft_node_id]}"
    local socket_path="${control_plane_socket_paths[$raft_node_id]}"
    for ((attempt = 0; attempt < 300; attempt++)); do
        wait_for_process "$pid" "$log_path" "control-plane-$raft_node_id"
        if [[ -S "$socket_path" ]] \
            && grep -q "control-plane manager using state" "$log_path"; then
            return 0
        fi
        sleep 0.1
    done
    cat "$log_path" >&2 || true
    die "control-plane-$raft_node_id did not become ready at $socket_path"
}

restart_storage_node() {
    local node_id="$1"
    local pid="${storage_node_pids[$node_id]}"
    echo "== argmin-s3 UAT restart storage-node-$node_id =="
    if kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
    fi
    start_storage_node "$node_id"
    wait_for_storage_node_socket "$node_id"
}

restart_all_storage_nodes() {
    local node_id
    for ((node_id = 0; node_id < ARGMIN_LOCAL_NODE_COUNT; node_id++)); do
        restart_storage_node "$node_id"
    done
}

restart_frontend() {
    echo "== argmin-s3 UAT restart frontend =="
    if [[ -n "${frontend_pid:-}" ]] && kill -0 "$frontend_pid" 2>/dev/null; then
        kill "$frontend_pid" 2>/dev/null || true
        wait "$frontend_pid" 2>/dev/null || true
    fi
    start_frontend
    wait_for_process "$frontend_pid" "$frontend_log" "frontend"
    wait_for_https_ready
}

kill_storage_node() {
    local node_id="$1"
    local pid="${storage_node_pids[$node_id]}"
    echo "== argmin-s3 UAT kill storage-node-$node_id =="
    if kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
    fi
}

kill_control_plane() {
    echo "== argmin-s3 UAT kill control-plane =="
    for index in "${!server_names[@]}"; do
        if [[ "${server_names[$index]}" == "control-plane" ]]; then
            local pid="${server_pids[$index]}"
            if kill -0 "$pid" 2>/dev/null; then
                kill "$pid" 2>/dev/null || true
                wait "$pid" 2>/dev/null || true
            fi
        fi
    done
}

replicated_control_plane_leader=""
replicated_control_plane_leader_status=""

observe_replicated_control_plane_leader() {
    local preferred_raft_node_id="${1:-}"
    replicated_control_plane_leader=""
    replicated_control_plane_leader_status=""
    local quorum=$(((${#control_plane_raft_node_ids[@]} / 2) + 1))
    local highest_term=-1
    local highest_term_observations=0
    local raft_node_ids=()
    if [[ -n "$preferred_raft_node_id" ]]; then
        raft_node_ids+=("$preferred_raft_node_id")
    fi
    local raft_node_id
    for raft_node_id in "${control_plane_raft_node_ids[@]}"; do
        [[ "$raft_node_id" == "$preferred_raft_node_id" ]] || raft_node_ids+=("$raft_node_id")
    done
    for raft_node_id in "${raft_node_ids[@]}"; do
        local pid="${control_plane_pids[$raft_node_id]:-}"
        [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null || continue
        local status
        status="$(control_plane_authority_clock_status_for_node "$raft_node_id" 2>/dev/null)" || continue
        local current_term
        current_term="$(authority_clock_status_field "$status" current_raft_term)" || continue
        [[ "$current_term" =~ ^[0-9]+$ ]] || continue
        local local_leader
        local local_serving
        local_leader="$(authority_clock_status_field "$status" local_raft_authority_leader)" || continue
        local_serving="$(authority_clock_status_field "$status" local_raft_authority_serving)" || continue

        if ((current_term > highest_term)); then
            highest_term="$current_term"
            highest_term_observations=1
            replicated_control_plane_leader=""
            replicated_control_plane_leader_status=""
        elif ((current_term == highest_term)); then
            ((highest_term_observations += 1))
        else
            continue
        fi

        if [[ "$local_leader" == "true" && "$local_serving" == "true" ]]; then
            if [[ -n "$replicated_control_plane_leader" ]]; then
                replicated_control_plane_leader=""
                replicated_control_plane_leader_status=""
                return 1
            fi
            replicated_control_plane_leader="$raft_node_id"
            replicated_control_plane_leader_status="$status"
        fi
    done
    ((highest_term_observations >= quorum)) || return 1
    [[ -n "$replicated_control_plane_leader" ]]
}

current_replicated_control_plane_leader() {
    observe_replicated_control_plane_leader || return 1
    echo "$replicated_control_plane_leader"
}

control_plane_authority_clock_status_for_node() {
    local raft_node_id="$1"
    env -u ARGMIN_CONTROL_PLANE_CLIENT_SOCKET_PATHS \
        "${server_cmd[@]}" control-plane-authority-clock-status \
        "${control_plane_socket_paths[$raft_node_id]}"
}

authority_clock_status_field() {
    local status="$1"
    local field="$2"
    local token
    for token in $status; do
        if [[ "$token" == "$field="* ]]; then
            printf '%s\n' "${token#*=}"
            return 0
        fi
    done
    return 1
}

fail_if_replicated_control_plane_authority_clock_blocked() {
    ((replicated_control_plane)) || return 0
    observe_replicated_control_plane_leader || return 0
    local status="$replicated_control_plane_leader_status"
    local established
    established="$(authority_clock_status_field "$status" established)" ||
        die "replicated control-plane authority-clock status omitted established state: $status"
    if [[ "$established" == "false" ]]; then
        echo "$status" >&2
        die "replicated control-plane authority clock became blocked outside an explicit failover recovery step"
    fi
    [[ "$established" == "true" ]] ||
        die "replicated control-plane authority-clock status has invalid established state: $status"
}

reestablished_control_plane_term=""

reestablish_replicated_control_plane_after_term_change() {
    local previous_term="$1"
    local transition_label="$2"
    local leader=""
    local status=""
    local current_term=""
    for ((attempt = 0; attempt < 200; attempt++)); do
        if observe_replicated_control_plane_leader "$leader"; then
            leader="$replicated_control_plane_leader"
            status="$replicated_control_plane_leader_status"
            current_term="$(authority_clock_status_field "$status" current_raft_term)" ||
                die "$transition_label authority-clock status omitted current Raft term: $status"
            if [[ "$current_term" =~ ^[0-9]+$ ]] && ((current_term > previous_term)); then
                break
            fi
        fi
        sleep 0.1
    done
    [[ "$current_term" =~ ^[0-9]+$ ]] && ((current_term > previous_term)) || {
        [[ -z "$status" ]] || echo "$status" >&2
        local diagnostic_node_id
        for diagnostic_node_id in "${control_plane_raft_node_ids[@]}"; do
            local diagnostic_pid="${control_plane_pids[$diagnostic_node_id]:-}"
            if [[ -z "$diagnostic_pid" ]] || ! kill -0 "$diagnostic_pid" 2>/dev/null; then
                echo "control-plane-$diagnostic_node_id process is not running" >&2
                continue
            fi
            local diagnostic_status
            diagnostic_status="$(control_plane_authority_clock_status_for_node \
                "$diagnostic_node_id" 2>&1)" || true
            echo "control-plane-$diagnostic_node_id authority clock: $diagnostic_status" >&2
        done
        die "$transition_label did not elect a leader in a term newer than $previous_term"
    }

    local established
    local blocked_reason
    local local_leader
    established="$(authority_clock_status_field "$status" established)" ||
        die "$transition_label status omitted established state: $status"
    blocked_reason="$(authority_clock_status_field "$status" blocked_reason)" ||
        die "$transition_label status omitted blocked reason: $status"
    local_leader="$(authority_clock_status_field "$status" local_raft_authority_leader)" ||
        die "$transition_label status omitted local leader state: $status"
    if [[ "$established" != "false" \
        || "$blocked_reason" != "Some(RaftLeadershipChanged)" \
        || "$local_leader" != "true" ]]; then
        echo "$status" >&2
        die "$transition_label did not produce the expected RaftLeadershipChanged authority-clock fence"
    fi

    echo "== argmin-s3 UAT $transition_label authority clock before recovery: $status =="
    local socket_path="${control_plane_socket_paths[$leader]}"
    print_command "${server_cmd[@]}" control-plane-reestablish-authority-clock "$socket_path"
    local recovery_status
    recovery_status="$("${server_cmd[@]}" \
        control-plane-reestablish-authority-clock "$socket_path")" ||
        die "$transition_label authority-clock re-establishment failed"
    echo "$recovery_status"

    local recovered_established
    local recovered_term
    local recovered_leader
    recovered_established="$(authority_clock_status_field "$recovery_status" established)" ||
        die "$transition_label recovery status omitted established state: $recovery_status"
    recovered_term="$(authority_clock_status_field "$recovery_status" current_raft_term)" ||
        die "$transition_label recovery status omitted current Raft term: $recovery_status"
    recovered_leader="$(authority_clock_status_field "$recovery_status" local_raft_authority_leader)" ||
        die "$transition_label recovery status omitted local leader state: $recovery_status"
    if [[ "$recovered_established" != "true" \
        || "$recovered_term" != "$current_term" \
        || "$recovered_leader" != "true" ]]; then
        die "$transition_label recovery did not establish clock authority in term $current_term: $recovery_status"
    fi
    reestablished_control_plane_term="$current_term"
}

recover_replicated_control_plane_rejoin_term_if_needed() {
    local previous_term="$1"
    # OpenRaft's automatic timer permits a three-second election timeout. Keep
    # this explicit recovery boundary active until the term has remained stable
    # for five seconds, leaving an additional convergence interval before
    # ordinary observational readiness polling resumes.
    local stable_observations=0
    local required_stable_observations=11
    local leader=""
    local status=""
    for ((attempt = 0; attempt < 120; attempt++)); do
        if observe_replicated_control_plane_leader "$leader"; then
            leader="$replicated_control_plane_leader"
            status="$replicated_control_plane_leader_status"
            local current_term
            current_term="$(authority_clock_status_field "$status" current_raft_term)" ||
                die "rejoined voter status omitted current Raft term: $status"
            [[ "$current_term" =~ ^[0-9]+$ ]] ||
                die "rejoined voter status has invalid current Raft term: $status"
            if ((current_term > previous_term)); then
                reestablish_replicated_control_plane_after_term_change \
                    "$previous_term" "rejoined-voter term transition"
                previous_term="$reestablished_control_plane_term"
                stable_observations=0
                continue
            fi
            ((current_term == previous_term)) ||
                die "rejoined voter regressed Raft term from $previous_term to $current_term"
            local established
            established="$(authority_clock_status_field "$status" established)" ||
                die "rejoined voter status omitted established state: $status"
            if [[ "$established" != "true" ]]; then
                echo "$status" >&2
                die "rejoined voter blocked authority clock without a Raft term transition"
            fi
            ((stable_observations += 1))
            if ((stable_observations >= required_stable_observations)); then
                reestablished_control_plane_term="$previous_term"
                return
            fi
        else
            stable_observations=0
            leader=""
        fi
        sleep 0.5
    done
    [[ -z "$status" ]] || echo "$status" >&2
    die "rejoined voter did not retain an established authority clock in one stable Raft term"
}

kill_control_plane_node() {
    local raft_node_id="$1"
    local pid="${control_plane_pids[$raft_node_id]}"
    echo "== argmin-s3 UAT kill control-plane-$raft_node_id =="
    if kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
    fi
}

restart_control_plane() {
    if ((replicated_control_plane)); then
        local old_leader
        for ((attempt = 0; attempt < 200; attempt++)); do
            if observe_replicated_control_plane_leader; then
                old_leader="$replicated_control_plane_leader"
                break
            fi
            sleep 0.1
        done
        [[ -n "${old_leader:-}" ]] || die "could not identify replicated control-plane leader"
        local old_status="$replicated_control_plane_leader_status"
        local old_term
        old_term="$(authority_clock_status_field "$old_status" current_raft_term)" ||
            die "replicated control-plane leader status omitted current Raft term: $old_status"
        [[ "$old_term" =~ ^[0-9]+$ ]] ||
            die "replicated control-plane leader status has invalid current Raft term: $old_status"
        [[ "$(authority_clock_status_field "$old_status" established)" == "true" ]] ||
            die "replicated control-plane leader was already clock-blocked before restart: $old_status"
        local pre_failover_diagnostics
        pre_failover_diagnostics="$("${server_cmd[@]}" control-plane-runtime-map-diagnostics \
            "$control_plane_socket_path" 2>/dev/null)" ||
            die "could not read replicated control-plane diagnostics before leader restart"
        local pre_failover_epoch
        pre_failover_epoch="$(runtime_map_diagnostics_summary_field \
            "$pre_failover_diagnostics" epoch)" ||
            die "replicated control-plane diagnostics omitted the pre-failover epoch"
        [[ "$pre_failover_epoch" =~ ^[0-9]+$ ]] ||
            die "replicated control-plane returned invalid pre-failover epoch $pre_failover_epoch"
        local pre_failover_max_node_lease_deadline_ms
        pre_failover_max_node_lease_deadline_ms="$(runtime_map_max_node_lease_deadline \
            "$pre_failover_diagnostics")" ||
            die "replicated control-plane diagnostics omitted a pre-failover storage-node lease"
        local post_failover_min_epoch="$pre_failover_epoch"
        echo "== argmin-s3 UAT restart replicated control-plane leader $old_leader =="
        kill_control_plane_node "$old_leader"
        reestablish_replicated_control_plane_after_term_change \
            "$old_term" "leader-loss term transition"
        local replacement_term="$reestablished_control_plane_term"
        start_control_plane_node "$old_leader"
        wait_for_control_plane_node_socket "$old_leader"
        # Rejoining the former leader can legitimately advance the term again.
        # Bind clock authority only after all three voters are back so the
        # resumed storage heartbeats cannot retain the interim term binding.
        recover_replicated_control_plane_rejoin_term_if_needed "$replacement_term"
        # Do not accept a map still covered only by predecessor-term leases.
        # A clean failover does not change topology and therefore need not bump
        # the cluster epoch. Require the epoch not to regress and every storage
        # node to renew beyond the greatest predecessor deadline in the same
        # snapshot that reports every PG serving.
        wait_for_control_plane_runtime_map_ready 30 "$post_failover_min_epoch" \
            "$pre_failover_max_node_lease_deadline_ms"
        return
    fi
    echo "== argmin-s3 UAT restart control-plane =="
    kill_control_plane
    start_control_plane
    wait_for_control_plane_socket
    assert_control_plane_authority_clock_established_after_restart
}

assert_control_plane_authority_clock_established_after_restart() {
    local status=""
    for ((attempt = 0; attempt < 200; attempt++)); do
        if status="$("${server_cmd[@]}" control-plane-authority-clock-status "$control_plane_socket_path" 2>/dev/null)"; then
            break
        fi
        sleep 0.1
    done
    [[ -n "$status" ]] || die "failed to read control-plane authority-clock status after restart"
    echo "== argmin-s3 UAT control-plane authority clock after restart: $status =="
    [[ "$(authority_clock_status_field "$status" established)" == "true" ]] ||
        die "control-plane authority clock did not resume from durable restart evidence: $status"
}

set_pg_acting_set() {
    local label="$1"
    local pg_id="$2"
    shift
    shift
    echo "== argmin-s3 UAT set PG $pg_id acting set: $label =="
    print_command "${server_cmd[@]}" control-plane-set-pg-acting-set-live "$control_plane_socket_path" "$pg_id" "$@"
    "${server_cmd[@]}" control-plane-set-pg-acting-set-live "$control_plane_socket_path" "$pg_id" "$@"
}

transfer_pg_metadata() {
    local label="$1"
    local pg_id="$2"
    shift
    shift
    echo "== argmin-s3 UAT transfer PG $pg_id metadata: $label =="
    print_command "${server_cmd[@]}" control-plane-transfer-pg-metadata-live "$control_plane_socket_path" "$pg_id" "$@"
    "${server_cmd[@]}" control-plane-transfer-pg-metadata-live "$control_plane_socket_path" "$pg_id" "$@"
}

transfer_pg_metadata_expect_injected_failure() {
    local failpoint="$1"
    local label="$2"
    local pg_id="$3"
    shift 3
    echo "== argmin-s3 UAT transfer PG $pg_id metadata injected failure: $label ($failpoint) =="
    print_command env ARGMIN_METADATA_TRANSFER_FAILPOINT="$failpoint" "${server_cmd[@]}" control-plane-transfer-pg-metadata-live "$control_plane_socket_path" "$pg_id" "$@"
    if env ARGMIN_METADATA_TRANSFER_FAILPOINT="$failpoint" "${server_cmd[@]}" control-plane-transfer-pg-metadata-live "$control_plane_socket_path" "$pg_id" "$@"; then
        die "metadata transfer failpoint $failpoint unexpectedly succeeded"
    fi
}

set_all_pg_acting_sets() {
    local label="$1"
    shift
    for ((pg_id = 0; pg_id < ARGMIN_PG_COUNT; pg_id++)); do
        echo "== argmin-s3 UAT set PG $pg_id acting set: $label =="
        print_command "${server_cmd[@]}" control-plane-set-pg-acting-set-live "$control_plane_socket_path" "$pg_id" "$@"
        "${server_cmd[@]}" control-plane-set-pg-acting-set-live "$control_plane_socket_path" "$pg_id" "$@"
    done
}

wait_for_control_plane_pg_active() {
    local pg_id="$1"
    local deadline_seconds="$2"
    local expected_acting_set="${3:-}"
    [[ -n "$expected_acting_set" ]] || die "wait_for_control_plane_pg_active requires an expected acting set"
    local expected_nodes=()
    IFS=: read -r -a expected_nodes <<<"$expected_acting_set"
    local start
    start="$(date +%s)"
    while true; do
        local pg_status
        if pg_status="$("${server_cmd[@]}" control-plane-pg-runtime-map-ready "$control_plane_socket_path" "$pg_id" "${expected_nodes[@]}" 2>/dev/null)"; then
            read -r control_plane_pg_runtime_epoch control_plane_pg_route_epoch <<<"$pg_status"
            echo "== argmin-s3 UAT PG $pg_id is active at route epoch $control_plane_pg_route_epoch in runtime epoch $control_plane_pg_runtime_epoch =="
            return 0
        fi
        if (($(date +%s) - start >= deadline_seconds)); then
            "${server_cmd[@]}" control-plane-pg-runtime-map-ready "$control_plane_socket_path" "$pg_id" "${expected_nodes[@]}" >&2 || true
            print_control_plane_runtime_map_diagnostics
            die "timed out waiting for PG $pg_id to become active"
        fi
        sleep 0.1
    done
}

control_plane_cluster_epoch() {
    local status
    status="$("${server_cmd[@]}" control-plane-runtime-map-ready "$control_plane_socket_path")" || return 1
    awk '{ print $1; exit }' <<<"$status"
}

wait_for_control_plane_node_epochs_aligned() {
    local deadline_seconds="$1"
    local min_epoch="${2:-1}"
    local start
    start="$(date +%s)"
    while true; do
        fail_if_replicated_control_plane_authority_clock_blocked
        local aligned_epoch
        aligned_epoch="$(control_plane_node_aligned_epoch)"
        if [[ -n "$aligned_epoch" ]] && ((aligned_epoch >= min_epoch)); then
            echo "== argmin-s3 UAT storage nodes aligned at runtime epoch $aligned_epoch =="
            control_plane_aligned_epoch="$aligned_epoch"
            return 0
        fi
        if (($(date +%s) - start >= deadline_seconds)); then
            tail -n 80 "$control_plane_state_path" >&2 || true
            print_control_plane_runtime_map_diagnostics
            die "timed out waiting for storage-node runtime-map epochs to align at or after $min_epoch"
        fi
        sleep 0.1
    done
}

control_plane_node_aligned_epoch() {
    local diagnostics
    if ! diagnostics="$("${server_cmd[@]}" control-plane-runtime-map-diagnostics "$control_plane_socket_path" 2>/dev/null)"; then
        return 0
    fi
    awk -v expected_count="$ARGMIN_LOCAL_NODE_COUNT" '
        $1 ~ /^node_id=/ {
            observed_epoch = ""
            for (i = 1; i <= NF; i++) {
                split($i, fields, "=")
                if (fields[1] == "history_report_observed_epoch") {
                    observed_epoch = fields[2]
                    break
                }
            }
            if (observed_epoch !~ /^[0-9]+$/) {
                bad = 1
                next
            }
            count += 1
            if (epoch == "") {
                epoch = observed_epoch
            } else if (observed_epoch != epoch) {
                bad = 1
            }
        }
        END {
            if (count == expected_count && bad != 1 && epoch != "") {
                print epoch
            }
        }
    ' <<<"$diagnostics"
}

wait_for_control_plane_runtime_map_ready() {
    local deadline_seconds="$1"
    local min_epoch="${2:-1}"
    local renewed_after_deadline_ms="${3:-}"
    local start
    start="$(date +%s)"
    while true; do
        fail_if_replicated_control_plane_authority_clock_blocked
        if [[ -n "$renewed_after_deadline_ms" ]]; then
            local diagnostics
            local renewed_epoch
            if diagnostics="$("${server_cmd[@]}" control-plane-runtime-map-diagnostics \
                "$control_plane_socket_path" 2>/dev/null)" \
                && renewed_epoch="$(runtime_map_diagnostics_renewed_ready_epoch \
                    "$diagnostics" "$min_epoch" "$renewed_after_deadline_ms")"; then
                echo "== argmin-s3 UAT control-plane runtime map ready at epoch $renewed_epoch with all storage-node leases renewed beyond $renewed_after_deadline_ms ms =="
                control_plane_runtime_map_ready_epoch="$renewed_epoch"
                return 0
            fi
        else
            local map_status
            if map_status="$("${server_cmd[@]}" control-plane-runtime-map-ready "$control_plane_socket_path" 2>/dev/null)" \
                && control_plane_runtime_map_status_ready "$map_status" "$min_epoch"; then
                return 0
            fi
        fi
        if (($(date +%s) - start >= deadline_seconds)); then
            if [[ -n "$renewed_after_deadline_ms" ]]; then
                local final_diagnostics
                final_diagnostics="$("${server_cmd[@]}" control-plane-runtime-map-diagnostics \
                    "$control_plane_socket_path" 2>&1)" || true
                printf '%s\n' "$final_diagnostics" >&2
            else
                local final_map_status
                if final_map_status="$("${server_cmd[@]}" control-plane-runtime-map-ready "$control_plane_socket_path" 2>&1)" \
                    && control_plane_runtime_map_status_ready "$final_map_status" "$min_epoch"; then
                    return 0
                fi
                printf '%s\n' "$final_map_status" >&2
            fi
            tail -n 120 "$control_plane_state_path" >&2 || true
            if [[ -n "$renewed_after_deadline_ms" ]]; then
                die "timed out waiting for control-plane runtime map readiness at or after epoch $min_epoch with every storage-node lease renewed beyond $renewed_after_deadline_ms ms"
            fi
            die "timed out waiting for control-plane runtime map readiness at or after epoch $min_epoch"
        fi
        if [[ -n "$renewed_after_deadline_ms" ]]; then
            sleep 0.5
        else
            sleep 0.1
        fi
    done
}

runtime_map_diagnostics_summary_field() {
    local diagnostics="$1"
    local wanted_field="$2"
    awk -v wanted_field="$wanted_field" '
        NR == 1 {
            for (i = 1; i <= NF; i++) {
                split($i, fields, "=")
                if (fields[1] == wanted_field) {
                    print fields[2]
                    exit
                }
            }
        }
    ' <<<"$diagnostics"
}

runtime_map_max_node_lease_deadline() {
    local diagnostics="$1"
    awk -v expected_count="$ARGMIN_LOCAL_NODE_COUNT" '
        $1 ~ /^node_id=/ {
            deadline = ""
            for (i = 1; i <= NF; i++) {
                split($i, fields, "=")
                if (fields[1] == "lease_deadline_ms") {
                    deadline = fields[2]
                    break
                }
            }
            if (deadline !~ /^[0-9]+$/) {
                bad = 1
                next
            }
            count += 1
            if (maximum == "" || deadline + 0 > maximum + 0) {
                maximum = deadline
            }
        }
        END {
            if (count == expected_count && bad != 1 && maximum != "") {
                print maximum
            } else {
                exit 1
            }
        }
    ' <<<"$diagnostics"
}

runtime_map_diagnostics_renewed_ready_epoch() {
    local diagnostics="$1"
    local min_epoch="$2"
    local renewed_after_deadline_ms="$3"
    awk \
        -v expected_nodes="$ARGMIN_LOCAL_NODE_COUNT" \
        -v expected_pgs="$ARGMIN_PG_COUNT" \
        -v min_epoch="$min_epoch" \
        -v renewed_after="$renewed_after_deadline_ms" '
        NR == 1 {
            for (i = 1; i <= NF; i++) {
                split($i, fields, "=")
                if (fields[1] == "epoch") epoch = fields[2]
                if (fields[1] == "pg_routes") pg_routes = fields[2]
                if (fields[1] == "active_serving_pg_routes") active_routes = fields[2]
            }
        }
        $1 ~ /^node_id=/ {
            deadline = ""
            for (i = 1; i <= NF; i++) {
                split($i, fields, "=")
                if (fields[1] == "lease_deadline_ms") {
                    deadline = fields[2]
                    break
                }
            }
            if (deadline !~ /^[0-9]+$/ || deadline + 0 <= renewed_after + 0) {
                bad_node = 1
            }
            nodes += 1
        }
        END {
            if (epoch ~ /^[0-9]+$/ && epoch + 0 >= min_epoch + 0 \
                && pg_routes + 0 == expected_pgs + 0 \
                && active_routes + 0 == expected_pgs + 0 \
                && nodes + 0 == expected_nodes + 0 && bad_node != 1) {
                print epoch
            } else {
                exit 1
            }
        }
    ' <<<"$diagnostics"
}

control_plane_runtime_map_status_ready() {
    local map_status="$1"
    local min_epoch="$2"
    local runtime_epoch
    local pg_routes
    local active_serving_pg_routes
    read -r runtime_epoch pg_routes active_serving_pg_routes <<<"$map_status"
    if [[ "$runtime_epoch" =~ ^[0-9]+$ && "$pg_routes" =~ ^[0-9]+$ && "$active_serving_pg_routes" =~ ^[0-9]+$ ]] \
        && ((runtime_epoch >= min_epoch && pg_routes == ARGMIN_PG_COUNT && active_serving_pg_routes == ARGMIN_PG_COUNT)); then
        echo "== argmin-s3 UAT control-plane runtime map ready at epoch $runtime_epoch with $active_serving_pg_routes/$pg_routes serving PG routes =="
        control_plane_runtime_map_ready_epoch="$runtime_epoch"
        return 0
    fi
    return 1
}

print_control_plane_runtime_map_diagnostics() {
    if [[ -z "$control_plane_socket_path" || ! -S "$control_plane_socket_path" || ${#server_cmd[@]} -eq 0 ]]; then
        return 0
    fi
    echo "== argmin-s3 UAT control-plane runtime-map diagnostics ==" >&2
    "${server_cmd[@]}" control-plane-runtime-map-diagnostics "$control_plane_socket_path" >&2 || true
}

runtime_map_node_storage_history_floor() {
    local diagnostics="$1"
    local node_id="$2"
    awk -v wanted_node_id="$node_id" '
        $1 == ("node_id=" wanted_node_id) {
            for (i = 1; i <= NF; i++) {
                split($i, fields, "=")
                if (fields[1] == "storage_history_floor_epoch") {
                    print fields[2]
                    exit
                }
            }
        }
    ' <<<"$diagnostics"
}

wait_for_control_plane_storage_history_floor_nodes() {
    local deadline_seconds="$1"
    local max_floor_epoch="$2"
    shift 2
    local expected_node_ids=("$@")
    local start
    start="$(date +%s)"
    local diagnostics=""
    while true; do
        if diagnostics="$("${server_cmd[@]}" control-plane-runtime-map-diagnostics "$control_plane_socket_path" 2>/dev/null)"; then
            local matched_nodes=0
            local node_id
            for node_id in "${expected_node_ids[@]}"; do
                local node_floor
                node_floor="$(runtime_map_node_storage_history_floor "$diagnostics" "$node_id")"
                if [[ "$node_floor" =~ ^[0-9]+$ ]] && ((node_floor <= max_floor_epoch)); then
                    matched_nodes=$((matched_nodes + 1))
                fi
            done
            if ((matched_nodes == ${#expected_node_ids[@]})); then
                echo "== argmin-s3 UAT control-plane storage history floors: nodes=${expected_node_ids[*]} max_expected_epoch=$max_floor_epoch =="
                return 0
            fi
        fi
        if (($(date +%s) - start >= deadline_seconds)); then
            if [[ -n "$diagnostics" ]]; then
                printf '%s\n' "$diagnostics" >&2
            else
                print_control_plane_runtime_map_diagnostics
            fi
            die "timed out waiting for control-plane storage history floors on nodes ${expected_node_ids[*]} at or before epoch $max_floor_epoch"
        fi
        sleep 0.2
    done
}

wait_for_frontend_storage_epoch_at_least() {
    local expected_epoch="$1"
    local deadline_seconds="$2"
    local metrics_path="$3"
    local start
    start="$(date +%s)"
    while true; do
        if sample_frontend_metrics "$metrics_path"; then
            local frontend_epoch
            frontend_epoch="$(latest_metric_sample_value "$metrics_path" frontend_storage_cluster_epoch)"
            if ((frontend_epoch >= expected_epoch)); then
                echo "== argmin-s3 UAT frontend storage epoch $frontend_epoch >= $expected_epoch =="
                return 0
            fi
        fi
        if (($(date +%s) - start >= deadline_seconds)); then
            cat "$metrics_path" >&2 || true
            die "timed out waiting for frontend storage epoch to reach $expected_epoch"
        fi
        sleep 0.1
    done
}

wait_for_serving_runtime_installed() {
    local deadline_seconds="$1"
    local metrics_path="$2"
    sample_frontend_metrics "$metrics_path" || true
    local frontend_epoch
    frontend_epoch="$(latest_metric_sample_value "$metrics_path" frontend_storage_cluster_epoch)"
    wait_for_control_plane_runtime_map_ready "$deadline_seconds" "$frontend_epoch"
    wait_for_control_plane_node_epochs_aligned "$deadline_seconds" "$control_plane_runtime_map_ready_epoch"
    wait_for_frontend_storage_epoch_at_least "$control_plane_aligned_epoch" "$deadline_seconds" "$metrics_path"
}

wait_for_target_pg_runtime_installed() {
    local pg_id="$1"
    local expected_acting_set="$2"
    local deadline_seconds="$3"
    local metrics_path="$4"
    wait_for_control_plane_pg_active "$pg_id" "$deadline_seconds" "$expected_acting_set"
    local target_epoch
    target_epoch="$control_plane_pg_runtime_epoch"
    wait_for_control_plane_runtime_map_ready "$deadline_seconds" "$target_epoch"
    wait_for_control_plane_node_epochs_aligned "$deadline_seconds" "$control_plane_runtime_map_ready_epoch"
    wait_for_frontend_storage_epoch_at_least "$control_plane_aligned_epoch" "$deadline_seconds" "$metrics_path"
}

latest_metric_sample_value() {
    local metrics_log="$1"
    local metric_name="$2"
    awk -v metric="$metric_name" '$1 == metric { value = $2 } END { if (value != "") print value; else print "0" }' "$metrics_log"
}

latest_metric_family_label_sum() {
    local metrics_log="$1"
    local metric_name="$2"
    local label_name="$3"
    local label_value="$4"
    local label_name_2="${5:-}"
    local label_value_2="${6:-}"
    awk -v metric="$metric_name" -v label="$label_name" -v label_value="$label_value" -v label_2="$label_name_2" -v label_value_2="$label_value_2" '
        BEGIN {
            needle = label "=\"" label_value "\""
            needle_2 = label_2 "=\"" label_value_2 "\""
        }
        index($1, metric "{") == 1 && index($1, needle) > 0 && (label_2 == "" || index($1, needle_2) > 0) { values[$1] = $2 }
        END {
            total = 0
            for (sample in values) {
                total += values[sample]
            }
            print total
        }
    ' "$metrics_log"
}

latest_metric_family_top() {
    local metrics_log="$1"
    local metric_name="$2"
    local limit="$3"
    awk -v metric="$metric_name" '
        index($1, metric "{") == 1 { values[$1] = $2 }
        END {
            for (sample in values) {
                print values[sample], sample
            }
        }
    ' "$metrics_log" | sort -nr | head -n "$limit"
}

sample_frontend_metrics() {
    local output_path="$1"
    curl -k -sS "$endpoint/__argmin/debug/metrics" >"$output_path"
}

print_storage_node_log_tails() {
    if [[ -z "${logs_dir:-}" || ! -d "$logs_dir" ]]; then
        return 0
    fi

    local log_path
    while IFS= read -r -d '' log_path; do
        echo "== argmin-s3 UAT storage-node log tail: $log_path ==" >&2
        tail -n 80 "$log_path" >&2 || true
    done < <(find "$logs_dir" -maxdepth 1 -type f -name 'storage-node-*.log' -print0 2>/dev/null | sort -z)
}

print_shard_backfill_sqlite_debug() {
    if [[ -z "${data_dir:-}" || ! -d "$data_dir" ]]; then
        return 0
    fi
    if ! command -v sqlite3 >/dev/null 2>&1; then
        echo "== argmin-s3 UAT shard backfill sqlite debug skipped: sqlite3 not found ==" >&2
        return 0
    fi

    local printed_header=0
    local db_path
    while IFS= read -r -d '' db_path; do
        local rel_path="${db_path#$data_dir/}"
        local node_id="unknown"
        local pg_id="unknown"
        if [[ "$rel_path" =~ ^storage-node-([0-9]+)/pg-([0-9]+)/metadata\.db$ ]]; then
            node_id="$((10#${BASH_REMATCH[1]}))"
            pg_id="${BASH_REMATCH[2]}"
        fi

        local summary
        summary="$(sqlite3 "$db_path" <<SQL 2>/dev/null || true
.mode tabs
SELECT 'pending_slot', '$node_id', '$pg_id',
       cluster_epoch, pg_id, log_index, command_checksum, length(command_bytes), COALESCE(scope_bucket, '')
FROM metadata_command_pending_slot
LIMIT 1;
SELECT 'replica_state', '$node_id', '$pg_id',
       cluster_epoch, applied_log_index
FROM metadata_command_replica_state
LIMIT 1;
SELECT 'backfill', '$node_id', '$pg_id',
       data_pg_id, source_cluster_epoch, desired_cluster_epoch, remaining_tolerance,
       CASE WHEN claim_id IS NULL THEN 0 ELSE 1 END,
       COALESCE(cluster_epoch, -1), COALESCE(lease_deadline, -1), attempt_count,
       COALESCE(next_attempt_after, -1), substr(COALESCE(last_error, ''), 1, 160)
FROM placed_segment_shard_backfills
ORDER BY data_pg_id, source_cluster_epoch, desired_cluster_epoch, segment_vid
LIMIT 40;
SQL
)"
        if [[ -n "$summary" ]]; then
            if ((printed_header == 0)); then
                echo "== argmin-s3 UAT shard backfill sqlite snapshot ==" >&2
                echo "columns: kind node_id metadata_pg_id details..." >&2
                printed_header=1
            fi
            printf '%s\n' "$summary" >&2
        fi

        if grep -q '^pending_slot' <<<"$summary"; then
            echo "== argmin-s3 UAT metadata command log tail: node=$node_id pg=$pg_id ==" >&2
            sqlite3 "$db_path" <<SQL >&2 2>/dev/null || true
.mode tabs
SELECT cluster_epoch, pg_id, log_index, command_checksum, length(command_bytes), abandoned
FROM metadata_command_log
ORDER BY cluster_epoch DESC, log_index DESC
LIMIT 5;
SQL
        fi
    done < <(find "$data_dir" -path '*/pg-*/metadata.db' -type f -print0 2>/dev/null | sort -z)
}

print_shard_backfill_debug() {
    local metrics_path="$1"

    echo "== argmin-s3 UAT shard backfill failure diagnostics ==" >&2
    print_control_plane_runtime_map_diagnostics
    if [[ -s "$metrics_path" ]]; then
        echo "shard_backfill_top event" >&2
        latest_metric_family_top "$metrics_path" shard_backfill_event_by_pg_total 20 >&2 || true
        echo "metadata_pending_slot_top action" >&2
        latest_metric_family_top "$metrics_path" metadata_command_pending_slot_action_by_pg_command_total 20 >&2 || true
        echo "metadata_recovery_top admission" >&2
        latest_metric_family_top "$metrics_path" metadata_command_recovery_admission_by_pg_command_total 20 >&2 || true
        echo "metadata_recovery_top outcome" >&2
        latest_metric_family_top "$metrics_path" metadata_command_recovery_outcome_by_pg_command_total 20 >&2 || true
        echo "storage_rpc_top errors" >&2
        latest_metric_family_top "$metrics_path" storage_rpc_error_by_node_total 20 >&2 || true
        echo "background_work_top admission" >&2
        latest_metric_family_top "$metrics_path" background_work_admission_by_class_total 20 >&2 || true
    fi
    print_shard_backfill_sqlite_debug
    print_storage_node_log_tails
}

local_debug_endpoint_enabled() {
    case "$uat_local_debug_endpoint" in
        1|true|TRUE|True|yes|YES|Yes|on|ON|On)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

if [[ -n "$smoke" && -n "$server_binary" ]]; then
    die "--smoke cannot be combined with --binary; smoke runs require script-built debug binaries"
fi
if [[ -n "$smoke" && "$release" -eq 1 ]]; then
    die "--smoke cannot be combined with --release; smoke runs require debug binaries"
fi
if [[ -n "$smoke" ]] && ! local_debug_endpoint_enabled; then
    die "--smoke requires ARGMIN_LOCAL_DEBUG_ENDPOINT to be enabled"
fi
if [[ "$release" -eq 1 ]] && local_debug_endpoint_enabled; then
    die "--release cannot be combined with ARGMIN_LOCAL_DEBUG_ENDPOINT=1"
fi

print_bucket_delete_attempt_debug() {
    local bucket="$1"
    if [[ -z "$bucket" ]] || ! local_debug_endpoint_enabled; then
        return 0
    fi
    echo "== argmin-s3 UAT bucket delete attempt debug: bucket=$bucket ==" >&2
    curl -k -sS "$endpoint/__argmin/debug/bucket-delete-attempt/$bucket" >&2 || true
}

print_bucket_file_delete_attempt_debug() {
    local bucket_file="$1"
    [[ -s "$bucket_file" ]] || return 0

    local bucket
    bucket="$(tr -d '[:space:]' <"$bucket_file")"
    print_bucket_delete_attempt_debug "$bucket"
}

print_bucket_list_delete_attempt_debug() {
    local bucket_list_file="$1"
    [[ -s "$bucket_list_file" ]] || return 0

    local bucket
    while IFS= read -r bucket; do
        print_bucket_delete_attempt_debug "$bucket"
    done <"$bucket_list_file"
}

wait_for_storage_shard_files() {
    local expected_count="$1"
    local deadline_seconds="$2"
    local marker_file="$3"
    local start
    start="$(date +%s)"
    while true; do
        local count
        count="$(find "$data_dir" -path '*/pg-*/shards/*' -type f -newer "$marker_file" 2>/dev/null | wc -l | tr -d ' ')"
        if ((count >= expected_count)); then
            return 0
        fi
        if (($(date +%s) - start >= deadline_seconds)); then
            find "$data_dir" -path '*/pg-*/shards/*' -type f -newer "$marker_file" -print >&2 || true
            die "timed out waiting for at least $expected_count shard files; found $count"
        fi
        sleep 0.1
    done
}

corrupt_storage_data_shard_file() {
    local output_path_file="$1"
    local marker_file="$2"
    local shard_path
    shard_path=""
    local data_suffixes=()
    for ((shard_index = 0; shard_index < ARGMIN_EC_K; shard_index++)); do
        data_suffixes+=("$(printf '%02x' "$shard_index")")
    done
    while IFS= read -r -d '' candidate; do
        local filename="${candidate##*/}"
        for suffix in "${data_suffixes[@]}"; do
            if [[ "${filename: -2}" == "$suffix" ]]; then
                shard_path="$candidate"
                break 2
            fi
        done
    done < <(find "$data_dir" -path '*/pg-*/shards/*' -type f -newer "$marker_file" -print0 2>/dev/null)
    [[ -n "$shard_path" ]] || die "no data shard file found to corrupt"
    [[ -s "$shard_path" ]] || die "selected shard file is empty: $shard_path"
    local tmp_path="$shard_path.corrupting.$$"
    perl -0777 -pe 'substr($_, 0, 1) = chr(ord(substr($_, 0, 1)) ^ 0xff)' \
        "$shard_path" >"$tmp_path"
    mv "$tmp_path" "$shard_path"
    printf '%s\n' "$shard_path" >"$output_path_file"
    echo "== argmin-s3 UAT corrupted shard: $shard_path =="
}

wait_for_shard_repair_completion_metrics() {
    local metrics_path="$1"
    local deadline_seconds="$2"
    local start
    start="$(date +%s)"
    while true; do
        sample_frontend_metrics "$metrics_path"
        local rewritten
        local repaired
        local completed
        local queue_depth
        rewritten="$(latest_metric_sample_value "$metrics_path" shard_repair_shards_rewritten_total)"
        repaired="$(latest_metric_family_label_sum "$metrics_path" shard_repair_event_by_pg_total event repaired)"
        completed="$(latest_metric_family_label_sum "$metrics_path" shard_repair_event_by_pg_total event complete_succeeded)"
        queue_depth="$(latest_metric_sample_value "$metrics_path" shard_repair_queue_depth)"
        if ((rewritten >= 1 && repaired >= 1 && completed >= 1 && queue_depth == 0)); then
            echo "== argmin-s3 UAT shard repair metrics: rewritten=$rewritten repaired=$repaired complete_succeeded=$completed queue_depth=$queue_depth =="
            return 0
        fi
        if (($(date +%s) - start >= deadline_seconds)); then
            cat "$metrics_path" >&2 || true
            die "timed out waiting for shard repair completion metrics"
        fi
        sleep 0.2
    done
}

wait_for_shard_backfill_completion_metrics() {
    local metrics_path="$1"
    local deadline_seconds="$2"
    local min_scan_total="${3:-1}"
    local min_enqueued="${4:-1}"
    local min_written="${5:-1}"
    local min_completed="${6:-1}"
    local min_routine_admitted="${7:-1}"
    local min_routine_finished="${8:-1}"
    local max_candidate_failed="${9:-0}"
    local max_scan_error="${10:-0}"
    local max_complete_failed="${11:-0}"
    local max_failed="${12:-0}"
    local max_record_error_failed="${13:-0}"
    local target_pg_id="${14:-}"
    local start
    start="$(date +%s)"
    while true; do
        sample_frontend_metrics "$metrics_path"
        local scan_total
        local enqueued
        local written
        local completed
        local queue_depth
        local routine_admitted
        local routine_finished
        local candidate_failed
        local candidate_deferred
        local scan_error
        local complete_failed
        local failed
        local stale_retry
        local record_error_failed
        scan_total="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_scan_total)"
        enqueued="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_enqueued_total)"
        written="$(latest_metric_sample_value "$metrics_path" shard_backfill_shards_written_total)"
        completed="$(latest_metric_sample_value "$metrics_path" shard_backfill_complete_succeeded_total)"
        queue_depth="$(latest_metric_sample_value "$metrics_path" shard_backfill_queue_depth)"
        routine_admitted="$(latest_metric_family_label_sum "$metrics_path" background_work_admission_by_class_total event admitted class routine_backfill)"
        routine_finished="$(latest_metric_family_label_sum "$metrics_path" background_work_admission_by_class_total event finished class routine_backfill)"
        candidate_failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_failed_total)"
        candidate_deferred="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_deferred_total)"
        scan_error="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_scan_error_total)"
        complete_failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_complete_failed_total)"
        failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_failed_total)"
        stale_retry="$(latest_metric_family_label_sum "$metrics_path" shard_backfill_event_by_pg_total event stale_retry)"
        record_error_failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_record_error_failed_total)"
        if ((candidate_failed > max_candidate_failed || scan_error > max_scan_error || complete_failed > max_complete_failed || failed > max_failed || record_error_failed > max_record_error_failed)); then
            print_shard_backfill_debug "$metrics_path"
            cat "$metrics_path" >&2 || true
            die "shard backfill worker hard-failure metrics increased: candidate_failed=$candidate_failed scan_error=$scan_error complete_failed=$complete_failed failed=$failed record_error_failed=$record_error_failed"
        fi
        if ((scan_total >= min_scan_total && enqueued >= min_enqueued && written >= min_written && completed >= min_completed && queue_depth == 0 && routine_admitted >= min_routine_admitted && routine_finished >= min_routine_finished)); then
            echo "== argmin-s3 UAT shard backfill metrics: scan_total=$scan_total enqueued=$enqueued written=$written complete_succeeded=$completed candidate_deferred=$candidate_deferred candidate_failed=$candidate_failed scan_error=$scan_error stale_retry=$stale_retry failed=$failed queue_depth=$queue_depth routine_admitted=$routine_admitted routine_finished=$routine_finished pg_id=${target_pg_id:-any} =="
            return 0
        fi
        if (($(date +%s) - start >= deadline_seconds)); then
            print_shard_backfill_debug "$metrics_path"
            cat "$metrics_path" >&2 || true
            die "timed out waiting for shard backfill completion metrics"
        fi
        sleep 0.2
    done
}

wait_for_metadata_checkpoint_compaction_metrics() {
    local metrics_path="$1"
    local deadline_seconds="$2"
    local min_recorded="$3"
    local min_compacted="$4"
    local min_deleted_entries="$5"
    local max_record_failed="$6"
    local max_scan_error="$7"
    local max_compaction_failed="$8"
    local start
    start="$(date +%s)"
    while true; do
        sample_frontend_metrics "$metrics_path"
        local recorded
        local compacted
        local deleted_entries
        local record_failed
        local scan_error
        local compaction_failed
        recorded="$(latest_metric_sample_value "$metrics_path" metadata_command_checkpoint_record_recorded_total)"
        compacted="$(latest_metric_sample_value "$metrics_path" metadata_command_checkpoint_record_compacted_total)"
        deleted_entries="$(latest_metric_sample_value "$metrics_path" metadata_command_checkpoint_record_compaction_deleted_entries_total)"
        record_failed="$(latest_metric_sample_value "$metrics_path" metadata_command_checkpoint_record_failed_total)"
        scan_error="$(latest_metric_sample_value "$metrics_path" metadata_command_checkpoint_record_scan_error_total)"
        compaction_failed="$(latest_metric_sample_value "$metrics_path" metadata_command_checkpoint_record_compaction_failed_total)"
        if ((record_failed > max_record_failed || scan_error > max_scan_error || compaction_failed > max_compaction_failed)); then
            cat "$metrics_path" >&2 || true
            die "metadata checkpoint smoke saw hard failure: record_failed=$record_failed scan_error=$scan_error compaction_failed=$compaction_failed"
        fi
        if ((recorded >= min_recorded && compacted >= min_compacted && deleted_entries >= min_deleted_entries)); then
            echo "== argmin-s3 UAT metadata checkpoint metrics: recorded=$recorded compacted=$compacted compaction_deleted_entries=$deleted_entries =="
            return 0
        fi
        if (($(date +%s) - start >= deadline_seconds)); then
            cat "$metrics_path" >&2 || true
            die "timed out waiting for metadata checkpoint compaction metrics"
        fi
        sleep 0.2
    done
}

metadata_checkpoint_response_field() {
    local response_path="$1"
    local field_name="$2"
    awk -v field_name="$field_name" '
        {
            for (i = 1; i <= NF; i++) {
                split($i, parts, "=")
                if (parts[1] == field_name) {
                    print parts[2]
                    found = 1
                }
            }
        }
        END {
            if (!found) {
                print "0"
            }
        }
    ' "$response_path"
}

record_metadata_checkpoint_for_pg() {
    local pg_id="$1"
    local deadline_seconds="$2"
    local metrics_path="$3"
    local min_checkpoint_deleted_entries="$4"
    local start
    start="$(date +%s)"
    while true; do
        local response_path
        response_path="$(mktemp)"
        local status
        status="$(curl -k -sS -o "$response_path" -w '%{http_code}' -X POST "$endpoint/__argmin/debug/metadata-checkpoint/record/$pg_id" || true)"
        local recorded
        local compacted
        local deleted_entries
        local compaction_failed
        local failed
        recorded="$(metadata_checkpoint_response_field "$response_path" recorded)"
        compacted="$(metadata_checkpoint_response_field "$response_path" compacted)"
        deleted_entries="$(metadata_checkpoint_response_field "$response_path" compaction_deleted_entries)"
        compaction_failed="$(metadata_checkpoint_response_field "$response_path" compaction_failed)"
        failed="$(metadata_checkpoint_response_field "$response_path" failed)"
        if ((compaction_failed > 0 || failed > 0)); then
            cat "$response_path" >&2 || true
            rm -f "$response_path"
            die "metadata checkpoint forced record failed for PG $pg_id: compaction_failed=$compaction_failed failed=$failed"
        fi
        if [[ "$status" == "200" ]]; then
            sample_frontend_metrics "$metrics_path"
            local metric_deleted_entries
            metric_deleted_entries="$(latest_metric_sample_value "$metrics_path" metadata_command_checkpoint_record_compaction_deleted_entries_total)"
            if ((recorded > 0 && ((compacted > 0 && deleted_entries > 0) || metric_deleted_entries > min_checkpoint_deleted_entries))); then
                echo "== argmin-s3 UAT metadata checkpoint PG $pg_id: $(tr '\n' ' ' <"$response_path") metrics_deleted_entries=$metric_deleted_entries =="
                rm -f "$response_path"
                return 0
            fi
        fi
        if (($(date +%s) - start >= deadline_seconds)); then
            cat "$response_path" >&2 || true
            rm -f "$response_path"
            die "timed out recording compacted metadata checkpoint for PG $pg_id; last HTTP status $status recorded=$recorded compacted=$compacted deleted_entries=$deleted_entries"
        fi
        rm -f "$response_path"
        sleep 0.2
    done
}

