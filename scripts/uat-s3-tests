    cargo build -p s3-tests --bin uat_pg_backfill_smoke
    pg_backfill_smoke_cmd=("$ROOT/target/debug/uat_pg_backfill_smoke")
fi

if [[ "$topology" == "local" ]]; then
    start_process "local server" "$server_log" env \
        -u ARGMIN_STORAGE_NODE_ID \
        -u ARGMIN_STORAGE_NODE_DATA_DIR \
        -u ARGMIN_STORAGE_NODE_SOCKET_PATH \
        -u ARGMIN_STORAGE_NODE_SOCKETS \
        ARGMIN_PROCESS_ROLE=legacy-local \
        ARGMIN_BUCKET_DELETE_VISIBLE_DATA_DIAGNOSTICS=1 \
        ARGMIN_METADATA_COMMAND_CONFLICT_DIAGNOSTICS=1 \
        ARGMIN_LOCAL_DEBUG_ENDPOINT="$uat_local_debug_endpoint" \
        ARGMIN_DATA_DIR="$data_dir" \
        ARGMIN_LISTEN_ADDR="$listen_addr" \
        "${server_cmd[@]}"
    frontend_index=$((${#server_pids[@]} - 1))
    frontend_pid="${server_pids[$frontend_index]}"
    frontend_log="${server_logs[$frontend_index]}"
else
    socket_entries=()
    for ((node_id = 0; node_id < ARGMIN_LOCAL_NODE_COUNT; node_id++)); do
        socket_path="$sockets_dir/node-$(printf '%04d' "$node_id").sock"
        socket_entries+=("$node_id=$socket_path")
    done
    storage_node_sockets="$(
        IFS=,
        echo "${socket_entries[*]}"
    )"

    if [[ "$smoke" == "route-change-control-plane-restart" ]]; then
        configure_replicated_control_plane
    fi

    if [[ "$smoke" == "control-plane-runtime-map" || "$smoke" == "route-change" || "$smoke" == "route-change-node-restart" || "$smoke" == "route-change-restart" || "$smoke" == "route-change-control-plane-restart" || "$smoke" == "route-change-frontend-restart" || "$smoke" == "route-change-full-restart" || "$smoke" == "pg-backfill-migration" || "$smoke" == "metadata-pg-migration" || "$smoke" == "metadata-pg-migration-failover" || "$smoke" == "cleanup-versioned-stress" ]]; then
        start_control_plane
        wait_for_control_plane_socket
        if [[ "$smoke" == "route-change" || "$smoke" == "route-change-node-restart" || "$smoke" == "route-change-restart" || "$smoke" == "route-change-control-plane-restart" || "$smoke" == "route-change-frontend-restart" || "$smoke" == "route-change-full-restart" || "$smoke" == "pg-backfill-migration" || "$smoke" == "metadata-pg-migration" || "$smoke" == "metadata-pg-migration-failover" ]]; then
            set_all_pg_acting_sets "initial old placement nodes 0,1" 0 1
        fi
    fi

    for ((node_id = 0; node_id < ARGMIN_LOCAL_NODE_COUNT; node_id++)); do
        start_storage_node "$node_id"
    done

    for ((node_id = 0; node_id < ARGMIN_LOCAL_NODE_COUNT; node_id++)); do
        wait_for_storage_node_socket "$node_id"
    done

    if [[ "$smoke" == "control-plane-runtime-map" || "$smoke" == "route-change" || "$smoke" == "route-change-node-restart" || "$smoke" == "route-change-restart" || "$smoke" == "route-change-control-plane-restart" || "$smoke" == "route-change-frontend-restart" || "$smoke" == "route-change-full-restart" || "$smoke" == "pg-backfill-migration" || "$smoke" == "metadata-pg-migration" || "$smoke" == "metadata-pg-migration-failover" || "$smoke" == "cleanup-versioned-stress" ]]; then
        wait_for_control_plane_runtime_map_ready 10
        wait_for_control_plane_node_epochs_aligned 10 "$control_plane_runtime_map_ready_epoch"
        wait_for_control_plane_runtime_map_ready 10 "$control_plane_aligned_epoch"
    fi

    start_frontend
fi

readiness_url="$endpoint/"
if local_debug_endpoint_enabled; then
    readiness_url="$endpoint/__argmin/debug/metrics"
fi

wait_for_https_ready() {
    for _ in {1..200}; do
        wait_for_process "$frontend_pid" "$frontend_log" "frontend"
        if curl -k -sS "$readiness_url" >/dev/null 2>&1; then
            wait_for_process "$frontend_pid" "$frontend_log" "frontend"
            return 0
        fi
        sleep 0.1
    done

    cat "$frontend_log" >&2 || true
    die "argmin-s3 did not become ready at $endpoint"
}

wait_for_https_ready

start_metrics_sampler() {
    local metrics_url="$endpoint/__argmin/debug/metrics"
    local metrics_log="$logs_dir/frontend-metrics-samples.log"
    (
        while true; do
            printf 'ts=%(%s)T\n' -1
            curl -k -sS "$metrics_url" || true
            printf '\n'
            sleep 1
        done
    ) >"$metrics_log" 2>&1 &
    metrics_sampler_pid="$!"
    echo "== argmin-s3 UAT frontend metrics samples: $metrics_log =="
}

if local_debug_endpoint_enabled; then
    start_metrics_sampler
fi

run_nextest() {
    local label="$1"
    shift
    local cmd=(cargo nextest run -p s3-tests)
    if (($#)); then
        cmd+=("$@")
    fi

    for ((iteration = 1; iteration <= repeat_count; iteration++)); do
        if ((repeat_count > 1)); then
            echo "== argmin-s3 UAT $label iteration $iteration/$repeat_count =="
        else
            echo "== argmin-s3 UAT $label =="
        fi
        printf '+'
        printf ' %q' "${cmd[@]}"
        printf '\n'
        set +e
        "${cmd[@]}"
        local status=$?
        set -e
        if ((status != 0)); then
            print_slowdown_summary
            return "$status"
        fi
    done
}

run_nextest_expect_failure() {
    local label="$1"
    shift
    local cmd=(cargo nextest run -p s3-tests)
    if (($#)); then
        cmd+=("$@")
    fi
    local failure_log="$logs_dir/${label// /-}.log"

    echo "== argmin-s3 UAT $label =="
    printf '+'
    printf ' %q' "${cmd[@]}"
    printf '\n'
    set +e
    "${cmd[@]}" >"$failure_log" 2>&1
    local status=$?
    set -e
    if ((status == 0)); then
        cat "$failure_log" >&2 || true
        die "$label unexpectedly passed"
    fi
    if ! grep -Eq "InternalError|DispatchFailure|ServiceError" "$failure_log"; then
        cat "$failure_log" >&2 || true
        die "$label failed without a clear S3/client error"
    fi
    echo "== argmin-s3 UAT $label expected failure observed =="
    if grep -m1 -E "InternalError|DispatchFailure|ServiceError" "$failure_log"; then
        :
    fi
    echo "PASS: $label failed closed as expected"
    echo "Captured expected-failure log: $failure_log"
    echo "Summary: expected failure observed; UAT smoke passed"
}

run_shard_repair_smoke() {
    local smoke_dir="$data_dir/shard-repair-smoke"
    local bucket_file="$smoke_dir/bucket"
    local body_file="$smoke_dir/body.bin"
    local corrupted_path_file="$smoke_dir/corrupted-shard-path"
    local corrupted_copy="$smoke_dir/corrupted-shard.bin"
    local metrics_path="$smoke_dir/metrics.prom"
    local shard_marker="$smoke_dir/pre-put-shard-marker"
    local key="uat-shard-repair-object"
    mkdir -p "$smoke_dir"
    printf 'argmin shard repair UAT payload\n%.0s' {1..512} >"$body_file"
    : >"$shard_marker"

    echo "== argmin-s3 UAT shard repair put =="
    printf '+'
    printf ' %q' "${shard_repair_smoke_cmd[@]}" put "$bucket_file" "$key" "$body_file"
    printf '\n'
    "${shard_repair_smoke_cmd[@]}" put "$bucket_file" "$key" "$body_file"

    wait_for_storage_shard_files "$((ARGMIN_EC_K + ARGMIN_EC_M))" 10 "$shard_marker"
    corrupt_storage_data_shard_file "$corrupted_path_file" "$shard_marker"
    cp "$(cat "$corrupted_path_file")" "$corrupted_copy"

    if [[ "$smoke" == "shard-repair-restart" ]]; then
        echo "== argmin-s3 UAT shard repair restart processes after corruption =="
        restart_all_storage_nodes
        restart_frontend
    fi

    echo "== argmin-s3 UAT shard repair foreground recovery read =="
    printf '+'
    printf ' %q' "${shard_repair_smoke_cmd[@]}" get "$bucket_file" "$key" "$body_file"
    printf '\n'
    "${shard_repair_smoke_cmd[@]}" get "$bucket_file" "$key" "$body_file"

    wait_for_shard_repair_completion_metrics "$metrics_path" 20
    if cmp -s "$(cat "$corrupted_path_file")" "$corrupted_copy"; then
        die "shard repair metrics completed but corrupted shard file did not change"
    fi

    echo "== argmin-s3 UAT shard repair post-repair read =="
    printf '+'
    printf ' %q' "${shard_repair_smoke_cmd[@]}" get "$bucket_file" "$key" "$body_file"
    printf '\n'
    "${shard_repair_smoke_cmd[@]}" get "$bucket_file" "$key" "$body_file"

    echo "== argmin-s3 UAT shard repair cleanup =="
    printf '+'
    printf ' %q' "${shard_repair_smoke_cmd[@]}" cleanup "$bucket_file" "$key"
    printf '\n'
    "${shard_repair_smoke_cmd[@]}" cleanup "$bucket_file" "$key"
    if [[ "$smoke" == "shard-repair-restart" ]]; then
        echo "PASS: shard repair restart UAT smoke repaired a corrupt shard after process restart"
    else
        echo "PASS: shard repair UAT smoke repaired a read-discovered corrupt shard"
    fi
}

run_storage_node_kill_fails_closed_smoke() {
    local smoke_dir="$data_dir/storage-node-kill-fails-closed-smoke"
    local bucket_file="$smoke_dir/bucket"
    local old_body_file="$smoke_dir/old-body.bin"
    local new_body_file="$smoke_dir/new-body.bin"
    local old_key="uat-storage-node-loss-old-object"
    local new_key="uat-storage-node-loss-new-object"
    mkdir -p "$smoke_dir"
    printf 'argmin storage-node loss retained-read payload\n%.0s' {1..128} >"$old_body_file"
    printf 'argmin storage-node loss failed-write payload\n%.0s' {1..128} >"$new_body_file"

    echo "== argmin-s3 UAT storage-node loss pre-kill put =="
    print_command "${pg_backfill_smoke_cmd[@]}" create-put "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" create-put "$bucket_file" "$old_key" "$old_body_file"

    echo "== argmin-s3 UAT storage-node loss pre-kill read/list =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" head "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" head "$bucket_file" "$old_key" "$old_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" list-contains "$bucket_file" "$old_key"
    "${pg_backfill_smoke_cmd[@]}" list-contains "$bucket_file" "$old_key"

    kill_storage_node 1

    echo "== argmin-s3 UAT storage-node loss post-kill retained read/list =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" head "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" head "$bucket_file" "$old_key" "$old_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" list-contains "$bucket_file" "$old_key"
    "${pg_backfill_smoke_cmd[@]}" list-contains "$bucket_file" "$old_key"

    echo "== argmin-s3 UAT storage-node loss post-kill write fails closed =="
    print_command "${pg_backfill_smoke_cmd[@]}" put-expect-failure "$bucket_file" "$new_key" "$new_body_file"
    "${pg_backfill_smoke_cmd[@]}" put-expect-failure "$bucket_file" "$new_key" "$new_body_file"

    echo "PASS: storage-node kill UAT smoke preserved readable data and failed new writes closed"
}

run_storage_node_primary_kill_fails_closed_smoke() {
    local smoke_dir="$data_dir/storage-node-primary-kill-fails-closed-smoke"
    local bucket_file="$smoke_dir/bucket"
    local old_body_file="$smoke_dir/old-body.bin"
    local new_body_file="$smoke_dir/new-body.bin"
    local old_key="uat-storage-node-primary-loss-old-object"
    local new_key="uat-storage-node-primary-loss-new-object"
    mkdir -p "$smoke_dir"
    printf 'argmin storage-node primary loss payload\n%.0s' {1..128} >"$old_body_file"
    printf 'argmin storage-node primary loss failed-write payload\n%.0s' {1..128} >"$new_body_file"

    echo "== argmin-s3 UAT storage-node primary loss pre-kill put =="
    print_command "${pg_backfill_smoke_cmd[@]}" create-put "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" create-put "$bucket_file" "$old_key" "$old_body_file"

    echo "== argmin-s3 UAT storage-node primary loss pre-kill read/list =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" head "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" head "$bucket_file" "$old_key" "$old_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" list-contains "$bucket_file" "$old_key"
    "${pg_backfill_smoke_cmd[@]}" list-contains "$bucket_file" "$old_key"

    kill_storage_node 0

    echo "== argmin-s3 UAT storage-node primary loss post-kill reads fail closed =="
    print_command "${pg_backfill_smoke_cmd[@]}" get-expect-failure "$bucket_file" "$old_key"
    "${pg_backfill_smoke_cmd[@]}" get-expect-failure "$bucket_file" "$old_key"
    print_command "${pg_backfill_smoke_cmd[@]}" head-expect-failure "$bucket_file" "$old_key"
    "${pg_backfill_smoke_cmd[@]}" head-expect-failure "$bucket_file" "$old_key"
    print_command "${pg_backfill_smoke_cmd[@]}" list-expect-failure "$bucket_file"
    "${pg_backfill_smoke_cmd[@]}" list-expect-failure "$bucket_file"

    echo "== argmin-s3 UAT storage-node primary loss post-kill write fails closed =="
    print_command "${pg_backfill_smoke_cmd[@]}" put-expect-failure "$bucket_file" "$new_key" "$new_body_file"
    "${pg_backfill_smoke_cmd[@]}" put-expect-failure "$bucket_file" "$new_key" "$new_body_file"

    echo "PASS: storage-node primary kill UAT smoke failed reads and writes closed with S3 service responses"
}

run_route_change_smoke() {
    local iteration="${1:-1}"
    local smoke_dir="$data_dir/route-change-smoke/iteration-$iteration"
    local bucket_file="$smoke_dir/bucket"
    local old_key_file="$smoke_dir/old-key"
    local new_key_file="$smoke_dir/new-key"
    local data_pg_file="$smoke_dir/data-pg"
    local old_body_file="$smoke_dir/old-body.bin"
    local new_body_file="$smoke_dir/new-body.bin"
    local metrics_path="$smoke_dir/metrics.prom"
    local target_data_pg=$((iteration - 1))
    mkdir -p "$smoke_dir"
    printf 'argmin route-change old-placement payload\n%.0s' {1..128} >"$old_body_file"
    printf 'argmin route-change new-placement payload\n%.0s' {1..128} >"$new_body_file"

    if ((repeat_count > 1)); then
        echo "== argmin-s3 UAT route-change iteration $iteration/$repeat_count =="
    fi

    set_pg_acting_set "route-change old placement nodes 0,1" "$target_data_pg" 0 1
    wait_for_target_pg_runtime_installed "$target_data_pg" "0:1" 20 "$metrics_path"

    echo "== argmin-s3 UAT route-change old-placement versioned put =="
    print_command "${pg_backfill_smoke_cmd[@]}" create-versioned-put-distinct-data-pg "$bucket_file" "$old_key_file" "$data_pg_file" "uat-route-change-old-object-$iteration" "$old_body_file" "$target_data_pg" "$ARGMIN_ROUTE_CHANGE_TARGET_PGS"
    "${pg_backfill_smoke_cmd[@]}" create-versioned-put-distinct-data-pg "$bucket_file" "$old_key_file" "$data_pg_file" "uat-route-change-old-object-$iteration" "$old_body_file" "$target_data_pg" "$ARGMIN_ROUTE_CHANGE_TARGET_PGS"
    local old_key
    local data_pg
    old_key="$(tr -d '[:space:]' <"$old_key_file")"
    data_pg="$(tr -d '[:space:]' <"$data_pg_file")"
    if ((data_pg != target_data_pg)); then
        die "route-change helper selected data PG $data_pg, expected $target_data_pg"
    fi

    echo "== argmin-s3 UAT route-change pre-change reads and listings =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" head "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" head "$bucket_file" "$old_key" "$old_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" list-contains "$bucket_file" "$old_key"
    "${pg_backfill_smoke_cmd[@]}" list-contains "$bucket_file" "$old_key"
    print_command "${pg_backfill_smoke_cmd[@]}" list-versions-contains "$bucket_file" "$old_key"
    "${pg_backfill_smoke_cmd[@]}" list-versions-contains "$bucket_file" "$old_key"

    set_pg_acting_set "route-change moved data PG to nodes 0,2" "$data_pg" 0 2
    if [[ "$smoke" == "route-change-node-restart" ]]; then
        echo "== argmin-s3 UAT route-change restart newly added storage node during data-PG move =="
        restart_storage_node 2
    fi
    wait_for_target_pg_runtime_installed "$data_pg" "0:2" 20 "$metrics_path"

    if [[ "$smoke" == "route-change-restart" ]]; then
        echo "== argmin-s3 UAT route-change restart storage nodes after data-PG move =="
        restart_all_storage_nodes
        wait_for_target_pg_runtime_installed "$data_pg" "0:2" 30 "$metrics_path"
    elif [[ "$smoke" == "route-change-control-plane-restart" ]]; then
        echo "== argmin-s3 UAT route-change restart control-plane after data-PG move =="
        restart_control_plane
        wait_for_target_pg_runtime_installed "$data_pg" "0:2" 30 "$metrics_path"
    elif [[ "$smoke" == "route-change-frontend-restart" ]]; then
        echo "== argmin-s3 UAT route-change restart frontend after data-PG move =="
        restart_frontend
        wait_for_target_pg_runtime_installed "$data_pg" "0:2" 30 "$metrics_path"
    elif [[ "$smoke" == "route-change-full-restart" ]]; then
        echo "== argmin-s3 UAT route-change restart control-plane, storage nodes, and frontend after data-PG move =="
        restart_control_plane
        restart_all_storage_nodes
        restart_frontend
        wait_for_target_pg_runtime_installed "$data_pg" "0:2" 30 "$metrics_path"
    fi

    echo "== argmin-s3 UAT route-change post-change retained reads and listings =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" head "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" head "$bucket_file" "$old_key" "$old_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" list-contains "$bucket_file" "$old_key"
    "${pg_backfill_smoke_cmd[@]}" list-contains "$bucket_file" "$old_key"
    print_command "${pg_backfill_smoke_cmd[@]}" list-versions-contains "$bucket_file" "$old_key"
    "${pg_backfill_smoke_cmd[@]}" list-versions-contains "$bucket_file" "$old_key"

    echo "== argmin-s3 UAT route-change new-placement write =="
    print_command "${pg_backfill_smoke_cmd[@]}" put-for-data-pg "$bucket_file" "$new_key_file" "uat-route-change-new-object-$iteration" "$new_body_file" "$data_pg" "$ARGMIN_ROUTE_CHANGE_TARGET_PGS"
    "${pg_backfill_smoke_cmd[@]}" put-for-data-pg "$bucket_file" "$new_key_file" "uat-route-change-new-object-$iteration" "$new_body_file" "$data_pg" "$ARGMIN_ROUTE_CHANGE_TARGET_PGS"
    local new_key
    new_key="$(tr -d '[:space:]' <"$new_key_file")"

    echo "== argmin-s3 UAT route-change final reads and listings =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" list-contains "$bucket_file" "$old_key" "$new_key"
    "${pg_backfill_smoke_cmd[@]}" list-contains "$bucket_file" "$old_key" "$new_key"
    print_command "${pg_backfill_smoke_cmd[@]}" list-versions-contains "$bucket_file" "$old_key" "$new_key"
    "${pg_backfill_smoke_cmd[@]}" list-versions-contains "$bucket_file" "$old_key" "$new_key"

    echo "PASS: route-change UAT smoke preserved read/list visibility and accepted new writes after a data-PG acting-set change"
}

run_pg_backfill_migration_smoke() {
    local iteration="${1:-1}"
    local smoke_dir="$data_dir/pg-backfill-migration-smoke/iteration-$iteration"
    local bucket_file="$smoke_dir/bucket"
    local old_key_file="$smoke_dir/old-key"
    local new_key_file="$smoke_dir/new-key"
    local data_pg_file="$smoke_dir/data-pg"
    local old_body_file="$smoke_dir/old-body.bin"
    local new_body_file="$smoke_dir/new-body.bin"
    local metrics_path="$smoke_dir/metrics.prom"
    local target_data_pg=$((iteration - 1))
    mkdir -p "$smoke_dir"
    printf 'argmin PG backfill old-placement payload\n%.0s' {1..512} >"$old_body_file"
    printf 'argmin PG backfill new-placement payload\n%.0s' {1..512} >"$new_body_file"

    if ((repeat_count > 1)); then
        echo "== argmin-s3 UAT PG backfill migration iteration $iteration/$repeat_count =="
    fi

    set_pg_acting_set "old placement nodes 0,1 for PG backfill iteration $iteration" "$target_data_pg" 0 1
    wait_for_target_pg_runtime_installed "$target_data_pg" "0:1" 20 "$metrics_path"
    local old_floor_before_object_diagnostics=""
    old_floor_before_object_diagnostics="$("${server_cmd[@]}" control-plane-runtime-map-diagnostics "$control_plane_socket_path" 2>/dev/null || true)"
    sample_frontend_metrics "$metrics_path"
    local reset_min_scan_total
    local reset_min_enqueued
    local reset_min_written
    local reset_min_completed
    local reset_min_routine_admitted
    local reset_min_routine_finished
    local reset_max_candidate_failed
    local reset_max_scan_error
    local reset_max_complete_failed
    local reset_max_failed
    local reset_max_record_error_failed
    reset_min_scan_total="$(($(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_scan_total) + 1))"
    reset_min_enqueued="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_enqueued_total)"
    reset_min_written="$(latest_metric_sample_value "$metrics_path" shard_backfill_shards_written_total)"
    reset_min_completed="$(latest_metric_sample_value "$metrics_path" shard_backfill_complete_succeeded_total)"
    reset_min_routine_admitted="$(latest_metric_family_label_sum "$metrics_path" background_work_admission_by_class_total event admitted class routine_backfill)"
    reset_min_routine_finished="$(latest_metric_family_label_sum "$metrics_path" background_work_admission_by_class_total event finished class routine_backfill)"
    reset_max_candidate_failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_failed_total)"
    reset_max_scan_error="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_scan_error_total)"
    reset_max_complete_failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_complete_failed_total)"
    reset_max_failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_failed_total)"
    reset_max_record_error_failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_record_error_failed_total)"
    wait_for_shard_backfill_completion_metrics \
        "$metrics_path" \
        20 \
        "$reset_min_scan_total" \
        "$reset_min_enqueued" \
        "$reset_min_written" \
        "$reset_min_completed" \
        "$reset_min_routine_admitted" \
        "$reset_min_routine_finished" \
        "$reset_max_candidate_failed" \
        "$reset_max_scan_error" \
        "$reset_max_complete_failed" \
        "$reset_max_failed" \
        "$reset_max_record_error_failed"

    echo "== argmin-s3 UAT PG backfill old-placement put =="
    print_command "${pg_backfill_smoke_cmd[@]}" create-put-distinct-data-pg "$bucket_file" "$old_key_file" "$data_pg_file" "uat-pg-backfill-old-object-$iteration" "$old_body_file" "$target_data_pg" "$ARGMIN_PG_BACKFILL_TARGET_PGS"
    "${pg_backfill_smoke_cmd[@]}" create-put-distinct-data-pg "$bucket_file" "$old_key_file" "$data_pg_file" "uat-pg-backfill-old-object-$iteration" "$old_body_file" "$target_data_pg" "$ARGMIN_PG_BACKFILL_TARGET_PGS"
    local old_key
    old_key="$(tr -d '[:space:]' <"$old_key_file")"
    local data_pg
    data_pg="$(tr -d '[:space:]' <"$data_pg_file")"

    echo "== argmin-s3 UAT PG backfill old-placement read =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"

    sample_frontend_metrics "$metrics_path"
    local min_scan_total
    local min_enqueued
    local min_written
    local min_completed
    local min_routine_admitted
    local min_routine_finished
    local max_candidate_failed
    local max_scan_error
    local max_complete_failed
    local max_failed
    local max_record_error_failed
    local old_placement_floor_max_epoch
    old_placement_floor_max_epoch="$(latest_metric_sample_value "$metrics_path" frontend_storage_cluster_epoch)"
    local old_floor_nodes_needing_signal=()
    local old_floor_node_id
    for old_floor_node_id in 0 1; do
        local old_floor_before_object
        old_floor_before_object="$(runtime_map_node_storage_history_floor "$old_floor_before_object_diagnostics" "$old_floor_node_id")"
        if ! [[ "$old_floor_before_object" =~ ^[0-9]+$ ]] || ((old_floor_before_object > old_placement_floor_max_epoch)); then
            old_floor_nodes_needing_signal+=("$old_floor_node_id")
        fi
    done
    min_scan_total="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_scan_total)"
    min_enqueued="$(($(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_enqueued_total) + 1))"
    min_written="$(($(latest_metric_sample_value "$metrics_path" shard_backfill_shards_written_total) + 1))"
    min_completed="$(($(latest_metric_sample_value "$metrics_path" shard_backfill_complete_succeeded_total) + 1))"
    min_routine_admitted="$(($(latest_metric_family_label_sum "$metrics_path" background_work_admission_by_class_total event admitted class routine_backfill) + 1))"
    min_routine_finished="$(($(latest_metric_family_label_sum "$metrics_path" background_work_admission_by_class_total event finished class routine_backfill) + 1))"

    set_pg_acting_set "desired placement nodes 0,2" "$data_pg" 0 2
    wait_for_target_pg_runtime_installed "$data_pg" "0:2" 20 "$metrics_path"
    if ((${#old_floor_nodes_needing_signal[@]})); then
        wait_for_control_plane_storage_history_floor_nodes 20 "$old_placement_floor_max_epoch" "${old_floor_nodes_needing_signal[@]}"
    else
        echo "== argmin-s3 UAT control-plane storage history floors: old acting nodes already retained epoch <= $old_placement_floor_max_epoch before current object =="
    fi
    if ((iteration == 1)); then
        restart_control_plane
        wait_for_control_plane_runtime_map_ready 10
        wait_for_control_plane_node_epochs_aligned 10 "$control_plane_runtime_map_ready_epoch"
        wait_for_target_pg_runtime_installed "$data_pg" "0:2" 20 "$metrics_path"
        wait_for_control_plane_storage_history_floor_nodes 20 "$old_placement_floor_max_epoch" 0 1
    fi
    max_candidate_failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_failed_total)"
    max_scan_error="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_scan_error_total)"
    max_complete_failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_complete_failed_total)"
    max_failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_failed_total)"
    max_record_error_failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_record_error_failed_total)"

    echo "== argmin-s3 UAT PG backfill historical read after acting-set change =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"

    echo "== argmin-s3 UAT PG backfill new-placement put =="
    print_command "${pg_backfill_smoke_cmd[@]}" put-for-data-pg "$bucket_file" "$new_key_file" "uat-pg-backfill-new-object-$iteration" "$new_body_file" "$data_pg" "$ARGMIN_PG_BACKFILL_TARGET_PGS"
    "${pg_backfill_smoke_cmd[@]}" put-for-data-pg "$bucket_file" "$new_key_file" "uat-pg-backfill-new-object-$iteration" "$new_body_file" "$data_pg" "$ARGMIN_PG_BACKFILL_TARGET_PGS"
    local new_key
    new_key="$(tr -d '[:space:]' <"$new_key_file")"

    echo "== argmin-s3 UAT PG backfill new-placement read =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"

    wait_for_shard_backfill_completion_metrics \
        "$metrics_path" \
        30 \
        "$min_scan_total" \
        "$min_enqueued" \
        "$min_written" \
        "$min_completed" \
        "$min_routine_admitted" \
        "$min_routine_finished" \
        "$max_candidate_failed" \
        "$max_scan_error" \
        "$max_complete_failed" \
        "$max_failed" \
        "$max_record_error_failed" \
        "$data_pg"

    echo "== argmin-s3 UAT PG backfill post-backfill reads =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"

    echo "PASS: PG backfill migration UAT smoke migrated an old-placement object after an acting-set change"
}

run_metadata_pg_migration_smoke() {
    local iteration="${1:-1}"
    local smoke_dir="$data_dir/metadata-pg-migration-smoke/iteration-$iteration"
    local bucket_file="$smoke_dir/bucket"
    local old_key_file="$smoke_dir/old-key"
    local new_key_file="$smoke_dir/new-key"
    local final_key_file="$smoke_dir/final-key"
    local metadata_pg_file="$smoke_dir/metadata-pg"
    local old_body_file="$smoke_dir/old-body.bin"
    local new_body_file="$smoke_dir/new-body.bin"
    local final_body_file="$smoke_dir/final-body.bin"
    local metrics_path="$smoke_dir/metrics.prom"
    local target_metadata_pg=$((iteration - 1))
    mkdir -p "$smoke_dir"
    printf 'argmin metadata PG migration old-placement payload\n%.0s' {1..128} >"$old_body_file"
    printf 'argmin metadata PG migration new-placement payload\n%.0s' {1..128} >"$new_body_file"
    printf 'argmin metadata PG migration final-placement payload\n%.0s' {1..128} >"$final_body_file"

    if ((repeat_count > 1)); then
        echo "== argmin-s3 UAT metadata PG migration iteration $iteration/$repeat_count =="
    fi

    wait_for_serving_runtime_installed 20 "$metrics_path"

    echo "== argmin-s3 UAT metadata PG migration old-placement put =="
    print_command "${pg_backfill_smoke_cmd[@]}" create-put-metadata-pg "$bucket_file" "$old_key_file" "$metadata_pg_file" "uat-metadata-pg-old-object-$iteration" "$old_body_file" "$target_metadata_pg"
    "${pg_backfill_smoke_cmd[@]}" create-put-metadata-pg "$bucket_file" "$old_key_file" "$metadata_pg_file" "uat-metadata-pg-old-object-$iteration" "$old_body_file" "$target_metadata_pg"
    local old_key
    local metadata_pg
    old_key="$(tr -d '[:space:]' <"$old_key_file")"
    metadata_pg="$(tr -d '[:space:]' <"$metadata_pg_file")"
    if ((metadata_pg != target_metadata_pg)); then
        die "metadata PG helper selected PG $metadata_pg, expected $target_metadata_pg"
    fi

    echo "== argmin-s3 UAT metadata PG migration old-placement read =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"

    if [[ "$smoke" == "metadata-pg-migration-failover" ]]; then
        transfer_pg_metadata_expect_injected_failure "after-fence" "non-overlap destination nodes 2,3 before export" "$target_metadata_pg" 2 3
    fi
    transfer_pg_metadata "non-overlap destination nodes 2,3" "$target_metadata_pg" 2 3
    wait_for_control_plane_pg_active "$target_metadata_pg" 20 "2:3"
    wait_for_serving_runtime_installed 20 "$metrics_path"

    echo "== argmin-s3 UAT metadata PG migration post-transfer read =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"

    echo "== argmin-s3 UAT metadata PG migration post-transfer write =="
    print_command "${pg_backfill_smoke_cmd[@]}" put-for-metadata-pg "$bucket_file" "$new_key_file" "uat-metadata-pg-new-object-$iteration" "$new_body_file" "$target_metadata_pg"
    "${pg_backfill_smoke_cmd[@]}" put-for-metadata-pg "$bucket_file" "$new_key_file" "uat-metadata-pg-new-object-$iteration" "$new_body_file" "$target_metadata_pg"
    local new_key
    new_key="$(tr -d '[:space:]' <"$new_key_file")"

    echo "== argmin-s3 UAT metadata PG migration post-transfer reads =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"

    if [[ "$smoke" == "metadata-pg-migration-failover" ]]; then
        transfer_pg_metadata_expect_injected_failure "after-transfer-install" "return to original nodes 0,1 after transfer marker install" "$target_metadata_pg" 0 1
    fi
    transfer_pg_metadata "return to original nodes 0,1 with suffix replay" "$target_metadata_pg" 0 1
    wait_for_control_plane_pg_active "$target_metadata_pg" 20 "0:1"
    wait_for_serving_runtime_installed 20 "$metrics_path"

    echo "== argmin-s3 UAT metadata PG migration transfer-back reads =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"

    sample_frontend_metrics "$metrics_path"
    local min_checkpoint_deleted_entries
    local max_checkpoint_record_failed
    local max_checkpoint_scan_error
    local max_checkpoint_compaction_failed
    min_checkpoint_deleted_entries="$(latest_metric_sample_value "$metrics_path" metadata_command_checkpoint_record_compaction_deleted_entries_total)"
    max_checkpoint_record_failed="$(latest_metric_sample_value "$metrics_path" metadata_command_checkpoint_record_failed_total)"
    max_checkpoint_scan_error="$(latest_metric_sample_value "$metrics_path" metadata_command_checkpoint_record_scan_error_total)"
    max_checkpoint_compaction_failed="$(latest_metric_sample_value "$metrics_path" metadata_command_checkpoint_record_compaction_failed_total)"

    echo "== argmin-s3 UAT metadata PG migration transfer-back write =="
    print_command "${pg_backfill_smoke_cmd[@]}" put-for-metadata-pg "$bucket_file" "$final_key_file" "uat-metadata-pg-final-object-$iteration" "$final_body_file" "$target_metadata_pg"
    "${pg_backfill_smoke_cmd[@]}" put-for-metadata-pg "$bucket_file" "$final_key_file" "uat-metadata-pg-final-object-$iteration" "$final_body_file" "$target_metadata_pg"
    local final_key
    final_key="$(tr -d '[:space:]' <"$final_key_file")"

    record_metadata_checkpoint_for_pg "$target_metadata_pg" 30 "$metrics_path" "$min_checkpoint_deleted_entries"
    sample_frontend_metrics "$metrics_path"
    local checkpoint_record_failed
    local checkpoint_scan_error
    local checkpoint_compaction_failed
    checkpoint_record_failed="$(latest_metric_sample_value "$metrics_path" metadata_command_checkpoint_record_failed_total)"
    checkpoint_scan_error="$(latest_metric_sample_value "$metrics_path" metadata_command_checkpoint_record_scan_error_total)"
    checkpoint_compaction_failed="$(latest_metric_sample_value "$metrics_path" metadata_command_checkpoint_record_compaction_failed_total)"
    if ((checkpoint_record_failed > max_checkpoint_record_failed || checkpoint_scan_error > max_checkpoint_scan_error || checkpoint_compaction_failed > max_checkpoint_compaction_failed)); then
        cat "$metrics_path" >&2 || true
        die "metadata checkpoint smoke saw hard failure: record_failed=$checkpoint_record_failed scan_error=$checkpoint_scan_error compaction_failed=$checkpoint_compaction_failed"
    fi

    echo "== argmin-s3 UAT metadata PG migration restart checkpoint source nodes =="
    restart_storage_node 0
    restart_storage_node 1
    wait_for_control_plane_runtime_map_ready 60
    wait_for_control_plane_node_epochs_aligned 60 "$control_plane_runtime_map_ready_epoch"
    wait_for_control_plane_runtime_map_ready 60 "$control_plane_aligned_epoch"
    wait_for_control_plane_pg_active "$target_metadata_pg" 60 "0:1"
    wait_for_serving_runtime_installed 60 "$metrics_path"

    echo "== argmin-s3 UAT metadata PG migration post-restart reads =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$final_key" "$final_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$final_key" "$final_body_file"

    echo "== argmin-s3 UAT metadata PG migration repeated outbound transfer =="
    if [[ "$smoke" == "metadata-pg-migration-failover" ]]; then
        transfer_pg_metadata_expect_injected_failure "after-import" "second non-overlap destination nodes 2,3 after import" "$target_metadata_pg" 2 3
        wait_for_control_plane_pg_active "$target_metadata_pg" 60 "2:3"
    fi
    transfer_pg_metadata "second non-overlap destination nodes 2,3 with suffix replay" "$target_metadata_pg" 2 3
    wait_for_control_plane_pg_active "$target_metadata_pg" 60 "2:3"
    wait_for_serving_runtime_installed 60 "$metrics_path"

    echo "== argmin-s3 UAT metadata PG migration repeated-transfer reads =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$final_key" "$final_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$final_key" "$final_body_file"

    echo "== argmin-s3 UAT metadata PG migration final return transfer =="
    transfer_pg_metadata "final return to original nodes 0,1" "$target_metadata_pg" 0 1
    wait_for_control_plane_pg_active "$target_metadata_pg" 60 "0:1"
    wait_for_serving_runtime_installed 60 "$metrics_path"

    echo "== argmin-s3 UAT metadata PG migration final reads =="
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$old_key" "$old_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$new_key" "$new_body_file"
    print_command "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$final_key" "$final_body_file"
    "${pg_backfill_smoke_cmd[@]}" get "$bucket_file" "$final_key" "$final_body_file"

    echo "PASS: metadata PG migration UAT smoke transferred PG $target_metadata_pg from nodes 0,1 to nodes 2,3 and back"
}

cleanup_route_change_smoke() {
    local iteration="$1"
    local smoke_dir="$data_dir/route-change-smoke/iteration-$iteration"
    local bucket_file="$smoke_dir/bucket"
    [[ -s "$bucket_file" ]] || return 0

    echo "== argmin-s3 UAT route-change cleanup iteration $iteration =="
    print_command "${pg_backfill_smoke_cmd[@]}" cleanup-versioned "$bucket_file"
    if ! "${pg_backfill_smoke_cmd[@]}" cleanup-versioned "$bucket_file"; then
        print_bucket_file_delete_attempt_debug "$bucket_file"
        return 1
    fi
}

cleanup_pg_backfill_migration_smoke() {
    local iteration="$1"
    local smoke_dir="$data_dir/pg-backfill-migration-smoke/iteration-$iteration"
    local bucket_file="$smoke_dir/bucket"
    local old_key_file="$smoke_dir/old-key"
    local new_key_file="$smoke_dir/new-key"
    [[ -s "$bucket_file" && -s "$old_key_file" && -s "$new_key_file" ]] || return 0

    local old_key
    local new_key
    old_key="$(tr -d '[:space:]' <"$old_key_file")"
    new_key="$(tr -d '[:space:]' <"$new_key_file")"

    echo "== argmin-s3 UAT PG backfill cleanup iteration $iteration =="
    print_command "${pg_backfill_smoke_cmd[@]}" cleanup "$bucket_file" "$old_key" "$new_key"
    if ! "${pg_backfill_smoke_cmd[@]}" cleanup "$bucket_file" "$old_key" "$new_key"; then
        print_bucket_file_delete_attempt_debug "$bucket_file"
        return 1
    fi
}

cleanup_metadata_pg_migration_smoke() {
    local iteration="$1"
    local smoke_dir="$data_dir/metadata-pg-migration-smoke/iteration-$iteration"
    local bucket_file="$smoke_dir/bucket"
    local old_key_file="$smoke_dir/old-key"
    local new_key_file="$smoke_dir/new-key"
    local final_key_file="$smoke_dir/final-key"
    [[ -s "$bucket_file" && -s "$old_key_file" && -s "$new_key_file" ]] || return 0

    local old_key
    local new_key
    local final_key
    old_key="$(tr -d '[:space:]' <"$old_key_file")"
    new_key="$(tr -d '[:space:]' <"$new_key_file")"
    final_key=""
    if [[ -s "$final_key_file" ]]; then
        final_key="$(tr -d '[:space:]' <"$final_key_file")"
    fi

    echo "== argmin-s3 UAT metadata PG migration cleanup iteration $iteration =="
    if [[ -n "$final_key" ]]; then
        print_command "${pg_backfill_smoke_cmd[@]}" cleanup "$bucket_file" "$old_key" "$new_key" "$final_key"
        if ! "${pg_backfill_smoke_cmd[@]}" cleanup "$bucket_file" "$old_key" "$new_key" "$final_key"; then
            print_bucket_file_delete_attempt_debug "$bucket_file"
            return 1
        fi
    else
        print_command "${pg_backfill_smoke_cmd[@]}" cleanup "$bucket_file" "$old_key" "$new_key"
        if ! "${pg_backfill_smoke_cmd[@]}" cleanup "$bucket_file" "$old_key" "$new_key"; then
            print_bucket_file_delete_attempt_debug "$bucket_file"
            return 1
        fi
    fi
}

assert_cleanup_versioned_stress_metrics_clean() {
    local metrics_path="$1"
    local initial_http_500="$2"
    local initial_operation_aborted="$3"
    local initial_slow_down="$4"
    local initial_request_error="$5"
    local deadline_seconds="$6"
    local start
    start="$(date +%s)"
    while true; do
        if ! sample_frontend_metrics "$metrics_path"; then
            echo "error: cleanup versioned stress could not scrape frontend metrics" >&2
            return 1
        fi
        local http_500
        local operation_aborted
        local slow_down
        local request_error
        local bucket_delete_begin_queue_depth
        local bucket_delete_finalize_queue_depth
        local bucket_delete_finalize_outstanding_depth
        http_500="$(latest_metric_sample_value "$metrics_path" http_500_response_total)"
        operation_aborted="$(latest_metric_sample_value "$metrics_path" operation_aborted_response_total)"
        slow_down="$(latest_metric_sample_value "$metrics_path" slow_down_response_total)"
        request_error="$(latest_metric_sample_value "$metrics_path" request_error_total)"
        bucket_delete_begin_queue_depth="$(latest_metric_sample_value "$metrics_path" bucket_delete_begin_queue_depth)"
        bucket_delete_finalize_queue_depth="$(latest_metric_sample_value "$metrics_path" bucket_delete_finalize_queue_depth)"
        bucket_delete_finalize_outstanding_depth="$(latest_metric_sample_value "$metrics_path" bucket_delete_finalize_outstanding_depth)"

        if ((http_500 > initial_http_500)); then
            cat "$metrics_path" >&2 || true
            echo "error: cleanup versioned stress saw HTTP 500 increase: before=$initial_http_500 after=$http_500" >&2
            return 1
        fi
        if ((bucket_delete_begin_queue_depth == 0 && bucket_delete_finalize_outstanding_depth == 0)); then
            echo "== argmin-s3 UAT cleanup metrics: operation_aborted_delta=$((operation_aborted - initial_operation_aborted)) slow_down_delta=$((slow_down - initial_slow_down)) request_error_delta=$((request_error - initial_request_error)) http_500_delta=$((http_500 - initial_http_500)) bucket_delete_begin_queue_depth=$bucket_delete_begin_queue_depth bucket_delete_finalize_queue_depth=$bucket_delete_finalize_queue_depth bucket_delete_finalize_outstanding_depth=$bucket_delete_finalize_outstanding_depth =="
            return 0
        fi
        if (($(date +%s) - start >= deadline_seconds)); then
            cat "$metrics_path" >&2 || true
            echo "error: cleanup versioned stress left bucket delete begin queue depth $bucket_delete_begin_queue_depth and finalizer outstanding depth $bucket_delete_finalize_outstanding_depth" >&2
            return 1
        fi
        sleep 0.2
    done
}

run_cleanup_versioned_stress_smoke() {
    local iteration="${1:-1}"
    local smoke_dir="$data_dir/cleanup-versioned-stress-smoke/iteration-$iteration"
    local body_file="$smoke_dir/body.bin"
    local bucket_list_file="$smoke_dir/buckets"
    local metrics_path="$smoke_dir/metrics.prom"
    local bucket_count="${ARGMIN_CLEANUP_VERSIONED_STRESS_BUCKETS:-2}"
    local keys_per_bucket="${ARGMIN_CLEANUP_VERSIONED_STRESS_KEYS:-4}"
    local versions_per_key="${ARGMIN_CLEANUP_VERSIONED_STRESS_VERSIONS:-3}"
    mkdir -p "$smoke_dir"
    printf 'argmin cleanup versioned stress payload\n%.0s' {1..128} >"$body_file"

    if ((repeat_count > 1)); then
        echo "== argmin-s3 UAT cleanup versioned stress iteration $iteration/$repeat_count =="
    fi

    wait_for_serving_runtime_installed 20 "$metrics_path"
    sample_frontend_metrics "$metrics_path"
    local initial_http_500
    local initial_operation_aborted
    local initial_slow_down
    local initial_request_error
    initial_http_500="$(latest_metric_sample_value "$metrics_path" http_500_response_total)"
    initial_operation_aborted="$(latest_metric_sample_value "$metrics_path" operation_aborted_response_total)"
    initial_slow_down="$(latest_metric_sample_value "$metrics_path" slow_down_response_total)"
    initial_request_error="$(latest_metric_sample_value "$metrics_path" request_error_total)"

    echo "== argmin-s3 UAT cleanup versioned stress workload =="
    : >"$bucket_list_file"
    print_command "${pg_backfill_smoke_cmd[@]}" cleanup-versioned-stress "$bucket_count" "$keys_per_bucket" "$versions_per_key" "uat-cleanup-versioned-stress-$iteration" "$body_file" "$bucket_list_file"
    if ! "${pg_backfill_smoke_cmd[@]}" cleanup-versioned-stress "$bucket_count" "$keys_per_bucket" "$versions_per_key" "uat-cleanup-versioned-stress-$iteration" "$body_file" "$bucket_list_file"; then
        print_bucket_list_delete_attempt_debug "$bucket_list_file"
        return 1
    fi
    assert_cleanup_versioned_stress_metrics_clean \
        "$metrics_path" \
        "$initial_http_500" \
        "$initial_operation_aborted" \
        "$initial_slow_down" \
        "$initial_request_error" \
        20 || {
            print_bucket_list_delete_attempt_debug "$bucket_list_file"
            return 1
        }
}

assert_pg_backfill_migration_final_clean() {
    local metrics_path="$1"
    local max_candidate_failed="$2"
    local max_scan_error="$3"
    local max_complete_failed="$4"
    local max_failed="$5"
    local max_record_error_failed="$6"
    sample_frontend_metrics "$metrics_path"
    local queue_depth
    local candidate_failed
    local scan_error
    local complete_failed
    local failed
    local record_error_failed
    queue_depth="$(latest_metric_sample_value "$metrics_path" shard_backfill_queue_depth)"
    candidate_failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_failed_total)"
    scan_error="$(latest_metric_sample_value "$metrics_path" shard_backfill_candidate_scan_error_total)"
    complete_failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_complete_failed_total)"
    failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_failed_total)"
    record_error_failed="$(latest_metric_sample_value "$metrics_path" shard_backfill_record_error_failed_total)"
    if ((queue_depth != 0 || candidate_failed > max_candidate_failed || scan_error > max_scan_error || complete_failed > max_complete_failed || failed > max_failed || record_error_failed > max_record_error_failed)); then
        cat "$metrics_path" >&2 || true
        die "PG backfill smoke left hard-failure state: queue_depth=$queue_depth candidate_failed=$candidate_failed scan_error=$scan_error complete_failed=$complete_failed failed=$failed record_error_failed=$record_error_failed"
    fi
}

if [[ "$smoke" == "storage-node-restart" ]]; then
    run_nextest "pre-restart s3-tests smoke" test_object_default_content_type
    restart_storage_node 0
    run_nextest "post-restart s3-tests smoke" test_object_read_not_exist
elif [[ "$smoke" == "storage-node-kill-fails-closed" ]]; then
    run_storage_node_kill_fails_closed_smoke
elif [[ "$smoke" == "storage-node-primary-kill-fails-closed" ]]; then
    run_storage_node_primary_kill_fails_closed_smoke
elif [[ "$smoke" == "control-plane-runtime-map" ]]; then
    control_plane_runtime_metrics_log="$logs_dir/frontend-metrics-samples.log"
    wait_for_serving_runtime_installed 20 "$control_plane_runtime_metrics_log"
    run_nextest "control-plane runtime-map pre-restart s3-tests smoke" test_object_default_content_type
    run_nextest "control-plane runtime-map metadata-progress s3-tests smoke" test_object_write_read_update_read_delete
    wait_for_serving_runtime_installed 20 "$control_plane_runtime_metrics_log"
    run_nextest "control-plane runtime-map post-metadata-refresh s3-tests smoke" test_object_read_not_exist
    restart_storage_node 0
    wait_for_serving_runtime_installed 20 "$control_plane_runtime_metrics_log"
    run_nextest "control-plane runtime-map post-restart s3-tests smoke" test_object_read_not_exist
elif [[ "$smoke" == "shard-repair" || "$smoke" == "shard-repair-restart" ]]; then
    for ((iteration = 1; iteration <= repeat_count; iteration++)); do
        if ((repeat_count > 1)); then
            echo "== argmin-s3 UAT shard repair iteration $iteration/$repeat_count =="
        fi
        run_shard_repair_smoke
    done
elif [[ "$smoke" == "route-change" || "$smoke" == "route-change-node-restart" || "$smoke" == "route-change-restart" || "$smoke" == "route-change-control-plane-restart" || "$smoke" == "route-change-frontend-restart" || "$smoke" == "route-change-full-restart" ]]; then
    for ((iteration = 1; iteration <= repeat_count; iteration++)); do
        run_route_change_smoke "$iteration"
    done
    for ((iteration = 1; iteration <= repeat_count; iteration++)); do
        cleanup_route_change_smoke "$iteration"
    done
elif [[ "$smoke" == "pg-backfill-migration" ]]; then
    pg_backfill_metrics_log="$logs_dir/frontend-metrics-samples.log"
    sample_frontend_metrics "$pg_backfill_metrics_log"
    pg_backfill_initial_candidate_failed="$(latest_metric_sample_value "$pg_backfill_metrics_log" shard_backfill_candidate_failed_total)"
    pg_backfill_initial_scan_error="$(latest_metric_sample_value "$pg_backfill_metrics_log" shard_backfill_candidate_scan_error_total)"
    pg_backfill_initial_complete_failed="$(latest_metric_sample_value "$pg_backfill_metrics_log" shard_backfill_complete_failed_total)"
    pg_backfill_initial_failed="$(latest_metric_sample_value "$pg_backfill_metrics_log" shard_backfill_failed_total)"
    pg_backfill_initial_record_error_failed="$(latest_metric_sample_value "$pg_backfill_metrics_log" shard_backfill_record_error_failed_total)"
    for ((iteration = 1; iteration <= repeat_count; iteration++)); do
        run_pg_backfill_migration_smoke "$iteration"
    done
    for ((iteration = 1; iteration <= repeat_count; iteration++)); do
        cleanup_pg_backfill_migration_smoke "$iteration"
    done
    assert_pg_backfill_migration_final_clean \
        "$pg_backfill_metrics_log" \
        "$pg_backfill_initial_candidate_failed" \
        "$pg_backfill_initial_scan_error" \
        "$pg_backfill_initial_complete_failed" \
        "$pg_backfill_initial_failed" \
        "$pg_backfill_initial_record_error_failed"
elif [[ "$smoke" == "metadata-pg-migration" || "$smoke" == "metadata-pg-migration-failover" ]]; then
    for ((iteration = 1; iteration <= repeat_count; iteration++)); do
        run_metadata_pg_migration_smoke "$iteration"
    done
    for ((iteration = 1; iteration <= repeat_count; iteration++)); do
        cleanup_metadata_pg_migration_smoke "$iteration"
    done
elif [[ "$smoke" == "cleanup-versioned-stress" ]]; then
    for ((iteration = 1; iteration <= repeat_count; iteration++)); do
        run_cleanup_versioned_stress_smoke "$iteration"
    done
else
    run_nextest "s3-tests" "${cargo_args[@]}"
fi
