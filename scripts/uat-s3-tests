elif [[ "$smoke" == "storage-node-kill-fails-closed" || "$smoke" == "storage-node-primary-kill-fails-closed" || "$smoke" == "route-change" || "$smoke" == "route-change-node-restart" || "$smoke" == "route-change-restart" || "$smoke" == "route-change-control-plane-restart" || "$smoke" == "route-change-frontend-restart" || "$smoke" == "route-change-full-restart" || "$smoke" == "pg-backfill-migration" || "$smoke" == "metadata-pg-migration" || "$smoke" == "metadata-pg-migration-failover" || "$smoke" == "cleanup-versioned-stress" ]]; then
