        echo "shard_backfill_events durable_scan_no_claim=$shard_backfill_durable_scan_no_claim claim_started=$shard_backfill_claim_started started=$shard_backfill_started resolved_clean=$shard_backfill_resolved_clean backfilled=$shard_backfill_backfilled complete_succeeded=$shard_backfill_complete_succeeded complete_stale=$shard_backfill_complete_stale complete_failed=$shard_backfill_complete_failed stale_retry=$shard_backfill_stale_retry failed=$shard_backfill_failed record_error_failed=$shard_backfill_record_error_failed" >&2
        echo "background_work event_total=$background_work_event active=$background_work_active finished=$background_work_finished elapsed_us_total=$background_work_elapsed_us" >&2
        echo "background_work_classes known_damage_repair_admitted=$background_work_known_damage_admitted known_damage_repair_denied_limit=$background_work_known_damage_denied_limit known_damage_repair_denied_foreground_pressure=$background_work_known_damage_denied_foreground_pressure known_damage_repair_denied_backlog_pressure=$background_work_known_damage_denied_backlog_pressure known_damage_repair_finished=$background_work_known_damage_finished backfill_candidate_scan_admitted=$background_work_backfill_candidate_scan_admitted backfill_candidate_scan_denied_limit=$background_work_backfill_candidate_scan_denied_limit backfill_candidate_scan_denied_foreground_pressure=$background_work_backfill_candidate_scan_denied_foreground_pressure backfill_candidate_scan_denied_backlog_pressure=$background_work_backfill_candidate_scan_denied_backlog_pressure backfill_candidate_scan_finished=$background_work_backfill_candidate_scan_finished routine_backfill_admitted=$background_work_routine_backfill_admitted routine_backfill_denied_limit=$background_work_routine_backfill_denied_limit routine_backfill_denied_foreground_pressure=$background_work_routine_backfill_denied_foreground_pressure routine_backfill_denied_backlog_pressure=$background_work_routine_backfill_denied_backlog_pressure routine_backfill_finished=$background_work_routine_backfill_finished reclaim_cleanup_admitted=$background_work_reclaim_cleanup_admitted reclaim_cleanup_denied_limit=$background_work_reclaim_cleanup_denied_limit reclaim_cleanup_denied_foreground_pressure=$background_work_reclaim_cleanup_denied_foreground_pressure reclaim_cleanup_denied_backlog_pressure=$background_work_reclaim_cleanup_denied_backlog_pressure reclaim_cleanup_finished=$background_work_reclaim_cleanup_finished lifecycle_cleanup_admitted=$background_work_lifecycle_cleanup_admitted lifecycle_cleanup_denied_limit=$background_work_lifecycle_cleanup_denied_limit lifecycle_cleanup_denied_foreground_pressure=$background_work_lifecycle_cleanup_denied_foreground_pressure lifecycle_cleanup_denied_backlog_pressure=$background_work_lifecycle_cleanup_denied_backlog_pressure lifecycle_cleanup_finished=$background_work_lifecycle_cleanup_finished stream_session_cleanup_admitted=$background_work_stream_session_cleanup_admitted stream_session_cleanup_denied_limit=$background_work_stream_session_cleanup_denied_limit stream_session_cleanup_denied_foreground_pressure=$background_work_stream_session_cleanup_denied_foreground_pressure stream_session_cleanup_denied_backlog_pressure=$background_work_stream_session_cleanup_denied_backlog_pressure stream_session_cleanup_finished=$background_work_stream_session_cleanup_finished opportunistic_scan_admitted=$background_work_opportunistic_scan_admitted opportunistic_scan_denied_limit=$background_work_opportunistic_scan_denied_limit opportunistic_scan_denied_foreground_pressure=$background_work_opportunistic_scan_denied_foreground_pressure opportunistic_scan_denied_backlog_pressure=$background_work_opportunistic_scan_denied_backlog_pressure opportunistic_scan_finished=$background_work_opportunistic_scan_finished" >&2
        echo "metadata_recovery_top admission" >&2
        latest_metric_family_top "$metrics_log" metadata_command_recovery_admission_by_pg_command_total 10 >&2 || true
        echo "metadata_recovery_top outcome" >&2
        latest_metric_family_top "$metrics_log" metadata_command_recovery_outcome_by_pg_command_total 10 >&2 || true
        echo "metadata_pending_slot_top action" >&2
        latest_metric_family_top "$metrics_log" metadata_command_pending_slot_action_by_pg_command_total 10 >&2 || true
        echo "metadata_budget_top exhausted" >&2
        latest_metric_family_top "$metrics_log" metadata_command_budget_exhausted_by_pg_context_total 10 >&2 || true
