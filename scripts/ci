#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

usage() {
    cat <<'EOF'
Usage: ./scripts/ci [-- cargo-nextest-args...]

Run the standard local CI checks:

  1. cargo fmt --all --check
  2. ./scripts/check-storage-cluster-boundaries
  3. cargo clippy --workspace --all-targets --all-features -- -D warnings
  4. cargo build --workspace --all-targets --all-features
  5. cargo +nightly build --manifest-path fuzz/Cargo.toml --bins
  6. cargo nextest run --workspace
  7. cargo test -p storage --doc
  8. ./scripts/ci-control-plane-release
  9. ./scripts/uat-s3-tests
  10. ./scripts/uat-s3-tests --smoke storage-node-restart
  11. ./scripts/uat-s3-tests --smoke storage-node-kill-fails-closed
  12. ./scripts/uat-s3-tests --smoke storage-node-primary-kill-fails-closed
  13. ./scripts/uat-s3-tests --smoke control-plane-runtime-map
  14. ./scripts/uat-s3-tests --smoke shard-repair
  15. ./scripts/uat-s3-tests --smoke shard-repair-restart
  16. ./scripts/uat-s3-tests --smoke route-change
  17. ./scripts/uat-s3-tests --smoke route-change-node-restart
  18. ./scripts/uat-s3-tests --smoke route-change-restart
  19. ./scripts/uat-s3-tests --smoke route-change-control-plane-restart
  20. ./scripts/uat-s3-tests --smoke route-change-frontend-restart
  21. ./scripts/uat-s3-tests --smoke route-change-full-restart
  22. ./scripts/uat-s3-tests --smoke pg-backfill-migration
  23. ./scripts/uat-s3-tests --smoke metadata-pg-migration
  24. ./scripts/uat-s3-tests --smoke metadata-pg-migration-failover

Arguments after `--` are appended to `cargo nextest run --workspace`.

Examples:
  ./scripts/ci
  ./scripts/ci -- --no-fail-fast
  ./scripts/ci -- --test-threads 1
EOF
}

run_cmd() {
    local label="$1"
    shift

    echo
    echo "== $label =="
    printf '+'
    printf ' %q' "$@"
    printf '\n'
    "$@"
}

nextest_args=()

while (($# > 0)); do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            nextest_args=("$@")
            break
            ;;
        *)
            echo "unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

run_cmd "format" cargo fmt --all --check
run_cmd "storage cluster boundaries" ./scripts/check-storage-cluster-boundaries
run_cmd "clippy" cargo clippy --workspace --all-targets --all-features -- -D warnings
run_cmd "workspace compile" cargo build --workspace --all-targets --all-features
run_cmd "fuzz target compile" cargo +nightly build --manifest-path fuzz/Cargo.toml --bins
run_cmd "nextest" cargo nextest run --workspace "${nextest_args[@]}"
run_cmd "storage compile-fail API doctests" cargo test -p storage --doc
run_cmd "release control-plane gate" ./scripts/ci-control-plane-release
run_cmd "multihost UAT s3-tests" ./scripts/uat-s3-tests
run_cmd "multihost UAT storage-node restart smoke" ./scripts/uat-s3-tests --smoke storage-node-restart
run_cmd "multihost UAT storage-node kill smoke" ./scripts/uat-s3-tests --smoke storage-node-kill-fails-closed
run_cmd "multihost UAT storage-node primary kill smoke" ./scripts/uat-s3-tests --smoke storage-node-primary-kill-fails-closed
run_cmd "multihost UAT control-plane runtime-map smoke" ./scripts/uat-s3-tests --smoke control-plane-runtime-map
run_cmd "multihost UAT shard repair smoke" ./scripts/uat-s3-tests --smoke shard-repair
run_cmd "multihost UAT shard repair restart smoke" ./scripts/uat-s3-tests --smoke shard-repair-restart
run_cmd "multihost UAT route-change smoke" ./scripts/uat-s3-tests --smoke route-change
run_cmd "multihost UAT route-change node restart smoke" ./scripts/uat-s3-tests --smoke route-change-node-restart
run_cmd "multihost UAT route-change restart smoke" ./scripts/uat-s3-tests --smoke route-change-restart
run_cmd "multihost UAT route-change control-plane restart smoke" ./scripts/uat-s3-tests --smoke route-change-control-plane-restart
run_cmd "multihost UAT route-change frontend restart smoke" ./scripts/uat-s3-tests --smoke route-change-frontend-restart
run_cmd "multihost UAT route-change full restart smoke" ./scripts/uat-s3-tests --smoke route-change-full-restart
run_cmd "multihost UAT PG backfill migration smoke" ./scripts/uat-s3-tests --smoke pg-backfill-migration
run_cmd "multihost UAT metadata PG migration smoke" ./scripts/uat-s3-tests --smoke metadata-pg-migration
run_cmd "multihost UAT metadata PG migration failover smoke" ./scripts/uat-s3-tests --smoke metadata-pg-migration-failover
