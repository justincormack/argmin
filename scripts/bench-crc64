#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

SIZE_MIB="${SIZE_MIB:-8}"
WARMUP_ITERS="${WARMUP_ITERS:-32}"
SAMPLE_ITERS="${SAMPLE_ITERS:-256}"
SAMPLES="${SAMPLES:-5}"

common_args=(
  --size-mib "$SIZE_MIB"
  --warmup-iters "$WARMUP_ITERS"
  --sample-iters "$SAMPLE_ITERS"
  --samples "$SAMPLES"
)

echo "cpu=$(uname -m)"
echo "size_mib=$SIZE_MIB warmup_iters=$WARMUP_ITERS sample_iters=$SAMPLE_ITERS samples=$SAMPLES"

echo
echo "[pure-rust scalar]"
ARGMIN_CRC64_BENCH_BACKEND=scalar cargo run --offline -p checksum --example crc64_bench --release --no-default-features --features pure-rust,bench-select -- "${common_args[@]}" --label pure-rust-scalar

echo
echo "[pure-rust auto]"
cargo run --offline -p checksum --example crc64_bench --release --no-default-features --features pure-rust,bench-select -- "${common_args[@]}" --label pure-rust-auto

echo
echo "[isa-l]"
cargo run --offline -p checksum --example crc64_bench --release --no-default-features --features isa-l -- "${common_args[@]}" --label isa-l
