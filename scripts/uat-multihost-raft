wait_for_storage_network() {
    local source_index target_index deadline
    deadline=$((SECONDS + 60))
    for source_index in 0 1 2; do
        for target_index in 0 1 2; do
            while ! remote_exec_quiet "${hosts[$source_index]}" timeout 1 bash -c \
                "echo >/dev/tcp/${addresses[$target_index]}/$storage_port" >/dev/null 2>&1; do
                if ((SECONDS >= deadline)); then
                    die "${hosts[$source_index]} cannot reach storage RPC ${addresses[$target_index]}:$storage_port"
                fi
