for ((number = 1; number <= host_count; number++)); do
    start_storage "$number"
done
for ((number = 1; number <= host_count; number++)); do
    wait_storage_listener "$number"
done
wait_for_storage_network
wait_runtime_map_ready

echo "== start split-role frontends =="
for ((number = 1; number <= host_count; number++)); do
    start_frontend "$number"
done
for ((number = 1; number <= host_count; number++)); do
    wait_frontend_listener "$number"
done
if ((start_cluster)); then
    assert_all_service_units_active
    for lifecycle_value in \
        "$run_id" "$hosts_value" "$remote_root" "$local_run" "$ssh_config"; do
        [[ "$lifecycle_value" != *$'\n'* && "$lifecycle_value" != *$'\r'* ]] ||
            die "cluster lifecycle values cannot contain line breaks"
    done
    mkdir -p -- "$lifecycle_root"
    [[ -d "$lifecycle_root" && ! -L "$lifecycle_root" && -O "$lifecycle_root" ]] ||
        die "lifecycle root is not a private current-user directory: $lifecycle_root"
    chmod 700 "$lifecycle_root"
    lifecycle_record="$lifecycle_root/$run_id.record"
    lifecycle_record_next="$lifecycle_record.next-$$"
    (
        umask 077
        {
            printf 'version=1\n'
            printf 'run_id=%s\n' "$run_id"
            printf 'hosts=%s\n' "$hosts_value"
            printf 'remote_root=%s\n' "$remote_root"
            printf 'local_run=%s\n' "$local_run"
            printf 'ssh_config=%s\n' "$ssh_config"
        } >"$lifecycle_record_next"
    )
    mv "$lifecycle_record_next" "$lifecycle_record"
    lifecycle_record_next=""

    lifecycle_file="$local_run/cluster-lifecycle.env"
    {
        printf 'run_id=%q\n' "$run_id"
        printf 'cluster_id=%q\n' "$cluster_id"
        printf 'hosts=%q\n' "$hosts_value"
        printf 'addresses=%q\n' "$addresses_value"
        printf 'remote_root=%q\n' "$remote_root"
        printf 'remote_run=%q\n' "$remote_run"
        printf 'local_run=%q\n' "$local_run"
        printf 'frontend_port=%q\n' "$frontend_port"
        printf 's3_access_key_id=%q\n' 'argmin-multihost-primary'
        printf 's3_secret_access_key=%q\n' "$s3_secret_access_key"
        printf 's3_region=%q\n' 'us-east-1'
        for ((number = 1; number <= host_count; number++)); do
            printf 'frontend_%d_id=%q\n' "$number" "frontend-$number"
            printf 'frontend_%d_endpoint=%q\n' "$number" \
                "http://${addresses[$((number - 1))]}:$frontend_port"
        done
    } >"$lifecycle_file"
    chmod 600 "$lifecycle_file"

    echo "cluster_started run_id=$run_id cluster_id=$cluster_id"
    echo "remote_run=$remote_run"
    echo "local_run=$local_run"
    for ((number = 1; number <= host_count; number++)); do
        echo "frontend id=frontend-$number address=${addresses[$((number - 1))]}:$frontend_port endpoint=http://${addresses[$((number - 1))]}:$frontend_port"
    done
    echo "s3_credentials access_key_id=argmin-multihost-primary secret_access_key=$s3_secret_access_key region=us-east-1"
    shutdown_command=(
        ./scripts/uat-multihost-raft
        --lifecycle-root "$lifecycle_root"
        --shutdown-cluster "$run_id"
    )
    printf 'shutdown_command='
    printf ' %q' "${shutdown_command[@]}"
    printf '\n'
    echo "cluster_lifecycle_file=$lifecycle_file"
    echo "cluster_lifecycle_record=$lifecycle_record"
    leave_cluster_running=1
    exit 0
fi

echo "== run startup CRUD diagnostics =="
openssl rand -out "$data_plane_body_file" 1048576
capture_cluster_diagnostics startup-before-crud
if ((startup_only == 0)); then
    build_empty_cluster_retained_route_history
fi
for ((startup_round = 1; startup_round <= startup_crud_rounds; startup_round++)); do
    echo "== startup CRUD round $startup_round/$startup_crud_rounds =="
    run_startup_crud_round "$startup_round"
    capture_cluster_diagnostics "startup-after-crud-$startup_round"
done
echo "startup_crud_complete rounds=$startup_crud_rounds frontends=$host_count"

if ((startup_only)); then
    assert_all_service_units_active
    echo "OK: argmin-s3 multihost startup and CRUD diagnostic passed"
    exit 0
fi

echo "== seed persistent cross-frontend S3 workload =="
run_data_client_on 1 create-put-metadata-pg \
    "$data_plane_bucket_file" "$data_plane_initial_key_file" \
    "$data_plane_metadata_pg_file" object-000 "$data_plane_body_file" 0
IFS= read -r object_key <"$data_plane_initial_key_file"
[[ -n "$object_key" ]] || die "persistent workload did not report its initial object key"
data_plane_keys+=("$object_key")
for ((object_index = 1; object_index < data_object_count; object_index++)); do
    printf -v object_key 'object-%03d' "$object_index"
    frontend_number=$(((object_index % host_count) + 1))
    put_data_plane_object_on "$frontend_number" "$object_key"
done
verify_data_plane_objects_across_running_frontends
run_data_client_on 2 cleanup-versioned-stress 1 2 2 multihost-versioned "$data_plane_body_file"
echo "data_plane_cross_frontend_seed objects=${#data_plane_keys[@]} frontends=$host_count body_bytes=$(wc -c <"$data_plane_body_file")"

if ((quantitative)); then
    echo "== begin quantitative outage and sustained interval =="
    admin_command control-plane-trigger-raft-snapshot-purge "$remote_run/unused.sock"
    wait_runtime_map_ready
    for ((number = 1; number <= host_count; number++)); do
        transfer_leadership_to "$number"
        wait_runtime_map_ready
        capture_quantitative_baseline "$number"
    done
    quantitative_deadline=$((SECONDS + sustained_seconds))
fi

for ((iteration = 1; iteration <= repeat_count; iteration++)); do
    target_number=$((((iteration - 1) % host_count) + 1))
    target_raft_node=$((100 + target_number))
    survivor_number=$((target_number % host_count + 1))
    wait_runtime_map_ready
    if ((host_count > ec_total_shards)); then
        prepare_host_outage_routes "$iteration" "$target_number" "$survivor_number"
        wait_pg_runtime_map_ready "$outage_probe_pg" -1 \
            "${outage_probe_pre_acting_set[@]}"
        wait_pg_runtime_map_ready "$outage_probe_data_pg" -1 \
            "${outage_probe_data_acting_set[@]}"
        wait_runtime_map_ready
        put_data_plane_object_for_metadata_and_data_pg_on "$survivor_number" \
            "$outage_probe_pg" "$outage_probe_data_pg" "host-outage-read-$iteration"
    fi
    pre_host_outage_epoch="$last_runtime_epoch"
    if [[ -n "$host_fault_driver" ]]; then
        echo "== host power outage iteration $iteration: power off ${hosts[$((target_number - 1))]} and Raft node $target_raft_node =="
    else
        echo "== host-service outage iteration $iteration: stop frontend, storage, and Raft node $target_raft_node =="
    fi
    transfer_leadership_to "$target_number"

    if ((quantitative)); then
        wait_runtime_map_ready
        accumulate_quantitative_generation "$target_number" before-restart
    fi
    if [[ -n "$host_fault_driver" ]]; then
        power_down_host "$target_number" || die "failed to power down host $target_number"
    else
        stop_host_services "$target_number"
    fi
    if ((quantitative)); then
        reset_quantitative_generation_baseline "$target_number"
    fi
    command_process_number="$survivor_number"
    wait_clock_status false "$((transferred_term + 1))"
    [[ "$(status_field "$last_status" blocked_reason)" == "Some(RaftLeadershipChanged)" ]] ||
        die "host outage produced an unexpected authority-clock state: $last_status"
    admin_command control-plane-reestablish-authority-clock "$remote_run/unused.sock"
    wait_clock_status true "$((transferred_term + 1))"

    verify_data_plane_objects_across_running_frontends
    echo "host_outage_reads_verified host=$target_number surviving_frontends=$((host_count - 1)) objects=${#data_plane_keys[@]}"

    pre_host_rejoin_epoch="$last_runtime_epoch"
    if ((host_count > ec_total_shards)); then
        frontend_command control-plane-transfer-pg-metadata-live \
            "$remote_run/unused.sock" "$outage_probe_pg" \
            "${outage_probe_replacement_acting_set[@]}"
        wait_pg_runtime_map_ready "$outage_probe_pg" "$pre_host_outage_epoch" \
            "${outage_probe_replacement_acting_set[@]}"
        pre_host_rejoin_epoch="$last_runtime_epoch"
        put_data_plane_object_for_metadata_and_data_pg_on "$survivor_number" \
            "$outage_probe_pg" "$outage_probe_data_pg" "host-outage-write-$iteration"
        verify_data_plane_objects_across_running_frontends
        echo "host_outage_write_verified host=$target_number metadata_pg=$outage_probe_pg data_pg=$outage_probe_data_pg spare_node=$outage_probe_spare metadata_acting_set=${outage_probe_replacement_acting_set[*]} data_acting_set=${outage_probe_data_acting_set[*]} epoch=$last_runtime_epoch objects=${#data_plane_keys[@]}"
    else
        echo "host_outage_write_skipped host=$target_number reason=no-spare-storage-domain ec=$ec_data_shards+$ec_parity_shards"
    fi

    if [[ -n "$host_fault_driver" ]]; then
        power_up_host "$target_number" || die "failed to power up host $target_number"
    fi
    start_authority "$target_number"
    wait_authority_listener "$target_number"
    stabilize_rejoined_clock "$((transferred_term + 1))"
    start_storage "$target_number"
    wait_storage_listener "$target_number"
    wait_for_storage_network
    wait_runtime_map_ready "$pre_host_rejoin_epoch"
    start_frontend "$target_number"
    wait_frontend_listener "$target_number"

    rejoin_key="host-rejoin-$iteration"
    put_data_plane_object_on "$target_number" "$rejoin_key"
    verify_data_plane_objects_across_running_frontends
    echo "host_rejoin_verified host=$target_number epoch=$last_runtime_epoch objects=${#data_plane_keys[@]}"
    admin_command control-plane-trigger-raft-snapshot-purge "$remote_run/unused.sock"
done

if ((quantitative)); then
    echo "== complete quantitative sustained multihost release interval =="
    quantitative_read_rounds=0
    while ((SECONDS < quantitative_deadline)); do
        frontend_number=$(((quantitative_read_rounds % host_count) + 1))
        verify_data_plane_objects_on "$frontend_number"
        quantitative_read_rounds=$((quantitative_read_rounds + 1))
        remaining_seconds=$((quantitative_deadline - SECONDS))
        if ((remaining_seconds > 5)); then
            sleep 5
        elif ((remaining_seconds > 0)); then
            sleep "$remaining_seconds"
        fi
    done

    admin_command control-plane-trigger-raft-snapshot-purge "$remote_run/unused.sock"
    wait_runtime_map_ready
    for ((number = 1; number <= host_count; number++)); do
        transfer_leadership_to "$number"
        wait_runtime_map_ready
        capture_quantitative_result "$number"
    done
    assert_no_quantitative_auth_failures
    assert_all_service_units_active
    echo "control_plane_multihost_quantitative_complete host_outages=$repeat_count read_rounds=$quantitative_read_rounds sustained_seconds=$sustained_seconds"
fi

command_process_number=1
assert_all_service_units_active
run_data_client_on 1 cleanup "$data_plane_bucket_file" "${data_plane_keys[@]}"

echo "== final durable state =="
for ((index = 0; index < host_count; index++)); do
    number=$((index + 1))
    remote_exec "${hosts[$index]}" test -s "$remote_run/state-$number/control.state"
    remote_exec "${hosts[$index]}" find "$remote_run/state-$number" -maxdepth 1 -type f -printf '%f %s bytes\n'
    remote_exec "${hosts[$index]}" du -s -B1 "$remote_run/storage-$number"
done

if diagnostics="$(frontend_command control-plane-runtime-map-diagnostics "$remote_run/unused.sock" 2>/dev/null)"; then
    echo "$diagnostics"
fi

echo "OK: argmin-s3 multihost Raft and data-plane smoke passed"
