[[transport_profiles]]
id = "raft"
max_frame_bytes = 16777216
max_connections = 256
connect_timeout_ms = 1000
io_timeout_ms = 5000

[[transport_profiles]]
id = "control"
max_frame_bytes = 8388648
max_connections = 256
