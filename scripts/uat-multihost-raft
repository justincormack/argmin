    "$material_dir/ca.crt"
    "$material_dir/server.crt"
    "$material_dir/server.key"
    "$material_dir/s3-secret-access-key"
    "$material_dir/sse-s3-wrapping-key"
)
for role in raft storage admin; do
    for number in 1 2 3; do
        deploy_material+=("$material_dir/$role-$number.key")
    done
done
for number in 1 2 3; do
    deploy_material+=(
        "$material_dir/frontend-$number.key"
        "$material_dir/frontend-$number-admin.key"
        "$material_dir/frontend-$number-maintenance.key"
    )
done

for index in 0 1 2; do
    host="${hosts[$index]}"
    echo "== deploy to $host =="
    print_command scp "${scp_options[@]}" -q "$binary" "$host:$remote_run/argmin-s3.next"
    scp "${scp_options[@]}" -q "$binary" "$host:$remote_run/argmin-s3.next"
    print_command scp "${scp_options[@]}" -q "$manifest_path" "$host:$remote_run/cluster.toml"
    scp "${scp_options[@]}" -q "$manifest_path" "$host:$remote_run/cluster.toml"
    print_command scp "${scp_options[@]}" -q "${deploy_material[@]}" "$host:$remote_run/material/"
    scp "${scp_options[@]}" -q "${deploy_material[@]}" "$host:$remote_run/material/"
    remote_exec "$host" mv "$remote_run/argmin-s3.next" "$remote_run/argmin-s3"
    remote_exec "$host" chmod 700 "$remote_run/argmin-s3"
    sensitive_paths=(
        "$remote_run/cluster.toml"
        "$remote_run/material/server.key"
        "$remote_run/material/s3-secret-access-key"
        "$remote_run/material/sse-s3-wrapping-key"
    )
    for role in raft storage admin; do
        for number in 1 2 3; do
            sensitive_paths+=("$remote_run/material/$role-$number.key")
        done
    done
    for number in 1 2 3; do
        sensitive_paths+=(
            "$remote_run/material/frontend-$number.key"
            "$remote_run/material/frontend-$number-admin.key"
            "$remote_run/material/frontend-$number-maintenance.key"
        )
    done
    remote_exec "$host" chmod 600 "${sensitive_paths[@]}"
    remote_digest="$(remote_exec_quiet "$host" sha256sum "$remote_run/argmin-s3" | awk '{print $1}')"
    [[ "$remote_digest" == "$binary_digest" ]] || die "deployed binary checksum mismatch on $host"
done

