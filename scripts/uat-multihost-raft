#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

usage() {
    cat <<'EOF'
Usage: ./scripts/uat-multihost-raft [options]

Run the authenticated static-manifest Raft authority and data-plane soak across
three or four real hosts. Each host runs an authority, storage node, and
independently authenticated frontend. SSH is used only for deployment and process
supervision; all Argmin traffic uses the configured TLS/TCP endpoints
directly.
Unless explicit binary paths are supplied, the required server and UAT client
binaries are built locally before any remote setup.

Options:
  --hosts HOSTS          Three or four SSH aliases; required except for shutdown
  --addresses ADDRS      Matching advertised IPv4 addresses (or ARGMIN_MULTIHOST_RAFT_ADDRS)
  --binary PATH          Deploy a prebuilt argmin-s3 binary; standard target paths build it
  --client-binary PATH   Use a prebuilt UAT client; standard target paths build it
  --release              Build and deploy target/release/argmin-s3
  --remote-root PATH     Common absolute remote root (default: /home/argmin-test/argmin-soak)
  --lifecycle-root PATH  Private lifecycle registry (default: XDG state directory)
  --ssh-config PATH      Explicit SSH client config (or ARGMIN_MULTIHOST_RAFT_SSH_CONFIG)
  --storage-profile P    persistent or volatile-test (default: persistent)
  --port-base PORT       Raft port; other endpoints use the next four (default: 24000)
  --pg-count N           Bootstrap PG count, at least 2 (default: 116)
  --ec-data-shards N     EC data shards (default: 1 on three hosts, 2 on four)
  --ec-parity-shards N   EC parity shards (default: 1)
  --retained-epochs N    Committed route epoch advances before failover (default: 256)
  --data-objects N       Persistent S3 objects checked across failures (default: 8)
  --heartbeat-lease-ms N Storage-node heartbeat lease (default: 5000)
  --repeat N             Whole-host service outage/rejoin cycles (default: 3)
  --startup-crud-rounds N
                         CRUD rounds through every frontend before fault testing (default: 1)
  --startup-only         Stop after startup CRUD and cluster diagnostics
  --start-cluster        Start a cluster for ad hoc use; run no tests and leave it running
  --shutdown-cluster ID  Stop and remove a cluster previously started with --start-cluster
  --host-fault-driver P  Local executable invoked as P down|up HOST ADDRESS
  --quantitative         Enforce the sustained persistent-storage release gate
  --sustained-seconds N  Quantitative steady interval (default: 300)
  --no-cleanup           Preserve remote and local state after every run
  --no-cleanup-fail      Preserve remote and local state only after failure
  -h, --help             Show this help

Example:
  ./scripts/uat-multihost-raft \
    --hosts grey0,grey1,grey2,grey3 \
    --addresses 192.168.1.124,192.168.1.155,192.168.1.116,192.168.1.154 \
    --startup-only --startup-crud-rounds 10 --no-cleanup-fail

Ad hoc cluster lifecycle:
  ./scripts/uat-multihost-raft \
    --hosts grey0,grey1,grey2,grey3 \
    --addresses 192.0.2.10,192.0.2.11,192.0.2.12,192.0.2.13 \
    --release --start-cluster
  ./scripts/uat-multihost-raft \
    --shutdown-cluster RUN_ID
EOF
}

die() {
    echo "error: $*" >&2
    exit 2
}

print_command() {
    printf '+'
    printf ' %q' "$@"
    printf '\n'
}

build_cargo_binary() {
    local -n output_path="$1"
    local binary_name="$2"
    shift 2

    local build_messages
    build_messages="$(mktemp "${TMPDIR:-/tmp}/argmin-cargo-build.XXXXXX")"
    print_command "$@" --message-format=json-render-diagnostics
    if ! "$@" --message-format=json-render-diagnostics >"$build_messages"; then
        jq --join-output --raw-output \
            'select(.reason == "compiler-message") | .message.rendered // empty' \
            "$build_messages" >&2 || true
        rm -f -- "$build_messages"
        die "failed to build $binary_name"
    fi

    jq --join-output --raw-output \
        'select(.reason == "compiler-message") | .message.rendered // empty' \
        "$build_messages" >&2

    local -a executable_paths=()
    mapfile -t executable_paths < <(
        jq --raw-output --arg binary_name "$binary_name" '
            select(
                .reason == "compiler-artifact"
                and .target.name == $binary_name
                and (.target.kind | index("bin")) != null
                and .executable != null
            )
            | .executable
        ' "$build_messages"
    )
    rm -f -- "$build_messages"

    ((${#executable_paths[@]} == 1)) ||
        die "Cargo reported ${#executable_paths[@]} executable artifacts for $binary_name"
    output_path="${executable_paths[0]}"
    [[ -x "$output_path" ]] ||
        die "Cargo-built $binary_name binary is not executable: $output_path"
}

split_host_list() {
    local value="$1"
    local label="$2"
    local -n output="$3"
    IFS=, read -r -a output <<<"$value"
    ((${#output[@]} == 3 || ${#output[@]} == 4)) ||
        die "$label must contain three or four comma-separated values"
    local item
    for item in "${output[@]}"; do
        [[ -n "$item" ]] || die "$label cannot contain an empty value"
    done
}

route_acting_set_for_attempt() {
    local attempt="$1"
    local -n output_pg_id="$2"
    local -n output_acting_set="$3"
    local zero_based_attempt=$((attempt - 1))
    local route_pass=$((zero_based_attempt / pg_count))
    local first_node offset
    output_pg_id=$((zero_based_attempt % pg_count))
    first_node=$((((output_pg_id + route_pass) % host_count) + 1))
    output_acting_set=()
    for ((offset = 0; offset < ec_total_shards; offset++)); do
        output_acting_set+=($((((first_node - 1 + offset) % host_count) + 1)))
    done
}

validate_route_rotation() {
    local attempts=$((pg_count * (host_count + 1)))
    local attempt pg_id previous_set set_key
    local -a acting_set=()
    declare -A previous_sets=()
    for ((attempt = 1; attempt <= attempts; attempt++)); do
        route_acting_set_for_attempt "$attempt" pg_id acting_set
        printf -v set_key '%s,' "${acting_set[@]}"
        previous_set="${previous_sets[$pg_id]:-}"
        [[ -z "$previous_set" || "$previous_set" != "$set_key" ]] ||
            die "internal route rotation repeats PG $pg_id acting set $set_key on consecutive passes"
        previous_sets["$pg_id"]="$set_key"
    done
}

acting_set_with_primary_and_node() {
    local primary_node="$1"
    local included_node="$2"
    local seed="$3"
    local -n included_output="$4"
    local offset candidate
    ((primary_node != included_node)) ||
        die "acting-set primary and included node must differ"
    included_output=("$primary_node" "$included_node")
    ((${#included_output[@]} == ec_total_shards)) && return 0
    for ((offset = 0; offset < host_count; offset++)); do
        candidate=$((((seed + offset) % host_count) + 1))
        ((candidate == primary_node || candidate == included_node)) && continue
        included_output+=("$candidate")
        ((${#included_output[@]} == ec_total_shards)) && return 0
    done
    ((${#included_output[@]} == ec_total_shards)) ||
        die "could not construct an EC acting set with primary $primary_node including node $included_node"
}

acting_set_with_primary_excluding_node() {
    local primary_node="$1"
    local excluded_node="$2"
    local seed="$3"
    local -n excluded_output="$4"
    local offset candidate
    ((primary_node != excluded_node)) ||
        die "acting-set primary must differ from excluded node"
    excluded_output=("$primary_node")
    for ((offset = 0; offset < host_count; offset++)); do
        candidate=$((((seed + offset) % host_count) + 1))
        ((candidate == primary_node || candidate == excluded_node)) && continue
        excluded_output+=("$candidate")
        ((${#excluded_output[@]} == ec_total_shards)) && return 0
    done
    ((${#excluded_output[@]} == ec_total_shards)) ||
        die "could not construct an EC acting set with primary $primary_node excluding node $excluded_node"
}

shell_join() {
    local joined=""
    local argument
    for argument in "$@"; do
        printf -v argument '%q' "$argument"
        joined+="${joined:+ }$argument"
    done
    printf '%s\n' "$joined"
}

remote_exec() {
    local host="$1"
    shift
    local command
    command="$(shell_join "$@")"
    print_command ssh "${ssh_options[@]}" "$host" "$command"
    # shell_join quotes every remote argument.
    # shellcheck disable=SC2029
    ssh "${ssh_options[@]}" "$host" "$command"
}

remote_exec_quiet() {
    local host="$1"
    shift
    local command
    command="$(shell_join "$@")"
    # shell_join quotes every remote argument.
    # shellcheck disable=SC2029
    ssh "${ssh_options[@]}" "$host" "$command"
}

shutdown_started_cluster() {
    local requested_run_id="$1"
    local shutdown_run_name="argmin-multihost-raft-$requested_run_id"
    local shutdown_remote_run="$remote_root/$shutdown_run_name"
    local index host
    local failed=0
    local -a shutdown_hosts=()

    split_host_list "$hosts_value" "--hosts" shutdown_hosts
    echo "== shut down argmin-s3 multihost cluster $requested_run_id =="
    for ((index = 0; index < ${#shutdown_hosts[@]}; index++)); do
        host="${shutdown_hosts[$index]}"
        echo "== stop cluster services on $host =="
        # The single-quoted script expands positional parameters on the remote host.
        # shellcheck disable=SC2016
        if ! remote_exec "$host" bash -c '
            remote_run="$1"
            unit_prefix="$2"
            unit_rows="$(systemctl --user list-units --all --plain --no-legend "${unit_prefix}-*")" || exit 1
            units=()
            while read -r unit _; do
                [[ -n "$unit" ]] && units+=("$unit")
            done <<<"$unit_rows"
            if ((${#units[@]} > 0)); then
                systemctl --user stop "${units[@]}" >/dev/null 2>&1 || true
            fi
            for unit in "${units[@]}"; do
                if systemctl --user is-active --quiet "$unit"; then
                    printf "service remains active after shutdown: %s\n" "$unit" >&2
                    exit 1
                fi
            done
            rm -rf -- "$remote_run"
        ' _ "$shutdown_remote_run" "$shutdown_run_name"; then
            echo "error: failed to shut down cluster state on $host" >&2
            failed=1
        fi
    done
    ((failed == 0)) || die "cluster shutdown was incomplete; retained local lifecycle state"

    rm -rf -- "$shutdown_local_run"
    rm -f -- "$lifecycle_record"
    echo "cluster_shutdown_complete run_id=$requested_run_id remote_run=$shutdown_remote_run"
}

load_cluster_lifecycle_record() {
    local requested_run_id="$1"
    local expected_run_name="argmin-multihost-raft-$requested_run_id"
    local line key value
    local record_version="" record_run_id="" record_hosts=""
    local record_remote_root="" record_local_run="" record_ssh_config=""
    local -A seen=()

    lifecycle_record="$lifecycle_root/$requested_run_id.record"
    [[ -d "$lifecycle_root" && ! -L "$lifecycle_root" && -O "$lifecycle_root" ]] ||
        die "lifecycle root is not a private current-user directory: $lifecycle_root"
    [[ "$(stat -c %a "$lifecycle_root")" == "700" ]] ||
        die "lifecycle root must have mode 0700"
    [[ -f "$lifecycle_record" && ! -L "$lifecycle_record" ]] ||
        die "lifecycle record does not exist or is not a regular file: $lifecycle_record"
    [[ -O "$lifecycle_record" ]] || die "lifecycle record is not owned by the current user"
    [[ "$(stat -c %a "$lifecycle_record")" == "600" ]] ||
        die "lifecycle record must have mode 0600"
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" == *=* ]] || die "malformed lifecycle record: $lifecycle_record"
        key="${line%%=*}"
        value="${line#*=}"
        [[ -z "${seen[$key]:-}" ]] ||
            die "duplicate lifecycle record field $key"
        seen["$key"]=1
        case "$key" in
            version) record_version="$value" ;;
            run_id) record_run_id="$value" ;;
            hosts) record_hosts="$value" ;;
            remote_root) record_remote_root="$value" ;;
            local_run) record_local_run="$value" ;;
            ssh_config) record_ssh_config="$value" ;;
            *) die "unknown lifecycle record field $key" ;;
        esac
    done <"$lifecycle_record"

    for key in version run_id hosts remote_root local_run ssh_config; do
        [[ "${seen[$key]:-}" == "1" ]] ||
            die "lifecycle record is missing field $key"
    done
    [[ "$record_version" == "1" ]] || die "unsupported lifecycle record version"
    [[ "$record_run_id" == "$requested_run_id" ]] ||
        die "lifecycle record run ID does not match $requested_run_id"
    [[ -n "$record_hosts" ]] || die "lifecycle record has no hosts"
    [[ "$record_remote_root" == /* && "$record_remote_root" != "/" ]] ||
        die "lifecycle record has an unsafe remote root"
    [[ "$record_remote_root" != *[[:space:]]* ]] ||
        die "lifecycle record remote root contains whitespace"
    [[ "$record_local_run" == /* && "$record_local_run" != "/" ]] ||
        die "lifecycle record has an unsafe local path"
    [[ "${record_local_run##*/}" == "$expected_run_name" ]] ||
        die "lifecycle record local path is not bound to run $requested_run_id"
    if [[ -n "$record_ssh_config" ]]; then
        [[ -f "$record_ssh_config" ]] ||
            die "recorded SSH config does not exist: $record_ssh_config"
    fi

    if ((hosts_explicit)) && [[ "$hosts_value" != "$record_hosts" ]]; then
        die "--hosts does not match the lifecycle record"
    fi
    if ((remote_root_explicit)) && [[ "$remote_root" != "$record_remote_root" ]]; then
        die "--remote-root does not match the lifecycle record"
    fi
    if ((ssh_config_explicit)) && [[ "$ssh_config" != "$record_ssh_config" ]]; then
        die "--ssh-config does not match the lifecycle record"
    fi
    hosts_value="$record_hosts"
    remote_root="$record_remote_root"
    shutdown_local_run="$record_local_run"
    ssh_config="$record_ssh_config"
}

hosts_value="${ARGMIN_MULTIHOST_RAFT_HOSTS:-}"
addresses_value="${ARGMIN_MULTIHOST_RAFT_ADDRS:-}"
hosts_explicit=0
[[ -z "${ARGMIN_MULTIHOST_RAFT_HOSTS+x}" ]] || hosts_explicit=1
binary=""
client_binary=""
release=0
remote_root="${ARGMIN_MULTIHOST_RAFT_REMOTE_ROOT:-/home/argmin-test/argmin-soak}"
remote_root_explicit=0
[[ -z "${ARGMIN_MULTIHOST_RAFT_REMOTE_ROOT+x}" ]] || remote_root_explicit=1
lifecycle_root="${ARGMIN_MULTIHOST_RAFT_LIFECYCLE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/argmin/multihost-raft}"
ssh_config="${ARGMIN_MULTIHOST_RAFT_SSH_CONFIG:-}"
ssh_config_explicit=0
[[ -z "${ARGMIN_MULTIHOST_RAFT_SSH_CONFIG+x}" ]] || ssh_config_explicit=1
storage_profile="${ARGMIN_MULTIHOST_RAFT_STORAGE_PROFILE:-persistent}"
port_base="${ARGMIN_MULTIHOST_RAFT_PORT_BASE:-24000}"
pg_count="${ARGMIN_MULTIHOST_RAFT_PG_COUNT:-116}"
ec_data_shards="${ARGMIN_MULTIHOST_RAFT_EC_DATA_SHARDS:-}"
ec_parity_shards="${ARGMIN_MULTIHOST_RAFT_EC_PARITY_SHARDS:-1}"
retained_epochs="${ARGMIN_MULTIHOST_RAFT_RETAINED_EPOCHS:-256}"
data_object_count="${ARGMIN_MULTIHOST_RAFT_DATA_OBJECTS:-8}"
heartbeat_lease_ms="${ARGMIN_MULTIHOST_RAFT_HEARTBEAT_LEASE_MS:-5000}"
repeat_count="${ARGMIN_MULTIHOST_RAFT_REPEAT:-3}"
startup_crud_rounds="${ARGMIN_MULTIHOST_RAFT_STARTUP_CRUD_ROUNDS:-1}"
startup_only=0
start_cluster=0
shutdown_run_id=""
host_fault_driver="${ARGMIN_MULTIHOST_RAFT_HOST_FAULT_DRIVER:-}"
quantitative=0
sustained_seconds="${ARGMIN_MULTIHOST_RAFT_SUSTAINED_SECONDS:-300}"
max_durable_bytes_per_second=1048576
max_wal_file_sync_us=1000000
max_checkpoint_store_us=5000000
max_rpc_operation_us=15000000
keep_always=0
keep_failure=0

while (($# > 0)); do
    case "$1" in
        --hosts)
            [[ $# -ge 2 ]] || die "--hosts requires a value"
            hosts_value="$2"
            hosts_explicit=1
            shift 2
            ;;
        --addresses)
            [[ $# -ge 2 ]] || die "--addresses requires a value"
            addresses_value="$2"
            shift 2
            ;;
        --binary)
            [[ $# -ge 2 ]] || die "--binary requires a value"
            binary="$2"
            shift 2
            ;;
        --client-binary)
            [[ $# -ge 2 ]] || die "--client-binary requires a value"
            client_binary="$2"
            shift 2
            ;;
        --release)
            release=1
            shift
            ;;
        --remote-root)
            [[ $# -ge 2 ]] || die "--remote-root requires a value"
            remote_root="$2"
            remote_root_explicit=1
            shift 2
            ;;
        --lifecycle-root)
            [[ $# -ge 2 ]] || die "--lifecycle-root requires a value"
            lifecycle_root="$2"
            shift 2
            ;;
        --ssh-config)
            [[ $# -ge 2 ]] || die "--ssh-config requires a value"
            ssh_config="$2"
            ssh_config_explicit=1
            shift 2
            ;;
        --storage-profile)
            [[ $# -ge 2 ]] || die "--storage-profile requires a value"
            storage_profile="$2"
            shift 2
            ;;
        --port-base)
            [[ $# -ge 2 ]] || die "--port-base requires a value"
            port_base="$2"
            shift 2
            ;;
        --pg-count)
            [[ $# -ge 2 ]] || die "--pg-count requires a value"
            pg_count="$2"
            shift 2
            ;;
        --ec-data-shards)
            [[ $# -ge 2 ]] || die "--ec-data-shards requires a value"
            ec_data_shards="$2"
            shift 2
            ;;
        --ec-parity-shards)
            [[ $# -ge 2 ]] || die "--ec-parity-shards requires a value"
            ec_parity_shards="$2"
            shift 2
            ;;
        --retained-epochs)
            [[ $# -ge 2 ]] || die "--retained-epochs requires a value"
            retained_epochs="$2"
            shift 2
            ;;
        --data-objects)
            [[ $# -ge 2 ]] || die "--data-objects requires a value"
            data_object_count="$2"
            shift 2
            ;;
        --heartbeat-lease-ms)
            [[ $# -ge 2 ]] || die "--heartbeat-lease-ms requires a value"
            heartbeat_lease_ms="$2"
            shift 2
            ;;
        --repeat)
            [[ $# -ge 2 ]] || die "--repeat requires a value"
            repeat_count="$2"
            shift 2
            ;;
        --startup-crud-rounds)
            [[ $# -ge 2 ]] || die "--startup-crud-rounds requires a value"
            startup_crud_rounds="$2"
            shift 2
            ;;
        --startup-only)
            startup_only=1
            shift
            ;;
        --start-cluster)
            start_cluster=1
            shift
            ;;
        --shutdown-cluster)
            [[ $# -ge 2 ]] || die "--shutdown-cluster requires a run ID"
            shutdown_run_id="$2"
            shift 2
            ;;
        --host-fault-driver)
            [[ $# -ge 2 ]] || die "--host-fault-driver requires a value"
            host_fault_driver="$2"
            shift 2
            ;;
        --quantitative)
            quantitative=1
            shift
            ;;
        --sustained-seconds)
            [[ $# -ge 2 ]] || die "--sustained-seconds requires a value"
            sustained_seconds="$2"
            shift 2
            ;;
        --no-cleanup)
            keep_always=1
            shift
            ;;
        --no-cleanup-fail)
            keep_failure=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            die "unknown option: $1"
            ;;
    esac
done

((release == 0 || ${#binary} == 0)) || die "--binary cannot be combined with --release"
[[ "$lifecycle_root" == /* && "$lifecycle_root" != "/" ]] ||
    die "--lifecycle-root must be a non-root absolute path"
[[ "$lifecycle_root" != *$'\n'* ]] || die "--lifecycle-root cannot contain a newline"
if [[ -n "$shutdown_run_id" ]]; then
    ((start_cluster == 0)) || die "--shutdown-cluster cannot be combined with --start-cluster"
    [[ "$shutdown_run_id" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+-[0-9]+$ ]] ||
        die "--shutdown-cluster requires a run ID printed by --start-cluster"
    load_cluster_lifecycle_record "$shutdown_run_id"
fi

[[ -n "$hosts_value" ]] || die "--hosts is required"
[[ "$remote_root" == /* && "$remote_root" != "/" ]] || die "--remote-root must be a non-root absolute path"
[[ "$remote_root" != *[[:space:]]* ]] || die "--remote-root cannot contain whitespace"
declare -a ssh_options=(-o BatchMode=yes -o ConnectTimeout=3)
declare -a scp_options=(-o BatchMode=yes -o ConnectTimeout=3)
if [[ -n "$ssh_config" ]]; then
    [[ -f "$ssh_config" ]] || die "--ssh-config does not name a regular file: $ssh_config"
    ssh_options+=(-F "$ssh_config")
    scp_options+=(-F "$ssh_config")
fi
if [[ -n "$shutdown_run_id" ]]; then
    shutdown_started_cluster "$shutdown_run_id"
    exit 0
fi

[[ -n "$addresses_value" ]] || die "--addresses is required"
if ((start_cluster)); then
    ((startup_only == 0)) || die "--start-cluster cannot be combined with --startup-only"
    ((quantitative == 0)) || die "--start-cluster cannot be combined with --quantitative"
    ((keep_always == 0 && keep_failure == 0)) ||
        die "--start-cluster manages preservation automatically; omit cleanup options"
    [[ -z "$host_fault_driver" ]] ||
        die "--start-cluster cannot be combined with --host-fault-driver"
    [[ -z "$client_binary" ]] ||
        die "--start-cluster does not use --client-binary"
fi
case "$storage_profile" in
    persistent|volatile-test) ;;
    *) die "--storage-profile must be persistent or volatile-test" ;;
esac
for numeric in "$port_base" "$pg_count" "$retained_epochs" "$data_object_count" "$heartbeat_lease_ms" "$repeat_count" "$startup_crud_rounds" "$sustained_seconds" "$max_durable_bytes_per_second" "$max_wal_file_sync_us" "$max_checkpoint_store_us" "$max_rpc_operation_us"; do
    [[ "$numeric" =~ ^[1-9][0-9]*$ ]] || die "numeric options must be positive integers"
done
((port_base >= 1024 && port_base <= 65531)) || die "--port-base must be between 1024 and 65531"
((pg_count >= 2)) || die "--pg-count must be at least 2 for distinct metadata and payload outage probes"
((pg_count <= 4096)) || die "--pg-count exceeds the manifest limit of 4096"
((data_object_count <= 64)) || die "--data-objects must not exceed 64"
((heartbeat_lease_ms >= 2000 && heartbeat_lease_ms <= 10000)) ||
    die "--heartbeat-lease-ms must be between 2000 and 10000"
if ((quantitative)); then
    ((startup_only == 0)) || die "--quantitative cannot be combined with --startup-only"
    ((release == 1)) || die "--quantitative requires --release"
    [[ "$storage_profile" == "persistent" ]] ||
        die "--quantitative requires --storage-profile persistent"
    ((pg_count == 116)) || die "--quantitative requires --pg-count 116"
    ((retained_epochs == 256)) || die "--quantitative requires --retained-epochs 256"
    ((data_object_count >= 8)) || die "--quantitative requires at least 8 data objects"
    ((repeat_count >= 3)) || die "--quantitative requires at least 3 failover cycles"
    ((sustained_seconds >= 300)) ||
        die "--quantitative requires at least 300 sustained seconds"
fi

declare -a hosts addresses
split_host_list "$hosts_value" "--hosts" hosts
split_host_list "$addresses_value" "--addresses" addresses
((${#hosts[@]} == ${#addresses[@]})) ||
    die "--hosts and --addresses must contain the same number of values"
host_count=${#hosts[@]}
if [[ -z "$ec_data_shards" ]]; then
    ec_data_shards=$((host_count - 2))
fi
for numeric in "$ec_data_shards" "$ec_parity_shards"; do
    [[ "$numeric" =~ ^[1-9][0-9]*$ ]] ||
        die "EC shard counts must be positive integers"
done
ec_total_shards=$((ec_data_shards + ec_parity_shards))
((ec_total_shards <= host_count)) ||
    die "EC $ec_data_shards+$ec_parity_shards requires $ec_total_shards hosts, but only $host_count were supplied"
validate_route_rotation
for address in "${addresses[@]}"; do
    [[ "$address" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] ||
        die "--addresses currently requires literal IPv4 addresses: $address"
done
if [[ -n "$host_fault_driver" ]]; then
    if [[ "$host_fault_driver" != /* ]]; then
        host_fault_driver="$ROOT/$host_fault_driver"
    fi
    [[ -x "$host_fault_driver" ]] ||
        die "--host-fault-driver is not executable: $host_fault_driver"
fi

declare -A machine_id_hosts=()
declare -a server_build=() client_build=()

if [[ -z "$binary" ]]; then
    server_build=(cargo build -p argmin-s3 --bin argmin-s3)
    if ((release)); then
        server_build=(cargo build --release -p argmin-s3 --bin argmin-s3)
    fi
elif [[ "$binary" != /* ]]; then
    binary="$ROOT/$binary"
fi
case "$binary" in
    "$ROOT/target/debug/argmin-s3")
        server_build=(cargo build -p argmin-s3 --bin argmin-s3)
        ;;
    "$ROOT/target/release/argmin-s3")
        server_build=(cargo build --release -p argmin-s3 --bin argmin-s3)
        ;;
esac

if ((start_cluster == 0)) && [[ -z "$client_binary" ]]; then
    client_build=(cargo build -p s3-tests --features uat-pg-topology --bin uat_pg_backfill_smoke)
    if ((release)); then
        client_build=(cargo build --release -p s3-tests --features uat-pg-topology --bin uat_pg_backfill_smoke)
    fi
elif [[ "$client_binary" != /* ]]; then
    client_binary="$ROOT/$client_binary"
fi
case "$client_binary" in
    "$ROOT/target/debug/uat_pg_backfill_smoke")
        client_build=(cargo build -p s3-tests --features uat-pg-topology --bin uat_pg_backfill_smoke)
        ;;
    "$ROOT/target/release/uat_pg_backfill_smoke")
        client_build=(cargo build --release -p s3-tests --features uat-pg-topology --bin uat_pg_backfill_smoke)
        ;;
esac

if ((${#server_build[@]} != 0 || ${#client_build[@]} != 0)); then
    command -v cargo >/dev/null 2>&1 || die "cargo is required to build the UAT binaries"
    command -v jq >/dev/null 2>&1 || die "jq is required to locate Cargo-built UAT binaries"
fi
command -v openssl >/dev/null 2>&1 || die "openssl is required to generate the test PKI"
command -v scp >/dev/null 2>&1 || die "scp is required"

if ((${#server_build[@]} != 0)); then
    build_cargo_binary binary argmin-s3 "${server_build[@]}"
fi
[[ -x "$binary" ]] || die "argmin-s3 binary is not executable: $binary"

if ((${#client_build[@]} != 0)); then
    build_cargo_binary client_binary uat_pg_backfill_smoke "${client_build[@]}"
fi
if ((start_cluster == 0)); then
    [[ -x "$client_binary" ]] || die "S3 UAT client binary is not executable: $client_binary"
fi

for host in "${hosts[@]}"; do
    if ! machine_id="$(remote_exec_quiet "$host" cat /etc/machine-id)"; then
        die "could not read /etc/machine-id from $host"
    fi
    [[ "$machine_id" =~ ^[0-9a-f]{32}$ ]] ||
        die "$host returned an invalid /etc/machine-id"
    [[ "$machine_id" != "00000000000000000000000000000000" ]] ||
        die "$host returned an uninitialized /etc/machine-id"
    if [[ -n "${machine_id_hosts[$machine_id]:-}" ]]; then
        die "hosts ${machine_id_hosts[$machine_id]} and $host resolve to the same machine"
    fi
    machine_id_hosts["$machine_id"]="$host"
done

run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
run_name="argmin-multihost-raft-$run_id"
remote_run="$remote_root/$run_name"
if ((start_cluster)); then
    local_run="${TMPDIR:-/tmp}/$run_name"
    mkdir "$local_run" || die "local lifecycle path already exists: $local_run"
else
    local_run="$(mktemp -d "${TMPDIR:-/tmp}/$run_name.XXXXXX")"
fi
material_dir="$local_run/material"
manifest_path="$local_run/cluster.toml"
mkdir -p "$material_dir"
chmod 700 "$local_run" "$material_dir"
s3_secret_access_key="$(openssl rand -hex 20)"
sse_s3_wrapping_key="$(openssl rand -base64 32)"
[[ ${#s3_secret_access_key} -eq 40 && ${#sse_s3_wrapping_key} -eq 44 ]] ||
    die "openssl returned malformed per-run secret material"
printf '%s' "$s3_secret_access_key" >"$material_dir/s3-secret-access-key"
printf '%s' "$sse_s3_wrapping_key" >"$material_dir/sse-s3-wrapping-key"
chmod 600 "$material_dir/s3-secret-access-key" "$material_dir/sse-s3-wrapping-key"
lifecycle_record=""
lifecycle_record_next=""

declare -a current_units=() unit_generations=()
declare -a storage_units=() storage_unit_generations=()
declare -a frontend_units=() frontend_unit_generations=()
declare -A diagnostic_unit_hosts=()
command_process_number=1
cleanup_started=0
leave_cluster_running=0
powered_off_number=0
metrics_dir="$local_run/metrics"
mkdir -p "$metrics_dir"

declare -a quantitative_baseline_checkpoint_bytes=()
declare -a quantitative_baseline_wal_bytes=()
declare -a quantitative_baseline_checkpoint_errors=()
declare -a quantitative_baseline_checkpoint_compaction_errors=()
declare -a quantitative_baseline_wal_errors=()
declare -a quantitative_baseline_rpc_write_errors=()
declare -a quantitative_baseline_seconds=()
declare -a quantitative_checkpoint_bytes=()
declare -a quantitative_wal_bytes=()
declare -a quantitative_checkpoint_store_us_max=()
declare -a quantitative_wal_file_sync_us_max=()
declare -a quantitative_rpc_operation_us_max=()
for ((index = 0; index < host_count; index++)); do
    current_units[index]=""
    unit_generations[index]=0
    storage_units[index]=""
    storage_unit_generations[index]=0
    frontend_units[index]=""
    frontend_unit_generations[index]=0
    quantitative_baseline_checkpoint_bytes[index]=0
    quantitative_baseline_wal_bytes[index]=0
    quantitative_baseline_checkpoint_errors[index]=0
    quantitative_baseline_checkpoint_compaction_errors[index]=0
    quantitative_baseline_wal_errors[index]=0
    quantitative_baseline_rpc_write_errors[index]=0
    quantitative_baseline_seconds[index]=0
    quantitative_checkpoint_bytes[index]=0
    quantitative_wal_bytes[index]=0
    quantitative_checkpoint_store_us_max[index]=0
    quantitative_wal_file_sync_us_max[index]=0
    quantitative_rpc_operation_us_max[index]=0
done

collect_artifacts() {
    local index host host_dir unit
    for ((index = 0; index < host_count; index++)); do
        host="${hosts[$index]}"
        host_dir="$local_run/$host"
        mkdir -p "$host_dir"
        scp "${scp_options[@]}" -q -r "$host:$remote_run/logs/." "$host_dir/logs" 2>/dev/null || true
        remote_exec_quiet "$host" find "$remote_run" -maxdepth 3 -type f -printf '%P %s bytes\n' \
            >"$host_dir/files.txt" 2>&1 || true
        for unit in "${!diagnostic_unit_hosts[@]}"; do
            [[ "${diagnostic_unit_hosts[$unit]}" == "$index" ]] || continue
            remote_exec_quiet "$host" systemctl --user status "$unit" --no-pager \
                >"$host_dir/$unit-status.txt" 2>&1 || true
            remote_exec_quiet "$host" journalctl --user-unit "$unit" --no-pager \
                >"$host_dir/$unit-journal.txt" 2>&1 || true
        done
        remote_exec_quiet "$host" chronyc tracking >"$host_dir/chronyc-tracking.txt" 2>&1 || true
    done
}

stop_processes() {
    local index
    for ((index = 0; index < host_count; index++)); do
        if [[ -n "${frontend_units[$index]}" ]]; then
            remote_exec_quiet "${hosts[$index]}" systemctl --user stop "${frontend_units[$index]}" \
                >/dev/null 2>&1 || true
        fi
        if [[ -n "${storage_units[$index]}" ]]; then
            remote_exec_quiet "${hosts[$index]}" systemctl --user stop "${storage_units[$index]}" \
                >/dev/null 2>&1 || true
        fi
        if [[ -n "${current_units[$index]}" ]]; then
            remote_exec_quiet "${hosts[$index]}" systemctl --user stop "${current_units[$index]}" \
                >/dev/null 2>&1 || true
        fi
    done
}

cleanup() {
    local status=$?
    trap - EXIT INT TERM
    ((cleanup_started == 0)) || exit "$status"
    cleanup_started=1
    set +e
    if ((status == 0 && leave_cluster_running)); then
        exit 0
    fi
    if ((status != 0)) && declare -F capture_cluster_diagnostics >/dev/null; then
        capture_cluster_diagnostics failure
    fi
    if ((powered_off_number != 0)) && declare -F power_up_host >/dev/null; then
        power_up_host "$powered_off_number" ||
            echo "warning: failed to restore powered-off host $powered_off_number" >&2
    fi
    stop_processes
    if ((status != 0 || keep_always)); then
        collect_artifacts
    fi
    if ((keep_always == 0 && !(status != 0 && keep_failure != 0))); then
        local host
        for host in "${hosts[@]}"; do
            remote_exec_quiet "$host" rm -rf -- "$remote_run" >/dev/null 2>&1 || true
        done
        rm -rf -- "$local_run"
        if [[ -n "$lifecycle_record" ]]; then
            rm -f -- "$lifecycle_record"
        fi
        if [[ -n "$lifecycle_record_next" ]]; then
            rm -f -- "$lifecycle_record_next"
        fi
    else
        echo "preserved local artifacts: $local_run" >&2
        echo "preserved remote state: $remote_run on ${hosts_value}" >&2
    fi
    exit "$status"
}
trap cleanup EXIT INT TERM

echo "== argmin-s3 multihost Raft and data-plane soak =="
echo "run_id=$run_id hosts=$hosts_value addresses=$addresses_value host_count=$host_count storage_profile=$storage_profile pg_count=$pg_count ec=$ec_data_shards+$ec_parity_shards retained_epochs=$retained_epochs data_objects=$data_object_count heartbeat_lease_ms=$heartbeat_lease_ms repeat=$repeat_count startup_crud_rounds=$startup_crud_rounds startup_only=$startup_only start_cluster=$start_cluster quantitative=$quantitative sustained_seconds=$sustained_seconds"
echo "binary=$binary client_binary=$client_binary remote_run=$remote_run"
if [[ -n "$host_fault_driver" ]]; then
    echo "host_fault_driver=$host_fault_driver"
fi
if [[ "$storage_profile" == "volatile-test" ]]; then
    echo "NOTE: volatile-test storage is a functional/locking profile and is not durability release evidence"
fi

openssl req -x509 -newkey rsa:2048 -nodes -sha256 -days 2 \
    -subj "/CN=argmin-multihost-test-ca-$run_id" \
    -addext "basicConstraints=critical,CA:TRUE" \
    -addext "keyUsage=critical,keyCertSign,cRLSign" \
    -keyout "$material_dir/ca.key" -out "$material_dir/ca.crt" >/dev/null 2>&1
chmod 600 "$material_dir/ca.key"
chmod 644 "$material_dir/ca.crt"

server_san=""
for address in "${addresses[@]}"; do
    server_san+="${server_san:+,}IP:$address"
done
cat >"$material_dir/server.ext" <<EOF
basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature,keyEncipherment
extendedKeyUsage=serverAuth
subjectAltName=$server_san
EOF
openssl req -new -newkey rsa:2048 -nodes -sha256 \
    -subj "/CN=argmin-multihost-$run_id" \
    -keyout "$material_dir/server.key" -out "$material_dir/server.csr" >/dev/null 2>&1
openssl x509 -req -sha256 -days 2 -in "$material_dir/server.csr" \
    -CA "$material_dir/ca.crt" -CAkey "$material_dir/ca.key" -CAcreateserial \
    -extfile "$material_dir/server.ext" -out "$material_dir/server.crt" >/dev/null 2>&1
chmod 600 "$material_dir/server.key"
chmod 644 "$material_dir/server.crt"

declare -A generated_auth_secrets=()
for role in raft storage admin; do
    for ((number = 1; number <= host_count; number++)); do
        secret_path="$material_dir/$role-$number.key"
        (umask 077 && openssl rand -base64 32 >"$secret_path")
        secret="$(<"$secret_path")"
        [[ "$secret" =~ ^[A-Za-z0-9+/]{43}=$ ]] ||
            die "openssl generated malformed $role-$number credential material"
        [[ -z "${generated_auth_secrets[$secret]:-}" ]] ||
            die "openssl generated duplicate credential material for ${generated_auth_secrets[$secret]} and $role-$number"
        generated_auth_secrets["$secret"]="$role-$number"
    done
done
for ((number = 1; number <= host_count; number++)); do
    for role in frontend admin maintenance; do
        credential="frontend-$number"
        if [[ "$role" != "frontend" ]]; then
            credential+="-$role"
        fi
        secret_path="$material_dir/$credential.key"
        (umask 077 && openssl rand -base64 32 >"$secret_path")
        secret="$(<"$secret_path")"
        [[ "$secret" =~ ^[A-Za-z0-9+/]{43}=$ ]] ||
            die "openssl generated malformed $credential credential material"
        [[ -z "${generated_auth_secrets[$secret]:-}" ]] ||
            die "openssl generated duplicate credential material for ${generated_auth_secrets[$secret]} and $credential"
        generated_auth_secrets["$secret"]="$credential"
    done
done

declare -a mount_paths
for ((index = 0; index < host_count; index++)); do
    host="${hosts[$index]}"
    remote_exec "$host" mkdir -p "$remote_run/material" "$remote_run/logs" "$remote_run/state-$((index + 1))"
    remote_exec "$host" chmod 700 "$remote_run" "$remote_run/material" "$remote_run/logs" "$remote_run/state-$((index + 1))"
    mount_paths[index]="$(remote_exec_quiet "$host" findmnt -n -o TARGET -T "$remote_run")"
    [[ -n "${mount_paths[$index]}" ]] || die "could not determine filesystem mount for $remote_run on $host"
done

raft_port="$port_base"
control_port=$((port_base + 1))
recovery_port=$((port_base + 2))
storage_port=$((port_base + 3))
frontend_port=$((port_base + 4))
cluster_id="multihost-raft-$run_id"

cat >"$manifest_path" <<EOF
schema_version = 1

[s3]
account_id = "111122223333"
access_key_id = "argmin-multihost-primary"
secret_access_key_ref = "file:$remote_run/material/s3-secret-access-key"
