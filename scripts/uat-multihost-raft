}

start_frontend() {
    local number="$1"
    local index=$((number - 1))
    local host="${hosts[$index]}"
    frontend_unit_generations[index]=$((frontend_unit_generations[index] + 1))
    local unit="$run_name-frontend-$number-${frontend_unit_generations[$index]}"
    frontend_units[index]="$unit"
    diagnostic_unit_hosts["$unit"]="$index"
    remote_exec "$host" systemd-run --user --collect --unit "$unit" \
        --property "WorkingDirectory=$remote_run" \
        --property "StandardOutput=append:$remote_run/logs/frontend-$number.log" \
