}

start_frontend() {
    local number="$1"
    local index=$((number - 1))
    local host="${hosts[$index]}"
    frontend_unit_generations[index]=$((frontend_unit_generations[index] + 1))
    local unit="$run_name-frontend-$number-${frontend_unit_generations[$index]}"
    frontend_units[index]="$unit"
    remote_exec "$host" systemd-run --user --collect --unit "$unit" \
        --property "WorkingDirectory=$remote_run" \
        --property "StandardOutput=append:$remote_run/logs/frontend-$number.log" \
        --property "StandardError=append:$remote_run/logs/frontend-$number.log" \
        --setenv "ARGMIN_CLUSTER_CONFIG_PATH=$remote_run/cluster.toml" \
        --setenv "ARGMIN_PROCESS_ID=frontend-$number" \
        "$remote_run/argmin-s3"
}

stop_frontend() {
    local number="$1"
    local index=$((number - 1))
    local host="${hosts[$index]}"
    local unit="${frontend_units[$index]}"
    [[ -n "$unit" ]] || return 0
    remote_exec "$host" systemctl --user stop "$unit"
    frontend_units[index]=""
}

stop_host_services() {
    local number="$1"
    local index=$((number - 1))
    local host="${hosts[$index]}"
    local frontend_unit="${frontend_units[$index]}"
    local storage_unit="${storage_units[$index]}"
    local authority_unit="${current_units[$index]}"
    [[ -n "$frontend_unit" && -n "$storage_unit" && -n "$authority_unit" ]] ||
        die "host $number does not have all three Argmin services running"
    remote_exec "$host" systemctl --user stop \
        "$frontend_unit" "$storage_unit" "$authority_unit"
    frontend_units[index]=""
    storage_units[index]=""
    current_units[index]=""
}

wait_frontend_listener() {
    local number="$1"
    local index=$((number - 1))
    local host="${hosts[$index]}"
    local unit="${frontend_units[$index]}"
    local attempt
    for ((attempt = 0; attempt < 600; attempt++)); do
        if ! remote_exec_quiet "$host" systemctl --user is-active --quiet "$unit"; then
            remote_exec_quiet "$host" systemctl --user status "$unit" --no-pager >&2 || true
            remote_exec_quiet "$host" tail -n 200 "$remote_run/logs/frontend-$number.log" >&2 || true
            die "frontend-$number exited before binding its S3 listener"
        fi
        if timeout 1 bash -c "echo >/dev/tcp/${addresses[$index]}/$frontend_port" >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.1
    done
    remote_exec_quiet "$host" tail -n 200 "$remote_run/logs/frontend-$number.log" >&2 || true
    die "frontend-$number did not bind ${addresses[$index]}:$frontend_port"
}

assert_all_service_units_active() {
    local number index host unit label
    for number in 1 2 3; do
        index=$((number - 1))
        host="${hosts[$index]}"
        for label in authority storage frontend; do
            case "$label" in
                authority) unit="${current_units[$index]}" ;;
                storage) unit="${storage_units[$index]}" ;;
                frontend) unit="${frontend_units[$index]}" ;;
            esac
            [[ -n "$unit" ]] || die "host $number has no tracked $label unit"
            remote_exec_quiet "$host" systemctl --user is-active --quiet "$unit" ||
                die "host $number $label unit $unit is not active"
        done
        wait_authority_listener "$number"
        wait_storage_listener "$number"
        wait_frontend_listener "$number"
    done
}

admin_command() {
    local number="$command_process_number"
    local index=$((number - 1))
    remote_exec_quiet "${hosts[$index]}" env \
        "ARGMIN_CLUSTER_CONFIG_PATH=$remote_run/cluster.toml" \
        "ARGMIN_PROCESS_ID=control-$number" \
        "$remote_run/argmin-s3" "$@"
}

frontend_read_command() {
    local number="$command_process_number"
    local index=$((number - 1))
    remote_exec_quiet "${hosts[$index]}" env \
        "ARGMIN_CLUSTER_CONFIG_PATH=$remote_run/cluster.toml" \
        "ARGMIN_PROCESS_ID=frontend-$number" \
        "$remote_run/argmin-s3" "$@"
}

last_runtime_epoch=""
wait_runtime_map_ready() {
    local minimum_exclusive_epoch="${1:--1}"
    local deadline=$((SECONDS + 120))
    local status=""
    local runtime_epoch runtime_pg_routes active_serving_pg_routes trailing
    while ((SECONDS < deadline)); do
        if status="$(frontend_read_command control-plane-runtime-map-ready "$remote_run/unused.sock" 2>&1)"; then
            read -r runtime_epoch runtime_pg_routes active_serving_pg_routes trailing <<<"$status"
            if [[ "$runtime_epoch" =~ ^[0-9]+$ && "$runtime_pg_routes" == "$pg_count" &&
                "$minimum_exclusive_epoch" =~ ^-?[0-9]+$ &&
                "$runtime_epoch" -gt "$minimum_exclusive_epoch" &&
                "$active_serving_pg_routes" == "$pg_count" && -z "$trailing" ]]; then
                last_runtime_epoch="$runtime_epoch"
                echo "runtime_map_ready $status"
                return 0
            fi
            status="runtime-map status is not fully serving: $status"
        fi
        sleep 0.2
    done
    [[ -z "$status" ]] || echo "last_runtime_map_error=$status" >&2
    frontend_read_command control-plane-runtime-map-diagnostics "$remote_run/unused.sock" >&2 || true
    die "control-plane runtime map did not become ready"
}

data_plane_bucket_file="$local_run/data-plane-bucket"
data_plane_body_file="$local_run/data-plane-body"
data_plane_keys=()

run_data_client_on() {
    local number="$1"
    shift
    local index=$((number - 1))
    local data_plane_endpoint="http://${addresses[$index]}:$frontend_port"
    print_command env \
        "S3_TEST_ENDPOINT=$data_plane_endpoint" \
        "S3_TEST_BUCKET_PREFIX=argmin-multihost-" \
        "S3_TEST_TIMEOUT_SECS=60" \
        "AWS_TEST_ACCESS_KEY=argmin-multihost-primary" \
        "AWS_TEST_SECRET_KEY=argmin-multihost-primary-secret" \
        "AWS_TEST_REGION=us-east-1" \
        "$client_binary" "$@"
    env \
        "S3_TEST_ENDPOINT=$data_plane_endpoint" \
        "S3_TEST_BUCKET_PREFIX=argmin-multihost-" \
        "S3_TEST_TIMEOUT_SECS=60" \
        "AWS_TEST_ACCESS_KEY=argmin-multihost-primary" \
        "AWS_TEST_SECRET_KEY=argmin-multihost-primary-secret" \
        "AWS_TEST_REGION=us-east-1" \
        "$client_binary" "$@"
}

put_data_plane_object_on() {
    local number="$1"
    shift
    local key="$1"
    run_data_client_on "$number" put "$data_plane_bucket_file" "$key" "$data_plane_body_file"
    data_plane_keys+=("$key")
}

verify_data_plane_objects_on() {
    local number="$1"
    local key
    for key in "${data_plane_keys[@]}"; do
        run_data_client_on "$number" get "$data_plane_bucket_file" "$key" "$data_plane_body_file"
    done
    run_data_client_on "$number" head "$data_plane_bucket_file" "${data_plane_keys[0]}" "$data_plane_body_file"
    run_data_client_on "$number" list-contains "$data_plane_bucket_file" "${data_plane_keys[@]}"
}

verify_data_plane_objects_across_running_frontends() {
    local number index verified=0
    for number in 1 2 3; do
        index=$((number - 1))
        [[ -n "${frontend_units[$index]}" ]] || continue
        verify_data_plane_objects_on "$number"
        verified=$((verified + 1))
    done
    ((verified > 0)) || die "no running frontend was available for data verification"
}

status_field() {
    local status="$1"
    local field="$2"
    local token
    for token in $status; do
        if [[ "$token" == "$field="* ]]; then
            printf '%s\n' "${token#*=}"
            return 0
        fi
    done
    return 1
}

diagnostic_line() {
    local diagnostics="$1"
    local prefix="$2"
    local line
    while IFS= read -r line; do
        if [[ "$line" == "$prefix "* ]]; then
            printf '%s\n' "$line"
            return 0
        fi
    done <<<"$diagnostics"
    return 1
}

diagnostic_value() {
    local diagnostics="$1"
    local prefix="$2"
    local field="$3"
    local line value
    line="$(diagnostic_line "$diagnostics" "$prefix")" ||
        die "diagnostics omitted $prefix"
    value="$(status_field "$line" "$field")" ||
        die "$prefix diagnostics omitted $field"
    [[ "$value" =~ ^[0-9]+$ ]] ||
        die "$prefix diagnostic $field is not an unsigned integer: $value"
    printf '%s\n' "$value"
}

diagnostic_sum() {
    local diagnostics="$1"
    local prefix="$2"
    local field="$3"
    local line value total=0 found=0
    while IFS= read -r line; do
        [[ "$line" == "$prefix "* ]] || continue
        found=1
        value="$(status_field "$line" "$field")" ||
            die "$prefix diagnostics omitted $field"
        [[ "$value" =~ ^[0-9]+$ ]] ||
            die "$prefix diagnostic $field is not an unsigned integer: $value"
        total=$((total + value))
    done <<<"$diagnostics"
    ((found == 1)) || die "diagnostics omitted $prefix"
    printf '%s\n' "$total"
}

diagnostic_max() {
    local diagnostics="$1"
    local prefix="$2"
    local field="$3"
    local line value maximum=0 found=0
    while IFS= read -r line; do
        [[ "$line" == "$prefix "* ]] || continue
        found=1
        value="$(status_field "$line" "$field")" ||
            die "$prefix diagnostics omitted $field"
        [[ "$value" =~ ^[0-9]+$ ]] ||
            die "$prefix diagnostic $field is not an unsigned integer: $value"
        if ((value > maximum)); then
            maximum="$value"
        fi
    done <<<"$diagnostics"
    ((found == 1)) || die "diagnostics omitted $prefix"
    printf '%s\n' "$maximum"
}

last_status=""
wait_clock_status() {
    local expected_established="$1"
    local min_term="${2:-0}"
    local deadline=$((SECONDS + 60))
    local status term established last_error=""
    while ((SECONDS < deadline)); do
        if status="$(admin_command control-plane-authority-clock-status "$remote_run/unused.sock" 2>&1)"; then
            term="$(status_field "$status" current_raft_term || true)"
            established="$(status_field "$status" established || true)"
            if [[ "$term" =~ ^[0-9]+$ && "$established" == "$expected_established" ]] && ((term >= min_term)); then
                last_status="$status"
                return 0
            fi
        else
            last_error="$status"
        fi
        sleep 0.1
    done
    [[ -z "${status:-}" ]] || echo "last_authority_clock_status=$status" >&2
    [[ -z "$last_error" ]] || echo "last_authority_clock_error=$last_error" >&2
    die "authority clock did not reach established=$expected_established at term >= $min_term"
}

authority_clock_checkpoint_digest() {
    local number="$1"
    local index=$((number - 1))
    remote_exec_quiet "${hosts[$index]}" sha256sum "$remote_run/state-$number/control.state.clock" 2>/dev/null |
        awk '{print $1}'
}

stabilize_rejoined_clock() {
    local min_term="$1"
    local stable_observations=0
    local deadline=$((SECONDS + 60))
    local status term established blocked_reason
    while ((SECONDS < deadline)); do
        if status="$(admin_command control-plane-authority-clock-status "$remote_run/unused.sock" 2>/dev/null)"; then
            term="$(status_field "$status" current_raft_term || true)"
            established="$(status_field "$status" established || true)"
            blocked_reason="$(status_field "$status" blocked_reason || true)"
            if [[ "$term" =~ ^[0-9]+$ ]] && ((term >= min_term)); then
                if [[ "$established" == "false" && "$blocked_reason" == "Some(RaftLeadershipChanged)" ]]; then
                    admin_command control-plane-reestablish-authority-clock "$remote_run/unused.sock"
                    min_term="$term"
                    stable_observations=0
                elif [[ "$established" == "true" ]]; then
                    stable_observations=$((stable_observations + 1))
                    if ((stable_observations >= 10)); then
                        last_status="$status"
                        return 0
                    fi
                else
                    stable_observations=0
                fi
            fi
        else
            stable_observations=0
        fi
        sleep 0.5
    done
    [[ -z "${status:-}" ]] || echo "$status" >&2
    die "rejoined voter did not converge in one established Raft term"
}

transferred_term=""
transfer_leadership_to() {
    local target_number="$1"
    local target_raft_node=$((100 + target_number))
    local previous_term transfer_attempt transfer_confirmed=0
    local target_clock_digest_before target_clock_digest_after

    wait_clock_status true
    previous_term="$(status_field "$last_status" current_raft_term)"
    for transfer_attempt in 1 2 3 4 5; do
        target_clock_digest_before="$(authority_clock_checkpoint_digest "$target_number" || true)"
        admin_command control-plane-transfer-raft-leadership \
            "$remote_run/unused.sock" "$target_raft_node"
        # OpenRaft returns after queuing the transfer broadcast. The target can
        # subsequently reject it until its durable log reaches the advertised
        # tip, in which case another voter can win the resulting term. Recover
        # that observed term before deciding whether a retry is safe.
        sleep 4
        wait_clock_status false "$previous_term"
        [[ "$(status_field "$last_status" blocked_reason)" == "Some(RaftLeadershipChanged)" ]] ||
            die "leadership transfer produced an unexpected authority-clock state: $last_status"
        admin_command control-plane-reestablish-authority-clock "$remote_run/unused.sock"
        wait_clock_status true "$previous_term"
        transferred_term="$(status_field "$last_status" current_raft_term)"
        target_clock_digest_after="$(authority_clock_checkpoint_digest "$target_number" || true)"
        if [[ -n "$target_clock_digest_after" &&
            "$target_clock_digest_after" != "$target_clock_digest_before" ]]; then
            transfer_confirmed=1
            break
        fi
        echo "Raft transfer attempt $transfer_attempt settled on another voter at term $transferred_term; retrying target $target_raft_node"
        previous_term="$transferred_term"
    done
    ((transfer_confirmed == 1)) ||
        die "Raft node $target_raft_node did not publish a post-transfer authority-clock checkpoint"
}

capture_quantitative_baseline() {
    local number="$1"
    local index=$((number - 1))
    local diagnostics checkpoint_line wal_line
    diagnostics="$(frontend_read_command control-plane-runtime-map-diagnostics \
        "$remote_run/unused.sock")"
    printf '%s\n' "$diagnostics" \
        >"$metrics_dir/control-$number-baseline.txt"
    checkpoint_line="control_plane_raft_checkpoint"
    wal_line="control_plane_raft_wal"
    quantitative_baseline_checkpoint_bytes[index]="$(diagnostic_value \
        "$diagnostics" "$checkpoint_line" bytes_total)"
    quantitative_baseline_wal_bytes[index]="$(diagnostic_value \
        "$diagnostics" "$wal_line" frame_bytes_total)"
    quantitative_baseline_checkpoint_errors[index]="$(diagnostic_value \
        "$diagnostics" "$checkpoint_line" store_error_total)"
    quantitative_baseline_checkpoint_compaction_errors[index]="$(diagnostic_value \
        "$diagnostics" "$checkpoint_line" compaction_error_total)"
    quantitative_baseline_wal_errors[index]="$(diagnostic_value \
        "$diagnostics" "$wal_line" append_error_total)"
    quantitative_baseline_rpc_write_errors[index]="$(diagnostic_sum \
        "$diagnostics" control_plane_rpc response_write_error_total)"
    quantitative_baseline_seconds[index]="$SECONDS"
}

accumulate_quantitative_generation() {
    local number="$1"
    local label="$2"
    local index=$((number - 1))
    local diagnostics checkpoint_line wal_line
    local checkpoint_bytes wal_bytes checkpoint_errors checkpoint_compaction_errors
    local wal_errors rpc_write_errors
    local checkpoint_delta wal_delta
    local checkpoint_store_us_max wal_file_sync_us_max rpc_operation_us_max

    diagnostics="$(frontend_read_command control-plane-runtime-map-diagnostics \
        "$remote_run/unused.sock")"
    printf '%s\n' "$diagnostics" \
        >"$metrics_dir/control-$number-generation-${unit_generations[$index]}-$label.txt"
    checkpoint_line="control_plane_raft_checkpoint"
    wal_line="control_plane_raft_wal"
    checkpoint_bytes="$(diagnostic_value "$diagnostics" "$checkpoint_line" bytes_total)"
    wal_bytes="$(diagnostic_value "$diagnostics" "$wal_line" frame_bytes_total)"
    checkpoint_errors="$(diagnostic_value \
        "$diagnostics" "$checkpoint_line" store_error_total)"
    checkpoint_compaction_errors="$(diagnostic_value \
        "$diagnostics" "$checkpoint_line" compaction_error_total)"
    wal_errors="$(diagnostic_value "$diagnostics" "$wal_line" append_error_total)"
    rpc_write_errors="$(diagnostic_sum \
        "$diagnostics" control_plane_rpc response_write_error_total)"

    ((checkpoint_bytes >= quantitative_baseline_checkpoint_bytes[index])) ||
        die "control-$number checkpoint byte counter regressed"
    ((wal_bytes >= quantitative_baseline_wal_bytes[index])) ||
        die "control-$number WAL byte counter regressed"
    ((checkpoint_errors == quantitative_baseline_checkpoint_errors[index])) ||
        die "control-$number checkpoint errors increased during the sustained interval"
    ((checkpoint_compaction_errors == quantitative_baseline_checkpoint_compaction_errors[index])) ||
        die "control-$number checkpoint compaction errors increased during the sustained interval"
    ((wal_errors == quantitative_baseline_wal_errors[index])) ||
        die "control-$number WAL errors increased during the sustained interval"
    ((rpc_write_errors == quantitative_baseline_rpc_write_errors[index])) ||
        die "control-$number response-write errors increased during the sustained interval"

    checkpoint_delta=$((checkpoint_bytes - quantitative_baseline_checkpoint_bytes[index]))
    wal_delta=$((wal_bytes - quantitative_baseline_wal_bytes[index]))
    quantitative_checkpoint_bytes[index]=$((quantitative_checkpoint_bytes[index] + checkpoint_delta))
    quantitative_wal_bytes[index]=$((quantitative_wal_bytes[index] + wal_delta))
    checkpoint_store_us_max="$(diagnostic_value \
        "$diagnostics" "$checkpoint_line" store_us_max)"
    wal_file_sync_us_max="$(diagnostic_value \
        "$diagnostics" "$wal_line" file_sync_us_max)"
    rpc_operation_us_max="$(diagnostic_max \
        "$diagnostics" control_plane_rpc operation_us_max)"
    if ((checkpoint_store_us_max > quantitative_checkpoint_store_us_max[index])); then
        quantitative_checkpoint_store_us_max[index]="$checkpoint_store_us_max"
    fi
    if ((wal_file_sync_us_max > quantitative_wal_file_sync_us_max[index])); then
        quantitative_wal_file_sync_us_max[index]="$wal_file_sync_us_max"
    fi
    if ((rpc_operation_us_max > quantitative_rpc_operation_us_max[index])); then
        quantitative_rpc_operation_us_max[index]="$rpc_operation_us_max"
    fi
    ((checkpoint_store_us_max <= max_checkpoint_store_us)) ||
        die "control-$number checkpoint store latency $checkpoint_store_us_max us exceeds $max_checkpoint_store_us us"
    ((wal_file_sync_us_max <= max_wal_file_sync_us)) ||
        die "control-$number WAL file-sync latency $wal_file_sync_us_max us exceeds $max_wal_file_sync_us us"
    ((rpc_operation_us_max <= max_rpc_operation_us)) ||
        die "control-$number RPC operation latency $rpc_operation_us_max us exceeds $max_rpc_operation_us us"
}

reset_quantitative_generation_baseline() {
    local number="$1"
    local index=$((number - 1))

    quantitative_baseline_checkpoint_bytes[index]=0
    quantitative_baseline_wal_bytes[index]=0
    quantitative_baseline_checkpoint_errors[index]=0
    quantitative_baseline_checkpoint_compaction_errors[index]=0
    quantitative_baseline_wal_errors[index]=0
    quantitative_baseline_rpc_write_errors[index]=0
}

capture_quantitative_result() {
    local number="$1"
    local index=$((number - 1))
    local diagnostics checkpoint_line wal_line
    local checkpoint_delta wal_delta durable_bytes elapsed_seconds durable_bytes_per_second
    local wal_queue_depth checkpoint_store_us_max wal_file_sync_us_max rpc_operation_us_max
    local artifact_bytes wal_file_bytes summary

    accumulate_quantitative_generation "$number" final
    diagnostics="$(<"$metrics_dir/control-$number-generation-${unit_generations[$index]}-final.txt")"
    printf '%s\n' "$diagnostics" >"$metrics_dir/control-$number-final.txt"
    checkpoint_line="control_plane_raft_checkpoint"
    wal_line="control_plane_raft_wal"

    checkpoint_delta="${quantitative_checkpoint_bytes[$index]}"
    wal_delta="${quantitative_wal_bytes[$index]}"
    durable_bytes=$((checkpoint_delta + wal_delta))
    elapsed_seconds=$((SECONDS - quantitative_baseline_seconds[index]))
    ((elapsed_seconds > 0)) || die "control-$number quantitative interval was empty"
    durable_bytes_per_second=$(((durable_bytes + elapsed_seconds - 1) / elapsed_seconds))
    ((durable_bytes_per_second < max_durable_bytes_per_second)) ||
        die "control-$number durable rate $durable_bytes_per_second B/s reached the release limit $max_durable_bytes_per_second B/s"

    wal_queue_depth="$(diagnostic_value "$diagnostics" "$wal_line" durability_queue_depth)"
    ((wal_queue_depth == 0)) ||
        die "control-$number ended with WAL durability queue depth $wal_queue_depth"
    checkpoint_store_us_max="${quantitative_checkpoint_store_us_max[$index]}"
    wal_file_sync_us_max="${quantitative_wal_file_sync_us_max[$index]}"
    rpc_operation_us_max="${quantitative_rpc_operation_us_max[$index]}"

    artifact_bytes="$(remote_exec_quiet "${hosts[$index]}" stat -c %s \
        "$remote_run/state-$number/control.state")"
    wal_file_bytes="$(remote_exec_quiet "${hosts[$index]}" stat -c %s \
        "$remote_run/state-$number/control.state.wal")"
    [[ "$artifact_bytes" =~ ^[0-9]+$ && "$wal_file_bytes" =~ ^[0-9]+$ ]] ||
        die "control-$number returned invalid durable file sizes"
    ((artifact_bytes <= 1048576)) ||
        die "control-$number restart artifact is $artifact_bytes bytes after purge"
    ((wal_file_bytes <= 67108864)) ||
        die "control-$number WAL is $wal_file_bytes bytes after purge"

    summary="control_plane_multihost_quantitative node=$number elapsed_seconds=$elapsed_seconds checkpoint_bytes=$checkpoint_delta wal_bytes=$wal_delta durable_bytes_per_second=$durable_bytes_per_second checkpoint_store_us_max=$checkpoint_store_us_max wal_file_sync_us_max=$wal_file_sync_us_max rpc_operation_us_max=$rpc_operation_us_max artifact_bytes=$artifact_bytes wal_file_bytes=$wal_file_bytes"
    printf '%s\n' "$summary" | tee -a "$metrics_dir/release-summary.txt"
}

assert_no_quantitative_auth_failures() {
    local index number host output grep_status
    local pattern='authentication (failed|rejected)|auth rejected'
    for index in 0 1 2; do
        number=$((index + 1))
        host="${hosts[$index]}"
        if output="$(remote_exec_quiet "$host" grep -nE "$pattern" \
            "$remote_run/logs/control-$number.log" \
            "$remote_run/logs/storage-$number.log" \
            "$remote_run/logs/frontend-$number.log" 2>/dev/null)"; then
            printf '%s\n' "$output" >"$metrics_dir/host-$number-auth-failures.txt"
            die "host $number logged an internal RPC authentication failure"
        else
            grep_status=$?
            ((grep_status == 1)) ||
                die "could not inspect host $number internal RPC authentication logs"
        fi
    done
}

echo "== start static authenticated TCP authorities =="
start_authority 2
wait_authority_listener 2
start_authority 3
wait_authority_listener 3
start_authority 1
wait_authority_listener 1
wait_for_raft_network
wait_clock_status true
echo "initial_authority_clock=$last_status"

echo "== start authenticated TLS/TCP storage nodes =="
for number in 1 2 3; do
    start_storage "$number"
done
for number in 1 2 3; do
    wait_storage_listener "$number"
done
wait_for_storage_network
wait_runtime_map_ready

echo "== build retained route history =="
baseline_output="$(admin_command control-plane-set-pg-acting-set-live "$remote_run/unused.sock" 0 1 2 2>&1)"
printf '%s\n' "$baseline_output" >&2
if [[ "$baseline_output" =~ control-plane\ set\ PG\ [0-9]+\ acting\ set\ at\ epoch\ ([0-9]+) ]]; then
    last_route_epoch="${BASH_REMATCH[1]}"
else
    die "could not parse baseline route epoch from admin response"
fi

route_advances=0
route_attempts=0
max_route_attempts=$((retained_epochs + (3 * pg_count)))
while ((route_advances < retained_epochs)); do
    route_attempts=$((route_attempts + 1))
    ((route_attempts <= max_route_attempts)) ||
        die "only observed $route_advances route epoch advances after $max_route_attempts attempts"
    pg_id=$(((route_attempts - 1) % pg_count))
    if ((route_attempts % 3 == 1)); then
        acting_set=(1 2)
    elif ((route_attempts % 3 == 2)); then
        acting_set=(2 3)
    else
        acting_set=(1 3)
    fi
    print_command admin_command control-plane-set-pg-acting-set-live "$remote_run/unused.sock" "$pg_id" "${acting_set[@]}"
    route_output="$(admin_command control-plane-set-pg-acting-set-live "$remote_run/unused.sock" "$pg_id" "${acting_set[@]}" 2>&1)"
    printf '%s\n' "$route_output" >&2
    if [[ "$route_output" =~ control-plane\ set\ PG\ [0-9]+\ acting\ set\ at\ epoch\ ([0-9]+) ]]; then
        route_epoch="${BASH_REMATCH[1]}"
    else
        die "could not parse route epoch from admin response"
    fi
    if ((route_epoch > last_route_epoch)); then
        route_advances=$((route_advances + 1))
        last_route_epoch="$route_epoch"
    elif ((route_epoch < last_route_epoch)); then
        die "route epoch regressed from $last_route_epoch to $route_epoch"
    fi
done
echo "retained_route_history advances=$route_advances attempts=$route_attempts final_epoch=$last_route_epoch"
admin_command control-plane-trigger-raft-snapshot-purge "$remote_run/unused.sock"
wait_runtime_map_ready

echo "== start split-role frontends and seed cross-frontend S3 workload =="
for number in 1 2 3; do
    start_frontend "$number"
done
for number in 1 2 3; do
    wait_frontend_listener "$number"
done
openssl rand -out "$data_plane_body_file" 1048576
run_data_client_on 1 create-put "$data_plane_bucket_file" object-000 "$data_plane_body_file"
data_plane_keys+=(object-000)
for ((object_index = 1; object_index < data_object_count; object_index++)); do
    printf -v object_key 'object-%03d' "$object_index"
    frontend_number=$(((object_index % 3) + 1))
    put_data_plane_object_on "$frontend_number" "$object_key"
done
verify_data_plane_objects_across_running_frontends
run_data_client_on 2 cleanup-versioned-stress 1 2 2 multihost-versioned "$data_plane_body_file"
echo "data_plane_cross_frontend_seed objects=${#data_plane_keys[@]} frontends=3 body_bytes=$(wc -c <"$data_plane_body_file")"

if ((quantitative)); then
    echo "== begin quantitative outage and sustained interval =="
    admin_command control-plane-trigger-raft-snapshot-purge "$remote_run/unused.sock"
    wait_runtime_map_ready
    for number in 1 2 3; do
        transfer_leadership_to "$number"
        wait_runtime_map_ready
        capture_quantitative_baseline "$number"
    done
    quantitative_deadline=$((SECONDS + sustained_seconds))
fi

for ((iteration = 1; iteration <= repeat_count; iteration++)); do
    target_number=$((((iteration - 1) % 3) + 1))
    target_raft_node=$((100 + target_number))
    survivor_number=$((target_number % 3 + 1))
    wait_runtime_map_ready
    pre_host_outage_epoch="$last_runtime_epoch"
    echo "== host-service outage iteration $iteration: stop frontend, storage, and Raft node $target_raft_node =="
    transfer_leadership_to "$target_number"

    if ((quantitative)); then
        wait_runtime_map_ready
        accumulate_quantitative_generation "$target_number" before-restart
    fi
    stop_host_services "$target_number"
    if ((quantitative)); then
        reset_quantitative_generation_baseline "$target_number"
    fi
    command_process_number="$survivor_number"
    wait_clock_status false "$((transferred_term + 1))"
    [[ "$(status_field "$last_status" blocked_reason)" == "Some(RaftLeadershipChanged)" ]] ||
        die "host outage produced an unexpected authority-clock state: $last_status"
    admin_command control-plane-reestablish-authority-clock "$remote_run/unused.sock"
    wait_clock_status true "$((transferred_term + 1))"

    verify_data_plane_objects_across_running_frontends
    echo "host_outage_reads_verified host=$target_number surviving_frontends=2 objects=${#data_plane_keys[@]}"

    start_authority "$target_number"
    wait_authority_listener "$target_number"
    stabilize_rejoined_clock "$((transferred_term + 1))"
    start_storage "$target_number"
    wait_storage_listener "$target_number"
    wait_for_storage_network
    wait_runtime_map_ready "$pre_host_outage_epoch"
    start_frontend "$target_number"
    wait_frontend_listener "$target_number"

    rejoin_key="host-rejoin-$iteration"
    put_data_plane_object_on "$target_number" "$rejoin_key"
    verify_data_plane_objects_across_running_frontends
    echo "host_rejoin_verified host=$target_number epoch=$last_runtime_epoch objects=${#data_plane_keys[@]}"
    admin_command control-plane-trigger-raft-snapshot-purge "$remote_run/unused.sock"
done

if ((quantitative)); then
    echo "== complete quantitative sustained multihost release interval =="
    quantitative_read_rounds=0
    while ((SECONDS < quantitative_deadline)); do
        frontend_number=$(((quantitative_read_rounds % 3) + 1))
        verify_data_plane_objects_on "$frontend_number"
        quantitative_read_rounds=$((quantitative_read_rounds + 1))
        remaining_seconds=$((quantitative_deadline - SECONDS))
        if ((remaining_seconds > 5)); then
            sleep 5
        elif ((remaining_seconds > 0)); then
            sleep "$remaining_seconds"
        fi
    done

    admin_command control-plane-trigger-raft-snapshot-purge "$remote_run/unused.sock"
    wait_runtime_map_ready
    for number in 1 2 3; do
        transfer_leadership_to "$number"
        wait_runtime_map_ready
        capture_quantitative_result "$number"
    done
    assert_no_quantitative_auth_failures
    assert_all_service_units_active
    echo "control_plane_multihost_quantitative_complete host_outages=$repeat_count read_rounds=$quantitative_read_rounds sustained_seconds=$sustained_seconds"
fi

command_process_number=1
assert_all_service_units_active
run_data_client_on 1 cleanup "$data_plane_bucket_file" "${data_plane_keys[@]}"

echo "== final durable state =="
for index in 0 1 2; do
    number=$((index + 1))
    remote_exec "${hosts[$index]}" test -s "$remote_run/state-$number/control.state"
    remote_exec "${hosts[$index]}" find "$remote_run/state-$number" -maxdepth 1 -type f -printf '%f %s bytes\n'
    remote_exec "${hosts[$index]}" du -s -B1 "$remote_run/storage-$number"
done

if diagnostics="$(frontend_read_command control-plane-runtime-map-diagnostics "$remote_run/unused.sock" 2>/dev/null)"; then
    echo "$diagnostics"
fi

echo "OK: argmin-s3 multihost Raft and data-plane smoke passed"
