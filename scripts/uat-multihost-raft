        --property "WorkingDirectory=$remote_run" \
        --property "StandardOutput=append:$remote_run/logs/storage-$number.log" \
        --property "StandardError=append:$remote_run/logs/storage-$number.log" \
        --setenv "ARGMIN_CLUSTER_CONFIG_PATH=$remote_run/cluster.toml" \
        --setenv "ARGMIN_PROCESS_ID=storage-$number" \
        "$remote_run/argmin-s3"
}

