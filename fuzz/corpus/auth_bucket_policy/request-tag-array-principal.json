{
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "AWS": [
            "arn:aws:iam::444455556666:root",
            "arn:aws:iam::111122223333:root"
          ]
        },
        "Action": ["s3:PutObjectTagging"],
        "Resource": ["arn:aws:s3:::bucket/*"],
        "Condition": {
          "StringEquals": {
            "s3:RequestObjectTag/security": "public"
          }
        }
      }
    ]
  },
  "request": {
    "action": "PutObjectTagging",
    "principal": "arn:aws:iam::444455556666:user/alt",
    "bucket": "bucket",
    "key": "key",
    "request_tags": [
      ["security", "public"]
    ]
  }
}
