{
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "AWS": "arn:aws:iam::444455556666:root"
        },
        "Action": "s3:PutObject",
        "Resource": "arn:aws:s3:::bucket/*"
      },
      {
        "Effect": "Deny",
        "Principal": {
          "AWS": "arn:aws:iam::444455556666:root"
        },
        "Action": "s3:PutObject",
        "Resource": "arn:aws:s3:::bucket/*",
        "Condition": {
          "Null": {
            "s3:x-amz-acl": "true"
          }
        }
      }
    ]
  },
  "request": {
    "action": "PutObject",
    "principal": "arn:aws:iam::444455556666:user/alt",
    "bucket": "bucket",
    "key": "key"
  }
}
